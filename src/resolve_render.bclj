#lang beagle/clj

;; @upstream:graph — the code lives in the Fram fact graph; this text is
;; GENERATED. Author via the fram MCP graph-edit verbs (add-def / set-body /
;; rename-def / insert-after / replace-in-body), never Edit/Write — a text edit
;; would desync the graph. De-adopt (drop sentinel + registry entry) to edit as
;; text; that is a deliberate workflow change. ADOPTED 2026-07-27 (engine core
;; port link 3: the M1 resolve cuts become graph-authored modules).
;; ============================================================================
;; resolve-render — a graph node, rendered back to source.
;; ============================================================================
;; Stage M1 Cut E of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). Three related jobs, all reads:
;;
;;   render-sym  the spelling a symbol node RENDERS as. A resolved reference
;;               shows its BINDING's current name (mode-adjusted: ctor prefix,
;;               x/qualifier, :rename keep-spelling); an unresolved or literal
;;               symbol shows its stored v. This is the whole point of Turtle #5:
;;               a reference stores identity, so it renders the current name even
;;               after a graph rename it never heard about.
;;   node->str   a compact, copy-pastable source string for a node.
;;   node->canon the STRUCTURAL, formatting-insensitive comparison form — the
;;               same shape datum->canon computes for an EDN datum, which is what
;;               lets replace-in-body match a model-supplied anchor form against
;;               the graph without the model reproducing whitespace.
;;
;; plus the anchor search those feed: one O(N) post-order pass that canonicalizes
;; each node EXACTLY once and reports every fN edge whose child's canon equals the
;; target. A naive "canonicalize every candidate" re-walks each subtree per
;; candidate and blows up on a 10k-node mega-def.
;;
;; NOT HERE, deliberately: datum->canon stays raw in resolve.clj. It canonicalizes
;; what clojure.edn read, not what the graph holds, and it reaches java.util.regex
;; .Pattern directly — it is on the host side of the seam, and dragging it across
;; would buy externs, not logic.
;;
;; State arrives as parameters for the reason given in Cut B: resolve.clj's
;; ^:dynamic vars cannot change namespace, so it keeps one-line wrappers.
;;
;; Consumed by resolve.clj — the emitted out/resolve_render.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-render
  (:require [clojure.string :as str]
    [fram.types :as t]
    [fram.store :as c]
    [resolve-core :as rc]
    [resolve-read :as rr]
    [resolve-binds :as rb]))

(define-mode strict)

(defn ultimate [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? B :- Int?] :- Int?
  (loop [b :- Int? B n 0]
    (let [tgt (rr/refers-target ctx view BOUND REFERS b)]
      (if (and (some? tgt) (< n 64)) (recur tgt (inc n)) b))))

(defn binding-name [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? B :- Int?] :- Any
  (rr/sym-val ctx view (ultimate ctx view BOUND REFERS B)))

(defn render-sym [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? FIXED :- Int? e :- Int?] :- Any
  (let [v (rr/pred-val ctx view e "v") D (rr/refers-target ctx view BOUND REFERS e)]
    (if (nil? D)
      v
      (let [fixed? (and (some? ctx) (some? FIXED) (some? e) (not (empty? (c/by-lp ctx e FIXED)))) qual (rr/pred-val ctx view e "qualifier") cpfx (rr/pred-val ctx view e "ctor_prefix") afield (rr/pred-val ctx view e "accessor_field") nm0 (binding-name ctx view BOUND REFERS D) nm (cond (some? cpfx) (str (str cpfx) (str nm0)) (some? afield) (str (str/lower-case (str nm0)) "-" (str afield)) :else nm0)]
        (cond fixed? v (some? qual) (str (str qual) "/" (str nm)) :else nm)))))

(defn ord-edges [ctx :- (U (Atom t/Store) Nil) n :- Int?] :- (Vec Any)
  (if (or (nil? ctx) (nil? n))
    []
    (let [rows (reduce (fn [acc :- (Vec Any) cid :- Int] :- (Vec Any) (let [cl (c/fact-of ctx cid) pi :- Any (if (nil? cl) nil (get cl :p)) p :- Any (if (int? pi) (c/literal ctx pi) nil) r :- Any (if (nil? cl) nil (get cl :r))] (if (and (string? p) (rc/ord-pos? p) (int? r)) (conj acc [(rc/ord-parse p) p cid r]) acc))) [] (c/by-l ctx n))]
      (vec (sort-by (fn [row :- Any] :- Any (nth row 0)) rc/ord-cmp rows)))))

(defn node->str [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? FIXED :- Int? n :- Int?] :- String
  (let [k (rr/kind-of ctx view n)]
    (cond
      (= "list" k)
      (let [kids (rr/ordered-children ctx n) h (nth kids 0 nil) hs (if (and (some? h) (= "symbol" (rr/kind-of ctx view h))) (render-sym ctx view BOUND REFERS FIXED h) nil) kidstr (fn [ks :- (Vec Int)] :- String (str/join " " (mapv (fn [c :- Int] :- String (node->str ctx view BOUND REFERS FIXED c)) ks)))]
        (cond
          (= hs "#%brackets")
          (str "[" (kidstr (vec (rest kids))) "]")
          (= hs "#%map")
          (str "{" (kidstr (vec (rest kids))) "}")
          (= hs "#%set")
          (str "#{" (kidstr (vec (rest kids))) "}")
          (= hs "#%regex")
          (str "#\"" (str (rr/pred-val ctx view (nth kids 1 nil) "v")) "\"")
          :else
          (str "(" (kidstr kids) ")")))
      (= "symbol" k)
      (str (render-sym ctx view BOUND REFERS FIXED n))
      (= "string" k)
      (pr-str (rr/pred-val ctx view n "v"))
      (= "number" k)
      (str (rr/pred-val ctx view n "v"))
      (= "char" k)
      (str "\\" (str (rr/pred-val ctx view n "v")))
      :else
      (str (rr/pred-val ctx view n "v")))))

(defn node->canon [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? FIXED :- Int? n :- Int?] :- Any
  (if (= "list" (rr/kind-of ctx view n))
    (into [:list]
      (mapv (fn [c :- Int] :- Any (node->canon ctx view BOUND REFERS FIXED c))
        (rr/ordered-children ctx n)))
    (if (= "symbol" (rr/kind-of ctx view n))
      [:leaf "symbol" (render-sym ctx view BOUND REFERS FIXED n)]
      [:leaf (rr/kind-of ctx view n) (rr/pred-val ctx view n "v")])))

(defn- anchor-go [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? FIXED :- Int? n :- Int? target :- Any chain :- (Vec Int)] :- (Vec Any)
  (if (= "list" (rr/kind-of ctx view n))
    (let [chain2 (if (nil? n) chain (conj chain n)) st (reduce (fn [st :- (Vec Any) row :- Any] :- (Vec Any) (let [pos (nth row 1) cid (nth row 2) ch (nth row 3) sub (anchor-go ctx view BOUND REFERS FIXED ch target chain2) cc (nth sub 0) ms (into (nth st 1) (nth sub 1))] [(conj (nth st 0) cc) (if (= cc target) (conj ms {:parent n :pos pos :cid cid :child ch :chain chain2}) ms)])) [[] []] (ord-edges ctx n))]
      [(into [:list] (nth st 0)) (nth st 1)])
    [(if (= "symbol" (rr/kind-of ctx view n))
       [:leaf "symbol" (render-sym ctx view BOUND REFERS FIXED n)]
       [:leaf (rr/kind-of ctx view n) (rr/pred-val ctx view n "v")])
     []]))

(defn anchor-match-sites [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? FIXED :- Int? root :- Int? target :- Any] :- (Vec Any)
  (vec (nth (anchor-go ctx view BOUND REFERS FIXED root target []) 1)))

(defn anchor-matches [ctx :- (U (Atom t/Store) Nil) view :- Any BOUND :- Int? REFERS :- Int? FIXED :- Int? root :- Int? target :- Any] :- (Vec Any)
  (mapv (fn [s :- Any] :- Any [(get s :parent) (get s :pos) (get s :cid) (get s :child)])
    (anchor-match-sites ctx view BOUND REFERS FIXED root target)))

(defn crumb-label [ctx :- (U (Atom t/Store) Nil) view :- Any n :- Int?] :- Any
  (let [h (rr/head-sym ctx view n)]
    (if (some? h)
      h
      (cond
        (rb/map-node? ctx view n)
        "{}"
        (rb/brackets? ctx view n)
        "[]"
        :else
        "(...)"))))

;; ------------------------------------------------------------- identity ----

;; Follow the refers_to/bound_to chain to the node that actually HOLDS the name.

;; Capped at 64 hops: a cycle in the graph must not hang a render.

;; PER-DEF NOTES (the graph-edit datum channel carries FORMS, not text, so a

;; comment cannot ride inside an authored form; the load-bearing prose lives

;; here instead — same convention as src/pull.bclj).

;; ---------------------------------------------------------------------------

;;   render-sym

;;     ---------------------------------------------------------------- render ---

;;   ord-edges

;;     [ord-key pos-lit cid child] fN edges of n, in CRDT (ord-key) order.

;;   node->str

;;     Compact, copy-pastable source for a node: references by their CURRENT name

;;     (render-sym), structural fN children only and CRDT-ordered, comments/tails

;;     omitted.

;;   node->canon

;;     The canonical comparison form of a NODE — leaf -> [:leaf kind spelling],

;;     list -> [:list child-canon...]. Deliberately the same shape datum->canon

;;     produces for an EDN datum.

;;   anchor-go

;;     --------------------------------------------------------- anchor search ---

;;     ONE post-order pass. Each node's canon is computed exactly once on the way up;

;;     every fN edge whose child's canon equals `target` is appended to `acc`, in

;;     visit order, together with the ancestor chain (def-root .. immediate parent) a

;;     reject payload needs for breadcrumbs and a :within suggestion. The search ROOT

;;     itself is never a candidate — only its interior children — because replacing a

;;     whole top-level def is upsert-form's job, not this verb's.

;;     Returns [canon-of-n matches-under-n]. The original threaded the matches

;;     through an atom and a `letfn`; a returned pair says the same thing without an

;;     effect, and keeps the visit order identical — a child's own matches are

;;     appended during its recursion (deepest first), then the parent's match FOR

;;     that child, then the next sibling.

;;   anchor-match-sites

;;     [{:parent :pos :cid :child :chain} ...] — every interior match, with its

;;     enclosing ancestor chain in descent order.

;;   anchor-matches

;;     [parent pos-literal edge-cid child-node] per match — anchor-match-sites with

;;     the chain dropped. The original ran a SECOND, chain-free copy of the same

;;     post-order walk to produce this; one walk that always carries the chain gives

;;     the identical sequence (same traversal, same predicate, same order) for the

;;     cost of the chain allocation, so the duplicate is gone.

;;   crumb-label

;;     A short, distinctive label for one breadcrumb rung (an enclosing form's head).
