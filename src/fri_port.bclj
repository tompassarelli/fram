#lang beagle/clj
;; FRI is a disposable acceleration cache over a canonical TermStore/FRAMLOG.
;; Its private handles never cross the semantic API boundary.
(ns fri-port
  (:require [clojure.edn :as edn]
            [fram.store :as store]
            [fram.types :as t])
  (:import [java.io ByteArrayInputStream ByteArrayOutputStream
            DataInputStream DataOutputStream File FileOutputStream]
           [java.nio.charset StandardCharsets]
           [java.nio.file Files StandardCopyOption]
           [java.security MessageDigest]))

(define-mode strict)

(def MAGIC: String "FRAMFRI2")
(def FMT: Int 2)

;; The cache is accepted only when its immutable space and exact canonical-log
;; prefix match the caller's expectation.
(defrecord CacheSource [space-id: String fingerprint: String valid-bytes: Int])
(defrecord CacheReceipt
  [format: Int space-id: String source-fingerprint: String
   source-position: Int sha256: String])
(defrecord CacheImage
  [source: CacheSource dump: t/TermStoreDump indexes: Any store: Any])

(defn- fail [message: String type: Keyword] -> Any
  (throw (ex-info message {:type type})))

(defn- valid-fingerprint? [value: String] -> Bool
  (some? (re-matches #"[0-9a-f]{64}" value)))

(defn source-binding
  [space-id: String fingerprint: String valid-bytes: Int] -> CacheSource
  (if (and (pos? (count space-id))
           (and (valid-fingerprint? fingerprint) (>= valid-bytes 0)))
    (->CacheSource space-id fingerprint valid-bytes)
    (fail "fri: source binding requires SpaceId, sha256, and non-negative valid-byte position"
          :invalid-cache-source)))

(defn- utf8 [value: String] -> Any
  (.getBytes value StandardCharsets/UTF_8))

(defn- hex [bytes: Any] -> String
  (apply str (map (fn [value: Any] -> String
                    (format "%02x" (bit-and value 255)))
                  bytes)))

(defn- sha256 [bytes: Any] -> String
  (hex (.digest (MessageDigest/getInstance "SHA-256") bytes)))

(defn- instant-data [value: Any] -> Any
  [(t/instant-epoch-seconds value) (t/instant-nanos value)])

(defn- atom-row-data [row: t/AtomRow] -> Any
  (let [kind: Keyword (t/atomrow-kind row)]
    (cond
      [(= kind :string) [kind (t/atomrow-string-value row)]]
      [(= kind :int) [kind (t/atomrow-int-value row)]]
      [(= kind :float) [kind (t/atomrow-float-value row)]]
      [(= kind :bool) [kind (t/atomrow-bool-value row)]]
      [(= kind :keyword) [kind (t/atomrow-keyword-value row)]]
      [(= kind :instant) [kind (instant-data (t/atomrow-instant-value row))]]
      [:else (fail "fri: AtomRow has an unknown kind" :invalid-fri-cache)])))

(defn- data-atom-row [entry: Any] -> t/AtomRow
  (if (not (and (vector? entry) (= 2 (count entry))))
    (fail "fri: malformed AtomRow" :invalid-fri-cache)
    (let [kind: Any (nth entry 0)
          value: Any (nth entry 1)]
      (cond
        [(and (= kind :string) (string? value))
         (t/->AtomRow :string value nil nil nil nil nil)]
        [(and (= kind :int) (integer? value))
         (t/->AtomRow :int nil value nil nil nil nil)]
        [(and (= kind :float) (and (number? value) (not (integer? value))))
         (t/->AtomRow :float nil nil value nil nil nil)]
        [(and (= kind :bool) (boolean? value))
         (t/->AtomRow :bool nil nil nil value nil nil)]
        [(and (= kind :keyword) (keyword? value))
         (t/->AtomRow :keyword nil nil nil nil value nil)]
        [(and (= kind :instant)
              (and (vector? value)
                   (and (= 2 (count value))
                        (and (integer? (nth value 0))
                             (integer? (nth value 1))))))
         (t/->AtomRow :instant nil nil nil nil nil
                      (t/instant (nth value 0) (nth value 1)))]
        [:else (fail "fri: malformed AtomRow value" :invalid-fri-cache)]))))

(defn- triple-row-data [row: t/TripleRow] -> Any
  [(t/triplerow-slot0 row) (t/triplerow-slot1 row) (t/triplerow-slot2 row)])

(defn- data-triple-row [entry: Any] -> t/TripleRow
  (if (and (vector? entry)
           (and (= 3 (count entry)) (every? integer? entry)))
    (t/->TripleRow (nth entry 0) (nth entry 1) (nth entry 2))
    (fail "fri: malformed TripleRow" :invalid-fri-cache)))

(defn- transaction-row-data [row: t/TransactionRow] -> Any
  [(t/transactionrow-sequence row)
   (t/transactionrow-first-operation row)
   (t/transactionrow-operation-count row)])

(defn- data-transaction-row [entry: Any] -> t/TransactionRow
  (if (and (vector? entry)
           (and (= 3 (count entry)) (every? integer? entry)))
    (t/->TransactionRow (nth entry 0) (nth entry 1) (nth entry 2))
    (fail "fri: malformed TransactionRow" :invalid-fri-cache)))

(defn- action-code [action: Keyword] -> Int
  (cond
    [(= action t/assert-action) 1]
    [(= action t/retract-action) 2]
    [:else (fail "fri: operation has an unknown action" :invalid-fri-cache)]))

(defn- code-action [code: Int] -> Keyword
  (cond
    [(= code 1) t/assert-action]
    [(= code 2) t/retract-action]
    [:else (fail "fri: operation has an unknown action code" :invalid-fri-cache)]))

(defn- operation-row-data [row: t/OperationRow] -> Any
  [(t/operationrow-tx-sequence row)
   (t/operationrow-ordinal row)
   (action-code (t/operationrow-action row))
   (t/operationrow-triple-handle row)])

(defn- data-operation-row [entry: Any] -> t/OperationRow
  (if (and (vector? entry)
           (and (= 4 (count entry)) (every? integer? entry)))
    (t/->OperationRow (nth entry 0) (nth entry 1)
                      (code-action (nth entry 2)) (nth entry 3))
    (fail "fri: malformed OperationRow" :invalid-fri-cache)))

(defn- atom-handle [position: Int] -> Int (* 2 position))
(defn- triple-handle [position: Int] -> Int (inc (* 2 position)))

(defn- index-data [rows: Any] -> Any
  (let [with-handles: Any
        (map-indexed (fn [position: Int row: t/TripleRow] -> Any
                       [(triple-handle position) row])
                     rows)]
    [(vec (sort (map (fn [entry: Any] -> Any
                       [(t/triplerow-slot0 (nth entry 1)) (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry: Any] -> Any
                       [(t/triplerow-slot1 (nth entry 1)) (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry: Any] -> Any
                       [(t/triplerow-slot2 (nth entry 1)) (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry: Any] -> Any
                       [(t/triplerow-slot0 (nth entry 1))
                        (t/triplerow-slot1 (nth entry 1))
                        (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry: Any] -> Any
                       [(t/triplerow-slot1 (nth entry 1))
                        (t/triplerow-slot2 (nth entry 1))
                        (nth entry 0)])
                     with-handles)))
     (vec (sort (map (fn [entry: Any] -> Any
                       [(t/triplerow-slot0 (nth entry 1))
                        (t/triplerow-slot2 (nth entry 1))
                        (nth entry 0)])
                     with-handles))) ]))

;; The payload contains only named-row projections and homogeneous row vectors.
;; It is deterministic and intentionally carries no semantic assertion id.
(defn- dump-data [dump: t/TermStoreDump] -> Any
  [(t/termstoredump-space-id dump)
   (t/termstoredump-next-sequence dump)
   (mapv atom-row-data (t/termstoredump-atoms dump))
   (mapv triple-row-data (t/termstoredump-triples dump))
   (mapv transaction-row-data (t/termstoredump-transactions dump))
   (mapv operation-row-data (t/termstoredump-operations dump))
   (index-data (t/termstoredump-triples dump))])

(defn- valid-index-row? [width: Int entry: Any] -> Bool
  (and (vector? entry)
       (and (= width (count entry)) (every? integer? entry))))

(defn- data-cache [value: Any] -> Any
  (if (not (and (vector? value) (= 7 (count value))))
    (fail "fri: malformed TermStore payload" :invalid-fri-cache)
    (let [space-id: Any (nth value 0)
          next-sequence: Any (nth value 1)
          atoms: Any (nth value 2)
          triples: Any (nth value 3)
          transactions: Any (nth value 4)
          operations: Any (nth value 5)
          indexes: Any (nth value 6)]
      (if (not (and (string? space-id)
                    (and (integer? next-sequence)
                         (and (vector? atoms)
                              (and (vector? triples)
                                   (and (vector? transactions)
                                        (and (vector? operations)
                                             (and (vector? indexes)
                                                  (= 6 (count indexes))))))))))
        (fail "fri: malformed TermStore payload fields" :invalid-fri-cache)
        (let [dump: t/TermStoreDump
              (t/->TermStoreDump
               store/term-store-dump-version space-id next-sequence
               (mapv data-atom-row atoms)
               (mapv data-triple-row triples)
               (mapv data-transaction-row transactions)
               (mapv data-operation-row operations))
              widths: Any [2 2 2 3 3 3]]
          (if (not (every? true?
                           (map-indexed
                            (fn [position: Int entries: Any] -> Bool
                              (and (vector? entries)
                                   (every? (fn [entry: Any] -> Bool
                                             (valid-index-row? (nth widths position) entry))
                                           entries)))
                            indexes)))
            (fail "fri: malformed slot index" :invalid-fri-cache)
            (if (not (= indexes (index-data (t/termstoredump-triples dump))))
              (fail "fri: slot index does not match TripleRow table"
                    :invalid-fri-cache)
              {:dump dump :indexes indexes})))))))

(defn- validate-dump! [dump: Any source: CacheSource] -> Any
  (if (not (t/term-store-dump? dump))
    (fail "fri: legacy cache input requires rebuild from canonical FRAMLOG"
          :cache-rebuild-required)
    (if (not (= store/term-store-dump-version (t/termstoredump-version dump)))
      (fail "fri: legacy cache input requires rebuild from canonical FRAMLOG"
            :cache-rebuild-required)
      (if (not (= (cachesource-space-id source)
                  (t/termstoredump-space-id dump)))
        (fail "fri: cache source and TermStore belong to different spaces"
              :cache-space-mismatch)
        (let [ctx: Any (store/new-term-store (cachesource-space-id source))]
          (store/load-term-store! ctx dump)
          ctx)))))

(defn- write-bytes! [path: String bytes: Any] -> Nil
  (let [target: Any (File. path)
        parent: Any (.getParentFile target)
        temporary: Any (File. (str path ".tmp"))]
    (when (some? parent) (.mkdirs parent))
    (with-open [stream (FileOutputStream. temporary)]
      (.write stream bytes)
      (.flush stream)
      (.force (.getChannel stream) true))
    (Files/move (.toPath temporary) (.toPath target)
                (into-array StandardCopyOption
                            [StandardCopyOption/ATOMIC_MOVE
                             StandardCopyOption/REPLACE_EXISTING]))
    nil))

(defn write-fri!
  [dump: Any path: String source: CacheSource] -> Any
  (do
    (validate-dump! dump source)
    (let [payload: Any (utf8 (pr-str (dump-data dump)))
          header: Any (utf8 (pr-str [(cachesource-space-id source)
                                     (cachesource-fingerprint source)
                                     (cachesource-valid-bytes source)
                                     (sha256 payload)]))
          buffer: ByteArrayOutputStream (ByteArrayOutputStream.)]
      (with-open [stream (DataOutputStream. buffer)]
        (.write stream (utf8 MAGIC))
        (.writeInt stream FMT)
        (.writeInt stream (alength header))
        (.write stream header)
        (.writeLong stream (alength payload))
        (.write stream payload)
        (.flush stream))
      (write-bytes! path (.toByteArray buffer))
      (->CacheReceipt FMT
                      (cachesource-space-id source)
                      (cachesource-fingerprint source)
                      (cachesource-valid-bytes source)
                      (sha256 (.toByteArray buffer))))))

(defn- read-sized [stream: DataInputStream n: Int] -> Any
  (if (or (< n 0) (> n 2147483647))
    (fail "fri: invalid segment length" :invalid-fri-cache)
    (let [bytes: Any (byte-array n)]
      (.readFully stream bytes)
      bytes)))

(defn- decode-header [bytes: Any] -> Any
  (let [value: Any (edn/read-string (String. bytes StandardCharsets/UTF_8))]
    (if (and (vector? value)
             (and (= 4 (count value))
                  (and (string? (nth value 0))
                       (and (string? (nth value 1))
                            (and (integer? (nth value 2))
                                 (string? (nth value 3)))))))
      value
      (fail "fri: malformed cache header" :invalid-fri-cache))))

(defn- read-envelope [path: String] -> Any
  (try
    (with-open [stream (DataInputStream.
                        (ByteArrayInputStream. (Files/readAllBytes (.toPath (File. path)))))]
      (let [magic-bytes: Any (read-sized stream (count MAGIC))
            magic: String (String. magic-bytes StandardCharsets/US_ASCII)]
        (if (= magic "FRAMFRI1")
          (fail "fri: legacy or unknown cache requires rebuild from canonical FRAMLOG"
                :cache-rebuild-required)
          (if (not (= magic MAGIC))
            (fail "fri: invalid cache magic" :invalid-fri-cache)
            (let [format: Int (.readInt stream)]
              (if (= format 1)
              (fail "fri: legacy cache format requires rebuild from canonical FRAMLOG"
                    :cache-rebuild-required)
                (if (not (= format FMT))
                  (fail "fri: unsupported cache format" :invalid-fri-cache)
                  (let [header: Any (decode-header (read-sized stream (.readInt stream)))
                        payload-length: Int (.readLong stream)
                        payload: Any (read-sized stream payload-length)]
                    (if (not (= 0 (.available stream)))
                      (fail "fri: cache has trailing bytes" :invalid-fri-cache)
                      {:header header :payload payload})))))))))
    (catch clojure.lang.ExceptionInfo error
      (throw error))
    (catch Throwable error
      (throw (ex-info "fri: cache is truncated or malformed"
                      {:type :invalid-fri-cache :cause (str error)})))))

(defn open-fri! [path: String source: CacheSource] -> Any
  (let [envelope: Any (read-envelope path)
        header: Any (:header envelope)
        payload: Any (:payload envelope)
        stored-space: Any (nth header 0)
        stored-fingerprint: Any (nth header 1)
        stored-position: Any (nth header 2)
        stored-sha: Any (nth header 3)]
    (if (not (= stored-space (cachesource-space-id source)))
      (fail "fri: cache belongs to a different SpaceId" :cache-space-mismatch)
      (if (not (and (= stored-fingerprint (cachesource-fingerprint source))
                    (= stored-position (cachesource-valid-bytes source))))
        (fail "fri: cache does not match the canonical FRAMLOG prefix"
              :cache-source-mismatch)
        (if (not (= stored-sha (sha256 payload)))
          (fail "fri: cache payload checksum mismatch" :invalid-fri-cache)
          (let [cache-data: Any
                (data-cache (edn/read-string (String. payload StandardCharsets/UTF_8)))
                dump: t/TermStoreDump (:dump cache-data)
                ctx: Any (validate-dump! dump source)]
            (->CacheImage source dump (:indexes cache-data) ctx)))))))

(defn- atom-value [row: t/AtomRow] -> Any
  (let [kind: Keyword (t/atomrow-kind row)]
    (cond
      [(= kind :string) (t/atomrow-string-value row)]
      [(= kind :int) (t/atomrow-int-value row)]
      [(= kind :float) (t/atomrow-float-value row)]
      [(= kind :bool) (t/atomrow-bool-value row)]
      [(= kind :keyword) (t/atomrow-keyword-value row)]
      [(= kind :instant) (t/atomrow-instant-value row)]
      [:else (fail "fri: AtomRow has an unknown kind" :invalid-fri-cache)])))

(defn- atom-handle? [handle: Int] -> Bool (= 0 (mod handle 2)))
(defn- handle-position [handle: Int] -> Int (quot handle 2))

(defn- resolve-handle [dump: t/TermStoreDump handle: Int] -> Any
  (let [position: Int (handle-position handle)]
    (if (atom-handle? handle)
      (atom-value (nth (t/termstoredump-atoms dump) position))
      (let [row: t/TripleRow (nth (t/termstoredump-triples dump) position)]
        (t/triple (resolve-handle dump (t/triplerow-slot0 row))
                  (resolve-handle dump (t/triplerow-slot1 row))
                  (resolve-handle dump (t/triplerow-slot2 row)))))))

(defn- term-handles [dump: t/TermStoreDump] -> Any
  (into {}
        (concat
         (map-indexed (fn [position: Int row: t/AtomRow] -> Any
                        [(atom-value row) (atom-handle position)])
                      (t/termstoredump-atoms dump))
         (map-indexed (fn [position: Int row: t/TripleRow] -> Any
                        [(resolve-handle dump (triple-handle position))
                         (triple-handle position)])
                      (t/termstoredump-triples dump)))))

(defn- index-matches [image: Any index-position: Int keys: Any] -> Any
  (let [dump: t/TermStoreDump (cacheimage-dump image)
        handles: Any (term-handles dump)
        key-handles: Any (mapv (fn [term: Any] -> Any (get handles term)) keys)]
    (if (some nil? key-handles)
      []
      (let [entries: Any (nth (cacheimage-indexes image) index-position)
            key-count: Int (count key-handles)]
        (mapv (fn [entry: Any] -> Any
                (resolve-handle dump (nth entry key-count)))
              (filter (fn [entry: Any] -> Bool
                        (= key-handles (subvec entry 0 key-count)))
                      entries))))))

(defn- live-positions-as-of [image: Any sequence: Int] -> Any
  (if (< sequence 0)
    (fail "fri: as-of sequence must be non-negative" :invalid-as-of-sequence)
    (let [dump: t/TermStoreDump (cacheimage-dump image)
          operations: Any (t/termstoredump-operations dump)]
      (loop [position 0 active {} live []]
        (if (or (>= position (count operations))
                (> (t/operationrow-tx-sequence (nth operations position)) sequence))
          (vec (keep-indexed (fn [index: Int present?: Bool] -> Any
                               (when present? index))
                             live))
          (let [row: t/OperationRow (nth operations position)
                handle: Int (t/operationrow-triple-handle row)
                positions: Any (get active handle [])]
            (if (= t/assert-action (t/operationrow-action row))
              (recur (inc position)
                     (assoc active handle (conj positions position))
                     (conj live true))
              (if (empty? positions)
                (recur (inc position) active (conj live false))
                (let [target: Int (peek positions)]
                  (recur (inc position)
                         (assoc active handle (pop positions))
                         (conj (assoc live target false) false)))))))))))

(defn- occurrence-event [dump: t/TermStoreDump position: Int] -> t/Triple
  (let [row: t/OperationRow (nth (t/termstoredump-operations dump) position)
        transaction: t/Triple
        (t/transaction-coordinate (t/termstoredump-space-id dump)
                                  (t/operationrow-tx-sequence row))
        occurrence: t/Triple
        (t/occurrence-coordinate transaction (t/operationrow-ordinal row))
        proposition: Any
        (resolve-handle dump (t/operationrow-triple-handle row))]
    (if (= t/assert-action (t/operationrow-action row))
      (t/assertion-occurrence occurrence proposition)
      (t/retraction-occurrence occurrence proposition))))

(defn close-fri! [image: Any] -> Nil nil)
(defn restore-store! [image: Any target: Any] -> Any
  (store/load-term-store! target (cacheimage-dump image)))
(defn space-id [image: Any] -> String
  (cachesource-space-id (cacheimage-source image)))
(defn source-fingerprint [image: Any] -> String
  (cachesource-fingerprint (cacheimage-source image)))
(defn source-position [image: Any] -> Int
  (cachesource-valid-bytes (cacheimage-source image)))
(defn transaction-count [image: Any] -> Int
  (store/transaction-count (cacheimage-store image)))
(defn operation-count [image: Any] -> Int
  (store/operation-count (cacheimage-store image)))
(defn semantic-history [image: Any] -> Any
  (store/semantic-history (cacheimage-store image)))
(defn operation-occurrences [image: Any] -> Any
  (store/operation-occurrences (cacheimage-store image)))
(defn live-occurrences [image: Any] -> Any
  (store/live-occurrences (cacheimage-store image)))
(defn live-propositions [image: Any] -> Any
  (store/live-propositions (cacheimage-store image)))
(defn by-slot0 [image: Any term: Any] -> Any (index-matches image 0 [term]))
(defn by-slot1 [image: Any term: Any] -> Any (index-matches image 1 [term]))
(defn by-slot2 [image: Any term: Any] -> Any (index-matches image 2 [term]))
(defn by-slot01 [image: Any slot0: Any slot1: Any] -> Any
  (index-matches image 3 [slot0 slot1]))
(defn by-slot12 [image: Any slot1: Any slot2: Any] -> Any
  (index-matches image 4 [slot1 slot2]))
(defn by-slot02 [image: Any slot0: Any slot2: Any] -> Any
  (index-matches image 5 [slot0 slot2]))
(defn live-occurrences-as-of [image: Any sequence: Int] -> Any
  (let [dump: t/TermStoreDump (cacheimage-dump image)]
    (mapv (fn [position: Int] -> t/Triple (occurrence-event dump position))
          (live-positions-as-of image sequence))))
(defn live-propositions-as-of [image: Any sequence: Int] -> Any
  (let [dump: t/TermStoreDump (cacheimage-dump image)]
    (mapv (fn [position: Int] -> Any
            (resolve-handle
             dump
             (t/operationrow-triple-handle
              (nth (t/termstoredump-operations dump) position))))
          (live-positions-as-of image sequence))))
