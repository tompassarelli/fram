#lang beagle

(ns fram.native-server
  (:require [fram.log-codec :as log]
            [fram.native-dispatch :as dispatch]
            [fram.native-wire-codec :as native-wire]
            [fram.schema :as schema]
            [fram.store :as term-store]
            [fram.types :as t]))

(define-mode strict)

(def server-abi: Int 2)
(def status-ok: Int 0)
(def status-fatal: Int 2)
(def empty-bytes: (Vec Int) [])

(defrecord Status [code: Int error: String?])

(defrecord Store [canonical-log-path: String session: schema/Session])

(defrecord Request [frame: t/RpcFrameV1])
(defrecord Response [frame: t/RpcFrameV1])

;; Optional payloads and errors stay opaque; status and byte fields have fixed
;; positions because the C adapter consumes those fields directly.
(defrecord StoreResult
  [status: Int
   store: Store?
   error: String?
   valid-log-bytes: Int
   boot-append: (Vec Int)])

(defrecord RequestResult
  [status: Int
   request: Request?
   error: String?])

(defrecord ResponseResult
  [status: Int
   response: Response?
   error: String?
   append-bytes: (Vec Int)
   next-store: StoreResult
   state-changed: Bool])

(defrecord BytesResult [status: Int bytes: (Vec Int)])

(defn error-or [error: String? fallback: String] -> String
  (if error error fallback))

(defn ok-status [] -> Status (->Status status-ok nil))

(defn fatal-status [message: String] -> Status
  (->Status status-fatal message))

(defn failed-store [message: String] -> StoreResult
  (->StoreResult status-fatal nil message 0 empty-bytes))

(defn failed-request [message: String] -> RequestResult
  (->RequestResult status-fatal nil message))

(defn failed-response
  [message: String
   store-result: StoreResult] -> ResponseResult
  (->ResponseResult
   status-fatal nil message empty-bytes store-result false))

(defn next-store-result [prior: StoreResult store: Store] -> StoreResult
  (->StoreResult
   status-ok store nil
   (storeresult-valid-log-bytes prior) empty-bytes))

(defn boot-store!
  [canonical-log-path: String
   space-id: String
   log-bytes: (Vec Int)] -> StoreResult
  (let [byte-count (count log-bytes)
        streamed
        (loop [position 0
               stream (log/start-framlog-stream space-id)]
          (if (or (>= position byte-count)
                  (log/bootstream-complete stream)
                  (log/bootstream-error stream))
            stream
            (let [remaining (- byte-count position)
                  chunk-size
                  (if (> remaining log/framlog-stream-max-chunk-bytes)
                    log/framlog-stream-max-chunk-bytes remaining)
                  chunk-end (+ position chunk-size)]
              (recur
               chunk-end
               (log/feed-framlog-stream!
                stream (subvec log-bytes position chunk-end) false)))))
        completed
        (if (or (log/bootstream-complete streamed)
                (log/bootstream-error streamed))
          streamed
          (log/feed-framlog-stream! streamed empty-bytes true))
        root (log/bootstream-store completed)
        error (log/bootstream-error completed)]
    (if (and (nil? error)
             (log/bootstream-complete completed)
             root)
      (->StoreResult
       status-ok
       (->Store canonical-log-path (schema/session root))
       nil
       (log/bootstream-valid-log-bytes completed)
       (log/bootstream-boot-append completed))
      (failed-store
       (error-or error
                 "native FRAMLOG boot failed")))))

(defn wrap-rpc-response
  [request-frame: t/RpcFrameV1
   rpc-response: t/RpcResponse] -> Response
  (->Response
   (t/->RpcFrameV1 :response 0
                   (t/rpcframev1-request-id request-frame)
                   nil rpc-response)))

(defn dispatch-request!
  [store-result: StoreResult
   store: Store
   request-value: Request
   now-ms: Int] -> ResponseResult
  (let [frame (request-frame request-value)
        request (t/rpcframev1-request frame)]
    (if request
      (let [session (store-session store)
            working-session (schema/fork-session session)
            root (schema/store-of working-session)
            before-sequence (term-store/current-sequence root)
            before-derived (schema/derived-generation-of working-session)
            rpc-response (dispatch/dispatch! working-session request now-ms)
            after-sequence (term-store/current-sequence root)
            after-derived (schema/derived-generation-of working-session)
            encoded (log/encode-store-append! root before-sequence)
            next-store
            (next-store-result
             store-result
             (->Store (store-canonical-log-path store) working-session))]
        (if (= status-ok (log/bytesresult-status encoded))
          (->ResponseResult status-ok
                            (wrap-rpc-response frame rpc-response)
                            nil
                            (log/bytesresult-bytes encoded)
                            next-store
                            (or (not= before-sequence after-sequence)
                                (not= before-derived after-derived)))
          (failed-response
           (error-or (log/bytesresult-error encoded)
                     "native FRAMLOG append encoding failed")
           store-result)))
      (failed-response
       "decoded request frame omitted RpcRequest" store-result))))

(defn read-request! [request-bytes: (Vec Int)] -> RequestResult
  (let [decoded (native-wire/decode-request-bytes! request-bytes)
        frame (native-wire/decoderesult-frame decoded)
        error (native-wire/decoderesult-error decoded)]
    (if (and (nil? error) frame)
      (->RequestResult status-ok (->Request frame) nil)
      (failed-request
       (error-or error "native FRAMRPC request decode failed")))))

(defn write-response! [response-value: Response] -> BytesResult
  (let [encoded
        (native-wire/encode-response-bytes! (response-frame response-value))
        bytes (native-wire/encoderesult-bytes encoded)
        error (native-wire/encoderesult-error encoded)]
    (if (and (nil? error) bytes)
      (->BytesResult status-ok bytes)
      (->BytesResult status-fatal empty-bytes))))

;; These eight functions are the generated-module contract consumed by
;; fram:native/server_host.h. Keep their order and signatures stable.
(defn server-generated-abi [] -> Int server-abi)

(defn server-store-boot!
  [canonical-log-path: String
   space-id: String
   log-bytes: (Vec Int)] -> StoreResult
  (boot-store! canonical-log-path space-id log-bytes))

(defn server-store-dispatch!
  [store-result: StoreResult
   request-result: RequestResult
   now-ms: Int] -> ResponseResult
  (let [store (storeresult-store store-result)
        request-value (requestresult-request request-result)]
    (if (and (= status-ok (storeresult-status store-result))
             store
             (= status-ok (requestresult-status request-result))
             request-value)
      (dispatch-request! store-result store request-value now-ms)
      (failed-response
       (if (not= status-ok (storeresult-status store-result))
         (error-or (storeresult-error store-result) "store boot failed")
         (error-or (requestresult-error request-result)
                   "request decode failed"))
       store-result))))

(defn server-store-shutdown [store-result: StoreResult] -> Status
  (let [store (storeresult-store store-result)]
    (if (and (= status-ok (storeresult-status store-result)) store)
      (ok-status)
      (fatal-status
       (error-or (storeresult-error store-result) "store boot failed")))))

(defn server-codec-read-request! [request-bytes: (Vec Int)] -> RequestResult
  (read-request! request-bytes))

(defn server-codec-write-response!
  [response-result: ResponseResult] -> BytesResult
  (let [response-value (responseresult-response response-result)]
    (if (and (= status-ok (responseresult-status response-result))
             response-value)
      (write-response! response-value)
      (->BytesResult status-fatal empty-bytes))))

(defn server-codec-release-request [request-result: RequestResult] -> Nil nil)

(defn server-codec-release-response [response-result: ResponseResult] -> Nil nil)

(defn main [] -> Int status-fatal)
