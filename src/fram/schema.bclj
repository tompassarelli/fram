#lang beagle/clj

;; @upstream:graph — the code lives in the Fram fact graph; this text is
;; GENERATED. Author via the fram MCP graph-edit verbs (add-def / set-body /
;; rename-def / insert-after / replace-in-body), never Edit/Write — a text edit
;; would desync the graph. De-adopt (drop sentinel + registry entry) to edit as
;; text; that is a deliberate workflow change. RE-ADOPTED 2026-07-09 after the
;; store-rename re-ingest (render(log) verified structurally identical).
;; ============================================================================
;; fram.schema — the store schema/identity layer over the kernel.
;; ============================================================================
;; Still DOMAIN-AGNOSTIC: this is the META-model (name/identity, predicate
;; cardinality + value-kind, cardinality-driven supersession) — NOT life-os
;; vocabulary. Mirrors the oracle's schema.rkt + graph.rkt. The life-os
;; predicates (title/owner/depends_on/…) are registered ON TOP via def-predicate!
;; in the domain loader; they never appear here.
;;
;; Predicates are interned VALUES (a pred = value! of its name). Metadata
;; (cardinality single|multi, value_kind ref|literal) and identity (name) are
;; facts, so the store is self-describing — no external @id↔entity memo, and the
;; hardcoded single-valued list is gone (cardinality is read from the graph).
;;
;; API (every op takes ctx + tx for writes):
;;   (setup! ctx tx)                       bootstrap name/superseded_by/cardinality/value_kind
;;   (def-predicate! ctx pname card kind tx) -> pid   register a predicate's metadata
;;   (cardinality ctx pname) -> "single"|"multi"
;;   (assert! ctx subj pname literal tx) -> cid       value fact (single -> supersede prior)
;;   (link!   ctx subj pname target tx)  -> cid       ref fact   (single -> supersede prior)
;;   (lookup ctx subj pname) / (lookup-all …) / (find-by ctx pname v)
;;   (name! ctx subj nm tx) / (name-of ctx subj) / (resolve-name ctx nm)
;; ============================================================================
(ns fram.schema)

(define-mode strict)

(require fram.store :as c)

(require fram.types :as t)

(defn setup! [ctx :- (Atom t/Store) tx :- Int] :- (Atom t/Store)
  (do
    (declare predicate-ids
      resolve-predicate
      predicate-name
      register-predicate!
      alias-predicate!
      rename-predicate!)
    (let [name-p (c/value! ctx "name") sup-p (c/value! ctx "store-supersedes") card-p (c/value! ctx "cardinality") kind-p (c/value! ctx "value_kind") pname-p (c/value! ctx "predicate_name") palias-p (c/value! ctx "predicate_alias") single-v (c/value! ctx "single") multi-v (c/value! ctx "multi") literal-v (c/value! ctx "literal") ref-v (c/value! ctx "ref")]
      (c/set-supersedes-pred! ctx sup-p)
      (register-predicate! ctx "name" tx)
      (register-predicate! ctx "store-supersedes" tx)
      (register-predicate! ctx "cardinality" tx)
      (register-predicate! ctx "value_kind" tx)
      (register-predicate! ctx "predicate_name" tx)
      (register-predicate! ctx "predicate_alias" tx)
      (c/fact! ctx name-p card-p single-v tx)
      (c/fact! ctx card-p card-p single-v tx)
      (c/fact! ctx kind-p card-p single-v tx)
      (c/fact! ctx pname-p card-p single-v tx)
      (c/fact! ctx palias-p card-p multi-v tx)
      (c/fact! ctx sup-p card-p multi-v tx)
      (c/fact! ctx name-p kind-p literal-v tx)
      (c/fact! ctx card-p kind-p literal-v tx)
      (c/fact! ctx kind-p kind-p literal-v tx)
      (c/fact! ctx pname-p kind-p literal-v tx)
      (c/fact! ctx palias-p kind-p literal-v tx)
      (c/fact! ctx sup-p kind-p ref-v tx)
      ctx)))

(defn cardinality [ctx :- (Atom t/Store) pname :- String] :- String
  (let [pid (resolve-predicate ctx pname) card-pid (resolve-predicate ctx "cardinality") cs (if (and (some? pid) (some? card-pid)) (c/by-lp ctx pid card-pid) [])]
    (if (empty? cs)
      "multi"
      (let [v :- Any (c/literal ctx (:r (c/fact-of ctx (first cs))))]
        (if (string? v) v "multi")))))

;; supersede prior live (subj,pid) facts other than new-cid (single-valued write)
(defn- replace! [ctx :- (Atom t/Store) subj :- Int pid :- Int new-cid :- Int tx :- Int] :- Any
  (let [sup (c/value! ctx "store-supersedes")]
    (doseq [old (c/by-lp ctx subj pid)]
      (when (not (= old new-cid)) (c/fact! ctx new-cid sup old tx)))))

(defn assert! [ctx :- (Atom t/Store) subj :- Int pname :- String v :- Any tx :- Int] :- Int
  (let [pid (register-predicate! ctx pname tx) new-cid (c/fact! ctx subj pid (c/value! ctx v) tx)]
    (when (= "single" (cardinality ctx pname))
      (replace! ctx subj pid new-cid tx))
    new-cid))

(defn link! [ctx :- (Atom t/Store) subj :- Int pname :- String target :- Int tx :- Int] :- Int
  (let [pid (register-predicate! ctx pname tx) new-cid (c/fact! ctx subj pid target tx)]
    (when (= "single" (cardinality ctx pname))
      (replace! ctx subj pid new-cid tx))
    new-cid))

(defn lookup-all [ctx :- (Atom t/Store) subj :- Int pname :- String] :- (Vec Any)
  (let [pid (resolve-predicate ctx pname) cids (if (some? pid) (c/by-lp ctx subj pid) [])]
    (mapv (fn [cid :- Int] :- Any (let [r (:r (c/fact-of ctx cid))] (if (c/value-object? ctx r) (c/literal ctx r) r)))
      cids)))

;; (first all) selects the default-main of a possibly-multi (l,p) group: a view selection (first-wins), not a uniqueness proof. cf resolve/select-main-1
(defn lookup [ctx :- (Atom t/Store) subj :- Int pname :- String] :- Any
  (let [all (lookup-all ctx subj pname)] (if (empty? all) nil (first all))))

(defn find-by [ctx :- (Atom t/Store) pname :- String v :- Any] :- (Vec Int)
  (let [pid (resolve-predicate ctx pname) vid (c/value-id ctx v) cids (if (and (some? pid) (some? vid)) (c/by-pr ctx pid vid) [])]
    (mapv (fn [cid :- Int] :- Int (:l (c/fact-of ctx cid))) cids)))

(defn def-predicate! [ctx :- (Atom t/Store) pname :- String card :- String kind :- String tx :- Int] :- Int
  (let [pid (register-predicate! ctx pname tx)]
    (assert! ctx pid "cardinality" card tx)
    (assert! ctx pid "value_kind" kind tx)
    pid))

(defn name! [ctx :- (Atom t/Store) subj :- Int nm :- String tx :- Int] :- Int
  (assert! ctx subj "name" nm tx))

(defn name-of [ctx :- (Atom t/Store) subj :- Int] :- String?
  (lookup ctx subj "name"))

(defn resolve-name [ctx :- (Atom t/Store) nm :- String] :- Int?
  (let [ls (find-by ctx "name" nm)] (if (empty? ls) nil (first ls))))

(defn- predicate-ids [ctx :- (Atom t/Store) spelling :- String] :- (Vec Int)
  (let [vid (c/value-id ctx spelling) name-pid (c/value-id ctx "predicate_name") alias-pid (c/value-id ctx "predicate_alias") named (if (and (some? vid) (some? name-pid)) (c/by-pr ctx name-pid vid) []) aliased (if (and (some? vid) (some? alias-pid)) (c/by-pr ctx alias-pid vid) []) ids (mapv (fn [cid :- Int] :- Int (:l (c/fact-of ctx cid))) (concat named aliased))]
    (vec (distinct ids))))

(defn resolve-predicate [ctx :- (Atom t/Store) spelling :- String] :- Int?
  (let [ids (predicate-ids ctx spelling)]
    (cond
      (> (count ids) 1)
      (throw (ex-info (str "predicate spelling collision: " spelling) {:predicate spelling :ids ids}))
      (= (count ids) 1)
      (first ids)
      :else
      (c/value-id ctx spelling))))

(defn predicate-name [ctx :- (Atom t/Store) pid :- Int] :- String
  (let [name-pid (c/value-id ctx "predicate_name") cids (if (some? name-pid) (c/by-lp ctx pid name-pid) []) raw :- Any (if (empty? cids) (if (c/value-object? ctx pid) (c/literal ctx pid) pid) (c/literal ctx (:r (c/fact-of ctx (last cids)))))]
    (if (string? raw) raw (str raw))))

(defn register-predicate! [ctx :- (Atom t/Store) spelling :- String tx :- Int] :- Int
  (let [resolved (resolve-predicate ctx spelling) legacy (c/value-id ctx spelling) candidate (if (some? resolved) resolved legacy) canonical (if (some? candidate) (predicate-name ctx candidate) spelling) default-alias (str ":" canonical) alias-ids (predicate-ids ctx default-alias)]
    (when (and (not (empty? alias-ids)) (or (nil? candidate) (not (and (= 1 (count alias-ids)) (= candidate (first alias-ids))))))
      (throw (ex-info (str "predicate alias collision: " default-alias) {:predicate canonical :alias default-alias :ids alias-ids})))
    (let [pid (if (some? candidate) candidate (c/value! ctx spelling)) name-pid (c/value! ctx "predicate_name") alias-pid (c/value! ctx "predicate_alias") name-cids (c/by-lp ctx pid name-pid)]
      (when (empty? name-cids)
        (c/fact! ctx pid name-pid (c/value! ctx spelling) tx))
      (when (empty? alias-ids)
        (c/fact! ctx pid alias-pid (c/value! ctx default-alias) tx))
      pid)))

(defn alias-predicate! [ctx :- (Atom t/Store) spelling :- String alias :- String tx :- Int] :- Int
  (let [resolved (resolve-predicate ctx spelling) candidate (if (some? resolved) resolved (c/value-id ctx spelling)) ids-before (predicate-ids ctx alias)]
    (when (and (not (empty? ids-before)) (or (nil? candidate) (not (and (= 1 (count ids-before)) (= candidate (first ids-before))))))
      (throw (ex-info (str "predicate spelling collision: " alias) {:predicate spelling :alias alias :ids ids-before})))
    (let [pid (register-predicate! ctx spelling tx) ids (predicate-ids ctx alias)]
      (when (empty? ids)
        (c/fact! ctx
          pid
          (c/value! ctx "predicate_alias")
          (c/value! ctx alias)
          tx))
      pid)))

(defn rename-predicate! [ctx :- (Atom t/Store) spelling :- String new-name :- String tx :- Int] :- Int
  (let [resolved (resolve-predicate ctx spelling) candidate (if (some? resolved) resolved (c/value-id ctx spelling)) name-ids (predicate-ids ctx new-name) default-alias (str ":" new-name) alias-ids (predicate-ids ctx default-alias)]
    (when (and (not (empty? name-ids)) (or (nil? candidate) (not (and (= 1 (count name-ids)) (= candidate (first name-ids))))))
      (throw (ex-info (str "predicate spelling collision: " new-name) {:predicate spelling :new-name new-name :ids name-ids})))
    (when (and (not (empty? alias-ids)) (or (nil? candidate) (not (and (= 1 (count alias-ids)) (= candidate (first alias-ids))))))
      (throw (ex-info (str "predicate alias collision: " default-alias) {:predicate spelling :new-name new-name :alias default-alias :ids alias-ids})))
    (let [pid (register-predicate! ctx spelling tx) old-name (predicate-name ctx pid)]
      (when (not (= old-name new-name))
        (let [old-ids (predicate-ids ctx old-name) alias-pid (c/value! ctx "predicate_alias") old-vid (c/value! ctx old-name) aliases (c/by-pr ctx alias-pid old-vid)]
          (when (and (= 1 (count old-ids)) (= pid (first old-ids)) (empty? aliases))
            (c/fact! ctx pid alias-pid old-vid tx)))
        (assert! ctx pid "predicate_name" new-name tx)
        (alias-predicate! ctx new-name default-alias tx))
      pid)))
