#lang beagle

;; Covering rotations over the LIVE assertion occurrences of one TermStore: a
;; disposable projection pinned to (SpaceId, store version), never kernel
;; semantics and never a second identity — discard on mismatch and rebuild.
;; Leaves hold occurrences in commit order, so two equal propositions asserted
;; twice stay two answers. Three rotations cover all eight bound-subsets:
;;   spo [s] [s p] [s p o]   pos [p] [p o]   osp [o] [o s]   unbound = events.
(ns fram.rotation)

(define-mode strict)

(require fram.types :as t)

(require fram.store :as store)

;; A leaf keyed by its bound-subset tuple. The keys are appended, never moved,
;; so a slot row names entry positions and a probe compares whole keys.
(defrecord Bucket
  [width: Int
   keys: (Vec (Vec Any))
   events: (Vec (Vec t/Triple))
   slots: (Vec (Vec Int))])

(defrecord Rotation
  [space-id: String
   version: Int
   events: (Vec t/Triple)
   by-occurrence: Bucket
   spo: Bucket
   pos: Bucket
   osp: Bucket])

(def empty-events: (Vec t/Triple) [])

(def empty-keys: (Vec (Vec Any)) [])

(def empty-event-lists: (Vec (Vec t/Triple)) [])

(def empty-positions: (Vec Int) [])

(def empty-slot-rows: (Vec (Vec Int)) [])

;; A bucket doubles once it holds more than this many keys per slot.
(def bucket-initial-slots: Int 64)

(def bucket-slot-load: Int 4)

(defn- fresh-slot-rows [width: Int] -> (Vec (Vec Int))
  (loop [rows: (Vec (Vec Int)) empty-slot-rows position: Int 0]
    (if (>= position width)
      rows
      (recur (conj rows empty-positions) (inc position)))))

(defn- empty-bucket [] -> Bucket
  (->Bucket bucket-initial-slots empty-keys empty-event-lists
    (fresh-slot-rows bucket-initial-slots)))

(defn- bucket-slot [key: (Vec Any) width: Int] -> Int (mod (hash key) width))

(defn- bucket-entry [bucket: Bucket key: (Vec Any)] -> Int
  (let [keys: (Vec (Vec Any)) (bucket-keys bucket) positions: (Vec Int) (nth (bucket-slots bucket) (bucket-slot key (bucket-width bucket)))]
    (loop [offset: Int 0]
      (if (>= offset (count positions))
        -1
        (let [position: Int (nth positions offset)]
          (if (= (nth keys position) key)
            position
            (recur (inc offset))))))))

(defn- bucket-get [bucket: Bucket key: (Vec Any)] -> (Vec t/Triple)
  (let [position: Int (bucket-entry bucket key)]
    (if (>= position 0) (nth (bucket-events bucket) position) empty-events)))

(defn- bucket-rehash [bucket: Bucket width: Int] -> Bucket
  (let [keys: (Vec (Vec Any)) (bucket-keys bucket)]
    (loop [rows: (Vec (Vec Int)) (fresh-slot-rows width) position: Int 0]
      (if (>= position (count keys))
        (->Bucket width keys (bucket-events bucket) rows)
        (let [slot: Int (bucket-slot (nth keys position) width)]
          (recur (assoc rows slot (conj (nth rows slot) position)) (inc position)))))))

(defn- bucket-set
  [bucket: Bucket
   key: (Vec Any)
   events: (Vec t/Triple)] -> Bucket
  (let [at: Int (bucket-entry bucket key)]
    (if (>= at 0)
      (->Bucket (bucket-width bucket) (bucket-keys bucket)
        (assoc (bucket-events bucket) at events)
        (bucket-slots bucket))
      (let [width: Int (bucket-width bucket) position: Int (count (bucket-keys bucket)) keys: (Vec (Vec Any)) (conj (bucket-keys bucket) key) lists: (Vec (Vec t/Triple)) (conj (bucket-events bucket) events) slot: Int (bucket-slot key width) rows: (Vec (Vec Int)) (assoc (bucket-slots bucket) slot (conj (nth (bucket-slots bucket) slot) position)) grown: Bucket (->Bucket width keys lists rows)]
        (if (> (count keys) (* bucket-slot-load width))
          (bucket-rehash grown (* 2 width))
          grown)))))

(defn- one-event [event: t/Triple] -> (Vec t/Triple) [event])

(defn- occurrence-key [occurrence: t/Triple] -> (Vec Any) [occurrence])

(defn occurrence-of [event: t/Triple] -> t/Triple (t/triple-t1 event))

(defn proposition-of [event: t/Triple] -> t/Triple (t/triple-t3 event))

(defn assertion-occurrence? [event: Any] -> Bool
  (and (t/triple? event)
    (and (= t/asserts (t/triple-t2 event))
      (and (t/occurrence-coordinate? (t/triple-t1 event))
        (t/triple? (t/triple-t3 event))))))

(defn- checked-assertion [event: t/Triple] -> t/Triple
  (if (assertion-occurrence? event)
    event
    (throw (ex-info "fram: rotations cover assertion occurrences only" {:type :invalid-rotation-occurrence}))))

(defn- bucket-add
  [bucket: Bucket
   key: (Vec Any)
   event: t/Triple] -> Bucket
  (bucket-set bucket key (conj (bucket-get bucket key) event)))

(defn- without-event [events: (Vec t/Triple) target: t/Triple] -> (Vec t/Triple)
  (filterv (fn [event: t/Triple] -> Bool (not (= event target))) events))

(defn- bucket-del
  [bucket: Bucket
   key: (Vec Any)
   event: t/Triple] -> Bucket
  (bucket-set bucket key (without-event (bucket-get bucket key) event)))

(defn- rotate-add [rotation: Rotation event: t/Triple] -> Rotation
  (let [proposition: t/Triple (proposition-of (checked-assertion event)) t1: Any (t/triple-t1 proposition) t2: Any (t/triple-t2 proposition) t3: Any (t/triple-t3 proposition)]
    (->Rotation (rotation-space-id rotation)
      (rotation-version rotation)
      (conj (rotation-events rotation) event)
      (bucket-set (rotation-by-occurrence rotation) (occurrence-key (occurrence-of event))
        (one-event event))
      (bucket-add (bucket-add (bucket-add (rotation-spo rotation) [t1] event) [t1 t2] event)
        [t1 t2 t3]
        event)
      (bucket-add (bucket-add (rotation-pos rotation) [t2] event)
        [t2 t3]
        event)
      (bucket-add (bucket-add (rotation-osp rotation) [t3] event)
        [t3 t1]
        event))))

(defn- rotate-del [rotation: Rotation event: t/Triple] -> Rotation
  (let [proposition: t/Triple (proposition-of (checked-assertion event)) t1: Any (t/triple-t1 proposition) t2: Any (t/triple-t2 proposition) t3: Any (t/triple-t3 proposition)]
    (->Rotation (rotation-space-id rotation)
      (rotation-version rotation)
      (without-event (rotation-events rotation) event)
      (bucket-set (rotation-by-occurrence rotation) (occurrence-key (occurrence-of event))
        empty-events)
      (bucket-del (bucket-del (bucket-del (rotation-spo rotation) [t1] event) [t1 t2] event)
        [t1 t2 t3]
        event)
      (bucket-del (bucket-del (rotation-pos rotation) [t2] event)
        [t2 t3]
        event)
      (bucket-del (bucket-del (rotation-osp rotation) [t3] event)
        [t3 t1]
        event))))

(defn- empty-rotation [space-id: String version: Int] -> Rotation
  (->Rotation space-id
    version
    empty-events
    (empty-bucket)
    (empty-bucket)
    (empty-bucket)
    (empty-bucket)))

(defn space-id [rotation: Rotation] -> String (rotation-space-id rotation))

(defn version [rotation: Rotation] -> Int (rotation-version rotation))

(defn all-occurrences [rotation: Rotation] -> (Vec t/Triple)
  (rotation-events rotation))

(defn occurrence-count [rotation: Rotation] -> Int
  (count (rotation-events rotation)))

;; Every bound subset resolves to exactly one bucket key; results stay in commit
;; order, so `last` is the newest live occurrence of that pattern.
(defn by-t1 [rotation: Rotation t1: Any] -> (Vec t/Triple)
  (bucket-get (rotation-spo rotation) [t1]))

(defn by-t12
  [rotation: Rotation
   t1: Any
   t2: Any] -> (Vec t/Triple)
  (bucket-get (rotation-spo rotation) [t1 t2]))

(defn by-t2 [rotation: Rotation t2: Any] -> (Vec t/Triple)
  (bucket-get (rotation-pos rotation) [t2]))

(defn by-t23
  [rotation: Rotation
   t2: Any
   t3: Any] -> (Vec t/Triple)
  (bucket-get (rotation-pos rotation) [t2 t3]))

(defn by-t3 [rotation: Rotation t3: Any] -> (Vec t/Triple)
  (bucket-get (rotation-osp rotation) [t3]))

(defn by-t13
  [rotation: Rotation
   t1: Any
   t3: Any] -> (Vec t/Triple)
  (bucket-get (rotation-osp rotation) [t3 t1]))

(defn by-proposition
  [rotation: Rotation
   proposition: t/Triple] -> (Vec t/Triple)
  (bucket-get (rotation-spo rotation)
    [(t/triple-t1 proposition)
     (t/triple-t2 proposition)
     (t/triple-t3 proposition)]))

;; nil in a slot means UNBOUND. This is the semantic entry point; the bucket
;; layout above is private detail every caller is expected to route through.
(defn matching
  [rotation: Rotation
   t1: Any
   t2: Any
   t3: Any] -> (Vec t/Triple)
  (cond
    [(and (some? t1) (and (some? t2) (some? t3)))
     (by-proposition rotation (t/triple t1 t2 t3))]
    [(and (some? t1) (some? t2)) (by-t12 rotation t1 t2)]
    [(and (some? t2) (some? t3)) (by-t23 rotation t2 t3)]
    [(and (some? t1) (some? t3)) (by-t13 rotation t1 t3)]
    [(some? t1) (by-t1 rotation t1)]
    [(some? t2) (by-t2 rotation t2)]
    [(some? t3) (by-t3 rotation t3)]
    [:else (rotation-events rotation)]))

(defn live-occurrence? [rotation: Rotation occurrence: t/Triple] -> Bool
  (not (empty? (bucket-get (rotation-by-occurrence rotation)
                 (occurrence-key occurrence)))))

(defn event-at [rotation: Rotation occurrence: t/Triple] -> t/Triple?
  (let [events: (Vec t/Triple) (bucket-get (rotation-by-occurrence rotation) (occurrence-key occurrence))]
    (if (empty? events) nil (nth events 0))))

(defn newest-first [events: (Vec t/Triple)] -> (Vec t/Triple)
  (vec (reverse events)))

(defn newest [events: (Vec t/Triple)] -> t/Triple?
  (if (empty? events) nil (last events)))

(defn propositions [events: (Vec t/Triple)] -> (Vec t/Triple)
  (mapv (fn [event: t/Triple] -> t/Triple (proposition-of event)) events))

(defn subjects [events: (Vec t/Triple)] -> (Vec Any)
  (mapv (fn [event: t/Triple] -> Any (t/triple-t1 (proposition-of event)))
    events))

(defn values [events: (Vec t/Triple)] -> (Vec Any)
  (mapv (fn [event: t/Triple] -> Any (t/triple-t3 (proposition-of event)))
    events))

(defn occurrences [events: (Vec t/Triple)] -> (Vec t/Triple)
  (mapv (fn [event: t/Triple] -> t/Triple (occurrence-of event)) events))

;; The build owns its cells outright and closes into ordinary values, so the
;; whole projection costs one append per leaf instead of one bucket copy.
(defrecord BucketBuild
  [width: Int
   keys: (Vec (Vec Any))
   events: (Vec (Atom (Vec t/Triple)))
   slots: (Vec (Atom (Vec Int)))])

(defrecord RotationBuild
  [events: (Vec t/Triple)
   by-occurrence: BucketBuild
   spo: BucketBuild
   pos: BucketBuild
   osp: BucketBuild])

(def empty-event-cells: (Vec (Atom (Vec t/Triple))) [])

(def empty-position-cells: (Vec (Atom (Vec Int))) [])

(defn- fresh-position-cells [width: Int] -> (Vec (Atom (Vec Int)))
  (loop [cells: (Vec (Atom (Vec Int))) empty-position-cells position: Int 0]
    (if (>= position width)
      cells
      (recur (conj cells (atom empty-positions)) (inc position)))))

(defn- cells-add!
  [cells: (Vec (Atom (Vec Int)))
   slot: Int
   position: Int] -> (Vec (Atom (Vec Int)))
  (do
    (swap! (nth cells slot) conj position)
    cells))

(defn- events-add!
  [cells: (Vec (Atom (Vec t/Triple)))
   at: Int
   event: t/Triple] -> (Vec (Atom (Vec t/Triple)))
  (do
    (swap! (nth cells at) conj event)
    cells))

(defn- events-reset!
  [cells: (Vec (Atom (Vec t/Triple)))
   at: Int
   events: (Vec t/Triple)] -> (Vec (Atom (Vec t/Triple)))
  (do
    (reset! (nth cells at) events)
    cells))

(defn- open-bucket-build [] -> BucketBuild
  (->BucketBuild bucket-initial-slots empty-keys empty-event-cells
    (fresh-position-cells bucket-initial-slots)))

(defn- build-entry [build: BucketBuild key: (Vec Any)] -> Int
  (let [keys: (Vec (Vec Any)) (bucketbuild-keys build) positions: (Vec Int) (deref (nth (bucketbuild-slots build) (bucket-slot key (bucketbuild-width build))))]
    (loop [offset: Int 0]
      (if (>= offset (count positions))
        -1
        (let [position: Int (nth positions offset)]
          (if (= (nth keys position) key)
            position
            (recur (inc offset))))))))

(defn- build-rehash! [build: BucketBuild width: Int] -> BucketBuild
  (let [keys: (Vec (Vec Any)) (bucketbuild-keys build)]
    (loop [cells: (Vec (Atom (Vec Int))) (fresh-position-cells width) position: Int 0]
      (if (>= position (count keys))
        (->BucketBuild width keys (bucketbuild-events build) cells)
        (recur (cells-add! cells (bucket-slot (nth keys position) width) position)
          (inc position))))))

(defn- build-append!
  [build: BucketBuild
   key: (Vec Any)
   events: (Vec t/Triple)] -> BucketBuild
  (let [width: Int (bucketbuild-width build) position: Int (count (bucketbuild-keys build)) keys: (Vec (Vec Any)) (conj (bucketbuild-keys build) key) cells: (Vec (Atom (Vec t/Triple))) (conj (bucketbuild-events build) (atom events)) grown: BucketBuild (->BucketBuild width keys cells (cells-add! (bucketbuild-slots build) (bucket-slot key width) position))]
    (if (> (count keys) (* bucket-slot-load width))
      (build-rehash! grown (* 2 width))
      grown)))

(defn- build-add!
  [build: BucketBuild
   key: (Vec Any)
   event: t/Triple] -> BucketBuild
  (let [at: Int (build-entry build key)]
    (if (>= at 0)
      (->BucketBuild (bucketbuild-width build) (bucketbuild-keys build)
        (events-add! (bucketbuild-events build) at event)
        (bucketbuild-slots build))
      (build-append! build key (one-event event)))))

(defn- build-set!
  [build: BucketBuild
   key: (Vec Any)
   event: t/Triple] -> BucketBuild
  (let [at: Int (build-entry build key)]
    (if (>= at 0)
      (->BucketBuild (bucketbuild-width build) (bucketbuild-keys build)
        (events-reset! (bucketbuild-events build) at (one-event event))
        (bucketbuild-slots build))
      (build-append! build key (one-event event)))))

(defn- close-event-cells [cells: (Vec (Atom (Vec t/Triple)))] -> (Vec (Vec t/Triple))
  (loop [lists: (Vec (Vec t/Triple)) empty-event-lists position: Int 0]
    (if (>= position (count cells))
      lists
      (recur (conj lists (deref (nth cells position))) (inc position)))))

(defn- close-position-cells [cells: (Vec (Atom (Vec Int)))] -> (Vec (Vec Int))
  (loop [rows: (Vec (Vec Int)) empty-slot-rows position: Int 0]
    (if (>= position (count cells))
      rows
      (recur (conj rows (deref (nth cells position))) (inc position)))))

(defn- close-bucket-build [build: BucketBuild] -> Bucket
  (->Bucket (bucketbuild-width build)
    (bucketbuild-keys build)
    (close-event-cells (bucketbuild-events build))
    (close-position-cells (bucketbuild-slots build))))

(defn- build-rotate-add! [build: RotationBuild event: t/Triple] -> RotationBuild
  (let [proposition: t/Triple (proposition-of (checked-assertion event)) t1: Any (t/triple-t1 proposition) t2: Any (t/triple-t2 proposition) t3: Any (t/triple-t3 proposition)]
    (->RotationBuild (conj (rotationbuild-events build) event)
      (build-set! (rotationbuild-by-occurrence build) (occurrence-key (occurrence-of event))
        event)
      (build-add! (build-add! (build-add! (rotationbuild-spo build) [t1] event) [t1 t2] event)
        [t1 t2 t3]
        event)
      (build-add! (build-add! (rotationbuild-pos build) [t2] event)
        [t2 t3]
        event)
      (build-add! (build-add! (rotationbuild-osp build) [t3] event)
        [t3 t1]
        event))))

(defn project! [ctx: (Atom t/TermStore)] -> Rotation
  (let [built: RotationBuild (reduce (fn
                                       [build: RotationBuild
                                        event: t/Triple] -> RotationBuild (build-rotate-add! build event)) (->RotationBuild empty-events (open-bucket-build) (open-bucket-build) (open-bucket-build) (open-bucket-build)) (store/live-occurrences ctx))]
    (->Rotation (store/space-id ctx)
      (store/current-sequence ctx)
      (rotationbuild-events built)
      (close-bucket-build (rotationbuild-by-occurrence built))
      (close-bucket-build (rotationbuild-spo built))
      (close-bucket-build (rotationbuild-pos built))
      (close-bucket-build (rotationbuild-osp built)))))

;; A retraction withdraws the NEWEST live occurrence of its proposition — the
;; same choice store/apply-operation-state makes, so the delta cannot drift from
;; the history it projects.
(defn- apply-frame
  [rotation: Rotation
   space-id: String
   frame: t/TransactionFrame] -> Rotation
  (let [coordinate: t/Triple (t/transaction-coordinate space-id (t/transactionframe-sequence frame)) operations: (Vec t/CommitOperation) (t/transactionframe-operations frame)]
    (loop [current: Rotation rotation ordinal: Int 0]
      (if (>= ordinal (count operations))
        current
        (let [operation: t/CommitOperation (nth operations ordinal) proposition: t/Triple (t/commitoperation-proposition operation)]
          (if (= t/assert-action (t/commitoperation-action operation))
            (recur (rotate-add current (t/assertion-occurrence (t/occurrence-coordinate coordinate ordinal) proposition))
              (inc ordinal))
            (let [target: t/Triple? (newest (by-proposition current proposition))]
              (recur (if (some? target) (rotate-del current target) current)
                (inc ordinal)))))))))

;; Uncommitted builder operations projected onto a committed rotation through
;; the same fold commit applies, so a staged read cannot disagree with its own
;; commit.
(defn staged
  [rotation: Rotation
   space-id: String
   sequence: Int
   operations: (Vec t/CommitOperation)] -> Rotation
  (apply-frame rotation space-id (t/->TransactionFrame sequence operations)))

(defn refresh [rotation: Rotation ctx: (Atom t/TermStore)] -> Rotation
  (let [space: String (store/space-id ctx) target: Int (store/current-sequence ctx) pinned: Int (rotation-version rotation)]
    (if (not (= space (rotation-space-id rotation)))
      (throw (ex-info "fram: rotation belongs to a different space" {:type :rotation-space-mismatch}))
      (if (> pinned target)
        (throw (ex-info "fram: rotation is ahead of the store it projects" {:type :rotation-ahead-of-store}))
        (if (= pinned target)
          rotation
          (assoc (reduce (fn
                           [current: Rotation
                            frame: t/TransactionFrame] -> Rotation (apply-frame current space frame)) rotation (store/transaction-frames-between (deref ctx) pinned target))
            :version
            target))))))

;; The projection must travel with the root it was built from; a caller holding
;; an unpinned rotation is reading a version that no longer exists.
(defn pinned? [rotation: Rotation ctx: (Atom t/TermStore)] -> Bool
  (and (= (store/space-id ctx) (rotation-space-id rotation))
    (= (store/current-sequence ctx) (rotation-version rotation))))
