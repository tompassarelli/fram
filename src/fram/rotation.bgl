#lang beagle

;; Covering rotations over the LIVE assertion occurrences of one TermStore: a
;; disposable projection pinned to (SpaceId, store version), never kernel
;; semantics and never a second identity — discard on mismatch and rebuild.
;; Leaves hold occurrences in commit order, so two equal propositions asserted
;; twice stay two answers. Three rotations cover all eight bound-subsets:
;;   spo [s] [s p] [s p o]   pos [p] [p o]   osp [o] [o s]   unbound = events.
;;
;; A rotation is a CLOSED base plus a pending tail. The base buckets are built
;; once per projection; commits land as pending operations that every read
;; folds over its base answer, so a commit retains O(delta) instead of a
;; rebucketed copy of the projection. The tail folds down into a fresh base
;; only at a projection point (boot, compaction, or the tail cap).
(ns fram.rotation)

(define-mode strict)

(require fram.types :as t)

(require fram.store :as store)

;; A leaf keyed by its bound-subset tuple. The keys are appended, never moved,
;; so a slot row names entry positions and a probe compares whole keys.
(defrecord Bucket
  [width: Int
   keys: (Vec (Vec Any))
   events: (Vec (Vec t/Triple))
   slots: (Vec (Vec Int))])

;; One committed-but-unprojected operation. `event` carries the assertion
;; occurrence for an assert; a retract names only its proposition, so `event`
;; then repeats the proposition and is never read.
(defrecord PendingOp
  [action: Keyword
   proposition: t/Triple
   event: t/Triple])

(defrecord Rotation
  [space-id: String
   version: Int
   events: (Vec t/Triple)
   by-occurrence: Bucket
   spo: Bucket
   pos: Bucket
   osp: Bucket
   pending: (Vec PendingOp)])

(def empty-events: (Vec t/Triple) [])

(def empty-keys: (Vec (Vec Any)) [])

(def empty-event-lists: (Vec (Vec t/Triple)) [])

(def empty-positions: (Vec Int) [])

(def empty-slot-rows: (Vec (Vec Int)) [])

(def no-pending: (Vec PendingOp) [])

;; A bucket doubles once it holds more than this many keys per slot.
(def bucket-initial-slots: Int 64)

(def bucket-slot-load: Int 4)

;; A tail longer than this folds down into a fresh base on refresh. The native
;; server compacts (and reprojects) on its own cadence well under this cap; the
;; cap is what keeps a long-lived hosted session's reads bounded.
(def pending-fold-cap: Int 512)

(defn- bucket-slot [key: (Vec Any) width: Int] -> Int (mod (hash key) width))

(defn- bucket-entry [bucket: Bucket key: (Vec Any)] -> Int
  (let [keys: (Vec (Vec Any)) (bucket-keys bucket) positions: (Vec Int) (nth (bucket-slots bucket) (bucket-slot key (bucket-width bucket)))]
    (loop [offset: Int 0]
      (if (>= offset (count positions))
        -1
        (let [position: Int (nth positions offset)]
          (if (= (nth keys position) key)
            position
            (recur (inc offset))))))))

(defn- bucket-get [bucket: Bucket key: (Vec Any)] -> (Vec t/Triple)
  (let [position: Int (bucket-entry bucket key)]
    (if (>= position 0) (nth (bucket-events bucket) position) empty-events)))

(defn- occurrence-key [occurrence: t/Triple] -> (Vec Any) [occurrence])

(defn occurrence-of [event: t/Triple] -> t/Triple (t/triple-t1 event))

(defn proposition-of [event: t/Triple] -> t/Triple (t/triple-t3 event))

(defn assertion-occurrence? [event: Any] -> Bool
  (and (t/triple? event)
    (and (= t/asserts (t/triple-t2 event))
      (and (t/occurrence-coordinate? (t/triple-t1 event))
        (t/triple? (t/triple-t3 event))))))

;; --- Pending-tail reads. Every base answer is folded through the tail: an
;; assert appends its event when the pattern covers it, a retract withdraws the
;; newest surviving occurrence of its proposition. Restricted to any pattern a
;; bucket serves, the globally newest live occurrence of a proposition is the
;; last one in that pattern's commit-ordered answer, so the per-answer fold
;; agrees with the from-scratch projection of the same history.

(defn- slot-matches? [pattern: Any term: Any] -> Bool
  (or (nil? pattern) (= pattern term)))

(defn- pattern-match?
  [proposition: t/Triple
   t1: Any
   t2: Any
   t3: Any] -> Bool
  (and (slot-matches? t1 (t/triple-t1 proposition))
    (and (slot-matches? t2 (t/triple-t2 proposition))
      (slot-matches? t3 (t/triple-t3 proposition)))))

(defn- without-newest-of
  [events: (Vec t/Triple)
   proposition: t/Triple] -> (Vec t/Triple)
  (let [at: Int
        (loop [position: Int (dec (count events))]
          (if (< position 0)
            -1
            (if (= proposition (proposition-of (nth events position)))
              position
              (recur (dec position)))))]
    (if (< at 0)
      events
      (loop [built: (Vec t/Triple) empty-events position: Int 0]
        (if (>= position (count events))
          built
          (recur (if (= position at) built (conj built (nth events position)))
            (inc position)))))))

(defn- merged-matching
  [base: (Vec t/Triple)
   pending: (Vec PendingOp)
   t1: Any
   t2: Any
   t3: Any] -> (Vec t/Triple)
  (if (empty? pending)
    base
    (loop [events: (Vec t/Triple) base position: Int 0]
      (if (>= position (count pending))
        events
        (let [op: PendingOp (nth pending position)
              proposition: t/Triple (pendingop-proposition op)]
          (recur
           (if (= t/assert-action (pendingop-action op))
             (if (pattern-match? proposition t1 t2 t3)
               (conj events (pendingop-event op))
               events)
             (without-newest-of events proposition))
           (inc position)))))))

(defn space-id [rotation: Rotation] -> String (rotation-space-id rotation))

(defn version [rotation: Rotation] -> Int (rotation-version rotation))

(defn all-occurrences [rotation: Rotation] -> (Vec t/Triple)
  (merged-matching (rotation-events rotation) (rotation-pending rotation)
    nil nil nil))

(defn occurrence-count [rotation: Rotation] -> Int
  (count (all-occurrences rotation)))

;; Every bound subset resolves to exactly one bucket key; results stay in commit
;; order, so `last` is the newest live occurrence of that pattern.
(defn by-t1 [rotation: Rotation t1: Any] -> (Vec t/Triple)
  (merged-matching (bucket-get (rotation-spo rotation) [t1])
    (rotation-pending rotation) t1 nil nil))

(defn by-t12
  [rotation: Rotation
   t1: Any
   t2: Any] -> (Vec t/Triple)
  (merged-matching (bucket-get (rotation-spo rotation) [t1 t2])
    (rotation-pending rotation) t1 t2 nil))

(defn by-t2 [rotation: Rotation t2: Any] -> (Vec t/Triple)
  (merged-matching (bucket-get (rotation-pos rotation) [t2])
    (rotation-pending rotation) nil t2 nil))

(defn by-t23
  [rotation: Rotation
   t2: Any
   t3: Any] -> (Vec t/Triple)
  (merged-matching (bucket-get (rotation-pos rotation) [t2 t3])
    (rotation-pending rotation) nil t2 t3))

(defn by-t3 [rotation: Rotation t3: Any] -> (Vec t/Triple)
  (merged-matching (bucket-get (rotation-osp rotation) [t3])
    (rotation-pending rotation) nil nil t3))

(defn by-t13
  [rotation: Rotation
   t1: Any
   t3: Any] -> (Vec t/Triple)
  (merged-matching (bucket-get (rotation-osp rotation) [t3 t1])
    (rotation-pending rotation) t1 nil t3))

(defn by-proposition
  [rotation: Rotation
   proposition: t/Triple] -> (Vec t/Triple)
  (merged-matching
   (bucket-get (rotation-spo rotation)
     [(t/triple-t1 proposition)
      (t/triple-t2 proposition)
      (t/triple-t3 proposition)])
   (rotation-pending rotation)
   (t/triple-t1 proposition)
   (t/triple-t2 proposition)
   (t/triple-t3 proposition)))

;; nil in a slot means UNBOUND. This is the semantic entry point; the bucket
;; layout above is private detail every caller is expected to route through.
(defn matching
  [rotation: Rotation
   t1: Any
   t2: Any
   t3: Any] -> (Vec t/Triple)
  (cond
    [(and (some? t1) (and (some? t2) (some? t3)))
     (by-proposition rotation (t/triple t1 t2 t3))]
    [(and (some? t1) (some? t2)) (by-t12 rotation t1 t2)]
    [(and (some? t2) (some? t3)) (by-t23 rotation t2 t3)]
    [(and (some? t1) (some? t3)) (by-t13 rotation t1 t3)]
    [(some? t1) (by-t1 rotation t1)]
    [(some? t2) (by-t2 rotation t2)]
    [(some? t3) (by-t3 rotation t3)]
    [:else (all-occurrences rotation)]))

;; The newest surviving event carrying this occurrence, judged through the
;; proposition's own merged answer so a pending retract of the proposition
;; withdraws exactly the occurrence the store's fold would withdraw.
(defn event-at [rotation: Rotation occurrence: t/Triple] -> t/Triple?
  (let [base: (Vec t/Triple)
        (bucket-get (rotation-by-occurrence rotation)
          (occurrence-key occurrence))
        candidate: t/Triple?
        (let [pending: (Vec PendingOp) (rotation-pending rotation)]
          (loop [position: Int 0
                 found: t/Triple? (if (empty? base) nil (nth base 0))]
            (if (>= position (count pending))
              found
              (let [op: PendingOp (nth pending position)]
                (recur (inc position)
                  (if (and (= t/assert-action (pendingop-action op))
                        (= occurrence (occurrence-of (pendingop-event op))))
                    (pendingop-event op)
                    found))))))]
    (if (nil? candidate)
      nil
      (let [present: t/Triple candidate
            live: (Vec t/Triple)
            (by-proposition rotation (proposition-of present))
            survives: Bool
            (loop [position: Int 0]
              (if (>= position (count live))
                false
                (if (= occurrence (occurrence-of (nth live position)))
                  true
                  (recur (inc position)))))]
        (if survives present nil)))))

(defn live-occurrence? [rotation: Rotation occurrence: t/Triple] -> Bool
  (some? (event-at rotation occurrence)))

(defn newest-first [events: (Vec t/Triple)] -> (Vec t/Triple)
  (vec (reverse events)))

(defn newest [events: (Vec t/Triple)] -> t/Triple?
  (if (empty? events) nil (last events)))

(defn propositions [events: (Vec t/Triple)] -> (Vec t/Triple)
  (mapv (fn [event: t/Triple] -> t/Triple (proposition-of event)) events))

(defn subjects [events: (Vec t/Triple)] -> (Vec Any)
  (mapv (fn [event: t/Triple] -> Any (t/triple-t1 (proposition-of event)))
    events))

(defn values [events: (Vec t/Triple)] -> (Vec Any)
  (mapv (fn [event: t/Triple] -> Any (t/triple-t3 (proposition-of event)))
    events))

(defn occurrences [events: (Vec t/Triple)] -> (Vec t/Triple)
  (mapv (fn [event: t/Triple] -> t/Triple (occurrence-of event)) events))

;; --- The full projection. One inlined pass: per-key leaves accumulate in
;; cells the build owns outright and closes into ordinary values, so the whole
;; projection costs one append per leaf. The pass carries its four bucket
;; states as parallel vectors indexed 0 = by-occurrence (set), 1 = spo,
;; 2 = pos, 3 = osp; everything the pass allocates beyond the closed product
;; dies with the pass.

(def empty-event-cells: (Vec (Atom (Vec t/Triple))) [])

(def empty-position-cells: (Vec (Atom (Vec Int))) [])

(defn- fresh-position-cells [width: Int] -> (Vec (Atom (Vec Int)))
  (loop [cells: (Vec (Atom (Vec Int))) empty-position-cells position: Int 0]
    (if (>= position width)
      cells
      (recur (conj cells (atom empty-positions)) (inc position)))))

(defn- rehashed-position-cells!
  [keys: (Vec (Vec Any))
   width: Int] -> (Vec (Atom (Vec Int)))
  (let [cells: (Vec (Atom (Vec Int))) (fresh-position-cells width)]
    (loop [position: Int 0]
      (if (>= position (count keys))
        cells
        (do
          (swap! (nth cells (bucket-slot (nth keys position) width)) conj
            position)
          (recur (inc position)))))))

(defn- close-event-cells [cells: (Vec (Atom (Vec t/Triple)))] -> (Vec (Vec t/Triple))
  (loop [lists: (Vec (Vec t/Triple)) empty-event-lists position: Int 0]
    (if (>= position (count cells))
      lists
      (recur (conj lists (deref (nth cells position))) (inc position)))))

(defn- close-position-cells [cells: (Vec (Atom (Vec Int)))] -> (Vec (Vec Int))
  (loop [rows: (Vec (Vec Int)) empty-slot-rows position: Int 0]
    (if (>= position (count cells))
      rows
      (recur (conj rows (deref (nth cells position))) (inc position)))))

(defn- checked-assertion [event: t/Triple] -> t/Triple
  (if (assertion-occurrence? event)
    event
    (throw (ex-info "fram: rotations cover assertion occurrences only" {:type :invalid-rotation-occurrence}))))

;; Entry map per event: 0 by-occurrence [occ] (set), 1-3 spo [s] [s p] [s p o],
;; 4-5 pos [p] [p o], 6-7 osp [o] [o s].
(defn- entry-key [entry: Int event: t/Triple] -> (Vec Any)
  (let [proposition: t/Triple (proposition-of event)
        t1: Any (t/triple-t1 proposition)
        t2: Any (t/triple-t2 proposition)
        t3: Any (t/triple-t3 proposition)]
    (cond
      [(= entry 0) (occurrence-key (occurrence-of event))]
      [(= entry 1) [t1]]
      [(= entry 2) [t1 t2]]
      [(= entry 3) [t1 t2 t3]]
      [(= entry 4) [t2]]
      [(= entry 5) [t2 t3]]
      [(= entry 6) [t3]]
      [:else [t3 t1]])))

;; A bucket sized from the event count starts at the width its keys will want,
;; so the common projection rehashes at most once instead of walking every
;; doubling: a doubling reallocates the whole slot-cell array and re-appends
;; every key position, and those intermediate generations are pinned by the
;; cells that hold them.
(defn- initial-bucket-width [event-count: Int] -> Int
  (loop [width: Int bucket-initial-slots]
    (if (>= (* bucket-slot-load width) event-count)
      width
      (recur (* 2 width)))))

;; One bucket over the entries it owns. The four bucket states used to ride in
;; parallel four-wide vectors indexed by bucket, which cost an `assoc` per
;; appended key on each of them; here each state is an ordinary loop variable
;; and the pass reads the events once per bucket instead.
(defn- projected-bucket!
  [events: (Vec t/Triple)
   first-entry: Int
   last-entry: Int
   replace?: Bool
   initial-width: Int] -> Bucket
  (loop [width: Int initial-width
         keys: (Vec (Vec Any)) empty-keys
         cells: (Vec (Atom (Vec t/Triple))) empty-event-cells
         slot-cells: (Vec (Atom (Vec Int))) (fresh-position-cells initial-width)
         position: Int 0
         entry: Int first-entry]
    (if (>= position (count events))
      (->Bucket width keys (close-event-cells cells)
        (close-position-cells slot-cells))
      (if (> entry last-entry)
        (recur width keys cells slot-cells (inc position) first-entry)
        (let [event: t/Triple (checked-assertion (nth events position))
              key: (Vec Any) (entry-key entry event)
              slot: Int (bucket-slot key width)
              positions: (Vec Int) (deref (nth slot-cells slot))
              at: Int
              (loop [offset: Int 0]
                (if (>= offset (count positions))
                  -1
                  (let [candidate: Int (nth positions offset)]
                    (if (= (nth keys candidate) key)
                      candidate
                      (recur (inc offset))))))]
          (if (>= at 0)
            (do
              (if replace?
                (reset! (nth cells at) [event])
                (swap! (nth cells at) conj event))
              (recur width keys cells slot-cells position (inc entry)))
            (let [appended: Int (count keys)
                  grown-keys: (Vec (Vec Any)) (conj keys key)
                  grown-cells: (Vec (Atom (Vec t/Triple)))
                  (conj cells (atom [event]))]
              (do
                (swap! (nth slot-cells slot) conj appended)
                (if (> (count grown-keys) (* bucket-slot-load width))
                  (recur (* 2 width) grown-keys grown-cells
                    (rehashed-position-cells! grown-keys (* 2 width))
                    position (inc entry))
                  (recur width grown-keys grown-cells slot-cells position
                    (inc entry)))))))))))

(defn- projected!
  [space-id: String
   version: Int
   events: (Vec t/Triple)] -> Rotation
  (let [total: Int (count events)]
    (->Rotation space-id version events
      (projected-bucket! events 0 0 true (initial-bucket-width total))
      (projected-bucket! events 1 3 false (initial-bucket-width (* 3 total)))
      (projected-bucket! events 4 5 false (initial-bucket-width (* 2 total)))
      (projected-bucket! events 6 7 false (initial-bucket-width (* 2 total)))
      no-pending)))

(defn project! [ctx: (Atom t/TermStore)] -> Rotation
  (projected! (store/space-id ctx) (store/current-sequence ctx)
    (store/live-occurrences ctx)))

;; --- The pending tail. A committed frame joins the tail as one PendingOp per
;; operation; the tail folds down into a fresh base only at a projection point.

(defn- pending-with-frame
  [pending: (Vec PendingOp)
   space-id: String
   frame: t/TransactionFrame] -> (Vec PendingOp)
  (let [coordinate: t/Triple
        (t/transaction-coordinate space-id (t/transactionframe-sequence frame))
        operations: (Vec t/CommitOperation) (t/transactionframe-operations frame)]
    (loop [built: (Vec PendingOp) pending ordinal: Int 0]
      (if (>= ordinal (count operations))
        built
        (let [operation: t/CommitOperation (nth operations ordinal)
              proposition: t/Triple (t/commitoperation-proposition operation)]
          (recur
           (conj built
             (if (= t/assert-action (t/commitoperation-action operation))
               (->PendingOp t/assert-action proposition
                 (t/assertion-occurrence
                  (t/occurrence-coordinate coordinate ordinal) proposition))
               (->PendingOp t/retract-action proposition proposition)))
           (inc ordinal)))))))

;; Uncommitted builder operations projected onto a committed rotation through
;; the same fold commit applies, so a staged read cannot disagree with its own
;; commit.
(defn staged
  [rotation: Rotation
   space-id: String
   sequence: Int
   operations: (Vec t/CommitOperation)] -> Rotation
  (assoc rotation :pending
    (pending-with-frame (rotation-pending rotation) space-id
      (t/->TransactionFrame sequence operations))))

(defn refresh! [rotation: Rotation ctx: (Atom t/TermStore)] -> Rotation
  (let [space: String (store/space-id ctx) target: Int (store/current-sequence ctx) pinned: Int (rotation-version rotation)]
    (if (not (= space (rotation-space-id rotation)))
      (throw (ex-info "fram: rotation belongs to a different space" {:type :rotation-space-mismatch}))
      (if (> pinned target)
        (throw (ex-info "fram: rotation is ahead of the store it projects" {:type :rotation-ahead-of-store}))
        (if (= pinned target)
          rotation
          (let [frames: (Vec t/TransactionFrame) (store/transaction-frames-between (deref ctx) pinned target)
                pending: (Vec PendingOp)
                (loop [built: (Vec PendingOp) (rotation-pending rotation)
                       position: Int 0]
                  (if (>= position (count frames))
                    built
                    (recur (pending-with-frame built space (nth frames position))
                      (inc position))))
                advanced: Rotation
                (assoc (assoc rotation :pending pending) :version target)]
            (if (> (count pending) pending-fold-cap)
              (projected! space target (all-occurrences advanced))
              advanced)))))))

;; The projection must travel with the root it was built from; a caller holding
;; an unpinned rotation is reading a version that no longer exists.
(defn pinned? [rotation: Rotation ctx: (Atom t/TermStore)] -> Bool
  (and (= (store/space-id ctx) (rotation-space-id rotation))
    (= (store/current-sequence ctx) (rotation-version rotation))))
