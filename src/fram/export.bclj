#lang beagle/clj
(ns fram.export
  "Inverse of import: project the fact graph back to thread files as fact
  triples. GENERIC — groups a subject's facts and renders `@id` + `predicate
  object` lines (canonical order) + the prose body. Refs render as `@id`;
  literals via EDN (fram.rt/edn-quote) so re-import reproduces the fact set.
  Pure string production; file IO lives in fram.main via rt externs.")

(require fram.kernel :as k)
(require clojure.string :as str)
(require fram.rt)

(declare-extern fram.rt/edn-quote [String -> String])

;; canonical predicate order (body is rendered separately, after the `---`)
(def order :- (Vec String)
  ["title" "owner" "lead" "driver" "source" "proposed_by" "created_by"
   "created_at" "updated_at" "committed" "do_on" "valid_until" "estimate_hours"
   "repo" "part_of" "depends_on" "relates_to" "clarifies" "amends" "outcome" "abandoned"])

(defn- distinct-s [xs :- (Vec String)] :- (Vec String)
  (reduce (fn [acc :- (Vec String) x :- String] :- (Vec String)
            (if (k/vec-contains? acc x) acc (conj acc x)))
          [] xs))

;; a ref-pred's value renders as its @id bare; a literal is EDN-quoted whenever
;; bare would be ambiguous — whitespace, NEWLINE, empty, or a leading @/".
(defn- render-obj [facts :- (Vec k/Fact) p :- String v :- String] :- String
  (if (= "ref" (k/value-kind-of facts {} p))
    (if (str/starts-with? v "@") v (str "@" v))
    (if (or (str/blank? v)
            (str/includes? v " ") (str/includes? v "\t")
            (str/includes? v "\n") (str/includes? v "\r")
            (str/starts-with? v "@") (str/starts-with? v "\""))
      (fram.rt/edn-quote v)
      v)))

(defn thread-md [facts :- (Vec k/Fact) te :- String] :- String
  (let [reg (k/predicate-registry facts)
        subject-facts (k/q-by-l facts te)
        present (distinct-s (mapv (fn [c :- k/Fact] :- String
                                    (k/predicate-name reg (:p c)))
                                  subject-facts))
        ordered (filterv (fn [p :- String] :- Bool (k/vec-contains? present p)) order)
        extra (vec (sort (filterv (fn [p :- String] :- Bool
                                    (and (not (k/vec-contains? order p)) (not (= p "body"))))
                                  present)))
        preds (vec (concat ordered extra))
        lines (reduce (fn [acc :- (Vec String) p :- String] :- (Vec String)
                        (let [pid (k/predicate-id reg p)
                              values (mapv (fn [c :- k/Fact] :- String (:r c))
                                           (filterv
                                            (fn [c :- k/Fact] :- Bool
                                              (= pid (k/predicate-id reg (:p c))))
                                            subject-facts))]
                          (vec (concat acc
                                       (mapv (fn [v :- String] :- String
                                               (str p "  " (render-obj facts p v)))
                                             values)))))
                      []
                      preds)
        body-id (k/predicate-id reg "body")
        bodies (filterv (fn [c :- k/Fact] :- Bool
                          (= body-id (k/predicate-id reg (:p c))))
                        subject-facts)
        b (if (empty? bodies) nil (:r (first bodies)))
        body (if (some? b) b "")]
    (str te "\n" (str/join "\n" lines) "\n---\n" body)))
