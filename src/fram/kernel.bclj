#lang beagle/clj
;; Structural Triple operations. Domain roles and view policy live above this
;; neutral slot-addressed boundary.
(ns fram.kernel)
(define-mode strict)
(require fram.types :as t)

;; This is the one bootstrap door. Everything reachable through its slot2
;; profile header remains ordinary relational vocabulary.
(def profile-anchor: Keyword :kernel/profile)
(def relational-profile-kind: String "relational")
(def observe-profile-mode: String "observe")
(def profile-includes: String "includes")
(def profile-violation: String "violates")
(def relational-profile-rules: (Vec String) ["R1" "R2" "R3" "R4"])

(defn profile-header [profile-id: Any kind: String mode: String] -> t/Triple
  (t/triple profile-id kind mode))

(defn relational-profile-declaration
  [space-id: String profile-id: Any] -> t/Triple
  (t/triple space-id profile-anchor
            (profile-header profile-id relational-profile-kind
                            observe-profile-mode)))

(defn profile-rule [profile-id: Any rule: String] -> t/Triple
  (t/triple profile-id profile-includes rule))

(defn- profile-anchor? [value: t/Triple] -> Bool
  (= profile-anchor (t/triple-slot1 value)))

(defn- profile-has-rule?
  [triples: (Vec t/Triple) profile-id: Any rule: String] -> Bool
  (not (empty?
        (filterv (fn [value: t/Triple] -> Bool
                   (and (= profile-id (t/triple-slot0 value))
                        (and (= profile-includes (t/triple-slot1 value))
                             (= rule (t/triple-slot2 value)))))
                 triples))))

(defn declared-relational-profile?
  [triples: (Vec t/Triple) space-id: String] -> Bool
  (not
   (empty?
    (filterv
     (fn [value: t/Triple] -> Bool
       (let [header: Any (t/triple-slot2 value)]
         (and (= space-id (t/triple-slot0 value))
              (and (profile-anchor? value)
                   (and (t/triple? header)
                        (and (= relational-profile-kind
                                (t/triple-slot1 header))
                             (and (= observe-profile-mode
                                     (t/triple-slot2 header))
                                  (every?
                                   (fn [rule: String] -> Bool
                                     (profile-has-rule?
                                      triples (t/triple-slot0 header) rule))
                                   relational-profile-rules))))))))
     triples))))

(defn- nonblank-string-or-keyword? [value: Any] -> Bool
  (or (keyword? value)
      (and (string? value) (> (count value) 0))))

;; Observe commits must not call this prospective verdict.
(defn relational-admission-errors
  [proposition: t/Triple] -> (Vec String)
  (let [slot0: Any (t/triple-slot0 proposition)
        slot1: Any (t/triple-slot1 proposition)
        slot2: Any (t/triple-slot2 proposition)]
    (cond-> []
      (not (and (t/atom? slot0)
                (and (t/atom? slot1) (t/atom? slot2))))
      (conj "R1")
      (not (nonblank-string-or-keyword? slot0))
      (conj "R2")
      (not (nonblank-string-or-keyword? slot1))
      (conj "R3")
      (not (t/atom? slot2))
      (conj "R4"))))

;; P3 requires an independent expression rather than a shared verdict helper.
(defn relational-lint-errors
  [proposition: t/Triple] -> (Vec String)
  (let [slot0: Any (t/triple-slot0 proposition)
        slot1: Any (t/triple-slot1 proposition)
        slot2: Any (t/triple-slot2 proposition)
        r1: Bool (and (t/atom? slot0)
                      (and (t/atom? slot1) (t/atom? slot2)))
        r2: Bool (or (keyword? slot0)
                     (and (string? slot0) (not (= "" slot0))))
        r3: Bool (or (keyword? slot1)
                     (and (string? slot1) (not (= "" slot1))))
        r4: Bool (t/atom? slot2)]
    (cond-> []
      (not r1) (conj "R1")
      (not r2) (conj "R2")
      (not r3) (conj "R3")
      (not r4) (conj "R4"))))

(defn lint-declared-profile
  [triples: (Vec t/Triple) space-id: String] -> (Vec t/Triple)
  (if (not (declared-relational-profile? triples space-id))
    []
    (reduce
     (fn [violations: (Vec t/Triple) proposition: t/Triple] -> (Vec t/Triple)
       (if (profile-anchor? proposition)
         violations
         (reduce
          (fn [rows: (Vec t/Triple) rule: String] -> (Vec t/Triple)
            (conj rows (t/triple proposition profile-violation rule)))
          violations
          (relational-lint-errors proposition))))
     []
     triples)))

(defn triple-eq? [left: t/Triple right: t/Triple] -> Bool
  (= left right))

(defn by-slot0 [triples: (Vec t/Triple) term: Any] -> (Vec t/Triple)
  (filterv (fn [value: t/Triple] -> Bool
             (= term (t/triple-slot0 value)))
           triples))

(defn by-slot1 [triples: (Vec t/Triple) term: Any] -> (Vec t/Triple)
  (filterv (fn [value: t/Triple] -> Bool
             (= term (t/triple-slot1 value)))
           triples))

(defn by-slot2 [triples: (Vec t/Triple) term: Any] -> (Vec t/Triple)
  (filterv (fn [value: t/Triple] -> Bool
             (= term (t/triple-slot2 value)))
           triples))

(defn by-slot01
  [triples: (Vec t/Triple) slot0: Any slot1: Any] -> (Vec t/Triple)
  (filterv (fn [value: t/Triple] -> Bool
             (and (= slot0 (t/triple-slot0 value))
                  (= slot1 (t/triple-slot1 value))))
           triples))

(defn by-slot12
  [triples: (Vec t/Triple) slot1: Any slot2: Any] -> (Vec t/Triple)
  (filterv (fn [value: t/Triple] -> Bool
             (and (= slot1 (t/triple-slot1 value))
                  (= slot2 (t/triple-slot2 value))))
           triples))

(defn by-slot02
  [triples: (Vec t/Triple) slot0: Any slot2: Any] -> (Vec t/Triple)
  (filterv (fn [value: t/Triple] -> Bool
             (and (= slot0 (t/triple-slot0 value))
                  (= slot2 (t/triple-slot2 value))))
           triples))

(defn assertion-occurrence? [value: Any] -> Bool
  (and (t/triple? value)
       (and (t/occurrence-coordinate? (t/triple-slot0 value))
            (and (= t/asserts (t/triple-slot1 value))
                 (t/triple? (t/triple-slot2 value))))))

(defn retraction-occurrence? [value: Any] -> Bool
  (and (t/triple? value)
       (and (t/occurrence-coordinate? (t/triple-slot0 value))
            (and (= t/retracts (t/triple-slot1 value))
                 (t/triple? (t/triple-slot2 value))))))

(defn operation-occurrence? [value: Any] -> Bool
  (or (assertion-occurrence? value) (retraction-occurrence? value)))

(defn withdrawal? [value: Any] -> Bool
  (and (t/triple? value)
       (and (t/occurrence-coordinate? (t/triple-slot0 value))
            (and (= t/withdraws (t/triple-slot1 value))
                 (t/occurrence-coordinate? (t/triple-slot2 value))))))

(defn occurrence-of [event: t/Triple] -> t/Triple
  (if (operation-occurrence? event)
    (t/triple-slot0 event)
    (throw (ex-info "fram: value is not an operation occurrence"
                    {:type :invalid-operation-occurrence}))))

(defn proposition-of [event: t/Triple] -> t/Triple
  (if (operation-occurrence? event)
    (t/triple-slot2 event)
    (throw (ex-info "fram: value is not an operation occurrence"
                    {:type :invalid-operation-occurrence}))))

(defn withdrawal-source [value: t/Triple] -> t/Triple
  (if (withdrawal? value)
    (t/triple-slot0 value)
    (throw (ex-info "fram: value is not a withdrawal"
                    {:type :invalid-withdrawal}))))

(defn withdrawal-target [value: t/Triple] -> t/Triple
  (if (withdrawal? value)
    (t/triple-slot2 value)
    (throw (ex-info "fram: value is not a withdrawal"
                    {:type :invalid-withdrawal}))))
