#lang beagle/clj
;; Reified Store kernel.  Its native representation is record/vector only;
;; linear scans are intentional until the native index layer owns this concern —
;; except the probes that are linear in the whole store, which made loading one
;; impossible: find-value, the fact-index bucket family, and find-fact.  Each is
;; addressed through a hash-slot table instead.
(ns fram.store)
(define-mode strict)
(require fram.types :as t)

(def empty-ids :- (Vec Int) [])
(def empty-values :- (Vec t/StoredValue) [])
(def empty-facts :- (Vec t/StoredFact) [])
(def empty-tx-of :- (Vec t/StoredTxOf) [])
(def empty-txs :- (Vec t/StoredTx) [])
(def empty-id-buckets :- (Vec t/IdBucket) [])
(def empty-pair-buckets :- (Vec t/PairBucket) [])

;; Slot-table sizing.  A table doubles once the vector it indexes holds more than
;; slot-load entries per slot, so a probe walks slot-load positions amortized while
;; a fresh store pays for initial-slots buckets, not for a corpus it may never see.
(def initial-slots :- Int 64)
(def slot-load :- Int 4)

(defn- value-hash [v :- t/StoreValue] :- Int
  (if (string? v) (hash v)
    (if (integer? v) (hash v)
      (if (boolean? v) (hash v)
        (if (keyword? v) (hash v)
          (if (vector? v) (hash v) 0))))))

;; Agrees with value=?: it narrows on the same five alternatives, so two values
;; that intern as one always land in the same slot.
(defn- slot-of [v :- t/StoreValue width :- Int] :- Int
  (mod (value-hash v) width))

(defn- fresh-slots [width :- Int] :- (Vec t/IdBucket)
  (loop [acc :- (Vec t/IdBucket) empty-id-buckets i 0]
    (if (>= i width) acc
      (recur (conj acc (t/->IdBucket i empty-ids)) (inc i)))))

;; Slot-addressed update: assoc rewrites one path of the persistent vector, where
;; the put-bucket idiom would rebuild every bucket per insert (linear in width).
(defn- slot-add [slots :- (Vec t/IdBucket) i :- Int pos :- Int] :- (Vec t/IdBucket)
  (assoc slots i (t/->IdBucket i (conj (t/idbucket-ids (nth slots i)) pos))))

(defn- slot-put [slots :- (Vec t/IdBucket) v :- t/StoreValue pos :- Int] :- (Vec t/IdBucket)
  (slot-add slots (slot-of v (count slots)) pos))

;; Ids are minted in strides (an entity, its name value, its name fact), so mod on
;; a raw id would fold whole strides onto one slot of a power-of-two width.
(defn- key-slot [key :- Int width :- Int] :- Int (mod (hash key) width))
(defn- pair-slot [left :- Int right :- Int width :- Int] :- Int
  (mod (+ (* 31 (hash left)) (hash right)) width))

(defn- build-slots [values :- (Vec t/StoredValue) width :- Int] :- (Vec t/IdBucket)
  (loop [slots :- (Vec t/IdBucket) (fresh-slots width) i 0]
    (if (>= i (count values)) slots
      (recur (slot-put slots (t/storedvalue-value (nth values i)) i) (inc i)))))

(defn- build-fact-slots [facts :- (Vec t/StoredFact) width :- Int] :- (Vec t/IdBucket)
  (loop [slots :- (Vec t/IdBucket) (fresh-slots width) i 0]
    (if (>= i (count facts)) slots
      (recur (slot-add slots (key-slot (t/storedfact-id (nth facts i)) width) i) (inc i)))))

(defn- build-key-slots [buckets :- (Vec t/IdBucket) width :- Int] :- (Vec t/IdBucket)
  (loop [slots :- (Vec t/IdBucket) (fresh-slots width) i 0]
    (if (>= i (count buckets)) slots
      (recur (slot-add slots (key-slot (t/idbucket-key (nth buckets i)) width) i) (inc i)))))

(defn- build-pair-slots [buckets :- (Vec t/PairBucket) width :- Int] :- (Vec t/IdBucket)
  (loop [slots :- (Vec t/IdBucket) (fresh-slots width) i 0]
    (if (>= i (count buckets)) slots
      (let [bucket :- t/PairBucket (nth buckets i)]
        (recur (slot-add slots (pair-slot (t/pairbucket-left bucket) (t/pairbucket-right bucket) width) i)
               (inc i))))))

(defn- slots-width-for [n :- Int] :- Int
  (loop [width initial-slots]
    (if (>= (* slot-load width) n) width (recur (* 2 width)))))

(defn new-store [] :- (Atom t/Store)
  (atom (t/->Store 0 0 nil empty-ids empty-values empty-facts empty-tx-of empty-txs empty-ids
                   empty-id-buckets empty-id-buckets empty-id-buckets empty-pair-buckets empty-pair-buckets
                   (fresh-slots initial-slots)
                   (fresh-slots initial-slots) (fresh-slots initial-slots) (fresh-slots initial-slots)
                   (fresh-slots initial-slots) (fresh-slots initial-slots)
                   (fresh-slots initial-slots))))

(defn- includes-id? [ids :- (Vec Int) id :- Int] :- Bool
  (loop [i 0]
    (if (>= i (count ids)) false
      (if (= id (nth ids i)) true (recur (inc i))))))

;; Dedup for caller-supplied ids (:superseded). :objects never needs it — see fresh-id!.
(defn- add-id [ids :- (Vec Int) id :- Int] :- (Vec Int)
  (if (includes-id? ids id) ids (conj ids id)))

;; Sole minter of object ids, strictly increasing and never reissued, so every id
;; it returns is provably absent from :objects: the three :objects inserts conj
;; directly instead of paying add-id's O(n) membership scan per insert.
(defn fresh-id! [ctx :- (Atom t/Store)] :- Int
  (:next-id (swap! ctx update :next-id inc)))

(defn entity! [ctx :- (Atom t/Store)] :- Int
  (let [id (fresh-id! ctx)]
    (swap! ctx update :objects (fn [ids :- (Vec Int)] :- (Vec Int) (conj ids id)))
    id))

(defn- value=? [a :- t/StoreValue b :- t/StoreValue] :- Bool
  (if (string? a) (and (string? b) (= a b))
    (if (integer? a) (and (integer? b) (= a b))
      (if (boolean? a) (and (boolean? b) (= a b))
        (if (keyword? a) (and (keyword? b) (= a b))
          (and (vector? b) (= a b)))))))

;; The one site the file-header position does NOT cover: value! probes for an
;; existing intern on every write, so a scan of :values here made loading a store
;; quadratic in its distinct values.  The probe walks one hash slot instead.
(defn- find-value [s :- t/Store v :- t/StoreValue] :- t/StoredValue?
  (let [values :- (Vec t/StoredValue) (:values s)
        slots :- (Vec t/IdBucket) (:value-slots s)
        ids :- (Vec Int) (t/idbucket-ids (nth slots (slot-of v (count slots))))]
    (loop [i 0]
      (if (>= i (count ids)) nil
        (let [entry :- t/StoredValue (nth values (nth ids i))]
          (if (value=? (t/storedvalue-value entry) v) entry (recur (inc i))))))))

(defn- find-value-by-id [values :- (Vec t/StoredValue) id :- Int] :- t/StoredValue?
  (loop [i 0]
    (if (>= i (count values)) nil
      (let [entry :- t/StoredValue (nth values i)]
        (if (= id (t/storedvalue-id entry)) entry (recur (inc i)))))))

;; fact-of is on the supersede path, so this ran once per assert against the whole
;; of :facts.  The probe walks one hash slot of positions instead.
(defn- find-fact [s :- t/Store cid :- Int] :- t/StoredFact?
  (let [facts :- (Vec t/StoredFact) (:facts s)
        slots :- (Vec t/IdBucket) (:fact-slots s)
        ids :- (Vec Int) (t/idbucket-ids (nth slots (key-slot cid (count slots))))]
    (loop [i 0]
      (if (>= i (count ids)) nil
        (let [entry :- t/StoredFact (nth facts (nth ids i))]
          (if (= cid (t/storedfact-id entry)) entry (recur (inc i))))))))

(defn- find-tx-of [entries :- (Vec t/StoredTxOf) cid :- Int] :- t/StoredTxOf?
  (loop [i 0]
    (if (>= i (count entries)) nil
      (let [entry :- t/StoredTxOf (nth entries i)]
        (if (= cid (t/storedtxof-cid entry)) entry (recur (inc i)))))))

(defn- find-tx [entries :- (Vec t/StoredTx) id :- Int] :- t/StoredTx?
  (loop [i 0]
    (if (>= i (count entries)) nil
      (let [entry :- t/StoredTx (nth entries i)]
        (if (= id (t/storedtx-id entry)) entry (recur (inc i)))))))

;; pos is the position the new entry took in :values, so the probe reaches it by
;; nth rather than by another scan.  Doubling keeps the chain at slot-load.
(defn- index-value! [ctx :- (Atom t/Store) v :- t/StoreValue pos :- Int] :- t/Store
  (let [s :- t/Store (swap! ctx update :value-slots
                            (fn [slots :- (Vec t/IdBucket)] :- (Vec t/IdBucket) (slot-put slots v pos)))]
    (if (> (count (:values s)) (* slot-load (count (:value-slots s))))
      (swap! ctx assoc :value-slots (build-slots (:values s) (* 2 (count (:value-slots s)))))
      s)))

(defn- index-fact-slot! [ctx :- (Atom t/Store) cid :- Int pos :- Int] :- t/Store
  (let [s :- t/Store (swap! ctx update :fact-slots
                            (fn [slots :- (Vec t/IdBucket)] :- (Vec t/IdBucket)
                              (slot-add slots (key-slot cid (count slots)) pos)))]
    (if (> (count (:facts s)) (* slot-load (count (:fact-slots s))))
      (swap! ctx assoc :fact-slots (build-fact-slots (:facts s) (* 2 (count (:fact-slots s)))))
      s)))

(defn value! [ctx :- (Atom t/Store) v :- t/StoreValue] :- Int
  (let [s :- t/Store (deref ctx) known :- t/StoredValue? (find-value s v)]
    (if (some? known)
      (t/storedvalue-id known)
      (let [id (fresh-id! ctx) pos (count (:values s))]
        (swap! ctx update :objects (fn [ids :- (Vec Int)] :- (Vec Int) (conj ids id)))
        (swap! ctx update :values (fn [entries :- (Vec t/StoredValue)] :- (Vec t/StoredValue)
                                    (conj entries (t/->StoredValue id v))))
        (index-value! ctx v pos)
        id))))

(defn value-object? [ctx :- (Atom t/Store) id :- Int] :- Bool
  (some? (find-value-by-id (:values (let [s :- t/Store (deref ctx)] s)) id)))

(defn literal [ctx :- (Atom t/Store) id :- Int] :- t/StoreValue?
  (let [entry :- t/StoredValue? (find-value-by-id (:values (let [s :- t/Store (deref ctx)] s)) id)]
    (if (some? entry) (t/storedvalue-value entry) nil)))

(defn value-id [ctx :- (Atom t/Store) v :- t/StoreValue] :- Int?
  (let [entry :- t/StoredValue? (find-value (let [s :- t/Store (deref ctx)] s) v)]
    (if (some? entry) (t/storedvalue-id entry) nil)))

(defn begin-tx! [ctx :- (Atom t/Store) agent :- t/StoreValue] :- Int
  (let [tx (fresh-id! ctx) updated :- t/Store (swap! ctx update :next-seq inc)
        seq (:next-seq updated)]
    (swap! ctx update :txs (fn [entries :- (Vec t/StoredTx)] :- (Vec t/StoredTx)
                             (conj entries (t/->StoredTx tx seq agent nil nil))))
    tx))

(defn tx-seq [ctx :- (Atom t/Store) tx :- Int] :- Int
  (let [entry :- t/StoredTx? (find-tx (:txs (let [s :- t/Store (deref ctx)] s)) tx)]
    (if (some? entry) (t/storedtx-seq entry) 0)))
(defn tx-agent [ctx :- (Atom t/Store) tx :- Int] :- t/StoreValue?
  (let [entry :- t/StoredTx? (find-tx (:txs (let [s :- t/Store (deref ctx)] s)) tx)]
    (if (some? entry) (t/storedtx-agent entry) nil)))
(defn tx-observed [ctx :- (Atom t/Store) tx :- Int] :- Int?
  (let [entry :- t/StoredTx? (find-tx (:txs (let [s :- t/Store (deref ctx)] s)) tx)]
    (if (some? entry) (t/storedtx-observed entry) nil)))
(defn tx-ts [ctx :- (Atom t/Store) tx :- Int] :- String?
  (let [entry :- t/StoredTx? (find-tx (:txs (let [s :- t/Store (deref ctx)] s)) tx)]
    (if (some? entry) (t/storedtx-ts entry) nil)))
(defn current-seq [ctx :- (Atom t/Store)] :- Int (:next-seq (let [s :- t/Store (deref ctx)] s)))
(defn supersedes-pred [ctx :- (Atom t/Store)] :- Int? (:supersedes-pred (let [s :- t/Store (deref ctx)] s)))

(defn- replace-tx [entries :- (Vec t/StoredTx) id :- Int observed :- Int? ts :- String?] :- (Vec t/StoredTx)
  (mapv (fn [entry :- t/StoredTx] :- t/StoredTx
          (if (= id (t/storedtx-id entry))
            (t/->StoredTx id (t/storedtx-seq entry) (t/storedtx-agent entry) observed ts)
            entry)) entries))
(defn set-tx-observed! [ctx :- (Atom t/Store) tx :- Int observed :- Int] :- t/Store
  (let [old :- t/StoredTx? (find-tx (:txs (let [s :- t/Store (deref ctx)] s)) tx)]
    (if (some? old)
      (swap! ctx update :txs replace-tx tx observed (t/storedtx-ts old))
      (let [s :- t/Store (deref ctx)] s))))
(defn set-tx-ts! [ctx :- (Atom t/Store) tx :- Int ts :- String] :- t/Store
  (let [old :- t/StoredTx? (find-tx (:txs (let [s :- t/Store (deref ctx)] s)) tx)]
    (if (some? old)
      (swap! ctx update :txs replace-tx tx (t/storedtx-observed old) ts)
      (let [s :- t/Store (deref ctx)] s))))
(defn set-supersedes-pred! [ctx :- (Atom t/Store) pid :- Int] :- t/Store (swap! ctx assoc :supersedes-pred pid))

;; A bucket vector is addressed through its slot table: the key's slot holds the
;; POSITIONS of the buckets that hash there, so a probe compares slot-load keys
;; instead of every distinct key in the index.  -1 is "no bucket for this key".
(defn- bucket-pos [buckets :- (Vec t/IdBucket) slots :- (Vec t/IdBucket) key :- Int] :- Int
  (let [ids :- (Vec Int) (t/idbucket-ids (nth slots (key-slot key (count slots))))]
    (loop [i 0]
      (if (>= i (count ids)) -1
        (let [pos (nth ids i)]
          (if (= key (t/idbucket-key (nth buckets pos))) pos (recur (inc i))))))))
(defn- pair-bucket-pos [buckets :- (Vec t/PairBucket) slots :- (Vec t/IdBucket) left :- Int right :- Int] :- Int
  (let [ids :- (Vec Int) (t/idbucket-ids (nth slots (pair-slot left right (count slots))))]
    (loop [i 0]
      (if (>= i (count ids)) -1
        (let [pos (nth ids i) bucket :- t/PairBucket (nth buckets pos)]
          (if (and (= left (t/pairbucket-left bucket)) (= right (t/pairbucket-right bucket)))
            pos (recur (inc i))))))))

(defn- bucket-ids [buckets :- (Vec t/IdBucket) slots :- (Vec t/IdBucket) key :- Int] :- (Vec Int)
  (let [pos (bucket-pos buckets slots key)]
    (if (< pos 0) empty-ids (t/idbucket-ids (nth buckets pos)))))
(defn- pair-bucket-ids [buckets :- (Vec t/PairBucket) slots :- (Vec t/IdBucket) left :- Int right :- Int] :- (Vec Int)
  (let [pos (pair-bucket-pos buckets slots left right)]
    (if (< pos 0) empty-ids (t/pairbucket-ids (nth buckets pos)))))

;; An existing key rewrites one path with assoc where the mapv idiom rebuilt every
;; bucket; a new key appends, and only then does its slot table need a position.
(defn- put-bucket [buckets :- (Vec t/IdBucket) pos :- Int key :- Int cid :- Int] :- (Vec t/IdBucket)
  (if (< pos 0)
    (conj buckets (t/->IdBucket key (conj empty-ids cid)))
    (assoc buckets pos (t/->IdBucket key (conj (t/idbucket-ids (nth buckets pos)) cid)))))
(defn- put-pair-bucket [buckets :- (Vec t/PairBucket) pos :- Int left :- Int right :- Int cid :- Int] :- (Vec t/PairBucket)
  (if (< pos 0)
    (conj buckets (t/->PairBucket left right (conj empty-ids cid)))
    (assoc buckets pos (t/->PairBucket left right (conj (t/pairbucket-ids (nth buckets pos)) cid)))))

(defn- grow-key-slots [slots :- (Vec t/IdBucket) buckets :- (Vec t/IdBucket) key :- Int] :- (Vec t/IdBucket)
  (if (> (count buckets) (* slot-load (count slots)))
    (build-key-slots buckets (* 2 (count slots)))
    (slot-add slots (key-slot key (count slots)) (dec (count buckets)))))
(defn- grow-pair-slots [slots :- (Vec t/IdBucket) buckets :- (Vec t/PairBucket) left :- Int right :- Int] :- (Vec t/IdBucket)
  (if (> (count buckets) (* slot-load (count slots)))
    (build-pair-slots buckets (* 2 (count slots)))
    (slot-add slots (pair-slot left right (count slots)) (dec (count buckets)))))

(defn- index-by-l! [ctx :- (Atom t/Store) key :- Int cid :- Int] :- t/Store
  (let [s :- t/Store (deref ctx) buckets :- (Vec t/IdBucket) (:idx-by-l s) slots :- (Vec t/IdBucket) (:l-slots s)
        pos (bucket-pos buckets slots key) put :- (Vec t/IdBucket) (put-bucket buckets pos key cid)]
    (swap! ctx assoc :idx-by-l put)
    (if (< pos 0) (swap! ctx assoc :l-slots (grow-key-slots slots put key)) (deref ctx))))
(defn- index-by-p! [ctx :- (Atom t/Store) key :- Int cid :- Int] :- t/Store
  (let [s :- t/Store (deref ctx) buckets :- (Vec t/IdBucket) (:idx-by-p s) slots :- (Vec t/IdBucket) (:p-slots s)
        pos (bucket-pos buckets slots key) put :- (Vec t/IdBucket) (put-bucket buckets pos key cid)]
    (swap! ctx assoc :idx-by-p put)
    (if (< pos 0) (swap! ctx assoc :p-slots (grow-key-slots slots put key)) (deref ctx))))
(defn- index-by-r! [ctx :- (Atom t/Store) key :- Int cid :- Int] :- t/Store
  (let [s :- t/Store (deref ctx) buckets :- (Vec t/IdBucket) (:idx-by-r s) slots :- (Vec t/IdBucket) (:r-slots s)
        pos (bucket-pos buckets slots key) put :- (Vec t/IdBucket) (put-bucket buckets pos key cid)]
    (swap! ctx assoc :idx-by-r put)
    (if (< pos 0) (swap! ctx assoc :r-slots (grow-key-slots slots put key)) (deref ctx))))
(defn- index-by-lp! [ctx :- (Atom t/Store) left :- Int right :- Int cid :- Int] :- t/Store
  (let [s :- t/Store (deref ctx) buckets :- (Vec t/PairBucket) (:idx-by-lp s) slots :- (Vec t/IdBucket) (:lp-slots s)
        pos (pair-bucket-pos buckets slots left right) put :- (Vec t/PairBucket) (put-pair-bucket buckets pos left right cid)]
    (swap! ctx assoc :idx-by-lp put)
    (if (< pos 0) (swap! ctx assoc :lp-slots (grow-pair-slots slots put left right)) (deref ctx))))
(defn- index-by-pr! [ctx :- (Atom t/Store) left :- Int right :- Int cid :- Int] :- t/Store
  (let [s :- t/Store (deref ctx) buckets :- (Vec t/PairBucket) (:idx-by-pr s) slots :- (Vec t/IdBucket) (:pr-slots s)
        pos (pair-bucket-pos buckets slots left right) put :- (Vec t/PairBucket) (put-pair-bucket buckets pos left right cid)]
    (swap! ctx assoc :idx-by-pr put)
    (if (< pos 0) (swap! ctx assoc :pr-slots (grow-pair-slots slots put left right)) (deref ctx))))

(defn- index-fact! [ctx :- (Atom t/Store) cid :- Int l :- Int p :- Int r :- Int] :- t/Store
  (index-by-l! ctx l cid)
  (index-by-p! ctx p cid)
  (index-by-r! ctx r cid)
  (index-by-lp! ctx l p cid)
  (index-by-pr! ctx p r cid))

(defn fact! [ctx :- (Atom t/Store) l :- Int p :- Int r :- Int tx :- Int] :- Int
  (let [cid (fresh-id! ctx) pos (count (:facts (let [s :- t/Store (deref ctx)] s)))]
    (swap! ctx update :objects (fn [ids :- (Vec Int)] :- (Vec Int) (conj ids cid)))
    (swap! ctx update :facts (fn [facts :- (Vec t/StoredFact)] :- (Vec t/StoredFact) (conj facts (t/->StoredFact cid l p r))))
    (swap! ctx update :tx-of (fn [entries :- (Vec t/StoredTxOf)] :- (Vec t/StoredTxOf) (conj entries (t/->StoredTxOf cid tx))))
    (index-fact-slot! ctx cid pos)
    (index-fact! ctx cid l p r)
    (when (= p (supersedes-pred ctx))
      (swap! ctx update :superseded (fn [ids :- (Vec Int)] :- (Vec Int) (add-id ids r))))
    cid))

;; A record keeps keyword lookup and structural map equality for Clojure callers
;; without asking the native backend to lower an open map literal.
(defn fact-of [ctx :- (Atom t/Store) cid :- Int] :- t/FactView?
  (let [entry :- t/StoredFact? (find-fact (let [s :- t/Store (deref ctx)] s) cid)]
    (if (some? entry) (t/->FactView (t/storedfact-l entry) (t/storedfact-p entry) (t/storedfact-r entry)) nil)))
(defn fact-tx [ctx :- (Atom t/Store) cid :- Int] :- Int?
  (let [entry :- t/StoredTxOf? (find-tx-of (:tx-of (let [s :- t/Store (deref ctx)] s)) cid)]
    (if (some? entry) (t/storedtxof-tx entry) nil)))
(defn fact-l [ctx :- (Atom t/Store) cid :- Int] :- Int? (let [f (fact-of ctx cid)] (if (some? f) (:l f) nil)))
(defn fact-p [ctx :- (Atom t/Store) cid :- Int] :- Int? (let [f (fact-of ctx cid)] (if (some? f) (:p f) nil)))
(defn fact-r [ctx :- (Atom t/Store) cid :- Int] :- Int? (let [f (fact-of ctx cid)] (if (some? f) (:r f) nil)))
(defn live? [ctx :- (Atom t/Store) cid :- Int] :- Bool
  (not (includes-id? (:superseded (let [s :- t/Store (deref ctx)] s)) cid)))
(defn- live-only [ctx :- (Atom t/Store) ids :- (Vec Int)] :- (Vec Int)
  (filterv (fn [id :- Int] :- Bool (live? ctx id)) ids))
(defn raw-by-l [ctx :- (Atom t/Store) l :- Int] :- (Vec Int) (let [s :- t/Store (deref ctx)] (bucket-ids (:idx-by-l s) (:l-slots s) l)))
(defn raw-by-p [ctx :- (Atom t/Store) p :- Int] :- (Vec Int) (let [s :- t/Store (deref ctx)] (bucket-ids (:idx-by-p s) (:p-slots s) p)))
(defn raw-by-r [ctx :- (Atom t/Store) r :- Int] :- (Vec Int) (let [s :- t/Store (deref ctx)] (bucket-ids (:idx-by-r s) (:r-slots s) r)))
(defn raw-by-lp [ctx :- (Atom t/Store) l :- Int p :- Int] :- (Vec Int) (let [s :- t/Store (deref ctx)] (pair-bucket-ids (:idx-by-lp s) (:lp-slots s) l p)))
(defn raw-by-pr [ctx :- (Atom t/Store) p :- Int r :- Int] :- (Vec Int) (let [s :- t/Store (deref ctx)] (pair-bucket-ids (:idx-by-pr s) (:pr-slots s) p r)))
(defn by-l [ctx :- (Atom t/Store) l :- Int] :- (Vec Int) (live-only ctx (raw-by-l ctx l)))
(defn by-p [ctx :- (Atom t/Store) p :- Int] :- (Vec Int) (live-only ctx (raw-by-p ctx p)))
(defn by-r [ctx :- (Atom t/Store) r :- Int] :- (Vec Int) (live-only ctx (raw-by-r ctx r)))
(defn by-lp [ctx :- (Atom t/Store) l :- Int p :- Int] :- (Vec Int) (live-only ctx (raw-by-lp ctx l p)))
(defn by-pr [ctx :- (Atom t/Store) p :- Int r :- Int] :- (Vec Int) (live-only ctx (raw-by-pr ctx p r)))
(defn all-facts [ctx :- (Atom t/Store)] :- (Vec Int)
  (mapv (fn [entry :- t/StoredFact] :- Int (t/storedfact-id entry))
        (:facts (let [s :- t/Store (deref ctx)] s))))
(defn current-facts [ctx :- (Atom t/Store)] :- (Vec Int) (live-only ctx (all-facts ctx)))
(defn object-ids [ctx :- (Atom t/Store)] :- (Vec Int) (:objects (let [s :- t/Store (deref ctx)] s)))
(defn value-entries [ctx :- (Atom t/Store)] :- (Vec t/StoredValue) (:values (let [s :- t/Store (deref ctx)] s)))
(defn fact-entries [ctx :- (Atom t/Store)] :- (Vec t/StoredFact) (:facts (let [s :- t/Store (deref ctx)] s)))
(defn tx-entries [ctx :- (Atom t/Store)] :- (Vec t/StoredTx) (:txs (let [s :- t/Store (deref ctx)] s)))

(defn dump-store [ctx :- (Atom t/Store)] :- t/StoreDump
  (let [s :- t/Store (deref ctx)]
    (t/->StoreDump 1 (:next-id s) (:next-seq s) (:supersedes-pred s) (:objects s) (:values s) (:facts s) (:tx-of s) (:txs s) (:superseded s))))
;; Every slot table is derived, never dumped.  :values and :facts arrive whole, so
;; theirs are built once sized to the corpus; the fact indexes are rebuilt fact by
;; fact below and their tables double along with them.
(defn load-store! [ctx :- (Atom t/Store) data :- t/StoreDump] :- (Atom t/Store)
  (let [values :- (Vec t/StoredValue) (t/storedump-values data)
        facts :- (Vec t/StoredFact) (t/storedump-facts data)]
    (reset! ctx (t/->Store (t/storedump-next-id data) (t/storedump-next-seq data) (t/storedump-supersedes-pred data)
                            (t/storedump-objects data) values facts
                            (t/storedump-tx-of data) (t/storedump-txs data) (t/storedump-superseded data)
                            empty-id-buckets empty-id-buckets empty-id-buckets empty-pair-buckets empty-pair-buckets
                            (build-slots values (slots-width-for (count values)))
                            (fresh-slots initial-slots) (fresh-slots initial-slots) (fresh-slots initial-slots)
                            (fresh-slots initial-slots) (fresh-slots initial-slots)
                            (build-fact-slots facts (slots-width-for (count facts)))))
    (doseq [entry facts]
      (index-fact! ctx (t/storedfact-id entry) (t/storedfact-l entry) (t/storedfact-p entry) (t/storedfact-r entry)))
    ctx))
