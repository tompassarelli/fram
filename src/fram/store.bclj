#lang beagle/clj
;; Portable recursive Term storage and occurrence-ordered transaction history.
(ns fram.store)
(define-mode strict)
(require fram.types :as t)

(def empty-ids: (Vec Int) [])
(def empty-bools: (Vec Bool) [])
(def empty-atoms: (Vec t/AtomRow) [])
(def empty-triple-rows: (Vec t/TripleRow) [])
(def empty-transaction-rows: (Vec t/TransactionRow) [])
(def empty-operation-rows: (Vec t/OperationRow) [])
(def empty-commit-operations: (Vec t/CommitOperation) [])
(def empty-transaction-frames: (Vec t/TransactionFrame) [])
(def empty-active-buckets: (Vec t/ActiveBucket) [])
(def empty-term-buckets: (Vec t/TermBucket) [])
(def term-store-dump-version: Int 2)
(def max-transaction-sequence: Int 9223372036854775806)

(defrecord TermStoreLoadResult
  [ok: Bool
   code: Keyword?
   message: String?])

(defrecord TransactionReplayResult
  [ok: Bool
   code: Keyword?
   message: String?])

(defrecord TransactionFramesResult
  [ok: Bool
   frames: (Vec t/TransactionFrame)
   code: Keyword?
   message: String?])

;; A slot table doubles once its indexed vector holds more than this many rows
;; per slot. Every lookup still checks the complete physical row for collision.
(def initial-slots: Int 64)
(def slot-load: Int 4)

(defn- valid-space-id? [space-id: Any] -> Bool
  (and (string? space-id) (pos? (count space-id))))

(defn- fresh-term-slots [width: Int] -> (Vec t/TermBucket)
  (loop [slots: (Vec t/TermBucket) empty-term-buckets position 0]
    (if (>= position width)
      slots
      (recur (conj slots (t/->TermBucket position empty-ids)) (inc position)))))

(defn- term-slot
  [value: Any
   width: Int] -> Int (mod (hash value) width))

(defn- term-slot-add
  [slots: (Vec t/TermBucket)
   slot: Int
   position: Int] -> (Vec t/TermBucket)
  (assoc slots slot
         (t/->TermBucket slot
                         (conj (t/termbucket-positions (nth slots slot)) position))))

(defn- term-slots-width-for [n: Int] -> Int
  (loop [width initial-slots]
    (if (>= (* slot-load width) n) width (recur (* 2 width)))))

(defn- build-atom-term-slots
  [atoms: (Vec t/AtomRow)
   width: Int] -> (Vec t/TermBucket)
  (loop [slots: (Vec t/TermBucket) (fresh-term-slots width) position 0]
    (if (>= position (count atoms))
      slots
      (recur (term-slot-add slots (term-slot (nth atoms position) width) position)
             (inc position)))))

(defn- build-triple-term-slots
  [rows: (Vec t/TripleRow)
   width: Int] -> (Vec t/TermBucket)
  (loop [slots: (Vec t/TermBucket) (fresh-term-slots width) position 0]
    (if (>= position (count rows))
      slots
      (recur (term-slot-add slots (term-slot (nth rows position) width) position)
             (inc position)))))

(defn- build-active-slots
  [buckets: (Vec t/ActiveBucket)
   width: Int] -> (Vec t/TermBucket)
  (loop [slots: (Vec t/TermBucket) (fresh-term-slots width) position 0]
    (if (>= position (count buckets))
      slots
      (recur
       (term-slot-add slots
                      (term-slot (t/activebucket-triple-handle (nth buckets position)) width)
                      position)
       (inc position)))))

(defn new-term-store [space-id: String] -> (Atom t/TermStore)
  (if (valid-space-id? space-id)
    (atom (t/->TermStore
           space-id 1 empty-atoms empty-triple-rows
           empty-transaction-rows empty-operation-rows empty-bools empty-ids
           empty-active-buckets
           (fresh-term-slots initial-slots)
           (fresh-term-slots initial-slots)
           (fresh-term-slots initial-slots)))
    (throw (ex-info "fram: TermStore requires a non-empty SpaceId"
                    {:type :invalid-space-id}))))

(defn space-id [ctx: (Atom t/TermStore)] -> String
  (t/termstore-space-id (deref ctx)))

(defn next-sequence [ctx: (Atom t/TermStore)] -> Int
  (t/termstore-next-sequence (deref ctx)))

(defn current-sequence [ctx: (Atom t/TermStore)] -> Int
  (dec (next-sequence ctx)))

(defn- atom-row [value: Any] -> t/AtomRow
  (cond
    [(string? value) (t/->AtomRow :string value nil nil nil nil nil)]
    [(integer? value) (t/->AtomRow :int nil value nil nil nil nil)]
    [(number? value) (t/->AtomRow :float nil nil value nil nil nil)]
    [(boolean? value) (t/->AtomRow :bool nil nil nil value nil nil)]
    [(keyword? value) (t/->AtomRow :keyword nil nil nil nil value nil)]
    [(t/instant? value) (t/->AtomRow :instant nil nil nil nil nil value)]
    [:else (throw (ex-info "fram: value outside Atom" {:type :invalid-atom}))]))

(defn- atom-row-value [row: t/AtomRow] -> Any
  (cond
    [(= :string (t/atomrow-kind row)) (t/atomrow-string-value row)]
    [(= :int (t/atomrow-kind row)) (t/atomrow-int-value row)]
    [(= :float (t/atomrow-kind row)) (t/atomrow-float-value row)]
    [(= :bool (t/atomrow-kind row)) (t/atomrow-bool-value row)]
    [(= :keyword (t/atomrow-kind row)) (t/atomrow-keyword-value row)]
    [(= :instant (t/atomrow-kind row)) (t/atomrow-instant-value row)]
    [:else nil]))

(defn- valid-atom-row? [row: t/AtomRow] -> Bool
  (let [value (atom-row-value row)]
    (and (some? value) (= row (atom-row value)))))

(defn- find-atom-position
  [atoms: (Vec t/AtomRow)
   slots: (Vec t/TermBucket)
   value: t/AtomRow] -> Int
  (let [positions: (Vec Int)
        (t/termbucket-positions (nth slots (term-slot value (count slots))))]
    (loop [offset 0]
      (if (>= offset (count positions))
        -1
        (let [position (nth positions offset)]
          (if (= (nth atoms position) value)
            position
            (recur (inc offset))))))))

(defn- find-triple-position
  [rows: (Vec t/TripleRow)
   slots: (Vec t/TermBucket)
   value: t/TripleRow] -> Int
  (let [positions: (Vec Int)
        (t/termbucket-positions (nth slots (term-slot value (count slots))))]
    (loop [offset 0]
      (if (>= offset (count positions))
        -1
        (let [position (nth positions offset)]
          (if (= (nth rows position) value)
            position
            (recur (inc offset))))))))

(defn- index-atom-term!
  [ctx: (Atom t/TermStore)
   value: t/AtomRow
   position: Int] -> t/TermStore
  (let [store: t/TermStore
        (swap! ctx update :atom-slots
               (fn [slots: (Vec t/TermBucket)] -> (Vec t/TermBucket)
                 (term-slot-add slots (term-slot value (count slots)) position)))]
    (if (> (count (t/termstore-atoms store))
           (* slot-load (count (t/termstore-atom-slots store))))
      (swap! ctx assoc :atom-slots
             (build-atom-term-slots
              (t/termstore-atoms store)
              (* 2 (count (t/termstore-atom-slots store)))))
      store)))

(defn- index-triple-term!
  [ctx: (Atom t/TermStore)
   value: t/TripleRow
   position: Int] -> t/TermStore
  (let [store: t/TermStore
        (swap! ctx update :triple-slots
               (fn [slots: (Vec t/TermBucket)] -> (Vec t/TermBucket)
                 (term-slot-add slots (term-slot value (count slots)) position)))]
    (if (> (count (t/termstore-triples store))
           (* slot-load (count (t/termstore-triple-slots store))))
      (swap! ctx assoc :triple-slots
             (build-triple-term-slots
              (t/termstore-triples store)
              (* 2 (count (t/termstore-triple-slots store)))))
      store)))

(defn- atom-handle [position: Int] -> Int (* 2 position))
(defn- triple-handle [position: Int] -> Int (inc (* 2 position)))
(defn- atom-handle? [handle: Int] -> Bool (= 0 (mod handle 2)))
(defn- handle-position [handle: Int] -> Int (quot handle 2))

(defn- intern-handle!
  [ctx: (Atom t/TermStore)
   term: Any] -> Int
  (if (not (t/term? term))
    (throw (ex-info "fram: cannot intern a value outside Term" {:type :invalid-term}))
    (if (t/triple? term)
      (let [slot0 (intern-handle! ctx (t/triple-slot0 term))
            slot1 (intern-handle! ctx (t/triple-slot1 term))
            slot2 (intern-handle! ctx (t/triple-slot2 term))
            store: t/TermStore (deref ctx)
            rows: (Vec t/TripleRow) (t/termstore-triples store)
            value: t/TripleRow (t/->TripleRow slot0 slot1 slot2)
            known (find-triple-position rows (t/termstore-triple-slots store) value)]
        (if (>= known 0)
          (triple-handle known)
          (let [position (count rows)]
            (swap! ctx update :triples
                   (fn [current: (Vec t/TripleRow)] -> (Vec t/TripleRow)
                     (conj current value)))
            (index-triple-term! ctx value position)
            (triple-handle position))))
      (let [value: t/AtomRow (atom-row term)
            store: t/TermStore (deref ctx)
            atoms: (Vec t/AtomRow) (t/termstore-atoms store)
            known (find-atom-position atoms (t/termstore-atom-slots store) value)]
        (if (>= known 0)
          (atom-handle known)
          (let [position (count atoms)]
            (swap! ctx update :atoms
                   (fn [current: (Vec t/AtomRow)] -> (Vec t/AtomRow)
                     (conj current value)))
            (index-atom-term! ctx value position)
            (atom-handle position)))))))

(defn- valid-handle?
  [store: t/TermStore
   handle: Int] -> Bool
  (and (>= handle 0)
       (if (atom-handle? handle)
         (< (handle-position handle) (count (t/termstore-atoms store)))
         (< (handle-position handle) (count (t/termstore-triples store))))))

(defn- resolve-handle
  [store: t/TermStore
   handle: Int] -> Any
  (if (not (valid-handle? store handle))
    (throw (ex-info "fram: term handle does not resolve" {:type :invalid-term-handle}))
    (let [position (handle-position handle)]
      (if (atom-handle? handle)
        (atom-row-value (nth (t/termstore-atoms store) position))
        (let [row: t/TripleRow (nth (t/termstore-triples store) position)]
          (t/triple (resolve-handle store (t/triplerow-slot0 row))
                    (resolve-handle store (t/triplerow-slot1 row))
                    (resolve-handle store (t/triplerow-slot2 row))))))))

(defn- resolve-triple-handle
  [store: t/TermStore
   handle: Int] -> t/Triple
  (let [term (resolve-handle store handle)]
    (if (t/triple? term)
      term
      (throw (ex-info "fram: operation handle does not resolve to Triple"
                      {:type :invalid-operation-handle})))))

(defn known-term-handle
  [store: t/TermStore
   term: Any] -> Int?
  (if (not (t/term? term))
    nil
    (if (t/triple? term)
      (let [slot0 (known-term-handle store (t/triple-slot0 term))
            slot1 (known-term-handle store (t/triple-slot1 term))
            slot2 (known-term-handle store (t/triple-slot2 term))
            handles: (Vec Int?) [slot0 slot1 slot2]
            all-known
            (loop [position 0]
              (if (>= position (count handles))
                true
                (if (some? (nth handles position))
                  (recur (inc position))
                  false)))]
        (if all-known
          (let [position
                (find-triple-position
                 (t/termstore-triples store) (t/termstore-triple-slots store)
                 (t/->TripleRow (if (some? slot0) slot0 0)
                                (if (some? slot1) slot1 0)
                                (if (some? slot2) slot2 0)))]
            (when (>= position 0) (triple-handle position)))
          nil))
      (let [position
            (find-atom-position
             (t/termstore-atoms store) (t/termstore-atom-slots store)
             (atom-row term))]
        (when (>= position 0) (atom-handle position))))))

(defn intern-term!
  [ctx: (Atom t/TermStore)
   term: Any] -> Any
  (let [handle (intern-handle! ctx term)]
    (resolve-handle (deref ctx) handle)))

(defn replay-terms!
  [ctx: (Atom t/TermStore)
   terms: (Vec Any)] -> (Atom t/TermStore)
  (do
    (doseq [term terms] (intern-term! ctx term))
    ctx))

(defn atom-term-count [ctx: (Atom t/TermStore)] -> Int
  (count (t/termstore-atoms (deref ctx))))

(defn triple-term-count [ctx: (Atom t/TermStore)] -> Int
  (count (t/termstore-triples (deref ctx))))

(defn term-count [ctx: (Atom t/TermStore)] -> Int
  (+ (atom-term-count ctx) (triple-term-count ctx)))

(defn transaction-count [ctx: (Atom t/TermStore)] -> Int
  (count (t/termstore-transactions (deref ctx))))

(defn operation-count [ctx: (Atom t/TermStore)] -> Int
  (count (t/termstore-operations (deref ctx))))

(defn assert-operation [proposition: Any] -> t/CommitOperation
  (if (and (t/triple? proposition) (t/term? proposition))
    (t/->CommitOperation t/assert-action proposition)
    (throw (ex-info "fram: assertion operation requires a Triple"
                    {:type :invalid-commit-operation}))))

(defn retract-operation [proposition: Any] -> t/CommitOperation
  (if (and (t/triple? proposition) (t/term? proposition))
    (t/->CommitOperation t/retract-action proposition)
    (throw (ex-info "fram: retraction operation requires a Triple"
                    {:type :invalid-commit-operation}))))

(defn- valid-commit-operation? [operation: t/CommitOperation] -> Bool
  (and (or (= t/assert-action (t/commitoperation-action operation))
           (= t/retract-action (t/commitoperation-action operation)))
       (and (t/triple? (t/commitoperation-proposition operation))
            (t/term? (t/commitoperation-proposition operation)))))

(defn- valid-operations? [operations: (Vec t/CommitOperation)] -> Bool
  (and (pos? (count operations))
       (every? (fn [operation: t/CommitOperation] -> Bool
                 (valid-commit-operation? operation))
               operations)))

(defn transaction-frame
  [sequence: Int
   operations: (Vec t/CommitOperation)] -> t/TransactionFrame
  (if (and (>= sequence 0) (valid-operations? operations))
    (t/->TransactionFrame sequence operations)
    (throw (ex-info "fram: transaction frame requires a non-negative sequence and operations"
                    {:type :invalid-transaction-frame}))))

(defn- find-active-bucket-position
  [store: t/TermStore
   handle: Int] -> Int
  (let [slots: (Vec t/TermBucket) (t/termstore-active-slots store)
        buckets: (Vec t/ActiveBucket) (t/termstore-active-buckets store)
        positions: (Vec Int)
        (t/termbucket-positions (nth slots (term-slot handle (count slots))))]
    (loop [offset 0]
      (if (>= offset (count positions))
        -1
        (let [position (nth positions offset)]
          (if (= handle (t/activebucket-triple-handle (nth buckets position)))
            position
            (recur (inc offset))))))))

(defn- active-positions
  [store: t/TermStore
   handle: Int] -> (Vec Int)
  (let [position (find-active-bucket-position store handle)]
    (if (>= position 0)
      (t/activebucket-positions (nth (t/termstore-active-buckets store) position))
      empty-ids)))

(defn- set-active-positions
  [store: t/TermStore
   handle: Int
   positions: (Vec Int)] -> t/TermStore
  (let [known (find-active-bucket-position store handle)]
    (if (>= known 0)
      (assoc store :active-buckets
             (assoc (t/termstore-active-buckets store) known
                    (t/->ActiveBucket handle positions)))
      (let [buckets: (Vec t/ActiveBucket)
            (conj (t/termstore-active-buckets store) (t/->ActiveBucket handle positions))
            position (dec (count buckets))
            slots: (Vec t/TermBucket) (t/termstore-active-slots store)
            store-with-bucket: t/TermStore
            (assoc store
                   :active-buckets buckets
                   :active-slots
                   (term-slot-add slots (term-slot handle (count slots)) position))]
        (if (> (count buckets) (* slot-load (count slots)))
          (assoc store-with-bucket :active-slots
                 (build-active-slots buckets (* 2 (count slots))))
          store-with-bucket)))))

(defn- apply-operation-state
  [store: t/TermStore
   operation-position: Int
   row: t/OperationRow] -> t/TermStore
  (let [handle (t/operationrow-triple-handle row)
        action (t/operationrow-action row)
        active: (Vec Int) (active-positions store handle)]
    (if (= action t/assert-action)
      (set-active-positions
       (assoc store
              :operation-live (conj (t/termstore-operation-live store) true)
              :withdrawal-targets (conj (t/termstore-withdrawal-targets store) -1))
       handle
       (conj active operation-position))
      (if (empty? active)
        (assoc store
               :operation-live (conj (t/termstore-operation-live store) false)
               :withdrawal-targets (conj (t/termstore-withdrawal-targets store) -1))
        (let [target (peek active)
              live: (Vec Bool) (t/termstore-operation-live store)]
          (set-active-positions
           (assoc store
                  :operation-live (conj (assoc live target false) false)
                  :withdrawal-targets
                  (conj (t/termstore-withdrawal-targets store) target))
           handle
           (pop active)))))))

(defn- operation-handles!
  [ctx: (Atom t/TermStore)
   operations: (Vec t/CommitOperation)] -> (Vec Int)
  (reduce
   (fn
     [handles: (Vec Int)
      operation: t/CommitOperation] -> (Vec Int)
     (conj handles
           (intern-handle! ctx (t/commitoperation-proposition operation))))
   empty-ids
   operations))

(defn- transaction-replay-ok [] -> TransactionReplayResult
  (->TransactionReplayResult true nil nil))

(defn- transaction-replay-error
  [code: Keyword
   message: String] -> TransactionReplayResult
  (->TransactionReplayResult false code message))

(defn- transaction-replay-unclassified-error [] -> TransactionReplayResult
  (->TransactionReplayResult false nil nil))

(defn- append-valid-transaction!
  [ctx: (Atom t/TermStore)
   sequence: Int
   operations: (Vec t/CommitOperation)] -> t/TermStore
  (let [handles: (Vec Int) (operation-handles! ctx operations)
        store: t/TermStore (deref ctx)
        first-operation (count (t/termstore-operations store))
        transaction-row: t/TransactionRow
        (t/->TransactionRow sequence first-operation (count operations))
        with-transaction: t/TermStore
        (assoc store :transactions
               (conj (t/termstore-transactions store) transaction-row))
        appended: t/TermStore
        (loop [current: t/TermStore with-transaction ordinal 0]
          (if (>= ordinal (count operations))
            current
            (let [operation: t/CommitOperation (nth operations ordinal)
                  row: t/OperationRow
                  (t/->OperationRow sequence ordinal
                                    (t/commitoperation-action operation)
                                    (nth handles ordinal))
                  operation-position (+ first-operation ordinal)
                  with-row: t/TermStore
                  (assoc current :operations
                         (conj (t/termstore-operations current) row))]
              (recur (apply-operation-state with-row operation-position row)
                     (inc ordinal)))))
        final-store: t/TermStore (assoc appended :next-sequence (inc sequence))]
    (do
      (reset! ctx final-store)
      final-store)))

(defn- append-transaction-result!
  [ctx: (Atom t/TermStore)
   sequence: Int
   operations: (Vec t/CommitOperation)] -> TransactionReplayResult
  (let [before: t/TermStore (deref ctx)]
    (cond
      [(not (valid-operations? operations))
       (transaction-replay-error
        :invalid-transaction-frame
        "fram: transaction requires at least one valid operation")]
      [(< sequence (t/termstore-next-sequence before))
       (transaction-replay-error
        :nonmonotonic-transaction-sequence
        "fram: transaction sequence must advance within its space")]
      [(> sequence max-transaction-sequence)
       (transaction-replay-unclassified-error)]
      [:else
       (do
         (append-valid-transaction! ctx sequence operations)
         (transaction-replay-ok))])))

(defn- append-transaction!
  [ctx: (Atom t/TermStore)
   sequence: Int
   operations: (Vec t/CommitOperation)] -> t/Triple
  (let [before: t/TermStore (deref ctx)]
    (if (not (valid-operations? operations))
      (throw (ex-info "fram: transaction requires at least one valid operation"
                      {:type :invalid-transaction-frame}))
      (if (< sequence (t/termstore-next-sequence before))
        (throw (ex-info "fram: transaction sequence must advance within its space"
                        {:type :nonmonotonic-transaction-sequence}))
        (let [final-store: t/TermStore
              (append-valid-transaction! ctx sequence operations)]
          (t/transaction-coordinate
           (t/termstore-space-id final-store) sequence))))))

(defn commit-transaction!
  [ctx: (Atom t/TermStore)
   operations: (Vec t/CommitOperation)] -> t/Triple
  (append-transaction! ctx (t/termstore-next-sequence (deref ctx)) operations))

(defn replay-transaction-result!
  [ctx: (Atom t/TermStore)
   frame: t/TransactionFrame] -> TransactionReplayResult
  (if (and (t/transaction-frame? frame)
           (and (>= (t/transactionframe-sequence frame) 0)
                (valid-operations? (t/transactionframe-operations frame))))
    (append-transaction-result! ctx
                                (t/transactionframe-sequence frame)
                                (t/transactionframe-operations frame))
    (transaction-replay-error
     :invalid-transaction-frame
     "fram: invalid transaction frame")))

(defn replay-transaction!
  [ctx: (Atom t/TermStore)
   frame: t/TransactionFrame] -> t/Triple
  (if (and (t/transaction-frame? frame)
           (and (>= (t/transactionframe-sequence frame) 0)
                (valid-operations? (t/transactionframe-operations frame))))
    (append-transaction! ctx
                         (t/transactionframe-sequence frame)
                         (t/transactionframe-operations frame))
    (throw (ex-info "fram: invalid transaction frame"
                    {:type :invalid-transaction-frame}))))

(defn- occurrence-at
  [store: t/TermStore
   operation-position: Int] -> t/Triple
  (let [row: t/OperationRow (nth (t/termstore-operations store) operation-position)]
    (t/occurrence-coordinate
     (t/transaction-coordinate (t/termstore-space-id store)
                               (t/operationrow-tx-sequence row))
     (t/operationrow-ordinal row))))

(defn- event-at
  [store: t/TermStore
   operation-position: Int] -> t/Triple
  (let [row: t/OperationRow (nth (t/termstore-operations store) operation-position)
        occurrence: t/Triple (occurrence-at store operation-position)
        proposition: t/Triple
        (resolve-triple-handle store (t/operationrow-triple-handle row))]
    (if (= t/assert-action (t/operationrow-action row))
      (t/assertion-occurrence occurrence proposition)
      (t/retraction-occurrence occurrence proposition))))

(defn- first-transaction-after
  [transactions: (Vec t/TransactionRow)
   sequence: Int] -> Int
  (loop [low 0 high (count transactions)]
    (if (>= low high)
      low
      (let [middle (quot (+ low high) 2)
            candidate (t/transactionrow-sequence (nth transactions middle))]
        (if (<= candidate sequence)
          (recur (inc middle) high)
          (recur low middle))))))

(defn operation-range-bounds
  [store: t/TermStore
   lower-exclusive: Int
   upper-inclusive: Int] -> (Vec Int)
  (let [transactions: (Vec t/TransactionRow) (t/termstore-transactions store)
        operations: (Vec t/OperationRow) (t/termstore-operations store)
        start-transaction (first-transaction-after transactions lower-exclusive)
        end-transaction (first-transaction-after transactions upper-inclusive)
        start (if (>= start-transaction (count transactions))
                (count operations)
                (t/transactionrow-first-operation
                 (nth transactions start-transaction)))
        end (if (>= end-transaction (count transactions))
              (count operations)
              (t/transactionrow-first-operation
               (nth transactions end-transaction)))]
    [start end]))

(defn transaction-frames-between
  [store: t/TermStore
   lower-exclusive: Int
   upper-inclusive: Int] -> (Vec t/TransactionFrame)
  (let [transactions: (Vec t/TransactionRow) (t/termstore-transactions store)
        first (first-transaction-after transactions lower-exclusive)
        end (first-transaction-after transactions upper-inclusive)]
    (mapv
     (fn [row: t/TransactionRow] -> t/TransactionFrame
       (let [start (t/transactionrow-first-operation row)
             stop (+ start (t/transactionrow-operation-count row))]
         (t/->TransactionFrame
          (t/transactionrow-sequence row)
          (mapv
           (fn [operation: t/OperationRow] -> t/CommitOperation
             (t/->CommitOperation
              (t/operationrow-action operation)
              (resolve-triple-handle
               store (t/operationrow-triple-handle operation))))
           (subvec (t/termstore-operations store) start stop)))))
     (subvec transactions first end))))

(defn operation-postings [store: t/TermStore] -> (Map Int (Vec Int))
  (loop [position 0 postings: (Map Int (Vec Int)) {}]
    (if (>= position (count (t/termstore-operations store)))
      postings
      (let [handle
            (t/operationrow-triple-handle
             (nth (t/termstore-operations store) position))]
        (recur (inc position)
               (update postings handle
                       (fn [known: (U (Vec Int) Nil)] -> (Vec Int)
                         (conj (or known []) position))))))))

(defn- lower-bound-position
  [positions: (Vec Int)
   target: Int] -> Int
  (loop [low 0 high (count positions)]
    (if (>= low high)
      low
      (let [middle (quot (+ low high) 2)]
        (if (< (nth positions middle) target)
          (recur (inc middle) high)
          (recur low middle))))))

(defn- exact-occurrence-position
  [store: t/TermStore
   coordinate: Any] -> Int
  (if (not (t/occurrence-coordinate? coordinate))
    -1
    (let [transaction: t/Triple (t/triple-slot0 coordinate)
          space: String (t/triple-slot0 transaction)
          sequence: Int (t/triple-slot2 transaction)
          ordinal: Int (t/triple-slot2 coordinate)
          transactions: (Vec t/TransactionRow) (t/termstore-transactions store)
          position (first-transaction-after transactions (dec sequence))]
      (if (or (not (= space (t/termstore-space-id store)))
              (>= position (count transactions)))
        -1
        (let [row: t/TransactionRow (nth transactions position)]
          (if (and (= sequence (t/transactionrow-sequence row))
                   (< ordinal (t/transactionrow-operation-count row)))
            (+ (t/transactionrow-first-operation row) ordinal)
            -1))))))

(defn operation-candidate-positions
  [store: t/TermStore
   lower-exclusive: Int
   upper-inclusive: Int
   coordinate: Any
   proposition: Any
   postings: (Map Int (Vec Int))] -> (Vec Int)
  (let [bounds: (Vec Int)
        (operation-range-bounds store lower-exclusive upper-inclusive)
        start (nth bounds 0)
        end (nth bounds 1)
        exact (when (some? coordinate) (exact-occurrence-position store coordinate))
        proposition-handle
        (when (some? proposition) (known-term-handle store proposition))
        posted: (Vec Int)
        (if (some? proposition-handle) (get postings proposition-handle []) [])
        from (lower-bound-position posted start)
        until (lower-bound-position posted end)
        candidates
        (cond
          [(some? exact) (if (and (>= exact start) (< exact end)) [exact] [])]
          [(some? proposition)
           (if (some? proposition-handle) (subvec posted from until) [])]
          [:else (vec (range start end))])]
    (if (and (some? exact) (some? proposition))
      (filterv
       (fn [position: Int] -> Bool
         (= proposition-handle
            (t/operationrow-triple-handle
             (nth (t/termstore-operations store) position))))
       candidates)
      candidates)))

(defn occurrence-tuple-at
  [store: t/TermStore
   position: Int] -> (Vec Any)
  (let [event: t/Triple (event-at store position)]
    [(t/triple-slot0 event) (t/triple-slot1 event) (t/triple-slot2 event)]))

(defn operation-occurrences [ctx: (Atom t/TermStore)] -> (Vec t/Triple)
  (let [store: t/TermStore (deref ctx)]
    (loop [position 0 events: (Vec t/Triple) []]
      (if (>= position (count (t/termstore-operations store)))
        events
        (recur (inc position) (conj events (event-at store position)))))))

(defn withdrawal-triples [ctx: (Atom t/TermStore)] -> (Vec t/Triple)
  (let [store: t/TermStore (deref ctx)]
    (loop [position 0 withdrawals: (Vec t/Triple) []]
      (if (>= position (count (t/termstore-operations store)))
        withdrawals
        (let [target (nth (t/termstore-withdrawal-targets store) position)]
          (if (>= target 0)
            (recur (inc position)
                   (conj withdrawals
                         (t/withdrawal (occurrence-at store position)
                                       (occurrence-at store target))))
            (recur (inc position) withdrawals)))))))

(defn semantic-history [ctx: (Atom t/TermStore)] -> (Vec t/Triple)
  (let [store: t/TermStore (deref ctx)]
    (loop [position 0 history: (Vec t/Triple) []]
      (if (>= position (count (t/termstore-operations store)))
        history
        (let [with-event: (Vec t/Triple) (conj history (event-at store position))
              target (nth (t/termstore-withdrawal-targets store) position)]
          (if (>= target 0)
            (recur (inc position)
                   (conj with-event
                         (t/withdrawal (occurrence-at store position)
                                       (occurrence-at store target))))
            (recur (inc position) with-event)))))))

(defn live-occurrences [ctx: (Atom t/TermStore)] -> (Vec t/Triple)
  (let [store: t/TermStore (deref ctx)]
    (loop [position 0 live: (Vec t/Triple) []]
      (if (>= position (count (t/termstore-operations store)))
        live
        (if (nth (t/termstore-operation-live store) position)
          (recur (inc position) (conj live (event-at store position)))
          (recur (inc position) live))))))

(defn live-propositions [ctx: (Atom t/TermStore)] -> (Vec t/Triple)
  (let [store: t/TermStore (deref ctx)]
    (loop [position 0 live: (Vec t/Triple) []]
      (if (>= position (count (t/termstore-operations store)))
        live
        (let [row: t/OperationRow (nth (t/termstore-operations store) position)]
          (if (nth (t/termstore-operation-live store) position)
            (recur (inc position)
                   (conj live
                         (resolve-triple-handle store
                                                (t/operationrow-triple-handle row))))
            (recur (inc position) live)))))))

(defn dump-term-store [ctx: (Atom t/TermStore)] -> t/TermStoreDump
  (let [store: t/TermStore (deref ctx)]
    (t/->TermStoreDump
     term-store-dump-version
     (t/termstore-space-id store)
     (t/termstore-next-sequence store)
     (t/termstore-atoms store)
     (t/termstore-triples store)
     (t/termstore-transactions store)
     (t/termstore-operations store))))

(defn- valid-prior-handle?
  [atom-count: Int
   triple-position: Int
   handle: Int] -> Bool
  (and (>= handle 0)
       (if (atom-handle? handle)
         (< (handle-position handle) atom-count)
         (< (handle-position handle) triple-position))))

(defn- valid-triple-rows?
  [atom-count: Int
   rows: (Vec t/TripleRow)] -> Bool
  (loop [position 0]
    (if (>= position (count rows))
      true
      (let [row: t/TripleRow (nth rows position)]
        (if (and (valid-prior-handle? atom-count position (t/triplerow-slot0 row))
                 (and (valid-prior-handle? atom-count position (t/triplerow-slot1 row))
                      (valid-prior-handle? atom-count position (t/triplerow-slot2 row))))
          (recur (inc position))
          false)))))

(defn- valid-dump-operation?
  [triple-count: Int
   sequence: Int
   ordinal: Int
   row: t/OperationRow] -> Bool
  (let [handle (t/operationrow-triple-handle row)]
    (and (= sequence (t/operationrow-tx-sequence row))
         (and (= ordinal (t/operationrow-ordinal row))
              (and (or (= t/assert-action (t/operationrow-action row))
                       (= t/retract-action (t/operationrow-action row)))
                   (and (>= handle 0)
                        (and (not (atom-handle? handle))
                             (< (handle-position handle) triple-count))))))))

(defn- valid-operation-slice?
  [operations: (Vec t/OperationRow)
   triple-count: Int
   sequence: Int
   first-operation: Int
   operation-count: Int] -> Bool
  (loop [ordinal 0]
    (if (>= ordinal operation-count)
      true
      (if (valid-dump-operation?
           triple-count sequence ordinal (nth operations (+ first-operation ordinal)))
        (recur (inc ordinal))
        false))))

(defn- valid-history-rows?
  [transactions: (Vec t/TransactionRow)
   operations: (Vec t/OperationRow)
   triple-count: Int
   next-sequence-value: Int] -> Bool
  (loop [transaction-position 0 operation-position 0 previous-sequence -1]
    (if (>= transaction-position (count transactions))
      (and (= operation-position (count operations))
           (if (< previous-sequence 0)
             (= next-sequence-value 1)
             (and (> next-sequence-value 0)
                  (= (dec next-sequence-value) previous-sequence))))
      (let [row: t/TransactionRow (nth transactions transaction-position)
            sequence (t/transactionrow-sequence row)
            first-operation (t/transactionrow-first-operation row)
            operation-count-value (t/transactionrow-operation-count row)]
        (if (and (> sequence previous-sequence)
                 (and (= first-operation operation-position)
                      (and (pos? operation-count-value)
                           (and (<= operation-count-value
                                    (- (count operations) first-operation))
                                (valid-operation-slice?
                                 operations triple-count sequence first-operation
                                 operation-count-value)))))
          (recur (inc transaction-position)
                 (+ operation-position operation-count-value)
                 sequence)
          false)))))

(defn- transaction-frames-ok [frames: (Vec t/TransactionFrame)] -> TransactionFramesResult
  (->TransactionFramesResult true frames nil nil))

(defn- transaction-frames-error
  [code: Keyword
   message: String] -> TransactionFramesResult
  (->TransactionFramesResult false empty-transaction-frames code message))

(defn- operation-handle-error [store: t/TermStore] -> TransactionFramesResult?
  (let [atoms: (Vec t/AtomRow) (t/termstore-atoms store)
        triples: (Vec t/TripleRow) (t/termstore-triples store)
        operations: (Vec t/OperationRow) (t/termstore-operations store)]
    (loop [position 0]
      (if (>= position (count operations))
        nil
        (let [handle (t/operationrow-triple-handle (nth operations position))
              handle-position-value (handle-position handle)]
          (cond
            [(< handle 0)
             (transaction-frames-error
              :invalid-term-handle
              "fram: term handle does not resolve")]
            [(atom-handle? handle)
             (if (< handle-position-value (count atoms))
               (transaction-frames-error
                :invalid-operation-handle
                "fram: operation handle does not resolve to Triple")
               (transaction-frames-error
                :invalid-term-handle
                "fram: term handle does not resolve"))]
            [(>= handle-position-value (count triples))
             (transaction-frames-error
              :invalid-term-handle
              "fram: term handle does not resolve")]
            [:else (recur (inc position))]))))))

(defn- valid-atom-rows? [rows: (Vec t/AtomRow)] -> Bool
  (loop [position 0]
    (if (>= position (count rows))
      true
      (if (valid-atom-row? (nth rows position))
        (recur (inc position))
        false))))

(defn- history-sequence-error [transactions: (Vec t/TransactionRow)] -> TransactionFramesResult?
  (loop [position 0 previous-sequence 0]
    (if (>= position (count transactions))
      nil
      (let [sequence (t/transactionrow-sequence (nth transactions position))]
        (cond
          [(< sequence 0)
           (transaction-frames-error
            :invalid-transaction-frame
            "fram: invalid transaction frame")]
          [(<= sequence previous-sequence)
           (transaction-frames-error
            :nonmonotonic-transaction-sequence
            "fram: transaction sequence must advance within its space")]
          [:else (recur (inc position) sequence)])))))

(defn- resolve-valid-handle
  [store: t/TermStore
   handle: Int] -> Any
  (let [position (handle-position handle)]
    (if (atom-handle? handle)
      (atom-row-value (nth (t/termstore-atoms store) position))
      (let [row: t/TripleRow (nth (t/termstore-triples store) position)]
        (t/->Triple
         (resolve-valid-handle store (t/triplerow-slot0 row))
         (resolve-valid-handle store (t/triplerow-slot1 row))
         (resolve-valid-handle store (t/triplerow-slot2 row)))))))

(defn- resolve-valid-triple-handle
  [store: t/TermStore
   handle: Int] -> t/Triple
  (let [row: t/TripleRow
        (nth (t/termstore-triples store) (handle-position handle))]
    (t/->Triple
     (resolve-valid-handle store (t/triplerow-slot0 row))
     (resolve-valid-handle store (t/triplerow-slot1 row))
     (resolve-valid-handle store (t/triplerow-slot2 row)))))

(defn- valid-transaction-frame-at
  [store: t/TermStore
   transaction-position: Int] -> t/TransactionFrame
  (let [row: t/TransactionRow
        (nth (t/termstore-transactions store) transaction-position)
        start (t/transactionrow-first-operation row)
        stop (+ start (t/transactionrow-operation-count row))
        operations: (Vec t/CommitOperation)
        (loop [position start current: (Vec t/CommitOperation) empty-commit-operations]
          (if (>= position stop)
            current
            (let [operation: t/OperationRow
                  (nth (t/termstore-operations store) position)]
              (recur
               (inc position)
               (conj
                current
                (t/->CommitOperation
                 (t/operationrow-action operation)
                 (resolve-valid-triple-handle
                  store (t/operationrow-triple-handle operation))))))))]
    (t/->TransactionFrame (t/transactionrow-sequence row) operations)))

(defn- valid-transaction-frames-between
  [store: t/TermStore
   lower-exclusive: Int
   upper-inclusive: Int] -> (Vec t/TransactionFrame)
  (let [transactions: (Vec t/TransactionRow) (t/termstore-transactions store)
        first (first-transaction-after transactions lower-exclusive)
        end (first-transaction-after transactions upper-inclusive)]
    (loop [position first frames: (Vec t/TransactionFrame) empty-transaction-frames]
      (if (>= position end)
        frames
        (recur (inc position)
               (conj frames (valid-transaction-frame-at store position)))))))

(defn transaction-frames-between-result
  [store: t/TermStore
   lower-exclusive: Int
   upper-inclusive: Int] -> TransactionFramesResult
  (let [atoms: (Vec t/AtomRow) (t/termstore-atoms store)
        triples: (Vec t/TripleRow) (t/termstore-triples store)
        transactions: (Vec t/TransactionRow) (t/termstore-transactions store)
        operations: (Vec t/OperationRow) (t/termstore-operations store)]
    (cond
      [(> lower-exclusive upper-inclusive)
       (transaction-frames-error
        :invalid-transaction-frame
        "fram: transaction frame range is invalid")]
      [(not (valid-space-id? (t/termstore-space-id store)))
       (transaction-frames-error
        :invalid-space-id
        "fram: TermStore requires a non-empty SpaceId")]
      [(< (t/termstore-next-sequence store) 1)
       (transaction-frames-error
        :invalid-transaction-frame
        "fram: invalid transaction frame")]
      [:else
       (let [handle-error: TransactionFramesResult?
             (operation-handle-error store)]
         (if (some? handle-error)
           handle-error
           (if (not (valid-atom-rows? atoms))
             (transaction-frames-error
              :invalid-term
              "fram: triple contains a value outside Term")
             (if (not (valid-triple-rows? (count atoms) triples))
               (transaction-frames-error
                :invalid-term-handle
                "fram: term handle does not resolve")
               (let [sequence-error: TransactionFramesResult?
                     (history-sequence-error transactions)]
                 (if (some? sequence-error)
                   sequence-error
                   (if (not (valid-history-rows?
                             transactions operations (count triples)
                             (t/termstore-next-sequence store)))
                     (transaction-frames-error
                      :invalid-transaction-frame
                      "fram: invalid transaction frame")
                     (transaction-frames-ok
                      (valid-transaction-frames-between
                       store lower-exclusive upper-inclusive)))))))))])))

(defn- rebuild-operation-state [store: t/TermStore] -> t/TermStore
  (let [base: t/TermStore
        (assoc store
               :operation-live empty-bools
               :withdrawal-targets empty-ids
               :active-buckets empty-active-buckets
               :active-slots (fresh-term-slots initial-slots))]
    (loop [current: t/TermStore base position 0]
      (if (>= position (count (t/termstore-operations current)))
        current
        (recur
         (apply-operation-state
          current position (nth (t/termstore-operations current) position))
         (inc position))))))

(defn- term-store-load-ok [] -> TermStoreLoadResult
  (->TermStoreLoadResult true nil nil))

(defn- term-store-load-error
  [code: Keyword
   message: String] -> TermStoreLoadResult
  (->TermStoreLoadResult false code message))

(defn load-term-store-result!
  [ctx: (Atom t/TermStore)
   data: Any] -> TermStoreLoadResult
  (if (not (t/term-store-dump? data))
    (term-store-load-error
     :migration-required
     "fram: legacy store dump requires one-shot migration")
    (if (not (= term-store-dump-version (t/termstoredump-version data)))
      (term-store-load-error
       :migration-required
       "fram: legacy TermStore dump requires one-shot migration")
      (let [atoms: (Vec t/AtomRow) (t/termstoredump-atoms data)
            rows: (Vec t/TripleRow) (t/termstoredump-triples data)
            transactions: (Vec t/TransactionRow) (t/termstoredump-transactions data)
            operations: (Vec t/OperationRow) (t/termstoredump-operations data)
            dump-space: String (t/termstoredump-space-id data)
            next-sequence-value (t/termstoredump-next-sequence data)]
        (if (not (and (valid-space-id? dump-space)
                      (and (>= next-sequence-value 1)
                           (and (every? (fn [row: t/AtomRow] -> Bool
                                         (valid-atom-row? row))
                                       atoms)
                                (and (valid-triple-rows? (count atoms) rows)
                                     (valid-history-rows?
                                      transactions operations (count rows)
                                      next-sequence-value))))))
          (term-store-load-error
           :invalid-term-store-dump
           "fram: invalid TermStore dump")
          (if (not (= (space-id ctx) dump-space))
            (term-store-load-error
             :space-mismatch
             "fram: TermStore dump belongs to a different space")
            (let [loaded: t/TermStore
                  (t/->TermStore
                   dump-space next-sequence-value atoms rows transactions operations
                   empty-bools empty-ids empty-active-buckets
                   (build-atom-term-slots atoms (term-slots-width-for (count atoms)))
                   (build-triple-term-slots rows (term-slots-width-for (count rows)))
                   (fresh-term-slots initial-slots))]
              (reset! ctx (rebuild-operation-state loaded))
              (term-store-load-ok))))))))

(defn load-term-store!
  [ctx: (Atom t/TermStore)
   data: Any] -> (Atom t/TermStore)
  (let [result: TermStoreLoadResult (load-term-store-result! ctx data)]
    (if (termstoreloadresult-ok result)
      ctx
      (let [code (termstoreloadresult-code result)
            message (termstoreloadresult-message result)]
        (throw
         (ex-info
          (if message message "fram: TermStore load failed")
          {:type (if code code :invalid-term-store-dump)}))))))
