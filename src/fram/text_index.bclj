#lang beagle/clj

(ns fram.text-index)

(define-mode strict)

(require fram.types :as t)

(declare-extern java.util.Locale/ROOT Any)

(def text-index-max-bytes: Int (* 64 1024 1024))

(defrecord TextCandidateSource
  [rows: (Vec t/Triple)
   postings: (Map String (Vec Int))
   bytes: Int])

(defn source-weight [source: TextCandidateSource] -> Int
  (textcandidatesource-bytes source))

;; One fused pass: the match sequence, the case fold, and the dedup each used to
;; allocate their own collection per row, which the corpus build pays 50k times.
(defn- token-set [value: String] -> (Set String)
  (persistent!
   (reduce (fn
             [folded: Any
              token: String] -> Any
             (conj! folded (.toLowerCase token java.util.Locale/ROOT)))
           (transient #{}) (re-seq #"[\p{L}\p{Nd}]+" value))))

(defn tokenize [value: String] -> (Vec String)
  (vec (sort (vec (token-set value)))))

(defn text-needle-valid? [needle: Any] -> Bool
  (and (string? needle) (not (empty? (tokenize needle)))))

(defn- postings-weight [postings: (Map String (Vec Int))] -> Int
  (reduce-kv (fn
               [total: Int
                token: String
                handles: (Vec Int)] -> Int
               (+ total 84 (* 4 (count token)) (* 42 (count handles))))
             0 postings))

(defn- index-limit
  [weight: Int
   maximum: Int] -> Nil
  (if (> weight maximum)
    (throw (ex-info "text index exceeds the snapshot cache budget" {:type :query-text-index-limit :fram/code :query-text-index-limit :bytes weight :maximum maximum}))
    nil))

(defn build-source
  [propositions: (Vec t/Triple)
   maximum: Int] -> TextCandidateSource
  (let [rows: (Vec t/Triple) propositions
        row-count: Int (count rows)
        empty-postings: (Map String (Vec Int)) {}
        ;; One transient posting map for the whole corpus: the per-row persistent
        ;; assoc dominated the build at corpus scale.
        postings: (Map String (Vec Int))
        (persistent!
         (loop [handle 0 current: Any (transient empty-postings)]
           (if (>= handle row-count)
             current
             (let [value: Any (t/triple-slot2 (nth rows handle))]
               (recur (inc handle)
                      (if (string? value)
                        (reduce (fn
                                  [index: Any
                                   token: String] -> Any
                                  (assoc! index token
                                          (conj (get index token []) handle)))
                                current (token-set value))
                        current))))))
        weight: Int (+ 112 (* 14 row-count) (postings-weight postings))]
    (index-limit weight maximum)
    (->TextCandidateSource rows postings weight)))

(defn- needle-error [message: String] -> (Vec String)
  (throw (ex-info message {:type :fram-query-abort :code :query-text-invalid-needle})))

(defn- needle-tokens [needle: Any] -> (Vec String)
  (if (string? needle)
    (let [tokens: (Vec String) (tokenize needle)]
      (if (empty? tokens)
        (needle-error "text-match needle must contain at least one word token")
        tokens))
    (needle-error "text-match needle must be a string")))

(defn- shortest-posting [posting-vectors: (Vec (Vec Int))] -> (Vec Int)
  (let [empty-handles: (Vec Int) []]
    (if (empty? posting-vectors)
      empty-handles
      (loop [position 1
             best: (Vec Int) (nth posting-vectors 0)]
        (if (>= position (count posting-vectors))
          best
          (let [candidate: (Vec Int) (nth posting-vectors position)]
            (recur (inc position)
              (if (< (count candidate) (count best)) candidate best))))))))

(defn indexed-handles
  [source: TextCandidateSource
   needle: Any] -> (Vec Int)
  (let [tokens: (Vec String) (needle-tokens needle) postings: (Map String (Vec Int)) (textcandidatesource-postings source) posting-vectors: (Vec (Vec Int)) (mapv (fn [token: String] -> (Vec Int) (get postings token [])) tokens) seed: (Vec Int) (shortest-posting posting-vectors)]
    (if (or (empty? seed) (= 1 (count posting-vectors)))
      seed
      (let [posting-sets: (Vec (Set Int)) (mapv (fn [handles: (Vec Int)] -> (Set Int) (set handles)) posting-vectors)]
        (filterv (fn [handle: Int] -> Bool (every? (fn [handles: (Set Int)] -> Bool (contains? handles handle)) posting-sets))
          seed)))))

(defn scan-handles
  [source: TextCandidateSource
   needle: Any] -> (Vec Int)
  (let [tokens: (Vec String) (needle-tokens needle) rows: (Vec t/Triple) (textcandidatesource-rows source)]
    (loop [handle 0 matches: (Vec Int) []]
      (if (>= handle (count rows))
        matches
        (let [value: Any (t/triple-slot2 (nth rows handle)) matched: Bool (if (string? value) (let [haystack: (Set String) (token-set value)] (every? (fn [token: String] -> Bool (contains? haystack token)) tokens)) false)]
          (recur (inc handle) (if matched (conj matches handle) matches)))))))

(defn- rows-for-handles
  [source: TextCandidateSource
   needle: Any
   handles: (Vec Int)] -> (Vec (Vec Any))
  (let [rows: (Vec t/Triple) (textcandidatesource-rows source)]
    (mapv (fn [handle: Int] -> (Vec Any) (let [proposition: t/Triple (nth rows handle)] [(t/triple-slot0 proposition) (t/triple-slot1 proposition) needle]))
      handles)))

(defn indexed-rows
  [source: TextCandidateSource
   needle: Any] -> (Vec (Vec Any))
  (rows-for-handles source needle (indexed-handles source needle)))

(defn scan-rows
  [source: TextCandidateSource
   needle: Any] -> (Vec (Vec Any))
  (rows-for-handles source needle (scan-handles source needle)))
