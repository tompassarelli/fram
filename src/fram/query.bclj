#lang beagle/clj
;; Structured recursive queries over slot-addressable Triples.  Wire syntaxes
;; are adapters: execution consumes QueryPlan records, never EDN-shaped maps.
(ns fram.query)
(define-mode strict)
(require fram.datalog :as d)
(require fram.types :as t)
(require clojure.string :as str)

(defrecord QueryPlan [find: String strata: (Vec (Vec d/Rule))])
(defrecord Projection [edb: d/Db])

(def ^:dynamic *query-control*: Any nil)

(def base-rel-arities: (Map String Int)
  {d/triple-relation 3 d/occurrence-relation 3})
(def base-relations: (Set String) #{d/triple-relation d/occurrence-relation})

(defn query-plan? [value: Any] -> Bool (instance? QueryPlan value))
(defn projection? [value: Any] -> Bool (instance? Projection value))

(defn- variable-form? [value: Any] -> Bool
  (and (map? value)
       (and (= 1 (count value))
            (and (contains? value :var)
                 (and (string? (:var value))
                      (pos? (count (:var value))))))))

(defn- query-term-form? [value: Any] -> Bool
  (or (variable-form? value) (t/term? value)))

(defn- vars-of [arguments: (Vec Any)] -> (Set String)
  (reduce (fn [acc: (Set String) value: Any] -> (Set String)
            (if (variable-form? value) (conj acc (:var value)) acc))
          #{} arguments))

(defn- set-union [left: (Set String) right: (Set String)] -> (Set String)
  (reduce (fn [acc: (Set String) value: String] -> (Set String)
            (conj acc value))
          left right))

(defn- all-vectors? [values: (Vec Any)] -> Bool
  (loop [remaining values]
    (if (empty? remaining)
      true
      (if (vector? (first remaining))
        (recur (rest remaining))
        false))))

(defn- raw-strata [query: Any] -> Any
  (cond
    [(not (map? query)) nil]
    [(and (contains? query :rules) (not (contains? query :strata)))
     (if (vector? (:rules query)) [(:rules query)] nil)]
    [(and (contains? query :strata) (not (contains? query :rules)))
     (if (and (vector? (:strata query)) (all-vectors? (:strata query)))
       (:strata query)
       nil)]
    [:else nil]))

(defn- raw-rules [strata: Any] -> (Vec Any)
  (if (vector? strata)
    (reduce (fn [acc: (Vec Any) stratum: Any] -> (Vec Any)
              (if (vector? stratum) (vec (concat acc stratum)) acc))
            [] strata)
    []))

(defn- raw-head-relation [rule: Any] -> (U String Nil)
  (if (and (map? rule)
           (and (map? (:head rule)) (string? (:rel (:head rule)))))
    (:rel (:head rule))
    nil))

(defn- derived-relations [rules: (Vec Any)] -> (Set String)
  (reduce (fn [acc: (Set String) rule: Any] -> (Set String)
            (let [relation (raw-head-relation rule)]
              (if (some? relation) (conj acc relation) acc)))
          #{} rules))

(defn- term-errors [arguments: Any context: String] -> (Vec String)
  (if (not (vector? arguments))
    [(str context " arguments must be a vector")]
    (reduce (fn [acc: (Vec String) value: Any] -> (Vec String)
              (if (query-term-form? value)
                acc
                (conj acc (str context " contains a value outside query Term: "
                               (pr-str value)))))
            [] arguments)))

(defn- unbound-errors
  [arguments: Any bound: (Set String) context: String] -> (Vec String)
  (if (not (vector? arguments))
    []
    (reduce (fn [acc: (Vec String) name: String] -> (Vec String)
              (if (contains? bound name)
                acc
                (conj acc (str context " variable '" name "' must be bound earlier"))))
            [] (vars-of arguments))))

(defn- relation-literal-errors
  [literal: Any known: (Set String) bound: (Set String)] -> (Vec String)
  (let [relation (:rel literal)
        arguments (:args literal)
        negated (:neg literal)
        relation-errors
        (cond
          [(not (string? relation)) ["literal :rel must be a string"]]
          [(not (contains? known relation))
           [(str "unknown relation '" relation "'")]]
          [:else []])
        arity-errors
        (if (and (string? relation)
                 (and (contains? base-rel-arities relation)
                      (and (vector? arguments)
                           (not (= (count arguments)
                                   (get base-rel-arities relation))))))
          [(str "base relation '" relation "' takes three arguments")]
          [])
        negation-errors
        (if (or (nil? negated) (or (= false negated) (= true negated)))
          [] ["literal :neg must be boolean when present"])
        range-errors
        (if (= true negated)
          (unbound-errors arguments bound "negated literal")
          [])]
    (vec (concat relation-errors
                 (concat arity-errors
                         (concat negation-errors
                                 (concat (term-errors arguments "literal")
                                         range-errors)))))))

(defn- literal-errors
  [literal: Any known: (Set String) bound: (Set String)] -> (Vec String)
  (if (not (map? literal))
    ["body literal must be a map"]
    (cond
      [(or (contains? literal :pred) (contains? literal :fn))
       ["query core accepts relation literals only"]]
      [:else (relation-literal-errors literal known bound)])))

(defn- literal-bindings [literal: Any] -> (Set String)
  (cond
    [(not (map? literal)) #{}]
    [(or (contains? literal :pred) (contains? literal :fn)) #{}]
    [(= true (:neg literal)) #{}]
    [(vector? (:args literal)) (vars-of (:args literal))]
    [:else #{}]))

(defn- body-errors [body: Any known: (Set String)] -> (Vec String)
  (if (not (vector? body))
    ["rule :body must be a vector"]
    (loop [remaining body bound: (Set String) #{} errors: (Vec String) []]
      (if (empty? remaining)
        errors
        (let [literal (first remaining)]
          (recur (rest remaining)
                 (set-union bound (literal-bindings literal))
                 (vec (concat errors (literal-errors literal known bound)))))))))

(defn- rule-errors [rule: Any known: (Set String)] -> (Vec String)
  (if (not (map? rule))
    ["rule must be a map"]
    (let [head (:head rule)
          body (:body rule)
          head-valid (and (map? head)
                          (and (string? (:rel head)) (vector? (:args head))))
          head-errors
          (if head-valid
            (vec (concat
                  (if (contains? base-relations (:rel head))
                    [(str "rule head cannot redefine base relation '" (:rel head) "'")]
                    [])
                  (term-errors (:args head) "rule head")))
            ["rule :head must be {:rel <string> :args <vector>}"])
          body-error-values (body-errors body known)
          bound
          (if (vector? body)
            (reduce (fn [acc: (Set String) literal: Any] -> (Set String)
                      (set-union acc (literal-bindings literal)))
                    #{} body)
            #{})
          head-range-errors
          (if head-valid
            (unbound-errors (:args head) bound "rule head")
            [])]
      (vec (concat head-errors (concat body-error-values head-range-errors))))))

(defn- arity-errors [rules: (Vec Any)] -> (Vec String)
  (let [arities
        (reduce (fn [acc: (Map String Int) rule: Any] -> (Map String Int)
                  (if (and (map? rule)
                           (and (map? (:head rule))
                                (and (string? (:rel (:head rule)))
                                     (vector? (:args (:head rule))))))
                    (let [relation (:rel (:head rule))
                          arity (count (:args (:head rule)))]
                      (if (contains? acc relation)
                        acc
                        (assoc acc relation arity)))
                    acc))
                {} rules)]
    (reduce
     (fn [acc: (Vec String) rule: Any] -> (Vec String)
       (if (and (map? rule)
                (and (map? (:head rule))
                     (and (string? (:rel (:head rule)))
                          (vector? (:args (:head rule))))))
         (let [relation (:rel (:head rule))
               expected (get arities relation)
               actual (count (:args (:head rule)))]
           (if (= expected actual)
             acc
             (conj acc (str "relation '" relation "' has inconsistent arity"))))
         acc))
     [] rules)))

(defn- top-errors [query: Any] -> (Vec String)
  (cond
    [(not (map? query)) ["query must be a map"]]
    [(not (string? (:find query))) [":find must name a derived relation"]]
    [(= (contains? query :rules) (contains? query :strata))
     ["query must provide exactly one of :rules or :strata"]]
    [(nil? (raw-strata query))
     [":rules must be a vector or :strata a vector of rule vectors"]]
    [(empty? (raw-rules (raw-strata query))) ["query must provide at least one rule"]]
    [:else []]))

(defn- structural-errors [query: Any] -> (Vec String)
  (let [initial (top-errors query)]
    (if (not (empty? initial))
      initial
      (let [strata (raw-strata query)
            rules (raw-rules strata)
            derived (derived-relations rules)
            known (set-union base-relations derived)
            find-errors
            (cond
              [(contains? base-relations (:find query))
               [":find must name a derived relation"]]
              [(not (contains? derived (:find query)))
               [(str "unknown :find relation '" (:find query) "'")]]
              [:else []])
            rule-error-values
            (reduce (fn [acc: (Vec String) rule: Any] -> (Vec String)
                      (vec (concat acc (rule-errors rule known))))
                    [] rules)]
        (vec (concat find-errors (concat rule-error-values (arity-errors rules))))))))

(defn- compile-term [value: Any] -> d/QueryTerm
  (if (variable-form? value)
    (d/variable (:var value))
    (d/constant value)))

(defn- compile-terms [values: (Vec Any)] -> (Vec d/QueryTerm)
  (mapv (fn [value: Any] -> d/QueryTerm (compile-term value)) values))

(defn- compile-literal [literal: Any] -> d/Literal
  (if (= true (:neg literal))
    (d/negated-literal (:rel literal) (compile-terms (:args literal)))
    (d/relation-literal (:rel literal) (compile-terms (:args literal)))))

(defn- compile-rule [rule: Any] -> d/Rule
  (d/rule (:rel (:head rule))
          (compile-terms (:args (:head rule)))
          (mapv (fn [literal: Any] -> d/Literal (compile-literal literal))
                (:body rule))))

(defn- compile-strata [strata: (Vec (Vec Any))] -> (Vec (Vec d/Rule))
  (mapv (fn [stratum: (Vec Any)] -> (Vec d/Rule)
          (mapv (fn [rule: Any] -> d/Rule (compile-rule rule)) stratum))
        strata))

(defn- typed-forward-errors [strata: (Vec (Vec d/Rule))] -> (Vec String)
  (let [all-heads
        (reduce
         (fn [acc: (Set String) stratum: (Vec d/Rule)] -> (Set String)
           (reduce (fn [rels: (Set String) rule: d/Rule] -> (Set String)
                     (conj rels (d/rule-head-relation rule)))
                   acc stratum))
         #{} strata)]
    (loop [remaining strata lower: (Set String) base-relations errors: (Vec String) []]
      (if (empty? remaining)
        errors
        (let [stratum (first remaining)
              current
              (reduce (fn [acc: (Set String) rule: d/Rule] -> (Set String)
                        (conj acc (d/rule-head-relation rule)))
                      #{} stratum)
              available (set-union lower current)
              errors2
              (reduce
               (fn [acc: (Vec String) rule: d/Rule] -> (Vec String)
                 (reduce
                  (fn [inner: (Vec String) literal: d/Literal] -> (Vec String)
                    (let [relation (d/literal-relation literal)]
                      (if (and (not (d/literal-negated literal))
                                    (and (contains? all-heads relation)
                                         (not (contains? available relation))))
                        (conj inner (str "relation '" relation
                                         "' is defined only in a later stratum"))
                        inner)))
                  acc (d/rule-body rule)))
               errors stratum)]
          (recur (rest remaining) (set-union lower current) errors2))))))

;; Returns {:ok QueryPlan} or {:error [message ...]}.  The returned record is the
;; only executable query representation; the input map is boundary syntax.
(defn compile-query [query: Any] -> Any
  (let [errors (structural-errors query)]
    (if (not (empty? errors))
      {:error errors}
      (let [strata (compile-strata (raw-strata query))
            semantic-errors
            (vec (concat (d/strata-violations strata)
                         (typed-forward-errors strata)))]
        (if (empty? semantic-errors)
          {:ok (->QueryPlan (:find query) strata)}
          {:error semantic-errors})))))

(defn validate [query: Any] -> (Vec String)
  (let [compiled (compile-query query)]
    (if (contains? compiled :error) (:error compiled) [])))

(defn project [propositions: (Vec t/Triple)] -> Projection
  (->Projection (d/edb propositions)))

(defn project-with-occurrences
  [propositions: (Vec t/Triple) occurrences: (Vec t/Triple)] -> Projection
  (->Projection (d/edb-with-occurrences propositions occurrences)))

(def max-results: Int
  (let [raw: Any (System/getenv "FRAM_MAX_RESULTS")
        parsed: (U Int Nil)
        (if (and (some? raw) (not (= raw ""))) (parse-long raw) nil)]
    (if (and (some? parsed) (> parsed 0)) parsed 100000)))

(defn- evaluate-plan [projection: Projection plan: QueryPlan] -> d/Db
  (binding [d/*query-control* *query-control*]
    (d/run-strata-db (projection-edb projection) (queryplan-strata plan))))

(defn run-plan-projected [projection: Projection plan: QueryPlan] -> Any
  (let [db (evaluate-plan projection plan)
        relation (get db (queryplan-find plan) #{})
        count-value (count relation)]
    (if (> count-value max-results)
      {:error [(str "result set too large: '" (queryplan-find plan)
                    "' has " count-value " tuples, over the FRAM_MAX_RESULTS cap of "
                    max-results)]
       :over-limit count-value
       :max max-results}
      {:ok (vec relation)})))

(defn run-projected [projection: Projection query: Any] -> Any
  (let [compiled (compile-query query)]
    (if (contains? compiled :error)
      compiled
      (run-plan-projected projection (:ok compiled)))))

(defn run-plan [propositions: (Vec t/Triple) plan: QueryPlan] -> Any
  (run-plan-projected (project propositions) plan))

(defn run [propositions: (Vec t/Triple) query: Any] -> Any
  (run-projected (project propositions) query))

(def max-page-limit: Int 4096)
(def max-page-wire-bytes: Int 1048576)
(def max-page-payload-bytes: Int (- max-page-wire-bytes 512))
(def max-page-cursor-bytes: Int 524288)
(def page-cursor-prefix: String "fram-query-page-v2.")

(defn- utf8-size [value: String] -> Int
  (count (.getBytes value "UTF-8")))

(defn- row-key [row: d/Tuple] -> String (pr-str row))

(defn- encode-cursor-key [key: String] -> String
  (str page-cursor-prefix key))

(defn page-cursor [row: d/Tuple] -> String
  (encode-cursor-key (row-key row)))

(defn decode-page-cursor [cursor: Any] -> Any
  (if (not (string? cursor))
    {:error "query page :after must be a cursor string or nil"}
    (if (or (> (utf8-size cursor) max-page-cursor-bytes)
            (or (not (str/starts-with? cursor page-cursor-prefix))
                (= cursor page-cursor-prefix)))
      {:error "query page :after is not a valid canonical Fram query cursor"}
      (try
        (let [decoded (subs cursor (count page-cursor-prefix))]
          {:ok decoded})
        (catch Exception _
          {:error "query page :after is not a valid canonical Fram query cursor"})))))

(defn- page-envelope [window: (Vec d/Tuple) count-value: Int] -> Any
  (let [rows (subvec window 0 count-value)
        more (> (count window) count-value)
        next (if (and more (> count-value 0))
               (page-cursor (nth rows (- count-value 1)))
               nil)]
    {:ok rows :next next :more more}))

(defn- envelope-size
  [rows-size: Int next: Any more: Bool] -> Int
  (+ (utf8-size "{:ok ") rows-size (utf8-size " :next ")
     (utf8-size (pr-str next)) (utf8-size " :more ")
     (utf8-size (pr-str more)) (utf8-size "}")))

(defn- fitting-prefix [window: (Vec d/Tuple) wanted: Int] -> Int
  (loop [index 0 rows-size 2 best 0]
    (if (>= index wanted)
      best
      (let [row (nth window index)
            count-value (+ index 1)
            rows-size2 (+ rows-size (if (= index 0) 0 1)
                          (utf8-size (pr-str row)))
            more (> (count window) count-value)
            next (if more (page-cursor row) nil)
            fits (and (or (nil? next)
                          (<= (utf8-size next) max-page-cursor-bytes))
                      (<= (envelope-size rows-size2 next more)
                          max-page-payload-bytes))]
        (recur count-value rows-size2 (if fits count-value best))))))

(defn run-page-plan-projected
  [projection: Projection plan: QueryPlan limit: Any after: Any] -> Any
  (cond
    [(or (not (integer? limit)) (or (< limit 1) (> limit max-page-limit)))
     {:error [(str "query page :limit must be from 1 through " max-page-limit)]}]
    [(and (some? after) (not (string? after)))
     {:error ["query page :after must be a cursor string or nil"]}]
    [:else
     (let [decoded (if (some? after) (decode-page-cursor after) {:ok nil})]
       (if (contains? decoded :error)
         {:error [(:error decoded)]}
         (let [db (evaluate-plan projection plan)
               relation (get db (queryplan-find plan) #{})
               keyed
               (mapv (fn [row: d/Tuple] -> Any [(row-key row) row])
                     (vec relation))
               ordered (sort-by first keyed)
               after-key (:ok decoded)
               eligible
               (if (some? after-key)
                 (filter (fn [pair: Any] -> Bool
                           (pos? (compare (first pair) after-key)))
                         ordered)
                 ordered)
               window (mapv second (take (+ limit 1) eligible))
               wanted (min limit (count window))]
           (if (= wanted 0)
             (page-envelope window 0)
             (let [count-value (fitting-prefix window wanted)]
               (if (= count-value 0)
                 {:error ["query page contains a row too large for the bounded response"]
                  :max-bytes max-page-wire-bytes}
                 (page-envelope window count-value)))))))]))

(defn run-page-projected
  [projection: Projection query: Any limit: Any after: Any] -> Any
  (let [compiled (compile-query query)]
    (if (contains? compiled :error)
      compiled
      (run-page-plan-projected projection (:ok compiled) limit after))))

(defn run-page
  [propositions: (Vec t/Triple) query: Any limit: Any after: Any] -> Any
  (run-page-projected (project propositions) query limit after))
