#lang beagle/clj
;; Typed Datalog over homogeneous rows of recursive Fram Terms. Relation names
;; are query-local; the kernel assigns no role to slot0, slot1, or slot2.
(ns fram.datalog)
(define-mode strict)
(require fram.kernel :as kernel)
(require fram.types :as t)
(require fram.text-index :as text-index)
(require fram.text-search :as text-search)

;; Query syntax adapters compile to this IR. QueryTerm.value stays Any because
;; Beagle cannot consume a recursive Dyn through generic equality; constant and
;; edb enforce Term at the boundary, so there is still one semantic value model.
(defrecord QueryTerm
  [variable: String?
   value: Any])
(defrecord Literal
  [kind: Keyword
   relation: String
   arguments: (Vec QueryTerm)
   negated: Bool
   operator: Keyword
   binding: String])
(defrecord Rule
  [head-relation: String
   head-arguments: (Vec QueryTerm)
   body: (Vec Literal)])
(defrecord QueryControl
  [steps: Any
   cancelled: Any
   max-steps: Int
   deadline-ns: Int
   timeout-ms: Int])

(defalias Tuple (Vec Any))
(defalias Db (Map String (Set Tuple)))
(defalias Substitution (Map String Any))
(defalias HandleBucket (Map Any (Vec Int)))
(defalias PositionIndex (Map Int HandleBucket))
(defalias HandleTrie (Map Any Any))
(defalias SourceSelector [(Vec Any) -> (Vec Int)])
(defalias SourceResolver [Int -> Tuple])

;; Candidate handles are private positions in one immutable relation vector.
(defrecord CandidateSource
  [rows: (Vec Tuple)
   positions: PositionIndex
   spo: HandleTrie
   pos: HandleTrie
   osp: HandleTrie
   selector: SourceSelector?
   resolver: SourceResolver?])
(defrecord VirtualCandidateSource
  [indexed: [(Vec QueryTerm) Substitution -> (Vec Tuple)]
   scan: [(Vec QueryTerm) Substitution -> (Vec Tuple)]])
(defalias CandidateSourceValue (U CandidateSource VirtualCandidateSource))
(defalias CandidateSources (Map String CandidateSourceValue))

(def triple-relation: String "triple")
(def occurrence-relation: String "occurrence")
(def text-match-relation: String "text-match")
(def text-phrase-relation: String "text-phrase")
(def text-substring-relation: String "text-substring")
(def text-stem-relation: String "text-stem")
(def text-search-relation: String "text-search")
(def text-relations: (Set String)
  #{text-match-relation text-phrase-relation text-substring-relation
    text-stem-relation text-search-relation})
(def base-relations: (Set String)
  (conj text-relations triple-relation occurrence-relation))
(def comparison-operators: (Set Keyword) #{:eq :ne :lt :le :gt :ge})
(def subtract-operator: Keyword (keyword "-"))
(def builtin-operators: (Set Keyword)
  #{:+ subtract-operator :* :/ :mod})

(def ^:dynamic *query-control*: Any nil)

(defn query-control
  [max-steps: Int
   timeout-ms: Int] -> QueryControl
  (if (and (> max-steps 0) (>= timeout-ms 0))
    (->QueryControl (atom 0) (atom nil) max-steps
                    (+ (System/nanoTime) (* timeout-ms 1000000)) timeout-ms)
    (throw (ex-info "fram: query limits must be positive steps and non-negative milliseconds"
                    {:type :invalid-query-control}))))

(defn cancel-query!
  [control: QueryControl
   reason: Keyword] -> Nil
  (reset! (querycontrol-cancelled control) reason)
  nil)

(defn query-steps [control: QueryControl] -> Int
  (deref (querycontrol-steps control)))

(defn- query-check! [] -> Any
  (let [control *query-control*]
    (if (nil? control)
      nil
      (let [steps (swap! (querycontrol-steps control) inc)
            now (System/nanoTime)
            cancelled (deref (querycontrol-cancelled control))
            code (cond
                   [(some? cancelled) :query-cancelled]
                   [(> steps (querycontrol-max-steps control)) :query-work-limit]
                   [(>= now (querycontrol-deadline-ns control)) :query-time-limit]
                   [:else nil])]
        (if (nil? code)
          nil
          (throw (ex-info (str "query evaluation stopped: " (name code))
                          {:type :fram-query-abort
                           :code code
                           :reason cancelled
                           :steps steps
                           :max-steps (querycontrol-max-steps control)
                           :timeout-ms (querycontrol-timeout-ms control)})))))))

(defn variable [name: String] -> QueryTerm
  (if (pos? (count name))
    (->QueryTerm name nil)
    (throw (ex-info "fram: query variable name must be non-empty"
                    {:type :invalid-query-variable}))))

(defn constant [value: Any] -> QueryTerm
  (if (t/term? value)
    (->QueryTerm nil value)
    (throw (ex-info "fram: query constant must be a Term"
                    {:type :invalid-query-constant}))))

(defn query-term? [value: Any] -> Bool
  (and (instance? QueryTerm value)
       (if (some? (queryterm-variable value))
         (and (pos? (count (queryterm-variable value)))
              (nil? (queryterm-value value)))
         (t/term? (queryterm-value value)))))

(defn relation-literal
  [relation: String
   arguments: (Vec QueryTerm)] -> Literal
  (->Literal :relation relation arguments false :none ""))

(defn negated-literal
  [relation: String
   arguments: (Vec QueryTerm)] -> Literal
  (->Literal :relation relation arguments true :none ""))

(defn comparison-literal
  [operator: Keyword
   arguments: (Vec QueryTerm)] -> Literal
  (->Literal :comparison "" arguments false operator ""))

(defn builtin-literal
  [operator: Keyword
   arguments: (Vec QueryTerm)
   binding: String] -> Literal
  (->Literal :builtin "" arguments false operator binding))

(defn rule
  [head-relation: String
   head-arguments: (Vec QueryTerm)
   body: (Vec Literal)] -> Rule
  (->Rule head-relation head-arguments body))

(defn- triple-row [value: t/Triple] -> Tuple
  [(t/triple-slot0 value) (t/triple-slot1 value) (t/triple-slot2 value)])

(defn- rows [triples: (Vec t/Triple)] -> (Set Tuple)
  (reduce (fn
            [acc: (Set Tuple)
             value: t/Triple] -> (Set Tuple)
            (conj acc (triple-row value)))
          #{} triples))

;; Ordinary queries see live propositions only. History is a separate explicit
;; relation of (occurrence-coordinate, action, proposition) rows.
(defn edb [propositions: (Vec t/Triple)] -> Db
  {triple-relation (rows propositions)})

(defn edb-with-occurrences
  [propositions: (Vec t/Triple)
   occurrences: (Vec t/Triple)] -> Db
  (let [checked
        (reduce (fn
                  [acc: (Vec t/Triple)
                   value: t/Triple] -> (Vec t/Triple)
                  (if (kernel/operation-occurrence? value)
                    (conj acc value)
                    (throw (ex-info "fram: occurrence relation accepts only operation occurrences"
                                    {:type :invalid-operation-occurrence}))))
                [] occurrences)]
    {triple-relation (rows propositions)
     occurrence-relation (rows checked)}))

(defn- term-value
  [term: QueryTerm
   subst: Substitution] -> Any
  (let [name (queryterm-variable term)]
    (if (some? name) (get subst name) (queryterm-value term))))

(defn- unify
  [term: QueryTerm
   value: Any
   subst: Substitution] -> (U Substitution Nil)
  (let [name (queryterm-variable term)]
    (if (some? name)
      (if (contains? subst name)
        (if (= (get subst name) value) subst nil)
        (assoc subst name value))
      (if (= (queryterm-value term) value) subst nil))))

(defn- unify-arguments!
  [arguments: (Vec QueryTerm)
   tuple: Tuple
   subst: Substitution] -> (U Substitution Nil)
  (query-check!)
  (if (not (= (count arguments) (count tuple)))
    nil
    (loop [position 0 current: (U Substitution Nil) subst]
      (if (or (nil? current) (>= position (count arguments)))
        current
        (recur (+ position 1)
               (unify (nth arguments position)
                      (nth tuple position)
                      current))))))

(defn- ground
  [arguments: (Vec QueryTerm)
   subst: Substitution] -> Tuple
  (mapv (fn [term: QueryTerm] -> Any
          (let [value (term-value term subst)]
            (if (some? value)
              value
              (throw (ex-info "fram: unbound query variable reached evaluation"
                              {:type :unbound-query-variable})))))
        arguments))

(defn- integer-value [value: Any] -> (U Int Nil)
  (cond
    [(integer? value) value]
    [(string? value) (parse-long value)]
    [:else nil]))

(defn- numeric-value [value: Any] -> (U Double Nil)
  (cond
    [(integer? value) (double value)]
    [(number? value) (double value)]
    [(string? value)
     (let [integer-result (parse-long value)]
       (if (some? integer-result)
         (double integer-result)
         (parse-double value)))]
    [:else nil]))

(defn- comparison-result
  [literal: Literal
   subst: Substitution] -> Bool
  (let [arguments (literal-arguments literal)
        left (term-value (nth arguments 0) subst)
        right (term-value (nth arguments 1) subst)
        operator (literal-operator literal)]
    (if (or (nil? left) (nil? right))
      false
      (cond
        [(= operator :eq) (= left right)]
        [(= operator :ne) (not (= left right))]
        [:else
         (let [left-number (numeric-value left)
               right-number (numeric-value right)]
           (if (or (nil? left-number) (nil? right-number))
             false
             (cond
               [(= operator :lt) (< left-number right-number)]
               [(= operator :le) (<= left-number right-number)]
               [(= operator :gt) (> left-number right-number)]
               [(= operator :ge) (>= left-number right-number)]
               [:else false])))]))))

(defn- builtin-value
  [operator: Keyword
   left: Any
   right: Any] -> Any
  (let [left-int (integer-value left)
        right-int (integer-value right)
        left-number (numeric-value left)
        right-number (numeric-value right)]
    (cond
      [(= operator :mod)
       (if (or (nil? left-int) (nil? right-int) (= right-int 0))
         nil
         (mod left-int right-int))]
      [(= operator :/)
       (if (or (nil? left-number) (nil? right-number) (= right-number 0.0))
         nil
         (/ left-number right-number))]
      [(or (= operator :+) (or (= operator subtract-operator) (= operator :*)))
       (if (and (some? left-int) (some? right-int))
         (cond
           [(= operator :+) (+ left-int right-int)]
           [(= operator subtract-operator) (- left-int right-int)]
           [:else (* left-int right-int)])
         (if (or (nil? left-number) (nil? right-number))
           nil
           (cond
             [(= operator :+) (+ left-number right-number)]
             [(= operator subtract-operator) (- left-number right-number)]
             [:else (* left-number right-number)])))]
      [:else nil])))

(defn- builtin-results
  [literal: Literal
   subst: Substitution] -> (Vec Substitution)
  (let [arguments (literal-arguments literal)
        left (term-value (nth arguments 0) subst)
        right (term-value (nth arguments 1) subst)]
    (if (or (nil? left) (nil? right))
      []
      (let [result (builtin-value (literal-operator literal) left right)]
        (if (nil? result)
          []
          [(assoc subst (literal-binding literal) result)])))))

(defn- unify-tuples!
  [arguments: (Vec QueryTerm)
   tuples: (Vec Tuple)
   subst: Substitution] -> (Vec Substitution)
  (reduce (fn
            [acc: (Vec Substitution)
             tuple: Tuple] -> (Vec Substitution)
            (let [matched (unify-arguments! arguments tuple subst)]
              (if (some? matched) (conj acc matched) acc)))
          [] tuples))

(defn- virtual-source-rows!
  [source: VirtualCandidateSource
   indexed: Bool
   arguments: (Vec QueryTerm)
   subst: Substitution] -> (Vec Tuple)
  (let [rows-fn (if indexed
                  (virtualcandidatesource-indexed source)
                  (virtualcandidatesource-scan source))]
    (rows-fn arguments subst)))

(defn- missing-candidate-source! [relation: String] -> Any
  (throw (ex-info (str "candidate source is unavailable for relation '" relation "'")
                  {:type :fram-query-abort
                   :code :query-text-index-unavailable})))

(defn- relation-results!
  [db: Db
   sources: CandidateSources
   literal: Literal
   subst: Substitution] -> (Vec Substitution)
  (let [relation (literal-relation literal)
        arguments (literal-arguments literal)
        source (get sources relation)]
    (if (literal-negated literal)
      (if (contains? (get db relation #{}) (ground arguments subst)) [] [subst])
      (cond
        [(instance? VirtualCandidateSource source)
         (unify-tuples! arguments
                        (virtual-source-rows! source false arguments subst)
                        subst)]
        [(and (contains? text-relations relation) (nil? source))
         (missing-candidate-source! relation)]
        [:else (unify-tuples! arguments (vec (get db relation #{})) subst)]))))

(defn- literal-results!
  [db: Db
   sources: CandidateSources
   literal: Literal
   subst: Substitution] -> (Vec Substitution)
  (query-check!)
  (cond
    [(= :relation (literal-kind literal))
     (relation-results! db sources literal subst)]
    [(= :comparison (literal-kind literal))
     (if (comparison-result literal subst) [subst] [])]
    [(= :builtin (literal-kind literal)) (builtin-results literal subst)]
    [:else []]))

(defn- body-results!
  [db: Db
   sources: CandidateSources
   body: (Vec Literal)
   seed: Substitution] -> (Vec Substitution)
  (reduce
   (fn
     [substitutions: (Vec Substitution)
      literal: Literal] -> (Vec Substitution)
     (reduce (fn
               [acc: (Vec Substitution)
                subst: Substitution] -> (Vec Substitution)
               (vec (concat acc (literal-results! db sources literal subst))))
             [] substitutions))
   [seed] body))

(defn- derive-rule!
  [db: Db
   sources: CandidateSources
   value: Rule] -> (Set Tuple)
  (reduce (fn
            [acc: (Set Tuple)
             subst: Substitution] -> (Set Tuple)
            (conj acc (ground (rule-head-arguments value) subst)))
          #{} (body-results! db sources (rule-body value) {})))

(defn- rule-head-relations [rules: (Vec Rule)] -> (Vec String)
  (vec (reduce (fn
                 [acc: (Set String)
                  value: Rule] -> (Set String)
                 (conj acc (rule-head-relation value)))
               #{} rules)))

(defn- derive-round!
  [db: Db
   sources: CandidateSources
   rules: (Vec Rule)] -> Db
  (reduce
   (fn
     [acc: Db
      value: Rule] -> Db
     (let [relation (rule-head-relation value)
           derived (derive-rule! db sources value)]
       (update acc relation
               (fn [current: (U (Set Tuple) Nil)] -> (Set Tuple)
                 (reduce (fn
                           [rows-value: (Set Tuple)
                            row: Tuple] -> (Set Tuple)
                           (conj rows-value row))
                         (or current #{}) derived)))))
   db rules))

(defn- relations-stable?
  [before: Db
   after: Db
   relations: (Vec String)] -> Bool
  (loop [remaining relations]
    (if (empty? remaining)
      true
      (let [relation (first remaining)]
        (if (= (get before relation #{}) (get after relation #{}))
          (recur (rest remaining))
          false)))))

(defn fixpoint-oracle-with-candidates!
  [db0: Db
   rules: (Vec Rule)
   sources: CandidateSources] -> Db
  (let [relations (rule-head-relations rules)]
    (loop [db db0]
      (let [next (derive-round! db sources rules)]
        (if (relations-stable? db next relations)
          next
          (recur next))))))

(defn- fixpoint-oracle!
  [db0: Db
   rules: (Vec Rule)] -> Db
  (fixpoint-oracle-with-candidates! db0 rules {}))

(defn- append-handle
  [index: HandleBucket
   key: Any
   handle: Int] -> HandleBucket
  (update index key
          (fn [current: (U (Vec Int) Nil)] -> (Vec Int)
            (conj (or current []) handle))))

(defn- add-position-handles
  [index: PositionIndex
   tuple: Tuple
   handle: Int] -> PositionIndex
  (loop [position 0 current index]
    (if (>= position (count tuple))
      current
      (let [bucket (get current position {})]
        (recur (inc position)
               (assoc current position
                      (append-handle bucket (nth tuple position) handle)))))))

(defn- trie-add
  [trie: HandleTrie
   tuple: Tuple
   order: (Vec Int)
   handle: Int] -> HandleTrie
  (let [first-key (nth tuple (nth order 0))
        second-key (nth tuple (nth order 1))
        third-key (nth tuple (nth order 2))
        first-node (get trie first-key {})
        second-node (get first-node second-key {})
        leaf (get second-node third-key [])]
    (assoc trie first-key
           (assoc first-node second-key
                  (assoc second-node third-key (conj leaf handle))))))

(defn- trie-node-handles [node: Any] -> (Vec Int)
  (cond
    [(nil? node) []]
    [(vector? node) node]
    [(map? node)
     (reduce (fn
               [handles: (Vec Int)
                child: Any] -> (Vec Int)
               (into handles (trie-node-handles child)))
             [] (vec (vals node)))]
    [:else []]))

(defn- trie-probe
  [trie: HandleTrie
   prefix: (Vec Any)] -> (Vec Int)
  (loop [node: Any trie remaining prefix]
    (if (or (nil? node) (empty? remaining))
      (trie-node-handles node)
      (recur (get node (first remaining)) (rest remaining)))))

(defn- empty-candidate-source [] -> CandidateSource
  (->CandidateSource [] {} {} {} {} nil nil))

(defn external-candidate-source
  [selector: SourceSelector
   resolver: SourceResolver] -> CandidateSource
  (->CandidateSource [] {} {} {} {} selector resolver))

(defn- candidate-source-add
  [relation: String
   source: CandidateSource
   tuple: Tuple] -> CandidateSource
  (let [handle (count (candidatesource-rows source))
        with-row: CandidateSource
        (assoc source :rows (conj (candidatesource-rows source) tuple))]
    (if (and (= relation triple-relation) (= 3 (count tuple)))
      (assoc with-row
             :spo (trie-add (candidatesource-spo source) tuple [0 1 2] handle)
             :pos (trie-add (candidatesource-pos source) tuple [1 2 0] handle)
             :osp (trie-add (candidatesource-osp source) tuple [2 0 1] handle))
      (assoc with-row
             :positions (add-position-handles
                         (candidatesource-positions source) tuple handle)))))

(defn- candidate-source-add-rows
  [relation: String
   source: CandidateSource
   tuples: (Set Tuple)] -> CandidateSource
  (reduce (fn
            [current: CandidateSource
             tuple: Tuple] -> CandidateSource
            (candidate-source-add relation current tuple))
          source tuples))

(defn- build-candidate-sources
  [db: Db
   relations: (Vec String)
   seed: CandidateSources] -> CandidateSources
  (reduce (fn
            [sources: CandidateSources
             relation: String] -> CandidateSources
            (if (contains? sources relation)
              sources
              (assoc sources relation
                     (candidate-source-add-rows
                      relation (empty-candidate-source) (get db relation #{})))))
          seed relations))

(defn- add-delta-sources
  [sources: CandidateSources
   delta: Db
   relations: (Vec String)] -> CandidateSources
  (reduce (fn
            [current: CandidateSources
             relation: String] -> CandidateSources
            (let [tuples (get delta relation #{})
                  existing (get current relation)
                  base: CandidateSource
                  (if (instance? CandidateSource existing)
                    existing
                    (empty-candidate-source))]
              (if (empty? tuples)
                current
                (assoc current relation
                       (candidate-source-add-rows
                        relation base tuples)))))
          sources relations))

(defn- bound-term-value
  [term: QueryTerm
   subst: Substitution] -> Any
  (let [name (queryterm-variable term)]
    (if (some? name)
      (if (contains? subst name) (get subst name) nil)
      (queryterm-value term))))

(defn text-relation-needle-valid?
  [relation: String
   needle: Any] -> Bool
  (cond
    [(= relation text-match-relation)
     (text-index/text-needle-valid? needle)]
    [(or (= relation text-phrase-relation)
         (= relation text-stem-relation))
     (text-search/word-needle-valid? needle)]
    [(or (= relation text-substring-relation)
         (= relation text-search-relation))
     (text-search/substring-needle-valid? needle)]
    [:else false]))

;; Virtual relations register independently so adjacent candidate sources can
;; append without changing the physical relation index.
(defn text-candidate-sources [source: text-search/TextSearchSource] -> CandidateSources
  {text-match-relation
   (->VirtualCandidateSource
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/exact-indexed-rows
       source (bound-term-value (nth arguments 2) subst)))
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/exact-scan-rows
       source (bound-term-value (nth arguments 2) subst))))
   text-phrase-relation
   (->VirtualCandidateSource
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/phrase-indexed-rows
       source (bound-term-value (nth arguments 2) subst)))
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/phrase-scan-rows
       source (bound-term-value (nth arguments 2) subst))))
   text-substring-relation
   (->VirtualCandidateSource
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/substring-indexed-rows
       source (bound-term-value (nth arguments 2) subst)))
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/substring-scan-rows
       source (bound-term-value (nth arguments 2) subst))))
   text-stem-relation
   (->VirtualCandidateSource
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/stem-indexed-rows
       source (bound-term-value (nth arguments 2) subst)))
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/stem-scan-rows
       source (bound-term-value (nth arguments 2) subst))))
   text-search-relation
   (->VirtualCandidateSource
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/ranked-indexed-rows
       source (bound-term-value (nth arguments 2) subst)))
    (fn [arguments: (Vec QueryTerm) subst: Substitution] -> (Vec Tuple)
      (text-search/ranked-scan-rows
       source (bound-term-value (nth arguments 2) subst))))})

(defn build-text-candidates [propositions: (Vec t/Triple)] -> CandidateSources
  (text-candidate-sources
   (text-search/build-source propositions text-index/text-index-max-bytes)))

(defn- bound-prefix
  [arguments: (Vec QueryTerm)
   order: (Vec Int)
   subst: Substitution] -> (Vec Any)
  (loop [remaining order prefix: (Vec Any) []]
    (if (empty? remaining)
      prefix
      (let [value (bound-term-value (nth arguments (first remaining)) subst)]
        (if (nil? value)
          prefix
          (recur (rest remaining) (conj prefix value)))))))

(defn- triple-prefix-handles
  [source: CandidateSource
   arguments: (Vec QueryTerm)
   subst: Substitution] -> (U (Vec Int) Nil)
  (let [spo-key (bound-prefix arguments [0 1 2] subst)
        pos-key (bound-prefix arguments [1 2 0] subst)
        osp-key (bound-prefix arguments [2 0 1] subst)
        spo-count (count spo-key)
        pos-count (count pos-key)
        osp-count (count osp-key)]
    (cond
      [(and (= 0 spo-count) (and (= 0 pos-count) (= 0 osp-count))) nil]
      [(and (>= spo-count pos-count) (>= spo-count osp-count))
       (trie-probe (candidatesource-spo source) spo-key)]
      [(>= pos-count osp-count)
       (trie-probe (candidatesource-pos source) pos-key)]
      [:else (trie-probe (candidatesource-osp source) osp-key)])))

(defn- positional-handles
  [source: CandidateSource
   arguments: (Vec QueryTerm)
   subst: Substitution] -> (U (Vec Int) Nil)
  (loop [position 0 best: (U (Vec Int) Nil) nil found false]
    (if (>= position (count arguments))
      (if found best nil)
      (let [value (bound-term-value (nth arguments position) subst)]
        (if (nil? value)
          (recur (inc position) best found)
          (let [candidate
                (get (get (candidatesource-positions source) position {}) value [])]
            (recur (inc position)
                   (if (or (not found) (< (count candidate) (count best)))
                     candidate best)
                   true)))))))

(defn- source-handles
  [source: CandidateSource
   relation: String
   arguments: (Vec QueryTerm)
   subst: Substitution] -> (U (Vec Int) Nil)
  (let [selector (candidatesource-selector source)]
    (if (some? selector)
      (selector (mapv (fn [term: QueryTerm] -> Any
                        (bound-term-value term subst))
                      arguments))
      (if (and (= relation triple-relation) (= 3 (count arguments)))
        (triple-prefix-handles source arguments subst)
        (positional-handles source arguments subst)))))

(defn- source-row
  [source: CandidateSource
   handle: Int] -> Tuple
  (let [resolver (candidatesource-resolver source)]
    (if (some? resolver)
      (resolver handle)
      (nth (candidatesource-rows source) handle))))

(defn- source-contains?
  [source: CandidateSource
   relation: String
   arguments: (Vec QueryTerm)
   subst: Substitution] -> Bool
  (let [wanted (ground arguments subst)
        handles (source-handles source relation arguments subst)]
    (some? (some (fn [handle: Int] -> Any
                   (when (= wanted (source-row source handle)) handle))
                 (or handles [])))))

(defn- relation-results-indexed!
  [db: Db
   sources: CandidateSources
   literal: Literal
   subst: Substitution] -> (Vec Substitution)
  (let [relation (literal-relation literal)
        arguments (literal-arguments literal)
        source (get sources relation)]
    (if (literal-negated literal)
      (if (if (instance? CandidateSource source)
            (source-contains? source relation arguments subst)
            (contains? (get db relation #{}) (ground arguments subst)))
        [] [subst])
      (cond
        [(instance? VirtualCandidateSource source)
         (unify-tuples! arguments
                        (virtual-source-rows! source true arguments subst)
                        subst)]
        [(nil? source)
         (if (contains? text-relations relation)
           (missing-candidate-source! relation)
          (reduce (fn
                    [acc: (Vec Substitution)
                     tuple: Tuple] -> (Vec Substitution)
                    (let [matched (unify-arguments! arguments tuple subst)]
                      (if (some? matched) (conj acc matched) acc)))
                  [] (vec (get db relation #{}))))]
        [:else
         (let [rows-value (candidatesource-rows source)
               handles (source-handles source relation arguments subst)]
           (if (nil? handles)
             (unify-tuples! arguments rows-value subst)
             (reduce
              (fn
                [acc: (Vec Substitution)
                 handle: Int] -> (Vec Substitution)
                (let [tuple (source-row source handle)
                      matched (unify-arguments! arguments tuple subst)]
                  (if (some? matched) (conj acc matched) acc)))
              [] handles)))]))))

(defn- literal-results-indexed!
  [db: Db
   sources: CandidateSources
   literal: Literal
   subst: Substitution] -> (Vec Substitution)
  (query-check!)
  (cond
    [(= :relation (literal-kind literal))
     (relation-results-indexed! db sources literal subst)]
    [(= :comparison (literal-kind literal))
     (if (comparison-result literal subst) [subst] [])]
    [(= :builtin (literal-kind literal)) (builtin-results literal subst)]
    [:else []]))

(defn- body-results-indexed!
  [db: Db
   sources: CandidateSources
   body: (Vec Literal)
   seed: Substitution] -> (Vec Substitution)
  (reduce
   (fn
     [substitutions: (Vec Substitution)
      literal: Literal] -> (Vec Substitution)
     (reduce (fn
               [acc: (Vec Substitution)
                subst: Substitution] -> (Vec Substitution)
               (into acc (literal-results-indexed! db sources literal subst)))
             [] substitutions))
   [seed] body))

(defn- derive-rule-indexed!
  [db: Db
   sources: CandidateSources
   value: Rule] -> (Set Tuple)
  (reduce (fn
            [acc: (Set Tuple)
             subst: Substitution] -> (Set Tuple)
            (conj acc (ground (rule-head-arguments value) subst)))
          #{} (body-results-indexed! db sources (rule-body value) {})))

(defn- delta-relation-positions
  [body: (Vec Literal)
   delta-relations: (Set String)] -> (Vec Int)
  (loop [position 0 remaining body positions: (Vec Int) []]
    (if (empty? remaining)
      positions
      (let [literal (first remaining)]
        (recur (inc position) (rest remaining)
               (if (and (= :relation (literal-kind literal))
                        (not (literal-negated literal))
                        (contains? delta-relations (literal-relation literal)))
                 (conj positions position)
                 positions))))))

(defn- positive-relation-names [rules: (Vec Rule)] -> (Vec String)
  (vec
   (sort
    (reduce
     (fn
       [relations: (Set String)
        value: Rule] -> (Set String)
       (reduce (fn
                 [current: (Set String)
                  literal: Literal] -> (Set String)
                 (if (and (= :relation (literal-kind literal))
                          (not (literal-negated literal)))
                   (conj current (literal-relation literal))
                   current))
               relations (rule-body value)))
     #{} rules))))

(defn- body-results-pinned!
  [db: Db
   sources: CandidateSources
   delta: Db
   delta-sources: CandidateSources
   body: (Vec Literal)
   pin: Int] -> (Vec Substitution)
  (loop [position 0 remaining body substitutions: (Vec Substitution) [{}]]
    (if (empty? remaining)
      substitutions
      (let [literal (first remaining)
            pinned (and (= position pin)
                        (= :relation (literal-kind literal))
                        (not (literal-negated literal)))
            read-db (if pinned delta db)
            read-sources (if pinned delta-sources sources)
            next-substitutions
            (reduce
             (fn
               [acc: (Vec Substitution)
                subst: Substitution] -> (Vec Substitution)
               (into acc
                     (literal-results-indexed!
                      read-db read-sources literal subst)))
             [] substitutions)]
        (recur (inc position) (rest remaining) next-substitutions)))))

(defn- derive-rule-delta!
  [db: Db
   sources: CandidateSources
   delta: Db
   delta-sources: CandidateSources
   delta-relations: (Set String)
   value: Rule] -> (Set Tuple)
  (let [head (rule-head-arguments value)
        body (rule-body value)]
    (reduce
     (fn
       [derived: (Set Tuple)
        pin: Int] -> (Set Tuple)
       (reduce (fn
                 [current: (Set Tuple)
                  subst: Substitution] -> (Set Tuple)
                 (conj current (ground head subst)))
               derived
               (body-results-pinned! db sources delta delta-sources body pin)))
     #{} (delta-relation-positions body delta-relations))))

(defn- db-new-only
  [candidate: Db
   db: Db
   relations: (Vec String)] -> Db
  (reduce
   (fn
     [delta: Db
      relation: String] -> Db
     (let [new-tuples
           (reduce (fn
                     [rows-value: (Set Tuple)
                      tuple: Tuple] -> (Set Tuple)
                     (if (contains? (get db relation #{}) tuple)
                       rows-value
                       (conj rows-value tuple)))
                   #{} (get candidate relation #{}))]
       (if (empty? new-tuples) delta (assoc delta relation new-tuples))))
   {} relations))

(defn- db-merge-delta
  [db: Db
   delta: Db
   relations: (Vec String)] -> Db
  (reduce
   (fn
     [current: Db
      relation: String] -> Db
     (let [new-tuples (get delta relation #{})]
       (if (empty? new-tuples)
         current
         (update current relation
                 (fn [known: (U (Set Tuple) Nil)] -> (Set Tuple)
                   (reduce (fn
                             [rows-value: (Set Tuple)
                              tuple: Tuple] -> (Set Tuple)
                             (conj rows-value tuple))
                           (or known #{}) new-tuples))))))
   db relations))

(defn- delta-empty?
  [delta: Db
   relations: (Vec String)] -> Bool
  (loop [remaining relations]
    (if (empty? remaining)
      true
      (if (empty? (get delta (first remaining) #{}))
        (recur (rest remaining))
        false))))

(defn- derive-delta!
  [db: Db
   sources: CandidateSources
   delta: Db
   rules: (Vec Rule)
   relations: (Vec String)
   delta-relations: (Vec String)] -> Db
  (let [delta-set (set delta-relations)
        delta-sources (build-candidate-sources delta delta-relations {})
        candidate
        (reduce
         (fn
           [current: Db
            value: Rule] -> Db
           (let [relation (rule-head-relation value)
                 derived
                 (derive-rule-delta!
                  db sources delta delta-sources delta-set value)]
             (update current relation
                     (fn [known: (U (Set Tuple) Nil)] -> (Set Tuple)
                       (reduce (fn
                                 [rows-value: (Set Tuple)
                                  tuple: Tuple] -> (Set Tuple)
                                 (conj rows-value tuple))
                               (or known #{}) derived)))))
         {} rules)]
    (db-new-only candidate db relations)))

(defn fixpoint-with-candidates!
  [db0: Db
   rules: (Vec Rule)
   candidates: CandidateSources] -> Db
  (let [relations (rule-head-relations rules)
        read-relations (positive-relation-names rules)
        head-set (set relations)
        delta-relations
        (vec (filter (fn [relation: String] -> Bool
                       (contains? head-set relation))
                     read-relations))
        initial-sources (build-candidate-sources db0 read-relations candidates)
        seeded
        (reduce
         (fn
           [db: Db
            value: Rule] -> Db
           (let [relation (rule-head-relation value)
                 derived (derive-rule-indexed! db0 initial-sources value)]
             (update db relation
                     (fn [known: (U (Set Tuple) Nil)] -> (Set Tuple)
                       (reduce (fn
                                 [rows-value: (Set Tuple)
                                  tuple: Tuple] -> (Set Tuple)
                                 (conj rows-value tuple))
                               (or known #{}) derived)))))
         db0 rules)
        delta0 (db-new-only seeded db0 relations)
        seeded-sources (add-delta-sources initial-sources delta0 read-relations)]
    (loop [db seeded sources seeded-sources delta delta0]
      (if (delta-empty? delta delta-relations)
        db
        (let [next-delta
              (derive-delta!
               db sources delta rules relations delta-relations)]
          (recur (db-merge-delta db next-delta relations)
                 (add-delta-sources sources next-delta read-relations)
                 next-delta))))))

(defn fixpoint!
  [db0: Db
   rules: (Vec Rule)] -> Db
  (fixpoint-with-candidates! db0 rules {}))

(defn fixpoint-sourced!
  [db0: Db
   registered: CandidateSources
   rules: (Vec Rule)] -> Db
  (fixpoint-with-candidates! db0 rules registered))

(defn run-rules!
  [propositions: (Vec t/Triple)
   rules: (Vec Rule)] -> Db
  (fixpoint! (edb propositions) rules))

(defn run-strata-db-with-candidates!
  [db0: Db
   strata: (Vec (Vec Rule))
   candidates: CandidateSources] -> Db
  (reduce (fn
            [db: Db
             stratum: (Vec Rule)] -> Db
            (fixpoint-with-candidates! db stratum candidates))
          db0 strata))

(defn run-strata-db!
  [db0: Db
   strata: (Vec (Vec Rule))] -> Db
  (run-strata-db-with-candidates! db0 strata {}))

(defn run-strata-db-sourced!
  [db0: Db
   sources: CandidateSources
   strata: (Vec (Vec Rule))] -> Db
  (run-strata-db-with-candidates! db0 strata sources))

(defn run-strata!
  [propositions: (Vec t/Triple)
   strata: (Vec (Vec Rule))] -> Db
  (run-strata-db! (edb propositions) strata))

(defn- negated-relations [stratum: (Vec Rule)] -> (Vec String)
  (reduce
   (fn
     [acc: (Vec String)
      value: Rule] -> (Vec String)
     (reduce (fn
               [relations: (Vec String)
                literal: Literal] -> (Vec String)
               (if (and (= :relation (literal-kind literal))
                        (literal-negated literal))
                 (conj relations (literal-relation literal))
                 relations))
             acc (rule-body value)))
   [] stratum))

(defn strata-violations [strata: (Vec (Vec Rule))] -> (Vec String)
  (loop [index 0 lower: (Set String) base-relations problems: (Vec String) []]
    (if (>= index (count strata))
      problems
      (let [stratum (nth strata index)
            heads
            (reduce (fn
                      [acc: (Set String)
                       value: Rule] -> (Set String)
                      (conj acc (rule-head-relation value)))
                    #{} stratum)
            problems2
            (reduce
             (fn
               [acc: (Vec String)
                relation: String] -> (Vec String)
               (cond
                 [(contains? heads relation)
                  (conj acc (str "stratum " index ": negated '" relation
                                 "' is also derived in the same stratum"))]
                 [(not (contains? lower relation))
                  (conj acc (str "stratum " index ": negated '" relation
                                 "' is not a base or lower-stratum relation"))]
                 [:else acc]))
             problems (negated-relations stratum))]
        (recur (+ index 1)
               (reduce (fn
                         [acc: (Set String)
                          relation: String] -> (Set String)
                         (conj acc relation))
                       lower heads)
               problems2)))))

(defn facts
  [db: Db
   relation: String] -> (Vec Tuple)
  (vec (get db relation #{})))
