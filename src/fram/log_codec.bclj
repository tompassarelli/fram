#lang beagle/clj

(ns fram.log-codec
  (:require [fram.native-wire-codec :as wire]
            [fram.store :as term-store]
            [fram.types :as t]))

(define-mode strict)

(def status-ok: Int 0)
(def status-fatal: Int 2)
(def framlog-version: Int 1)
(def framlog-flags: Int 0)
(def max-codec-count: Int 2147483647)
(def max-term-depth: Int 256)
(def crc32-mask: Int 4294967295)
(def crc32-polynomial: Int 3988292384)
(def framlog-magic: (Vec Int) [70 82 65 77 76 79 71 0])

(defrecord BootResult
  [status: Int
   store: (U Nil (Atom t/TermStore))
   valid-log-bytes: Int
   boot-append: (Vec Int)
   error: String?])

(defrecord BytesResult
  [status: Int
   bytes: (Vec Int)
   error: String?])

(defrecord FrameDecodeResult
  [frame: t/TransactionFrame?
   error: String?])

(defn failed-boot [message: String] -> BootResult
  (->BootResult status-fatal nil 0 [] message))

(defn failed-bytes [message: String] -> BytesResult
  (->BytesResult status-fatal [] message))

(defn error-or
  [error: String?
   fallback: String] -> String
  (if error error fallback))

(defn valid-byte-vector? [bytes: (Vec Int)] -> Bool
  (loop [position 0]
    (if (>= position (count bytes))
      true
      (let [value (nth bytes position)]
        (if (wire/byte-value? value)
          (recur (+ position 1))
          false)))))

(defn crc32 [bytes: (Vec Int)] -> Int
  (loop [position 0 crc crc32-mask]
    (if (>= position (count bytes))
      (bit-and crc32-mask (bit-xor crc crc32-mask))
      (let [mixed (bit-xor crc (nth bytes position))
            next-crc
            (loop [bit 0 value mixed]
              (if (>= bit 8)
                value
                (let [shifted (unsigned-bit-shift-right value 1)]
                  (recur (+ bit 1)
                         (if (= 1 (bit-and value 1))
                           (bit-xor shifted crc32-polynomial)
                           shifted)))))]
        (recur (+ position 1) (bit-and crc32-mask next-crc))))))

(defn magic-at-start? [bytes: (Vec Int)] -> Bool
  (if (< (count bytes) (count framlog-magic))
    false
    (loop [position 0]
      (if (>= position (count framlog-magic))
        true
        (if (= (nth bytes position) (nth framlog-magic position))
          (recur (+ position 1))
          false)))))

(defn encode-header! [space-id: String] -> BytesResult
  (if (= 0 (count space-id))
    (failed-bytes "FRAMLOG SpaceId must be nonempty")
    (let [encoder (wire/->Encoder (wire/empty-byte-cell) (atom 0)
                                  (wire/empty-error-cell))
          space-bytes
          (wire/utf8-bytes! encoder space-id max-codec-count "FRAMLOG SpaceId")]
      (if (deref (wire/encoder-error encoder))
        (failed-bytes
         (str "FRAMLOG header encode failed: "
              (deref (wire/encoder-error encoder))))
        (do
          (swap! (wire/encoder-bytes encoder) into framlog-magic)
          (wire/append-u16-le! encoder framlog-version)
          (wire/append-u16-le! encoder framlog-flags)
          (wire/append-u32-le! encoder (count space-bytes))
          (swap! (wire/encoder-bytes encoder) into space-bytes)
          (let [error (deref (wire/encoder-error encoder))]
            (if error
              (failed-bytes (str "FRAMLOG header encode failed: " error))
              (->BytesResult status-ok
                             (deref (wire/encoder-bytes encoder)) nil))))))))

(defn decode-frame-payload! [payload: (Vec Int)] -> FrameDecodeResult
  (let [decoder (wire/->Decoder payload (atom 0) (atom 0)
                                (wire/empty-error-cell))]
    (if (< (count payload) 12)
      (->FrameDecodeResult nil "FRAMLOG transaction header is truncated")
      (let [sequence (wire/read-i64-le! decoder "FRAMLOG transaction sequence")
            operation-count
            (wire/read-u32-le! decoder "FRAMLOG operation count")]
        (cond
          [(deref (wire/decoder-error decoder))
           (->FrameDecodeResult nil (deref (wire/decoder-error decoder)))]
          [(< sequence 0)
           (->FrameDecodeResult nil
                                "FRAMLOG transaction sequence is negative")]
          [(or (= operation-count 0) (> operation-count max-codec-count))
           (->FrameDecodeResult
            nil "FRAMLOG transaction operation count is invalid")]
          [:else
           (loop [ordinal 0 operations: (Vec t/CommitOperation) []]
             (if (>= ordinal operation-count)
               (let [error (deref (wire/decoder-error decoder))]
                 (cond
                   [error (->FrameDecodeResult nil error)]
                   [(not= 0 (wire/decoder-remaining decoder))
                    (->FrameDecodeResult
                     nil "FRAMLOG transaction has trailing payload bytes")]
                   [:else
                    (->FrameDecodeResult
                     (term-store/transaction-frame sequence operations) nil)]))
               (let [actual
                     (wire/read-u32-le! decoder "FRAMLOG operation ordinal")
                     action (wire/read-u8! decoder "FRAMLOG operation action")
                     _ (reset! (wire/decoder-nodes decoder) 0)
                     proposition
                     (wire/read-term-limited!
                      decoder 0 max-codec-count max-codec-count max-term-depth)
                     error (deref (wire/decoder-error decoder))]
                 (cond
                   [error (->FrameDecodeResult nil error)]
                   [(not= actual ordinal)
                    (->FrameDecodeResult
                     nil "FRAMLOG operation ordinals are not contiguous")]
                   [(not (t/triple? proposition))
                    (->FrameDecodeResult
                     nil "FRAMLOG operation proposition is not a Triple")]
                   [(= action 1)
                    (recur (+ ordinal 1)
                           (conj operations
                                 (term-store/assert-operation proposition)))]
                   [(= action 2)
                    (recur (+ ordinal 1)
                           (conj operations
                                 (term-store/retract-operation proposition)))]
                   [:else
                    (->FrameDecodeResult
                     nil "FRAMLOG contains an unknown operation action")]))))])))))

(defn canonical-store-copy! [root: (Atom t/TermStore)] -> (Atom t/TermStore)
  (let [dump (term-store/dump-term-store root)
        copy (term-store/new-term-store (t/termstoredump-space-id dump))]
    (term-store/load-term-store! copy dump)))

(defn successful-boot!
  [root: (Atom t/TermStore)
   valid-log-bytes: Int
   boot-append: (Vec Int)] -> BootResult
  (->BootResult status-ok (canonical-store-copy! root)
                valid-log-bytes boot-append nil))

(defn replay-complete-frames!
  [decoder: wire/Decoder
   root: (Atom t/TermStore)
   header-bytes: Int] -> BootResult
  (loop [valid-log-bytes header-bytes]
    (let [remaining (wire/decoder-remaining decoder)]
      (cond
        [(= remaining 0)
         (successful-boot! root valid-log-bytes [])]
        [(< remaining 4)
         (successful-boot! root valid-log-bytes [])]
        [:else
         (let [frame-start (deref (wire/decoder-position decoder))
               payload-length
               (wire/read-u32-le! decoder "FRAMLOG frame payload length")]
           (cond
             [(deref (wire/decoder-error decoder))
              (failed-boot
               (error-or (deref (wire/decoder-error decoder))
                         "FRAMLOG frame decode failed"))]
             [(> payload-length max-codec-count)
              (failed-boot "FRAMLOG frame exceeds the supported byte range")]
             [(< (wire/decoder-remaining decoder) (+ payload-length 4))
              (do
                (reset! (wire/decoder-position decoder) frame-start)
                (successful-boot! root valid-log-bytes []))]
             [:else
              (let [payload-start (deref (wire/decoder-position decoder))
                    payload-end (+ payload-start payload-length)
                    payload
                    (subvec (wire/decoder-bytes decoder)
                            payload-start payload-end)
                    _ (reset! (wire/decoder-position decoder) payload-end)
                    stored-crc (wire/read-u32-le! decoder "FRAMLOG frame CRC")
                    actual-crc (crc32 payload)
                    decoded (decode-frame-payload! payload)
                    frame (framedecoderesult-frame decoded)]
                (cond
                  [(not= stored-crc actual-crc)
                   (failed-boot "FRAMLOG frame CRC does not match")]
                  [(framedecoderesult-error decoded)
                   (failed-boot
                    (str "FRAMLOG transaction decode failed: "
                         (framedecoderesult-error decoded)))]
                  [(nil? frame)
                   (failed-boot "FRAMLOG transaction decoder returned no frame")]
                  [(< (t/transactionframe-sequence frame)
                      (term-store/next-sequence root))
                   (failed-boot
                    "FRAMLOG transaction sequence does not advance")]
                  [:else
                   (do
                     (term-store/replay-transaction! root frame)
                     (recur (deref (wire/decoder-position decoder))))]))]))]))))

(defn boot-framlog!
  [configured-space-id: String
   bytes: (Vec Int)] -> BootResult
  (cond
    [(not (valid-byte-vector? bytes))
     (failed-boot "FRAMLOG byte vector contains a value outside u8")]
    [(= 0 (count bytes))
     (let [header (encode-header! configured-space-id)]
       (if (= status-ok (bytesresult-status header))
         (successful-boot!
          (term-store/new-term-store configured-space-id)
          0 (bytesresult-bytes header))
         (failed-boot
          (error-or (bytesresult-error header)
                    "FRAMLOG header encode failed"))))]
    [(not (magic-at-start? bytes))
     (failed-boot "FRAMLOG magic does not match; migration is required")]
    [:else
     (let [decoder (wire/->Decoder bytes (atom (count framlog-magic))
                                   (atom 0) (wire/empty-error-cell))]
       (if (< (wire/decoder-remaining decoder) 8)
         (failed-boot "FRAMLOG header is truncated")
         (let [version (wire/read-u16-le! decoder "FRAMLOG version")
               flags (wire/read-u16-le! decoder "FRAMLOG flags")
               space-length
               (wire/read-u32-le! decoder "FRAMLOG SpaceId length")]
           (cond
             [(or (not= version framlog-version) (not= flags framlog-flags))
              (failed-boot "FRAMLOG version or flags are unsupported")]
             [(or (= space-length 0) (> space-length max-codec-count))
              (failed-boot "FRAMLOG SpaceId length is invalid")]
             [(< (wire/decoder-remaining decoder) space-length)
              (failed-boot "FRAMLOG header is truncated inside SpaceId")]
             [:else
              (let [space-id
                    (wire/read-utf8! decoder space-length "FRAMLOG SpaceId")
                    error (deref (wire/decoder-error decoder))]
                (cond
                  [error
                   (failed-boot
                    (error-or error "FRAMLOG SpaceId decode failed"))]
                  [(= 0 (count space-id))
                   (failed-boot "FRAMLOG SpaceId must be nonempty")]
                  [(and (not= 0 (count configured-space-id))
                        (not= configured-space-id space-id))
                   (failed-boot "FRAMLOG belongs to a different SpaceId")]
                  [:else
                   (replay-complete-frames!
                    decoder (term-store/new-term-store space-id)
                    (deref (wire/decoder-position decoder)))]))]))))]))

(defn append-frame-bytes! [frame: t/TransactionFrame] -> BytesResult
  (let [payload (wire/->Encoder (wire/empty-byte-cell) (atom 0)
                                (wire/empty-error-cell))
        operations (t/transactionframe-operations frame)
        sequence (t/transactionframe-sequence frame)]
    (if (or (< sequence 0) (= 0 (count operations)))
      (failed-bytes "FRAMLOG transaction frame is invalid")
      (do
        (wire/append-i64-le! payload sequence)
        (wire/append-u32-le! payload (count operations))
        (loop [ordinal 0]
          (if (< ordinal (count operations))
            (let [operation (nth operations ordinal)
                  action (t/commitoperation-action operation)]
              (wire/append-u32-le! payload ordinal)
              (cond
                [(= action t/assert-action) (wire/append-u8! payload 1)]
                [(= action t/retract-action) (wire/append-u8! payload 2)]
                [:else
                 (wire/encoder-error!
                  payload "FRAMLOG operation action must be assert or retract")])
              (reset! (wire/encoder-nodes payload) 0)
              (wire/append-term-limited!
               payload (t/commitoperation-proposition operation)
               0 max-codec-count max-codec-count max-term-depth)
              (recur (+ ordinal 1)))
            nil))
        (let [payload-error (deref (wire/encoder-error payload))
              payload-bytes (deref (wire/encoder-bytes payload))]
          (if payload-error
            (failed-bytes
             (str "FRAMLOG transaction encode failed: " payload-error))
            (let [out (wire/->Encoder (wire/empty-byte-cell) (atom 0)
                                      (wire/empty-error-cell))]
              (wire/append-u32-le! out (count payload-bytes))
              (swap! (wire/encoder-bytes out) into payload-bytes)
              (wire/append-u32-le! out (crc32 payload-bytes))
              (let [error (deref (wire/encoder-error out))]
                (if error
                  (failed-bytes (str "FRAMLOG frame encode failed: " error))
                  (->BytesResult status-ok
                                 (deref (wire/encoder-bytes out)) nil))))))))))

(defn encode-store-tail!
  [root: (Atom t/TermStore)
   lower-exclusive: Int] -> BytesResult
  (let [canonical (canonical-store-copy! root)
        current (term-store/current-sequence canonical)]
    (if (or (< lower-exclusive 0) (> lower-exclusive current))
      (failed-bytes "FRAMLOG tail lower bound is outside store history")
      (let [frames
            (term-store/transaction-frames-between
             (deref canonical) lower-exclusive current)]
        (loop [position 0 bytes: (Vec Int) []]
          (if (>= position (count frames))
            (->BytesResult status-ok bytes nil)
            (let [encoded (append-frame-bytes! (nth frames position))]
              (if (= status-ok (bytesresult-status encoded))
                (recur (+ position 1)
                       (into bytes (bytesresult-bytes encoded)))
                (failed-bytes
                 (error-or (bytesresult-error encoded)
                           "FRAMLOG tail encode failed"))))))))))
