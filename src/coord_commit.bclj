#lang beagle/clj

;; @upstream:graph — the code lives in the Fram fact graph; this text is a
;; generated view. Author substantive forms only through the Fram graph-edit
;; verbs. SEEDED 2026-07-28 for engine-core M5 Cut B.
;; ============================================================================
;; coord-commit — pure coordinator commit decisions.
;; ============================================================================
;; Store snapshots and proposed writes enter explicitly. Mutation, coordinator
;; locks, queues, futures, promises, fsync, group commit, and dynamic vars stay
;; in coord.clj.
;; ============================================================================
(ns coord-commit (:require [fram.types :as t]))

(define-mode strict)

(defn version-conflict? [single :- Bool base-version :- Int expected-version :- Int?] :- Bool
  (if (nil? expected-version)
    false
    (and single (> base-version expected-version))))

(defn expected-value-match? [live-values :- (Set Int) expected-value :- Int?] :- Bool
  (if (nil? expected-value) false (contains? live-values expected-value)))

(defrecord CommitIntent [index :- Int pred :- String kind :- Keyword r :- String single :- Bool base-version :- Int expected-version :- Int? live-values :- (Set Int) expected-value :- Int? cycle :- Bool])

(defn commit-plan [head-version :- Int intents :- (Vec CommitIntent)] :- (Map Keyword Any)
  (loop [remaining :- (Vec CommitIntent) intents writes :- (Vec Any) [] idempotent :- (Vec String) []]
    (if (empty? remaining)
      {:writes writes :idempotent idempotent}
      (let [intent :- CommitIntent (first remaining) pred (:pred intent)]
        (cond
          (version-conflict? (:single intent)
            (:base-version intent)
            (:expected-version intent))
          {:reject
           :conflict
           :version
           head-version
           :at
           (:index intent)
           :pred
           pred}
          (:cycle intent)
          {:reject
           [(str pred " cycle")]
           :version
           head-version
           :at
           (:index intent)
           :pred
           pred}
          (and (not (:single intent))
            (expected-value-match? (:live-values intent)
              (:expected-value intent)))
          (recur (vec (rest remaining)) writes (conj idempotent pred))
          :else
          (recur (vec (rest remaining))
            (conj writes {:pred pred :kind (:kind intent) :r (:r intent)})
            idempotent))))))

(defrecord GroupBatchItem [path :- String?])

(defrecord GroupBatch [path :- String? indices :- (Vec Int)])

(defn- group-index [groups :- (Vec GroupBatch) path :- String?] :- Int?
  (loop [remaining :- (Vec GroupBatch) groups index 0]
    (if (empty? remaining)
      nil
      (if (= (:path (first remaining)) path)
        index
        (recur (vec (rest remaining)) (inc index))))))

(defn group-batch-plan [items :- (Vec GroupBatchItem)] :- (Vec GroupBatch)
  (loop [remaining :- (Vec GroupBatchItem) items index 0 groups :- (Vec GroupBatch) []]
    (if (empty? remaining)
      groups
      (let [item :- GroupBatchItem (first remaining) group-index (group-index groups (:path item))]
        (if (nil? group-index)
          (recur (vec (rest remaining))
            (inc index)
            (conj groups (->GroupBatch (:path item) [index])))
          (let [group :- GroupBatch (nth groups group-index)]
            (recur (vec (rest remaining))
              (inc index)
              (assoc groups
                group-index
                (->GroupBatch (:path group) (conj (:indices group) index))))))))))

(defrecord LeaseSnapshot [holder :- String exp :- Int epoch :- Int])

(defn lease-expired? [lease :- LeaseSnapshot? now-ms :- Int] :- Bool
  (if (nil? lease) false (<= (:exp lease) now-ms)))

(defn valid-lease-request? [holder :- Any resource :- Any ttl-ms :- Any now-ms :- Int max-ms :- Int] :- Bool
  (and (string? holder)
    (not (.isBlank holder))
    (not (.contains holder "|"))
    (string? resource)
    (not (.isBlank resource))
    (integer? ttl-ms)
    (pos? ttl-ms)
    (<= ttl-ms (- max-ms now-ms))))

(defn valid-lease-epoch? [epoch :- Any max-epoch :- Int] :- Bool
  (and (integer? epoch) (pos? epoch) (<= epoch max-epoch)))

(defn lease-fence-ok? [lease :- LeaseSnapshot? holder :- Any epoch :- Any now-ms :- Int] :- Bool
  (and (not (nil? lease))
    (> (:exp lease) now-ms)
    (= (:holder lease) holder)
    (= (:epoch lease) epoch)))

(defn lease-held? [lease :- LeaseSnapshot? now-ms :- Int] :- Bool
  (if (nil? lease) false (> (:exp lease) now-ms)))

(defn lease-grant-decision [lease :- LeaseSnapshot? holder :- Any resource :- Any ttl-ms :- Any now-ms :- Int max-ms :- Int version :- Int] :- (Map Keyword Any)
  (cond
    (not (valid-lease-request? holder resource ttl-ms now-ms max-ms))
    {:reject :invalid-lease-request :version version}
    (and (lease-held? lease now-ms) (not= (:holder lease) holder))
    {:reject :held :holder (:holder lease) :exp (:exp lease) :version version}
    :else
    {:persist true}))

(defn lease-renew-decision [lease :- LeaseSnapshot? holder :- Any resource :- Any expected-epoch :- Any ttl-ms :- Any now-ms :- Int max-ms :- Int max-epoch :- Int version :- Int] :- (Map Keyword Any)
  (cond
    (or (not (valid-lease-request? holder resource ttl-ms now-ms max-ms))
      (not (valid-lease-epoch? expected-epoch max-epoch)))
    {:reject :invalid-lease-request :version version}
    (and (lease-held? lease now-ms)
      (= (:holder lease) holder)
      (= (:epoch lease) expected-epoch))
    {:persist true}
    :else
    {:reject :fence-lost :version version}))

(defn lease-release-decision [lease :- LeaseSnapshot? holder :- Any epoch :- Any require-epoch :- Bool version :- Int] :- (Map Keyword Any)
  (if (and (not (nil? lease)) (= (:holder lease) holder) (or (not require-epoch) (= (:epoch lease) epoch)))
    {:retract true}
    {:ok version :noop true}))

(defrecord GroupFlushPolicy [min-items :- Int drain-limit :- Int])

(defn group-flush-policy [pending-count :- Int] :- GroupFlushPolicy
  (->GroupFlushPolicy 1 (max 0 pending-count)))

(defn group-flush-ready? [policy :- GroupFlushPolicy batch-count :- Int] :- Bool
  (>= batch-count (:min-items policy)))

(defn queue-admission-decision [deferred :- Bool] :- Keyword
  (if deferred :defer :await))

(defn group-lock-order [] :- (Vec Keyword) [:group-io :append-admission])
