#lang beagle/clj

;; ============================================================================
;; resolve-corpus — THE CORPUS/STORE FRAME: install one resolver run's state.
;; ============================================================================
;; Stage M1 Cut L of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). This layer owns the portable
;; corpus/store orchestration: cross-module resolver construction, warm-store
;; grouping, frame/export installation, whole/scoped resolver runs, and the
;; durable bound_to -> derived refers_to identity lift.
;;
;; STATE IS EXPLICIT. resolve.clj's ^:dynamic vars stay in that namespace
;; because coord_daemon.clj and tests bind them by qualified name. CorpusState
;; snapshots every value this module reads and carries small host callbacks for
;; the mutations that must target those thread-local bindings. CorpusHost carries
;; the one callback that establishes a fresh binding scope; the logic that runs
;; inside the scope lives here.
;;
;; Consumed by resolve.clj — the emitted out/resolve_corpus.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-corpus
  (:require [clojure.string :as str]
    [fram.types :as t]
    [fram.store :as c]
    [resolve-read :as rr]
    [resolve-modules :as rm]
    [resolve-walk :as rw]))

(define-mode strict)

(def MODULE-NAME-RE :- Any (re-pattern "@([^#]+)#\\d+"))

(def SLASH-RE :- Any (re-pattern "/"))

;; GAP: Beagle cannot name the heterogeneous module tables or the host callbacks
;; that mutate resolve.clj's thread-local dynamic bindings more precisely than
;; Any. Store, tx, predicate ids, source vectors, and the binding atom remain
;; concrete so the unchecked boundary is limited to those two shapes.
(defrecord CorpusState [ctx :- (Atom t/Store)
                        view :- Any
                        tx :- Int
                        KIND :- Int
                        BOUND :- Int?
                        REFERS :- Int
                        file-ents :- (Atom Any)
                        corpus-cache :- Any
                        corpus-scope :- Any
                        resolve-walk? :- Bool
                        srcs :- (Vec Any)
                        install-srcs :- Any
                        install-tables :- Any
                        install-warm :- Any
                        run-all :- Any
                        run-over :- Any
                        profile :- Any])

(defrecord CorpusHost [with-state :- Any
                       load-edn :- Any
                       state :- Any])

(defn walk-corpus [srcs :- (Vec Any) modframe :- Any typeframe :- Any
                   accessors :- Any ents :- Any] :- rw/Corpus
  (rw/->Corpus srcs modframe typeframe accessors ents))

(defn name->module [nm :- Any] :- Any
  (if (string? nm)
    (let [hit (re-matches MODULE-NAME-RE nm)]
      (if (some? hit) (second hit) nil))
    nil))

(defn make-xresolve [ctx :- (Atom t/Store) view :- Any ents-of :- Any
                     exports :- Any type-exports :- Any accessor-exports :- Any
                     src :- Any] :- Any
  (let [{:keys [refer as rename]} (rm/parse-require ctx view (vec (get ents-of src [])))
        xport (fn [m :- Any n :- Any] :- Any
                (or (get-in exports [m n]) (get-in type-exports [m n])))
        xacc (fn [m :- Any n :- Any] :- Any
               (get-in accessor-exports [m n]))]
    (fn [nm :- Any] :- Any
      (cond
        (nil? nm) nil
        (get refer nm)
        (let [m (get refer nm)]
          (if-let [target (xport m nm)]
            {:target target :mode :tracking}
            (when-let [accessor (xacc m nm)]
              {:target (first accessor) :mode :tracking :accessor (second accessor)})))
        (get rename nm)
        (let [[m source-name] (get rename nm)]
          {:target (xport m source-name) :mode :fixed})
        (str/includes? nm "/")
        (let [[alias public-name] (str/split nm SLASH-RE 2)
              module (or (get as alias)
                         (when (some (fn [table :- Any] :- Bool
                                       (contains? table alias))
                                 [exports type-exports accessor-exports])
                           alias))]
          (when module
            (if-let [target (xport module public-name)]
              {:target target :mode :qual :alias alias}
              (when-let [accessor (xacc module public-name)]
                {:target (first accessor) :mode :qual :alias alias
                 :accessor (second accessor)}))))
        :else nil))))

(defn module-export-set [ctx :- (Atom t/Store) view :- Any ents-of :- Any src :- Any] :- Any
  (let [ents (vec (get ents-of src []))
        exports (rm/module-exports ctx view ents)
        value-exports (if (seq exports) exports (rm/module-defs ctx view ents))]
    (into #{} (concat (keys value-exports)
                      (keys (rm/module-types ctx view ents))
                      (keys (rm/module-accessors ctx view ents))))))

(defn module-imports [ctx :- (Atom t/Store) view :- Any ents-of :- Any src :- Any] :- Any
  (let [{:keys [refer as rename]} (rm/parse-require ctx view (vec (get ents-of src [])))]
    (into #{} (concat (vals refer) (vals as) (map first (vals rename))))))

(defn import-graph [ctx :- (Atom t/Store) view :- Any ents-of :- Any srcs :- (Vec Any)] :- Any
  (into {}
    (map (fn [src :- Any] :- Any
           (let [ents (vec (get ents-of src []))]
             [(rm/module-name ctx view ents)
              (module-imports ctx view ents-of src)]))
      (filter (fn [src :- Any] :- Bool
                (some? (rm/module-name ctx view (vec (get ents-of src [])))))
        srcs))))

(defn module-has-macro? [ctx :- (Atom t/Store) view :- Any ents-of :- Any src :- Any] :- Bool
  (let [ents (vec (get ents-of src []))]
    (boolean
      (some (fn [form :- Int] :- Bool
              (let [def-form (rm/unwrap-def ctx view form)
                    head (first (rr/ordered-children ctx def-form))]
                (= "defmacro" (rr/sym-val ctx view head))))
        (rm/forms-of ctx view ents)))))

(defn lift-bound-to-refers! [ctx :- (Atom t/Store) tx :- Int
                             KIND :- Int BOUND :- Int? REFERS :- Int] :- Any
  (when (some? BOUND)
    (doseq [cid (c/by-p ctx BOUND)]
      (let [fact (c/fact-of ctx cid)
            leaf (:l fact)
            target (:r fact)]
        (when (and (integer? target)
                   (rr/live-node? ctx KIND target)
                   (empty? (c/by-lp ctx leaf REFERS)))
          (c/fact! ctx leaf REFERS target tx))))))

(defn corpus-from-store! [state :- CorpusState] :- Any
  (let [t0 (System/nanoTime)
        groups (rw/warm-groups (:ctx state) (:corpus-cache state) name->module)
        t-groups (System/nanoTime)
        tables (rw/scoped-corpus-tables (:ctx state) (:view state)
                 groups (:corpus-scope state))
        install (:install-warm state)]
    (do
      (install groups tables)
      (when (= "1" (System/getenv "FRAM_PROF"))
        (let [profile (:profile state)]
          (profile
            (format "  corpus-from-store!: groups=%.1fms frames+exports=%.1fms cached=%s nsrcs=%d scoped=%s"
              (/ (- t-groups t0) 1e6)
              (/ (- (System/nanoTime) t-groups) 1e6)
              (some? (:corpus-cache state))
              (count (:srcs tables))
              (boolean (:corpus-scope state))))))
      tables)))

(defn resolve-edn! [host :- CorpusHost edn-paths :- (Vec Any) body :- Any] :- Any
  (let [store (c/new-store)
        tx (c/begin-tx! store "resolve")
        sup (c/value! store "supersedes")
        with-state (:with-state host)]
    (do
      (c/set-supersedes-pred! store sup)
      (with-state store tx sup
        (fn [] :- Any
          (let [state-fn (:state host)
                load (:load-edn host)
                loaded (mapv load edn-paths)
                state (state-fn)
                install-srcs (:install-srcs state)
                install-tables (:install-tables state)]
            (do
              (install-srcs loaded)
              (install-tables
                (rw/corpus-tables (:ctx state) (:view state) loaded
                  @(:file-ents state)))
              (let [run-all (:run-all state)]
                (run-all))
              (body))))))))

(defn resolve-warm-store! [host :- CorpusHost store :- (Atom t/Store) body :- Any] :- Any
  (let [tx (c/begin-tx! store "resolve-warm")
        sup (or (c/value-id store "supersedes") (c/value! store "supersedes"))
        with-state (:with-state host)]
    (do
      (c/set-supersedes-pred! store sup)
      (with-state store tx sup
        (fn [] :- Any
          (let [state-fn (:state host)
                state (state-fn)]
            (do
              (corpus-from-store! state)
              (when (:resolve-walk? state)
                (let [run-all (:run-all state)]
                  (run-all))
                (lift-bound-to-refers! (:ctx state) (:tx state)
                  (:KIND state) (:BOUND state) (:REFERS state)))
              (body))))))))

(defn resolve-modules! [host :- CorpusHost store :- (Atom t/Store)
                        module-set :- Any body :- Any] :- Any
  (let [tx (c/begin-tx! store "resolve-scoped")
        sup (or (c/value-id store "supersedes") (c/value! store "supersedes"))
        with-state (:with-state host)]
    (do
      (c/set-supersedes-pred! store sup)
      (with-state store tx sup
        (fn [] :- Any
          (let [state-fn (:state host)
                state (state-fn)]
            (do
              (corpus-from-store! state)
              (let [fresh (state-fn)
                    run-over (:run-over fresh)]
                (run-over (filter module-set (:srcs fresh)))
                (lift-bound-to-refers! (:ctx fresh) (:tx fresh)
                  (:KIND fresh) (:BOUND fresh) (:REFERS fresh)))
              (body))))))))
