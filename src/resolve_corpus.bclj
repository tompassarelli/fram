#lang beagle/clj

;; ============================================================================
;; resolve-corpus — THE CORPUS/STORE FRAME: install one resolver run's state.
;; ============================================================================
;; Stage M1 Cut L of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). This layer owns the portable
;; corpus/store orchestration: cross-module resolver construction, warm-store
;; grouping, frame/export installation, whole/scoped resolver runs, and the
;; durable bound_to -> derived refers_to identity lift.
;;
;; STATE IS EXPLICIT. resolve.clj's ^:dynamic vars stay in that namespace
;; because coord_daemon.clj and tests bind them by qualified name. CorpusState
;; snapshots every value this module reads and carries small host callbacks for
;; the mutations that must target those thread-local bindings. CorpusHost carries
;; the one callback that establishes a fresh binding scope; the logic that runs
;; inside the scope lives here.
;;
;; Consumed by resolve.clj — the emitted out/resolve_corpus.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-corpus
  (:require [clojure.string :as str]
    [fram.types :as t]
    [fram.store :as c]
    [resolve-read :as rr]
    [resolve-modules :as rm]
    [resolve-walk :as rw]))

(define-mode strict)

(def MODULE-NAME-RE :- Any (re-pattern "@([^#]+)#.+"))

(def SLASH-RE :- Any (re-pattern "/"))

;; GAP: Beagle cannot name the heterogeneous module tables or the host callbacks
;; that mutate resolve.clj's thread-local dynamic bindings more precisely than
;; Any. The recursive Term alias cannot cross Beagle module calls without
;; narrowing, so node/predicate fields use Any and are validated by rr/context.
(defrecord CorpusState [ctx: rr/Context view: Any KIND: Any BOUND: Any REFERS: Any file-ents: (Atom Any) corpus-cache: Any corpus-scope: Any resolve-walk?: Bool srcs: (Vec Any) install-srcs: Any install-tables: Any install-warm: Any run-all: Any run-over: Any profile: Any])

(defrecord CorpusHost [with-state :- Any load-edn :- Any state :- Any])

(defn walk-corpus [srcs :- (Vec Any) modframe :- Any typeframe :- Any accessors :- Any ents :- Any] :- rw/Corpus
  (rw/->Corpus srcs modframe typeframe accessors ents))

(defn name->module [nm :- Any] :- Any
  (if (string? nm)
    (let [hit (re-matches MODULE-NAME-RE nm)] (if (some? hit) (second hit) nil))
    nil))

(defn make-xresolve [ctx: rr/Context view: Any ents-of: Any exports: Any type-exports: Any accessor-exports: Any src: Any] -> Any
  (let [{:keys [refer as rename]} (rm/parse-require ctx view (vec (get ents-of src []))) xport (fn [m :- Any n :- Any] :- Any (or (get-in exports [m n]) (get-in type-exports [m n]))) xacc (fn [m :- Any n :- Any] :- Any (get-in accessor-exports [m n]))]
    (fn [nm :- Any] :- Any
      (cond
        (nil? nm)
        nil
        (get refer nm)
        (let [m (get refer nm)]
          (if-let [target (xport m nm)]
            {:target target :mode :tracking}
            (when-let [accessor (xacc m nm)]
              {:target
               (first accessor)
               :mode
               :tracking
               :accessor
               (second accessor)})))
        (get rename nm)
        (let [[m source-name] (get rename nm)]
          {:target (xport m source-name) :mode :fixed})
        (str/includes? nm "/")
        (let [[alias public-name] (str/split nm SLASH-RE 2) module (or (get as alias) (when (some (fn [table :- Any] :- Bool (contains? table alias)) [exports type-exports accessor-exports]) alias))]
          (when module
            (if-let [target (xport module public-name)]
              {:target target :mode :qual :alias alias}
              (when-let [accessor (xacc module public-name)]
                {:target
                 (first accessor)
                 :mode
                 :qual
                 :alias
                 alias
                 :accessor
                 (second accessor)}))))
        :else
        nil))))

(defn module-export-set [ctx: rr/Context view: Any ents-of: Any src: Any] -> Any
  (let [ents (vec (get ents-of src [])) exports (rm/module-exports ctx view ents) value-exports (if (seq exports) exports (rm/module-defs ctx view ents))]
    (into #{}
      (concat (keys value-exports)
        (keys (rm/module-types ctx view ents))
        (keys (rm/module-accessors ctx view ents))))))

(defn module-imports [ctx: rr/Context view: Any ents-of: Any src: Any] -> Any
  (let [{:keys [refer as rename]} (rm/parse-require ctx view (vec (get ents-of src [])))]
    (into #{} (concat (vals refer) (vals as) (map first (vals rename))))))

(defn import-graph [ctx: rr/Context view: Any ents-of: Any srcs: (Vec Any)] -> Any
  (into {}
    (map (fn [src :- Any] :- Any (let [ents (vec (get ents-of src []))] [(rm/module-name ctx view ents) (module-imports ctx view ents-of src)]))
      (filter (fn [src :- Any] :- Bool (some? (rm/module-name ctx view (vec (get ents-of src [])))))
        srcs))))

(defn module-has-macro? [ctx: rr/Context view: Any ents-of: Any src: Any] -> Bool
  (let [ents (vec (get ents-of src []))]
    (boolean (some (fn [form: Any] -> Bool (let [def-form (rm/unwrap-def ctx view form) head (first (rr/ordered-children ctx def-form))] (= "defmacro" (rr/sym-val ctx view head)))) (rm/forms-of ctx view ents)))))

(defn lift-bound-to-refers! [ctx: rr/Context KIND: Any BOUND: Any REFERS: Any] -> Any
  (when (some? BOUND)
    (doseq [event (rr/events-by-predicate ctx BOUND)]
      (let [leaf (rr/event-subject event) target (rr/event-value event)]
        (when (and (rr/live-node? ctx KIND target) (empty? (rr/events-by-subject-predicate ctx leaf REFERS)))
          (rr/assert! ctx leaf REFERS target))))))

(defn corpus-from-store! [state :- CorpusState] :- Any
  (let [t0 (System/nanoTime) groups (rw/warm-groups (:ctx state) (:corpus-cache state) name->module) t-groups (System/nanoTime) tables (rw/scoped-corpus-tables (:ctx state) (:view state) groups (:corpus-scope state)) install (:install-warm state)]
    (do
      (install groups tables)
      (when (= "1" (System/getenv "FRAM_PROF"))
        (let [profile (:profile state)]
          (profile (format "  corpus-from-store!: groups=%.1fms frames+exports=%.1fms cached=%s nsrcs=%d scoped=%s" (/ (- t-groups t0) 1000000.0) (/ (- (System/nanoTime) t-groups) 1000000.0) (some? (:corpus-cache state)) (count (:srcs tables)) (boolean (:corpus-scope state))))))
      tables)))

(defn resolve-edn! [host: CorpusHost edn-paths: (Vec Any) body: Any] -> Any
  (let [context: rr/Context (rr/context (c/new-term-store "resolve")) with-state (:with-state host)]
    (with-state context
      (fn [] -> Any
        (let [state-fn (:state host) load (:load-edn host) loaded (mapv load edn-paths) state (state-fn) install-srcs (:install-srcs state) install-tables (:install-tables state)]
          (do
            (install-srcs loaded)
            (install-tables (rw/corpus-tables (:ctx state) (:view state) loaded (deref (:file-ents state))))
            (let [run-all (:run-all state)] (run-all))
            (let [result (body)] (do (rr/commit! context) result))))))))

(defn resolve-warm-store! [host: CorpusHost store: (Atom t/TermStore) body: Any] -> Any
  (let [context: rr/Context (rr/context store) with-state (:with-state host)]
    (with-state context
      (fn [] -> Any
        (let [state-fn (:state host) state (state-fn)]
          (do
            (corpus-from-store! state)
            (when (:resolve-walk? state)
              (let [run-all (:run-all state)] (run-all))
              (lift-bound-to-refers! (:ctx state) (:KIND state) (:BOUND state) (:REFERS state)))
            (let [result (body)] (do (rr/commit! context) result))))))))

(defn resolve-modules! [host: CorpusHost store: (Atom t/TermStore) module-set: Any body: Any] -> Any
  (let [context: rr/Context (rr/context store) with-state (:with-state host)]
    (with-state context
      (fn [] -> Any
        (let [state-fn (:state host) state (state-fn)]
          (do
            (corpus-from-store! state)
            (let [fresh (state-fn) run-over (:run-over fresh)]
              (run-over (filter module-set (:srcs fresh)))
              (lift-bound-to-refers! (:ctx fresh) (:KIND fresh) (:BOUND fresh) (:REFERS fresh)))
            (let [result (body)] (do (rr/commit! context) result))))))))

(defn file-entities [file-ents :- (Atom Any) src :- Any] :- Any
  (get (deref file-ents) src []))

(defn file-entity-map [file-ents :- (Atom Any)] :- Any (deref file-ents))

(defn def-binding [modframe :- Any typeframe :- Any src :- Any nm :- Any] :- Any
  (or (get (get modframe src) nm) (get (get typeframe src) nm)))

(defn corpus-table-values [tables :- Any] :- Any
  [(:modframe tables)
   (:typeframe tables)
   (:accessors tables)
   (:exports tables)
   (:type-exports tables)
   (:accessor-exports tables)])

(defn table-srcs [tables :- Any] :- Any (:srcs tables))

(defn corpus-predicate-ids! [context: rr/Context] -> Any
  {:Vp "v"
   :KIND "kind"
   :REFERS "refers_to"
   :BOUND "bound_to"
   :FIXED "keep_spelling"
   :QUAL "qualifier"
   :CTOR "ctor_prefix"
   :ACC "accessor_field"})

(def REF-PREDICATE-RE: Regex (re-pattern "(?:f|seg|comment)\\d+"))

(defn node-reference-predicate? [predicate: Any] -> Bool
  (and (string? predicate)
    (or (= "child" predicate)
      (or (= "tail" predicate) (some? (re-matches REF-PREDICATE-RE predicate))))))

(defn load-edn! [ctx: rr/Context file-ents: (Atom Any) path: Any] -> Any
  (let [lines (str/split-lines (slurp path)) src (-> (first (filter (fn [line :- Any] :- Bool (str/starts-with? line "@file")) lines)) (subs 6)) local (atom {}) read-edn (requiring-resolve (quote clojure.edn/read-string)) ent (fn [lid :- Any] :- Any (or (get (deref local) lid) (let [e (rr/mint! ctx)] (do (swap! local assoc lid e) (swap! file-ents update src (fnil conj []) e) e))))]
    (do
      (doseq [line lines :when (str/starts-with? line "[")]
        (let [[s p o] (read-edn line)]
          (rr/assert! ctx
            (ent s)
            p
            (if (node-reference-predicate? p)
              (if (integer? o)
                (ent o)
                (throw (ex-info "resolve: structural edge target must be a local integer id" {:predicate p :target o})))
              o))))
      src)))
