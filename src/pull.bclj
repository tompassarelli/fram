#lang beagle/clj

;; ============================================================================
;; pull — the PULL API: nested-shape projection over the reified store.
;; ============================================================================
;; Coordinator-layer. Loaded by coord_daemon.clj right AFTER coord.clj, so
;; coord.clj's reader vars live in namespace `coord` and resolve here as
;; `coord/…` (declared below as externs — coord.clj is load-file'd, not a
;; classpath namespace, so it is a HOST SEAM, never a `require`).
;;
;; Two entry points, both pure over the captured store snapshot (no locks, no writes):
;;   (validate root pattern opts) -> [] | [err-string …]   ; total, never throws
;;   (run store-atom root pattern opts) -> node-map | [node-maps…] | {:error [..]}
;;
;; The store-atom `run` receives is an IMMUTABLE snapshot (the daemon hands it
;; materialize-query-snapshot's :history-store — an atom over one Store value), so
;; every read here is a pure fn of that value. `co0 {:store store-atom}` is the shape
;; coord.clj's readers expect, so live-as-of / live-members / withdrawal-of / agent-of
;; are reused VERBATIM (identical as-of + withdrawal semantics to the :as-of query op).
;;   bb -cp out tests/pull_test.clj
;; ============================================================================
(ns pull)

(define-mode strict)

(require fram.store :as c)

(require fram.schema :as s)

(require fram.types :as t)

(require clojure.string :as str)

;; --- the coord seam ---------------------------------------------------------
;; coord.clj is raw Clojure load-file'd into namespace `coord` before this module
;; loads; it is not on the classpath, so it can only be declared, never required.
(declare-extern coord/live-as-of [(Map Keyword Any) Int -> (Set Int)])

(declare-extern coord/live-members [(Map Keyword Any) Int Int Keyword -> Any])

(declare-extern coord/withdrawn? [(Map Keyword Any) Int -> Bool])

(declare-extern coord/withdrawal-of [(Map Keyword Any) Int -> Any])

(declare-extern coord/agent-of [(Map Keyword Any) Int -> Any])

(declare-extern coord/ts-of [(Map Keyword Any) Int -> Any])

(def default-max-depth :- Int 5)

(def default-max-nodes :- Int 1000)

;; predicates NEVER surfaced by :* wildcard (identity/schema/withdrawal bookkeeping,
;; mirroring coord_daemon's read-hidden/schema/reserved sets). :fram/id already carries
;; the subject name, so "name" is redundant too.
(def reserved-preds :- (Set Any)
  #{"name" "store-supersedes" "cardinality" "value_kind"
    "withdrawn_by" "withdrawn_at" "withdrawn_reason"})

(defn- reserved-pred? [p :- Any] :- Bool (contains? reserved-preds p))

;; caps may only LOWER the daemon default (mirror coord_daemon's query-limit clamping).
(defn- clamp [v :- Any default :- Int] :- Int
  (if (and (integer? v) (pos? v)) (min v default) default))

;; --- validation: total, never throws ---------------------------------------
(defn- valid-elem? [e :- Any] :- Bool
  (letfn [(valid-subpat? [sp :- Any] :- Bool
            (or (and (vector? sp) (every? (fn [x :- Any] :- Bool (elem? x)) sp))
                (and (integer? sp) (pos? sp))
                (= sp :...)))
          (elem? [x :- Any] :- Bool
            (cond
              (= x :*)    true
              (string? x) (not (str/blank? x))
              (map? x)    (and (seq x)
                               (every? (fn [k :- Any] :- Bool
                                         (and (string? k)
                                              (not (str/blank? k))
                                              (valid-subpat? (get x k))))
                                       (keys x)))
              :else       false))]
    (elem? e)))

;; Errors accumulate in SOURCE ORDER as four independent pure segments (root,
;; pattern, caps, as-of) concatenated — the reading order of the original's
;; sequential `err!` calls, with no mutable accumulator to leak purity.
(defn validate [root :- Any pattern :- Any opts :- Any] :- (Vec String)
  (let [e-root (if (or (and (string? root) (not (str/blank? root)))
                       (and (vector? root) (seq root)
                            (every? (fn [x :- Any] :- Bool
                                      (and (string? x) (not (str/blank? x))))
                                    root)))
                 []
                 ["root must be a subject-name string or a non-empty vector of name strings"])
        e-pat (if-not (vector? pattern)
                ["pattern must be a vector"]
                (vec (mapcat (fn [e :- Any] :- (Vec String)
                               (if (valid-elem? e)
                                 []
                                 [(str "malformed pattern element: " (pr-str e))]))
                             pattern)))
        e-caps (vec (mapcat (fn [k :- Keyword] :- (Vec String)
                              (let [v (get opts k)]
                                (if (and (contains? opts k)
                                         (not (and (integer? v) (pos? v))))
                                  [(str k " must be a positive integer")]
                                  [])))
                            [:max-depth :max-nodes]))
        e-asof (let [v (get opts :as-of)]
                 (if (and (contains? opts :as-of)
                          (not (and (integer? v) (>= v 0))))
                   [":as-of must be a non-negative integer"]
                   []))]
    (vec (concat e-root e-pat e-caps e-asof))))

;; --- the projection ---------------------------------------------------------
;; Unknown root: pull is a projection, and an absent subject simply has no facts, so
;; an unresolved root renders as a bare {:fram/id <root>} (no predicate keys) — a
;; sensible empty node, NOT an error. (Chosen over :error so a vector root mixing
;; known + unknown names still returns one node per requested root.)
(defn run [store-atom :- (Atom t/Store) root :- Any pattern :- Any opts :- Any] :- Any
  (let [errs (validate root pattern opts)]
    (if (seq errs)
      {:error errs}
      (let [st        store-atom
            co0 :- (Map Keyword Any) {:store store-atom}
            asof      (get opts :as-of)
            asof-set  (if (some? asof) (coord/live-as-of co0 asof) nil)
            prov?     (boolean (get opts :provenance))
            max-depth (clamp (get opts :max-depth) default-max-depth)
            max-nodes (clamp (get opts :max-nodes) default-max-nodes)
            state :- (Atom Int) (atom 0)]
        (letfn [(pid-of [p :- Any] :- Int? (c/value-id st p))
                (nm-of [id :- Int] :- Any (or (s/name-of st id) id))
                ;; restrict a raw cid list to the live view — as-of set membership when
                ;; historical, else the store's own live filter.
                (flive [cids :- (Vec Int)] :- (Vec Int)
                  (if (some? asof-set)
                    (filterv (fn [x :- Int] :- Bool (contains? asof-set x)) cids)
                    (filterv (fn [x :- Int] :- Bool (c/live? st x)) cids)))
                (raw-lp [lid :- Int pid :- Int] :- (Vec Int)
                  (let [m :- t/Store (deref st)] (get (:idx-by-lp m) [lid pid] [])))
                (raw-pr [pid :- Int rid :- Int] :- (Vec Int)
                  (let [m :- t/Store (deref st)] (get (:idx-by-pr m) [pid rid] [])))
                (raw-l [lid :- Int] :- (Vec Int)
                  (let [m :- t/Store (deref st)] (get (:idx-by-l m) lid [])))
                (fwd-cids [lid :- Int pid :- Int] :- (Vec Int)
                  (cond
                    (some? asof-set) (flive (raw-lp lid pid))
                    ;; provenance surfaces WITHDRAWN members too (add-wins resurrects a
                    ;; cancelled value while a genuine overwrite still hides) — that is
                    ;; what makes :withdrawn/:withdrawn_by meaningful in the current view.
                    prov?            (vec (coord/live-members co0 lid pid :add-wins))
                    :else            (flive (raw-lp lid pid))))
                (rev-cids [pid :- Int rid :- Int] :- (Vec Int) (flive (raw-pr pid rid)))
                ;; a leaf value: literal or (for a ref) the target's name string. In
                ;; provenance mode each value carries its cid/agent/seq/withdrawn stamp.
                ;; as-of: a rendered member is live AS OF S, so its withdrawal state at S
                ;; is false (a value withdrawn after S is still live at S).
                (leaf [cid :- Int] :- Any
                  (let [cl (c/fact-of st cid)
                        r  (get cl :r)
                        v  (if (c/value-object? st r) (c/literal st r) (nm-of r))]
                    (if-not prov?
                      v
                      (let [tx   (c/fact-tx st cid)
                            wd   (if (some? asof) nil (coord/withdrawn? co0 cid))
                            ;; wall-clock of the asserting tx (ISO-8601 string). DISPLAY-ONLY
                            ;; metadata: :seq stays the causal address, :ts never drives as-of.
                            ;; nil for pre-existing v2 txs whose record predates the :ts field
                            ;; (and for internal txs that never stamped) -> the key is OMITTED.
                            ts   (coord/ts-of co0 cid)
                            base (cond-> {:val v :cid cid
                                          :by (coord/agent-of co0 cid)
                                          :seq (if (some? tx) (c/tx-seq st tx) 0)
                                          :withdrawn (boolean wd)}
                                   (some? ts) (assoc :ts ts))]
                        (if wd
                          (let [w (coord/withdrawal-of co0 cid)]
                            (assoc base :withdrawn_by (get w :by)
                                        :withdrawn_at (get w :at)
                                        :withdrawn_reason (get w :reason)))
                          base)))))
                ;; cardinality FACT drives scalar (single) vs vector (multi) rendering.
                (values [pname :- Any pid :- Int lid :- Int] :- Any
                  (let [cids (fwd-cids lid pid)]
                    (when (seq cids)
                      (let [vs (mapv (fn [x :- Int] :- Any (leaf x)) cids)]
                        (if (= "single" (s/cardinality st pname)) (first vs) vs)))))
                ;; normalize a subpattern token into a pattern vector for the next level.
                (subpat->pattern [k :- Any sp :- Any] :- Any
                  (cond (vector? sp)  sp
                        (integer? sp) (if (> sp 1) [{k (dec sp)}] [])
                        (= sp :...)   [{k :...}]
                        :else         []))
                (recur-target [tid :- Int subpat :- Any depth :- Int visited :- (Set Int)] :- Any
                  (if (> (inc depth) max-depth)
                    {:fram/id (nm-of tid) :fram/truncated true}
                    (node tid (nm-of tid) subpat (inc depth) visited)))
                (elem [acc :- Any lid :- Int depth :- Int visited :- (Set Int) e :- Any] :- Any
                  (cond
                    (= e :*)
                    (reduce (fn [a :- Any pid :- Int] :- Any
                              (let [pname (c/literal st pid)]
                                (if (reserved-pred? pname)
                                  a
                                  (let [v (values pname pid lid)]
                                    (if (some? v) (assoc a pname v) a)))))
                            acc
                            (distinct (map (fn [x :- Int] :- Any (get (c/fact-of st x) :p))
                                           (flive (raw-l lid)))))

                    (and (string? e) (str/starts-with? e "_"))
                    (let [pid (pid-of (subs e 1))]
                      (if (nil? pid)
                        acc
                        (let [ls (mapv (fn [x :- Int] :- Any (get (c/fact-of st x) :l))
                                       (rev-cids pid lid))]
                          (assoc acc e (mapv (fn [l :- Any] :- Any
                                               (node l (nm-of l) [] (inc depth) visited))
                                             ls)))))

                    (string? e)
                    (let [pid (pid-of e)]
                      (if (nil? pid)
                        acc
                        (let [v (values e pid lid)]
                          (if (some? v) (assoc acc e v) acc))))

                    (map? e)
                    (reduce
                     (fn [a :- Any k :- Any] :- Any
                       (let [sp (get e k)]
                         (if (str/starts-with? k "_")
                           (let [pid (pid-of (subs k 1))]
                             (if (nil? pid)
                               a
                               (let [ls (mapv (fn [x :- Int] :- Any (get (c/fact-of st x) :l))
                                              (rev-cids pid lid))]
                                 (assoc a k (mapv (fn [l :- Any] :- Any
                                                    (recur-target l (subpat->pattern k sp) depth visited))
                                                  ls)))))
                           (let [pid (pid-of k)]
                             (if (nil? pid)
                               a
                               (let [cids (fwd-cids lid pid)
                                     rendered (mapv (fn [cid :- Int] :- Any
                                                      (let [r (get (c/fact-of st cid) :r)]
                                                        (if (c/value-object? st r)
                                                          (c/literal st r)
                                                          (recur-target r (subpat->pattern k sp) depth visited))))
                                                    cids)]
                                 (if (seq rendered)
                                   (assoc a k (if (= "single" (s/cardinality st k)) (first rendered) rendered))
                                   a)))))))
                     acc (keys e))

                    :else acc))
                (node [rid :- Any nm :- Any pat :- Any depth :- Int visited :- (Set Int)] :- Any
                  (cond
                    (contains? visited rid) {:fram/id nm :fram/cycle true}
                    (>= (deref state) max-nodes) {:fram/id nm :fram/truncated true}
                    :else
                    (do (swap! state (fn [n :- Int] :- Int (inc n)))
                        (reduce (fn [acc :- Any e :- Any] :- Any
                                  (elem acc rid depth (conj visited rid) e))
                                {:fram/id nm} pat))))]
          (let [one (fn [r :- Any] :- Any
                      (let [rid (s/resolve-name st r)]
                        (if (nil? rid) {:fram/id r} (node rid r pattern 0 #{}))))]
            (if (vector? root) (mapv (fn [r :- Any] :- Any (one r)) root) (one root))))))))
