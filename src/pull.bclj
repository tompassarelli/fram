me v) a))))) acc (distinct (map (fn [x :- Int] :- Any (get (c/fact-of st x) :p)) (flive (raw-l lid))))) (and (string? e) (str/starts-with? e "_")) (let [pid (pid-of (subs e 1))] (if (nil? pid) acc (let [ls (mapv (fn [x :- Int] :- Any (get (c/fact-of st x) :l)) (rev-cids pid lid))] (assoc acc e (mapv (fn [l :- Any] :- Any (node l (nm-of l) [] (inc depth) visited)) ls))))) (string? e) (let [pid (pid-of e)] (if (nil? pid) acc (let [v (values e pid lid)] (if (some? v) (assoc acc e v) acc)))) (map? e) (reduce (fn
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                