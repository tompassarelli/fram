          (let [one (fn [r :- Any] :- Any (let [rid (s/resolve-name st r)] (if (nil? rid) {:fram/id r} (node rid r pattern 0 #{}))))]
            (if (vector? root)
              (mapv (fn [r :- Any] :- Any (one r)) root)
              (one root))))))))
