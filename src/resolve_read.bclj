#lang beagle/clj

;; ============================================================================
;; resolve-read — the view-relative READ layer over the fact graph.
;; ============================================================================
;; Stage M1 Cut B of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). Everything a reader needs to turn a
;; pile of facts back into an ordered syntax tree: which member of a live (l,p)
;; group the current VIEW elects, what a predicate says about a node, and the
;; node's children in CRDT-key order.
;;
;; WHY THE STORE IS A PARAMETER HERE AND A DYNAMIC VAR THERE. resolve.clj holds
;; `ctx`/`*view*`/`BOUND`/`REFERS`/`KIND` in ^:dynamic vars, and coord_daemon.clj
;; plus tests/coord_*.clj `binding` them by their QUALIFIED names (resolve/ctx,
;; resolve/*view*, ...). A dynamic var cannot be moved to another namespace
;; without breaking those: a `(def ctx rr/ctx)` alias copies the value (so
;; `binding` no longer reaches the reader) and a `:refer` alias leaves
;; `resolve/ctx` unresolvable (Clojure's qualified-symbol lookup is
;; findInternedVar, which ignores referred vars). So the VARS stay in resolve.clj
;; as the host state seam and the LOGIC moves here with the state passed
;; explicitly; resolve.clj keeps a one-line wrapper per name that reads the var.
;; Every call site in resolve.clj, coord_daemon.clj and the tests is unchanged.
;;
;; Consumed by resolve.clj (aliases these behind wrappers) — so the emitted
;; out/resolve_read.clj must stay on the classpath.
;; ============================================================================
(ns resolve-read
  (:require [fram.types :as t]
    [fram.store :as c]
    [fram.schema :as schema]
    [fram.rotation :as rot]
    [fram.txn :as txn]
    [resolve-core :as rc]))

(define-mode strict)

(def SEG-RE :- Any (re-pattern "seg\\d+"))

(defrecord Context [session: schema/Session builder: (Atom txn/Builder) shadow: (Atom t/TermStore) shadow-view: (Atom rot/Rotation)])

(defrecord OrdPair [key: rc/OrdKey event: t/Triple child: Any])

(defrecord SegPair [idx: Int event: t/Triple child: Any])

(defn context [store: (Atom t/TermStore)] -> Context
  (let [session: schema/Session (schema/session store)
        shadow: (Atom t/TermStore) (atom (deref store))]
    (->Context session (txn/open store) shadow (atom (rot/project shadow)))))

(defn store-of [ctx: Context] -> (Atom t/TermStore)
  (schema/store-of (context-session ctx)))

(defn builder [ctx: Context] -> (Atom txn/Builder) (context-builder ctx))

(defn current-view [ctx: Context] -> rot/Rotation
  (deref (context-shadow-view ctx)))

(defn- stage-appended! [ctx: Context before: Int] -> Context
  (let [operations: (Vec t/CommitOperation) (txn/operations (builder ctx))
        appended: (Vec t/CommitOperation) (subvec operations before (count operations))]
    (do
      (when (not (empty? appended))
        (do
          (c/commit-transaction! (context-shadow ctx) appended)
          (reset! (context-shadow-view ctx)
            (rot/refresh (current-view ctx) (context-shadow ctx)))))
      ctx)))

(defn mint! [ctx: Context] -> t/Triple
  (txn/mint! (builder ctx)))

(defn assert! [ctx: Context subject: Any predicate: Any value: Any] -> t/Triple
  (let [before (txn/operation-count (builder ctx))
        occurrence: t/Triple (txn/assert! (builder ctx) (t/triple subject predicate value))]
    (do (stage-appended! ctx before) occurrence)))

(defn update-single! [ctx: Context subject: Any predicate: Any value: Any] -> t/Triple
  (let [before (txn/operation-count (builder ctx))
        occurrence: t/Triple (txn/update-single! (builder ctx) (current-view ctx) subject predicate value)]
    (do (stage-appended! ctx before) occurrence)))

(defn retract-event! [ctx: Context event: t/Triple] -> t/Triple
  (let [before (txn/operation-count (builder ctx))
        occurrence: t/Triple (txn/retract! (builder ctx) (rot/proposition-of event))]
    (do (stage-appended! ctx before) occurrence)))

(defn commit! [ctx: Context] -> Any
  (if (zero? (txn/operation-count (builder ctx)))
    nil
    (let [coordinate: t/Triple (txn/commit! (store-of ctx) (builder ctx))]
      (do
        (schema/refresh! (context-session ctx))
        (reset! (context-builder ctx) (deref (txn/open (store-of ctx))))
        (reset! (context-shadow ctx) (deref (store-of ctx)))
        (reset! (context-shadow-view ctx) (schema/view (context-session ctx)))
        coordinate))))

(defn events-by-subject [ctx: Context subject: Any] -> (Vec t/Triple)
  (rot/by-slot0 (current-view ctx) subject))

(defn events-by-subject-predicate [ctx: Context subject: Any predicate: Any] -> (Vec t/Triple)
  (rot/by-slot01 (current-view ctx) subject predicate))

(defn events-by-predicate [ctx: Context predicate: Any] -> (Vec t/Triple)
  (rot/by-slot1 (current-view ctx) predicate))

(defn event-subject [event: t/Triple] -> Any
  (t/triple-slot0 (rot/proposition-of event)))

(defn event-predicate [event: t/Triple] -> Any
  (t/triple-slot1 (rot/proposition-of event)))

(defn event-value [event: t/Triple] -> Any
  (t/triple-slot2 (rot/proposition-of event)))

(defn view-cids [ctx: Context v: Any events: (Vec t/Triple)] -> (Vec t/Triple)
  (let [selected: (Set Any) (set (rot/values (rot/by-slot01 (current-view ctx) v "selects")))]
    (filterv (fn [event: t/Triple] -> Bool (contains? selected (rot/occurrence-of event))) events)))

(defn- pool-of [ctx: Context view: Any events: (Vec t/Triple)] -> (Vec t/Triple)
  (let [in-view: (Vec t/Triple) (if (nil? view) [] (view-cids ctx view events))]
    (if (empty? in-view) events in-view)))

(defn select-main-1 [ctx: Context? view: Any events: (Vec Any)] -> Any
  (if (empty? events)
    nil
    (if (nil? ctx)
      (first events)
      (first (pool-of ctx view events)))))

(defn select-causal-1 [ctx: Context? view: Any events: (Vec Any)] -> Any
  (select-main-1 ctx view events))

(defn- event-r [event: t/Triple?] -> Any
  (if (nil? event) nil (event-value event)))

(defn pred-val [ctx: Context? view: Any e: Any pname: Any] -> Any
  (if (or (nil? ctx) (nil? e))
    nil
    (event-r (select-main-1 ctx view (events-by-subject-predicate ctx e pname)))))

(defn kind-of [ctx: Context? view: Any e: Any] -> Any
  (pred-val ctx view e "kind"))

(defn sym-val [ctx: Context? view: Any e: Any] -> Any
  (if (= "symbol" (kind-of ctx view e)) (pred-val ctx view e "v") nil))

(defn ordered-children [ctx: Context? e: Any] -> (Vec Any)
  (if (or (nil? ctx) (nil? e))
    []
    (let [pairs: (Vec OrdPair)
          (reduce (fn [acc: (Vec OrdPair) event: t/Triple] -> (Vec OrdPair)
                    (let [predicate: Any (event-predicate event)
                          key: rc/OrdKey? (if (string? predicate) (rc/ord-parse predicate) nil)]
                      (if (nil? key) acc (conj acc (->OrdPair key event (event-value event))))))
            []
            (events-by-subject ctx e))]
      (mapv (fn [pair: OrdPair] -> Any (ordpair-child pair))
        (sort-by (fn [pair: OrdPair] -> rc/OrdKey (ordpair-key pair)) rc/ord-cmp pairs)))))

(defn ordered-segs [ctx: Context? e: Any] -> (Vec Any)
  (if (or (nil? ctx) (nil? e))
    []
    (let [pairs: (Vec SegPair)
          (reduce (fn [acc: (Vec SegPair) event: t/Triple] -> (Vec SegPair)
                    (let [predicate: Any (event-predicate event)]
                      (if (and (string? predicate) (some? (re-matches SEG-RE predicate)))
                        (let [idx (parse-long (subs predicate 3))]
                          (if (nil? idx) acc (conj acc (->SegPair idx event (event-value event)))))
                        acc)))
            []
            (events-by-subject ctx e))]
      (mapv (fn [pair: SegPair] -> Any (segpair-child pair))
        (sort-by (fn [pair: SegPair] -> Int (segpair-idx pair)) pairs)))))

(defn head-sym [ctx: Context? view: Any e: Any] -> Any
  (if (= "list" (kind-of ctx view e))
    (sym-val ctx view (first (ordered-children ctx e)))
    nil))

(defn unwrap-meta [ctx: Context? view: Any e: Any] -> Any
  (loop [current: Any e n 0]
    (if (and (some? current) (< n 64) (= "#%meta" (head-sym ctx view current)))
      (recur (nth (ordered-children ctx current) 2 nil) (inc n))
      current)))

(defn bound-target [ctx: Context? view: Any BOUND: Any leaf: Any] -> Any
  (if (or (nil? ctx) (nil? BOUND) (nil? leaf))
    nil
    (event-r (select-main-1 ctx view (events-by-subject-predicate ctx leaf BOUND)))))

(defn refers-target [ctx: Context? view: Any BOUND: Any REFERS: Any leaf: Any] -> Any
  (let [bt: Any (bound-target ctx view BOUND leaf)]
    (if (some? bt)
      bt
      (if (or (nil? ctx) (nil? REFERS) (nil? leaf))
        nil
        (event-r (select-main-1 ctx view (events-by-subject-predicate ctx leaf REFERS)))))))

(defn live-node? [ctx: Context? KIND: Any e: Any] -> Bool
  (if (or (nil? ctx) (nil? KIND) (nil? e))
    false
    (not (empty? (events-by-subject-predicate ctx e KIND)))))

;; A (child-position-key, child-node) pair, sorted to produce ordered-children.

;; A record rather than the original's 2-vector because the pair is fixed-shape

;; and the sort key is typed: sorting a (Vec Any) by `first` would hand ord-cmp

;; an Any and lose the OrdKey contract the comparator actually needs.

;; `#"…"` cannot cross the graph-edit datum channel (the verb payload is read as

;; EDN and `#"` is a Clojure reader macro), so the segment pattern is spelled with

;; re-pattern and hoisted to a top-level def — compiled once, as the literal was.

;; PER-DEF NOTES (the graph-edit datum channel carries FORMS, not text, so a

;; comment cannot ride inside an authored form; the load-bearing prose lives

;; here instead — same convention as src/pull.bclj).

;; ---------------------------------------------------------------------------

;;   SegPair

;;     The segN twin: comment segments carry an integer index, not an order key.

;;   view-cids

;;     --------------------------------------------------------------- election ---

;;   pool-of

;;     The election pool: a bound view narrows the group to the cids it selects, and

;;     inherits main wherever it selects none of them.

;;   event-r

;;     ------------------------------------------------------------- node reads ---

;;     The object Term of an elected occurrence. Nil selection propagates as no value;
;;     node and predicate identities are otherwise never narrowed by this layer.

;;   kind-of

;;     default-main kind of node e

;;   sym-val

;;     default-main spelling of a symbol

;;   ordered-children

;;     ---------------------------------------------------------- ordered reads ---

;;     fN children, in CRDT-key (path,tie) order.

;;   ordered-segs

;;     Turtle #6: a comment node's segN children, in order.

;;   unwrap-meta

;;     D2: peel leading (#%meta <metadata> <target>) wrappers to reach the bound form.

;;     A metadata-annotated def NAME — `(def ^:dynamic *x* 1)` ingests its name slot

;;     as `(#%meta {:dynamic true} *x*)` — hides the symbol from a bare `sym-val`.

;;     Metas nest left (`^a ^b x` = `(#%meta a (#%meta b x))`), so loop to the

;;     innermost target (the 3rd child). nil-safe: a malformed/absent target falls

;;     through to nil.

;;   bound-target

;;     ------------------------------------------------------------- identity ----

;;   live-node?

;;     Does the node still carry a `kind` — i.e. was it not retired out of the graph?
