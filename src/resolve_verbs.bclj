#lang beagle/clj

;; ============================================================================
;; resolve-verbs — THE AUTHORING VERBS: an edit is a FACT OPERATION.
;; ============================================================================
;; Stage M1 Cut H of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). These are the standalone authoring
;; verbs — rename / upsert-form / insert-form / insert-comment / set-body /
;; replace-in-body / delete / reorder — plus the graph-path dispatcher. Each one
;; checks its INVARIANTS first (collision, no-capture, no-orphaned-refs, shape,
;; anchor uniqueness) and, only if every one holds, mutates FACTS: mint the new
;; subtree, supersede the edges it replaces, never touch text. A rejected edit
;; mutates nothing.
;;
;; The verbs are STORE-AGNOSTIC by construction — they read the corpus tables and
;; write via fact!/value!/retire, so the SAME body runs on the text path (-main,
;; over resolve-edn! of emit-edn(text)) and on the graph path (run-verb-warm!,
;; over a LOG-booted warm store).
;;
;; STRUCTURAL ADAPTATIONS, all forced and all behavior-preserving:
;;
;;   1. STATE IS A PARAMETER (Cuts B–G's rule). resolve.clj's ^:dynamic vars
;;      cannot change namespace (coord_daemon.clj and tests/coord_*.clj `binding`
;;      them by qualified name), so the store, view, tx, the predicate value-ids,
;;      the corpus tables, the two reject arities and every resolve.clj-local
;;      helper the verbs call arrive HERE as one explicit `Verb` record that
;;      resolve.clj's `verb-env` builds from the dynamic state at call time.
;;
;;   2. THE HELPERS STAY BEHIND, AS CLOSURES. mint-datum! / retire-fact! /
;;      extract-file! / capture-refs / datum->canon / the disambiguation payload
;;      builder are resolve.clj's (they touch reader metadata, java.util.regex,
;;      clojure.edn and the projection writer — host surfaces this port does not
;;      move). They ride in the record as function VALUES, exactly as Cut G's
;;      xres/tres/ares did. What moved is the verb LOGIC: the invariant order,
;;      the reject codes + messages, the fact mutations and the emit reporting.
;;
;;   3. `binding [*out* *err*]` CANNOT MOVE (it rebinds a host dynamic var), so
;;      stderr reporting is one closure, `warn`, called once per LINE. The
;;      goldens compare bytes, so line order and spelling are preserved verbatim.
;;
;;   4. TWO REJECT ARITIES. Callers bind *reject!* with either arity — tests
;;      bind `(fn [code] …)`, the daemon `(fn [code & [detail]] …)` — so the
;;      record carries `reject` (1-arg) and `reject2` (2-arg, the structured
;;      disambiguation payload path) and each call site keeps its original arity.
;;
;; PER-DEF NOTES (the rationale that rode with the originals):
;;   verb-rename!      O(1) shadow-correct rename: the four invariants
;;                     (rename-doesn't-collide, beagle type-name shape,
;;                     no-capture, no-import-collision) then ONE fact per
;;                     definition name — references follow refers_to.
;;   verb-upsert-form! add OR replace a top-level def from an EDN datum. A
;;                     replace reuses the victim's CRDT path (new tie); an append
;;                     lands strictly after the last form.
;;   verb-insert-form! the CRDT MIDDLE-INSERT (#36): a path strictly between the
;;                     anchor and its next sibling — concurrent inserts after the
;;                     same anchor get distinct ties and BOTH land (commute).
;;   verb-insert-comment! author a standalone line comment (Turtle #6): a
;;                     kind="comment" node + one `text` seg + a commentN edge.
;;   verb-set-body!    replace a def/defn's body: supersede every body fN edge,
;;                     mint the new body, wire it at the first body slot. Handles
;;                     both the defn shape (body after the [param] vector) and
;;                     the value-def shape (body after the NAME).
;;   verb-replace-in-body! the SUB-DEF surgical edit — swap ONE interior form,
;;                     addressed structurally by an anchor datum, reusing the
;;                     matched edge's EXACT position literal (byte-stable; the
;;                     def is never re-minted, so siblings + comments survive).
;;   verb-delete!      remove a top-level def by superseding the wrapper's form
;;                     edge; fail-closed on any surviving reference (orphans).
;;   verb-reorder!     MOVE a def by re-spelling its wrapper order key — same
;;                     subtree, zero node churn, identity preserved.
;;   dispatch-verb!    run-verb-warm!'s op table (the portable half; the dynamic
;;                     `binding` scaffolding it runs inside stays in resolve.clj).
;;
;; Consumed by resolve.clj — the emitted out/resolve_verbs.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-verbs
  (:require [clojure.string :as str]
    [fram.types :as t]
    [fram.store :as c]
    [resolve-core :as rc]
    [resolve-read :as rr]
    [resolve-binds :as rb]
    [resolve-modules :as rm]))

(define-mode strict)

;; The verb environment: the dynamic state of resolve.clj, handed over explicitly.
;; Everything typed `Any` here is a HOST CLOSURE (a resolve.clj function that reads
;; the dynamic state) or a corpus table keyed by src — the same `Any` boundary Cut
;; G's xres/tres/ares sit on. GAP: Beagle cannot name "a Clojure map whose keys are
;; arbitrary node ids" or a variadic host fn more precisely than Any.
(defrecord Verb [ctx :- (Atom t/Store)
                 view :- Any
                 tx :- Int
                 SUP :- Int
                 KIND :- Int
                 Vp :- Int
                 srcs :- (Vec String)
                 capture-only? :- Bool
                 emit-srcs :- (Vec String)
                 reject :- Any          ; (fn [code]) — the 1-arg reject every verb but replace-in-body uses
                 reject2 :- Any         ; (fn [code detail]) — structured disambiguation payload
                 warn :- Any            ; (fn [line]) — one println to *err*
                 emit :- Any            ; (fn [op detail]) — author-emit-scoped!
                 extract :- Any         ; (fn [src]) — extract-file! src (out-path src)
                 out-path :- Any        ; (fn [src]) -> the projected EDN path
                 def-binding :- Any     ; (fn [src nm]) -> value OR type binding node
                 typeframe :- Any       ; {src -> {type-name -> node}}
                 modframe :- Any        ; {src -> {name -> node}}
                 forms-of :- Any        ; (fn [src]) -> top-level forms
                 module-name :- Any     ; (fn [src]) -> the ns-form module name
                 parse-require :- Any   ; (fn [src]) -> {:refer .. :as .. :rename ..}
                 capture-refs :- Any    ; (fn [node scope B new]) -> captured refs
                 ultimate :- Any        ; (fn [B]) -> follow refers_to to the node that HOLDS the name
                 BOUND :- Int           ; the durable bound_to predicate id
                 REFERS :- Int          ; the derived refers_to predicate id
                 wrapper-of :- Any      ; (fn [src]) -> the beagle-file wrapper node
                 wrap-forms :- Any      ; (fn [wrap]) -> [[OrdKey cid child] …], CRDT-ordered
                 form-for-victim :- Any ; (fn [src victim]) -> the top-level form named by `victim`
                 descendants :- Any     ; (fn [root]) -> root + every structural descendant
                 retire :- Any          ; (fn [cid]) -> supersede a fact with no replacement
                 reresolve :- Any       ; (fn []) -> re-walk the corpus so fresh refs carry refers_to
                 ents :- Any            ; {src -> [entity …]} — @file->ents, snapshotted
                 mint :- Any            ; (fn [src datum]) -> mint-datum!: an EDN datum as fresh facts
                 register :- Any        ; (fn [src e]) -> register! a fresh entity in file->ents
                 scope-srcs :- Any      ; (fn [scope]) -> scope->srcs: dot-SEGMENT-boundary module match
                 writable-victim :- Any ; (fn [src datum]) -> the top-level form this upsert REPLACES
                 writable-disp-name :- Any  ; (fn [datum]) -> the human label for the upserted form
                 fn-facts :- Any])      ; (fn [parent]) -> [[N cid child] …] over LIVE fN edges, ordered

;; ---------------------------------------------------------------------------
;; rename — every INVARIANT + fact mutation of the old `rename` case arm.
;; ---------------------------------------------------------------------------
;; the `^[A-Z]` shape test of the original, spelled without a regex literal
;; (`#"…"` cannot cross the graph-edit datum channel — resolve_read.bclj's rule):
;; ASCII A–Z is exactly the closed string range "A".."Z".
(defn- upper-first? [s :- String] :- Bool
  (and (> (count s) 0)
       (let [c (subs s 0 1)] (and (>= (compare c "A") 0) (<= (compare c "Z") 0)))))

(defn verb-rename! [v :- Verb old :- String new :- String target :- String] :- Any
  (let [ctx (:ctx v)
        tx (:tx v)
        srcs (:srcs v)
        warn (:warn v)
        reject (:reject v)
        dbind (:def-binding v)
        target-srcs (vec (filter (fn [s :- String] :- Bool (str/includes? s target)) srcs))
        edits (atom 0)]
    (doseq [src :- String target-srcs]
      (when (and (some? (dbind src old)) (some? (dbind src new)))
        (warn (str "REJECTED — `" new "` already names a binding in " src
                   " (rename-doesn't-collide; no facts mutated)."))
        (reject 3)))
    (doseq [src :- String target-srcs]
      (when (and (some? (get (get (:typeframe v) src) old)) (not (upper-first? new)))
        (warn (str "REJECTED — `" new "` is not a valid (Capitalized) type name "
                   "(beagle type-name shape; no facts mutated)."))
        (reject 3)))
    (doseq [src :- String target-srcs]
      (let [B (dbind src old)]
        (when (some? B)
          (let [crefs (:capture-refs v)
                fo (:forms-of v)
                caps (vec (mapcat (fn [s :- String] :- (Vec Any)
                                    (vec (mapcat (fn [f :- Any] :- (Vec Any)
                                                   (vec (crefs f (list (get (:modframe v) s)) B new)))
                                                 (vec (fo s)))))
                                  srcs))]
            (when (> (count caps) 0)
              (warn (str "REJECTED — renaming `" old "` -> `" new "` would be CAPTURED by a local `"
                         new "` in scope at " (count caps) " reference(s) (no-capture; no facts mutated)."))
              (reject 4))))))
    (let [mn (:module-name v)
          target-mods (set (vec (keep (fn [s :- String] :- Any (mn s)) target-srcs)))]
      (doseq [src :- String (vec (remove (fn [s :- String] :- Bool (some? (some (fn [t :- String] :- Any (when (= t s) t)) target-srcs))) srcs))]
        ;; GAP (beagle clj emitter): a keyword-access form applied DIRECTLY in call
        ;; position — `((:parse-require v) src)` — type-checks but crashes emit-clj
        ;; (symbol->string contract violation on the kw-access node). Every closure
        ;; field in this module is therefore let-bound before it is called.
        (let [preq (:parse-require v)
              pr (preq src)
              refer (get pr :refer)
              rename (get pr :rename)
              home (get refer old)]
          (when (and (some? home) (contains? target-mods home)
                     (or (some? (dbind src new)) (some? (get refer new)) (some? (get rename new))))
            (warn (str "REJECTED — renaming `" old "` -> `" new "` would DUPLICATE a binding in consumer "
                       src " (it already binds `" new "`; no-import-collision; no facts mutated)."))
            (reject 3)))))
    (doseq [src :- String target-srcs]
      (let [B (dbind src old)]
        (when (some? B)
          (let [oldc (first (vec (filter (fn [cid :- Int] :- Bool (= (:Vp v) (get (c/fact-of ctx cid) :p)))
                                         (c/by-l ctx B))))
                nc (c/fact! ctx B (:Vp v) (c/value! ctx new) tx)]
            (when (some? oldc) (c/fact! ctx nc (:SUP v) oldc tx))
            (swap! edits (fn [n :- Int] :- Int (+ n 1)))))))
    (when (= 0 @edits)
      (warn (str "REJECTED — no binding named `" old "` found in \"" target
                 "\" (nothing to rename; no facts mutated)."))
      (reject 5))
    ;; capture-only (daemon :edit-min): the name fact is mutated above; SKIP the
    ;; whole-corpus projection — the daemon commits the captured op + re-resolves scoped.
    (when-not (:capture-only? v)
      (let [ex (:extract v)
            op (:out-path v)]
        (doseq [src :- String (:emit-srcs v)] (ex src))
        (warn "================ Turtle #5 — O(1) shadow-correct rename ================")
        (warn (str "edit: rename def `" old "` -> `" new "` in \"" target "\""))
        (warn (str "FACTS EDITED: " @edits "  (just the definition's name; references follow refers_to)"))
        (doseq [src :- String (:emit-srcs v)] (warn (str "projected -> " (op src) "   <- " src)))))))

;; ---------------------------------------------------------------------------
;; the CRDT tie a verb writes. On the daemon (capture-only) path defer to
;; "PENDING" — the daemon sets the tie to the new node's ATOMIC name-int, so
;; concurrent same-path inserts get distinct keys and BOTH land (commute). The
;; single-writer CLI path has no race -> tie "0".
;; ord-str* is rc/ord-str with a STRING tie: the sentinel "PENDING" is not an
;; integer, and rc/ord-str's tie is typed Int (it serves the parsed-key side).
;; ---------------------------------------------------------------------------
;; nn — the -1 coercion Cut G used, for the two places beagle needs an Int and the
;; host hands over an Int?: an ABSENT index (`first` over keep-indexed types as
;; Int? and does not narrow on a some?/nil? test at the use site) and a node id
;; that arrives from a closure. In both, the nil case is one the verb has already
;; REJECTED, so -1 is unreachable, not a written value.
(defn- nn [e :- Int?] :- Int (if (nil? e) -1 e))

;; a wrap-forms ENTRY is [OrdKey cid child]. The accessors coerce through `vec`
;; because the entry arrives from a host closure as Any (and, where the entry is
;; an optional `some` result, as Nil on the branch the caller has already
;; rejected) — `nth` needs a vector, and this is the one place to say so.
(defn- ekey [e :- Any] :- Any (nth (vec e) 0))

(defn- ecid [e :- Any] :- Any (nth (vec e) 1))

(defn- enode [e :- Any] :- Any (nth (vec e) 2))

(defn- ord-tie [v :- Verb] :- String (if (:capture-only? v) "PENDING" "0"))

(defn- ord-str* [path :- (Vec Int) tie :- String] :- String
  (str "f" (str/join "." path) "~" tie))

;; ---------------------------------------------------------------------------
;; delete — remove a top-level def by name. FACT-NATIVE + fail-closed: the
;; EFFECT is a supersede of the wrapper's fN form-edge fact(s) pointing at the
;; deleted form(s). Retiring that edge makes the form unreachable from the
;; beagle-file wrapper, so (a) the minimal-op harvest (do-edit-min) sees a
;; RETRACT of the wrapper edge and (b) the render path's reachability filter
;; drops the orphaned subtree — ONE mechanism serves both drivers. A delete that
;; would ORPHAN a surviving reference REFUSES (no facts mutated).
;; ---------------------------------------------------------------------------
(defn verb-delete! [v :- Verb name :- String scope :- String] :- Any
  (let [ctx (:ctx v)
        view (:view v)
        srcs (:srcs v)
        warn (:warn v)
        reject (:reject v)
        dbind (:def-binding v)
        ffv (:form-for-victim v)
        desc (:descendants v)
        ult (:ultimate v)
        target-srcs (vec (filter (fn [s :- String] :- Bool (str/includes? s scope)) srcs))
        ;; value OR type binding occurrences to delete
        victims (vec (keep (fn [s :- String] :- Any (dbind s name)) target-srcs))
        ;; the top-level forms to remove + their whole subtrees (incl. a defunion's
        ;; variant-constructor name-leaves). Computed FIRST so the orphan check both
        ;; excludes refs INSIDE a deleted form and flags surviving refs to ANY binding
        ;; the deletion removes (the union name OR a variant).
        all-forms (set (vec (mapcat (fn [s :- String] :- (Vec Any)
                                      (vec (keep (fn [b :- Any] :- Any (ffv s b)) victims)))
                                    srcs)))
        subtree (reduce (fn [acc :- (Set Any) f :- Any] :- (Set Any) (into acc (desc f)))
                        #{} (vec all-forms))
        orphans (vec (mapcat (fn [s :- String] :- (Vec Any)
                               (vec (filter (fn [e :- Any] :- Bool
                                              (let [tgt (rr/refers-target ctx view (:BOUND v) (:REFERS v) e)]
                                                (and (= "symbol" (rr/kind-of ctx view e))
                                                     (some? tgt)
                                                     (not (contains? subtree e))
                                                     (contains? subtree (ult tgt)))))
                                            (vec (get (:ents v) s [])))))
                             srcs))]
    (when (= 0 (count victims))
      (warn (str "REJECTED — no binding named `" name "` found in \"" scope "\" (nothing to delete; no facts mutated)."))
      (reject 5))
    ;; matched a binding but no independently-deletable top-level form (e.g. a defunion
    ;; variant lives nested inside its union) — refuse, don't report a no-op as success.
    (when (= 0 (count all-forms))
      (warn (str "REJECTED — `" name "` is not an independently-deletable top-level form "
                 "(a defunion variant / nested binding); no facts mutated."))
      (reject 5))
    ;; INVARIANT (no-orphaned-refs): refuse if any SURVIVING reference points at a victim.
    (when (> (count orphans) 0)
      (warn "================ delete + orphaned-reference invariant ================")
      (warn (str "REJECTED — " (count orphans) " reference(s) would be ORPHANED (no-orphaned-refs; no facts mutated):"))
      (doseq [o :- Any (vec (take 5 orphans))]
        (warn (str "  orphan: reference node " o " (`" (rr/sym-val ctx view o) "`)")))
      (reject 6))
    ;; SAFE: retire each wrapper fN edge that points at a deleted form root. by-l filters
    ;; superseded facts, so the form drops out of the wrapper's children everywhere.
    (let [wof (:wrapper-of v)
          wf (:wrap-forms v)
          retire (:retire v)
          emit (:emit v)
          retired (atom 0)]
      (doseq [src :- String srcs]
        (let [wrap (wof src)]
          (when (some? wrap)
            (doseq [entry :- Any (vec (wf wrap))]
              (when (contains? all-forms (enode entry))
                (retire (ecid entry))
                (swap! retired (fn [n :- Int] :- Int (+ n 1))))))))
      (when-not (:capture-only? v) (let [rr! (:reresolve v)] (rr!)))
      (emit "delete"
            (str "deleted def `" name "` in \"" scope "\" (" @retired
                 " wrapper form-edge(s) superseded; subtree orphaned + dropped on render; 0 orphaned refs)")))))

;; ---------------------------------------------------------------------------
;; reorder — MOVE an existing top-level def to a new position (after an anchor)
;; by RE-SPELLING its wrapper order key, NOT by re-minting the form.
;; insert-form+delete would churn node identity (refers_to identity edges to the
;; moved form's nodes would break, and a concurrent edit to it would be lost).
;; The #36 CRDT design makes the in-place move trivial + sound: supersede the
;; moved form's existing wrapper fN edge and mint a NEW one at a between-path,
;; pointing at the SAME form root — zero node churn, identity preserved.
;; `(reorder X :after Y)` puts X immediately after Y; `:after nil`/"" -> FRONT.
;; ---------------------------------------------------------------------------
(defn verb-reorder! [v :- Verb name :- String scope :- String after-name :- Any] :- Any
  (let [ctx (:ctx v)
        tx (:tx v)
        warn (:warn v)
        reject (:reject v)
        dbind (:def-binding v)
        ffv (:form-for-victim v)
        wof (:wrapper-of v)
        wf (:wrap-forms v)
        target-srcs (vec (filter (fn [s :- String] :- Bool (str/includes? s scope)) (:srcs v)))]
    (when (not= 1 (count target-srcs))
      (warn (str "REJECTED — reorder scope \"" scope "\" matches "
                 (count target-srcs) " files (need 1); no facts mutated."))
      (reject 3))
    (let [src (first target-srcs)
          wrap (wof src)
          forms (vec (wf wrap))
          mover-bind (dbind src name)
          mover-form (when (some? mover-bind) (ffv src mover-bind))
          mover-entry (when (some? mover-form)
                        (some (fn [e :- Any] :- Any (when (= (enode e) mover-form) e)) forms))
          front? (str/blank? (str after-name))
          anchor-bind (when-not front? (dbind src after-name))
          anchor-form (when (some? anchor-bind) (ffv src anchor-bind))
          anchor-idx (when (some? anchor-form)
                       (first (vec (keep-indexed (fn [i :- Int e :- Any] :- Any
                                                   (when (= (enode e) anchor-form) i))
                                                 forms))))]
      (when (nil? mover-entry)
        (warn (str "REJECTED — reorder target `" name "` not found in \"" scope "\"; no facts mutated."))
        (reject 5))
      (when (and (not front?) (nil? anchor-idx))
        (warn (str "REJECTED — reorder anchor `" after-name "` not found in \"" scope "\"; no facts mutated."))
        (reject 3))
      ;; -1 sentinel, not nil: `first` over keep-indexed types as (U Int Nil) and
      ;; beagle does not narrow it on a some?/nil? test, so the index is made an Int
      ;; and the "absent" case is the guard (the original's nil test, spelled typed).
      (when-not front?
        (let [ai (nn anchor-idx)]
          (when (>= ai 0)
            (when (= (enode (nth forms ai)) mover-form)
              (warn (str "REJECTED — reorder `" name "` :after itself is a no-op; no facts mutated."))
              (reject 3)))))
      ;; the gap to land in: between the anchor and its next sibling, SKIPPING the mover
      ;; itself (so moving X just past its current neighbour computes the right gap).
      (let [others (vec (remove (fn [e :- Any] :- Bool (= (enode e) mover-form)) forms))
            ;; a-pos is -1 exactly in the front? case (the anchor-not-found and
            ;; :after-itself rejections above already returned), so the -1 test is the
            ;; same branch the original's `if front?` took — spelled this way so the
            ;; index is provably an Int where it indexes.
            a-pos (if front?
                    -1
                    (nn (first (vec (keep-indexed (fn [i :- Int e :- Any] :- Any
                                                     (when (= (enode e) anchor-form) i))
                                                   others)))))
            lo (if (< a-pos 0) nil (:path (ekey (nth others a-pos))))
            hi (if (< a-pos 0)
                 (:path (ekey (first others)))
                 (when (< (+ a-pos 1) (count others)) (:path (ekey (nth others (+ a-pos 1))))))]
        (let [retire (:retire v)
              emit (:emit v)]
          (retire (ecid mover-entry))
          (c/fact! ctx (nn wrap) (c/value! ctx (ord-str* (rc/ord-between lo hi) (ord-tie v))) (nn mover-form) tx)
          (when-not (:capture-only? v) (let [rr! (:reresolve v)] (rr!)))
          (emit "reorder"
                (str "moved def `" name "` " (if front? "to the front" (str "after `" after-name "`"))
                     " in \"" scope "\" (wrapper order-key re-spelled; SAME subtree, 0 node churn)")))))))

;; ---------------------------------------------------------------------------
;; upsert-form — add OR replace a top-level def from an EDN datum spec. A REPLACE
;; reuses the victim's CRDT PATH (new tie) and retires the victim's edge; an
;; APPEND lands at a path strictly after the last form. Concurrent appends compute
;; the same path on identical clones -> distinct tie (name-int) -> both land.
;; ---------------------------------------------------------------------------
(defn verb-upsert-form! [v :- Verb scope :- String datum :- Any] :- Any
  (let [ctx (:ctx v)
        tx (:tx v)
        warn (:warn v)
        reject (:reject v)
        ssrcs (:scope-srcs v)
        target-srcs (vec (ssrcs scope))]
    (when (not= 1 (count target-srcs))
      (warn (str "REJECTED — scope \"" scope "\" matches " (count target-srcs)
                 " source files; upsert-form needs exactly one (no facts mutated)."))
      (reject 3))
    (when (and (seq? datum) (not (rc/writable-def-head? (str (first datum)))))
      (warn (str "REJECTED — upsert-form spec head `" (first datum)
                 "` is not a writable top-level def (def/defn/deftype/defmulti/defmethod/extend-*); no facts mutated."))
      (reject 3))
    (let [wof (:wrapper-of v)
          wf (:wrap-forms v)
          mint (:mint v)
          wdn (:writable-disp-name v)
          wvic (:writable-victim v)
          src (first target-srcs)
          wrap (wof src)
          forms (vec (wf wrap))
          disp-name (when (seq? datum) (wdn datum))
          victim-form (when (seq? datum) (wvic src datum))
          victim-entry (when (some? victim-form)
                         (some (fn [e :- Any] :- Any (when (= (enode e) victim-form) e)) forms))
          new-root (mint src datum)]
      (if (some? victim-entry)
        ;; REPLACE in place: reuse the victim's PATH (new tie), retire the victim.
        (let [retire (:retire v)]
          (retire (ecid victim-entry))
          (c/fact! ctx (nn wrap) (c/value! ctx (ord-str* (:path (ekey victim-entry)) (ord-tie v))) (nn new-root) tx))
        ;; APPEND: a path strictly after the last form (CRDT).
        (let [last-path (when (> (count forms) 0) (:path (ekey (last forms))))]
          (c/fact! ctx (nn wrap) (c/value! ctx (ord-str* (rc/ord-append last-path) (ord-tie v))) (nn new-root) tx)))
      (when-not (:capture-only? v) (let [rr! (:reresolve v)] (rr!)))
      (let [emit (:emit v)]
        (emit "upsert-form"
              (str (if (some? victim-entry) "replaced" "added") " top-level def `" disp-name
                   "` in \"" scope "\" (1 form minted as facts; refs resolved via refers_to)"))))))

;; ---------------------------------------------------------------------------
;; insert-form — the MIDDLE-INSERT (#36): insert a def AFTER an anchor def, at a
;; CRDT path strictly between the anchor and its next sibling. Concurrent inserts
;; after the same anchor compute the same between-path -> distinct tie -> both
;; land, ordered by tie (commute) — the thing append-only could not do.
;; ---------------------------------------------------------------------------
(defn verb-insert-form! [v :- Verb scope :- String after-name :- String datum :- Any] :- Any
  (let [ctx (:ctx v)
        tx (:tx v)
        warn (:warn v)
        reject (:reject v)
        target-srcs (vec (filter (fn [s :- String] :- Bool (str/includes? s scope)) (:srcs v)))]
    (when (not= 1 (count target-srcs))
      (warn (str "REJECTED — insert-form scope \"" scope "\" matches "
                 (count target-srcs) " files (need 1)."))
      (reject 3))
    (when (and (seq? datum) (not (contains? rc/VALUE-DEFS (str (first datum)))))
      (warn (str "REJECTED — insert-form head `" (first datum) "` not a value def."))
      (reject 3))
    (let [wof (:wrapper-of v)
          wf (:wrap-forms v)
          dbind (:def-binding v)
          ffv (:form-for-victim v)
          src (first target-srcs)
          wrap (wof src)
          forms (vec (wf wrap))
          anchor-bind (dbind src after-name)
          anchor-form (when (some? anchor-bind) (ffv src anchor-bind))
          i (nn (when (some? anchor-form)
                  (first (vec (keep-indexed (fn [n :- Int e :- Any] :- Any
                                              (when (= (enode e) anchor-form) n))
                                            forms)))))]
      (when (< i 0)
        (warn (str "REJECTED — insert-form anchor `" after-name "` not found in \"" scope "\"."))
        (reject 3))
      (let [mint (:mint v)
            anchor-path (:path (ekey (nth forms i)))
            next-path (when (< (+ i 1) (count forms)) (:path (ekey (nth forms (+ i 1)))))
            new-root (mint src datum)]
        (c/fact! ctx (nn wrap) (c/value! ctx (ord-str* (rc/ord-between anchor-path next-path) (ord-tie v))) (nn new-root) tx)
        (when-not (:capture-only? v) (let [rr! (:reresolve v)] (rr!)))
        (let [emit (:emit v)]
          (emit "insert-form"
                (str "inserted def after `" after-name "` in \"" scope "\" (CRDT mid-insert)")))))))

;; ---------------------------------------------------------------------------
;; insert-comment — author a standalone LINE comment (Turtle #6) leading/trailing
;; an anchor def. Comments do NOT live in the wrapper's form order; they attach to
;; their anchor FORM via a `commentN` edge. This mints a kind="comment" node + one
;; `text` seg (the lexeme) + the commentN edge — the FIRST incremental authoring
;; of a comment node. The seg is a single `text` run (renders verbatim); symbol
;; segs (rename-tracked identifier mentions) are a follow-up.
;; ---------------------------------------------------------------------------
(def COMMENT-RE :- Any (re-pattern "comment\\d+"))

;; next free commentN slot on a form (0 if none)
(defn- next-comment-idx [v :- Verb form :- Int] :- Int
  (let [ctx (:ctx v)]
    (+ 1 (reduce (fn [acc :- Int n :- Int] :- Int (if (> n acc) n acc))
                 -1
                 (vec (keep (fn [cid :- Int] :- Int?
                              (let [cl (c/fact-of ctx cid)
                                    p (c/literal ctx (:p cl))]
                                (when (and (string? p) (some? (re-matches COMMENT-RE (str p))))
                                  (parse-long (subs (str p) 7)))))
                            (c/by-l ctx form)))))))

(defn verb-insert-comment! [v :- Verb scope :- String anchor-name :- String
                            text :- String placement :- Any] :- Any
  (let [ctx (:ctx v)
        tx (:tx v)
        warn (:warn v)
        reject (:reject v)
        target-srcs (vec (filter (fn [s :- String] :- Bool (str/includes? s scope)) (:srcs v)))]
    (when (not= 1 (count target-srcs))
      (warn (str "REJECTED — insert-comment scope \"" scope "\" matches "
                 (count target-srcs) " files (need 1)."))
      (reject 3))
    (when (str/blank? text)
      (warn "REJECTED — insert-comment needs non-empty --text; no facts mutated.")
      (reject 3))
    (let [dbind (:def-binding v)
          ffv (:form-for-victim v)
          src (first target-srcs)
          plc (if (contains? #{"leading" "trailing"} placement) (str placement) "leading")
          ;; the lexeme keeps the leading `;` (matches what text->graph ingest captures)
          lex (if (str/starts-with? (str/triml text) ";") text (str ";; " text))
          anchor-bind (dbind src anchor-name)
          anchor-form (when (some? anchor-bind) (ffv src anchor-bind))]
      (when (nil? anchor-form)
        (warn (str "REJECTED — insert-comment anchor `" anchor-name "` not found in \"" scope "\"."))
        (reject 3))
      (let [reg (:register v)
            emit (:emit v)
            form (nn anchor-form)
            k (next-comment-idx v form)
            cnode (nn (reg src (c/entity! ctx)))
            seg (nn (reg src (c/entity! ctx)))]
        (c/fact! ctx cnode (:KIND v) (c/value! ctx "comment") tx)
        (c/fact! ctx cnode (c/value! ctx "style") (c/value! ctx "line") tx)
        (c/fact! ctx cnode (c/value! ctx "placement") (c/value! ctx plc) tx)
        (c/fact! ctx seg (:KIND v) (c/value! ctx "text") tx)
        (c/fact! ctx seg (:Vp v) (c/value! ctx lex) tx)
        (c/fact! ctx cnode (c/value! ctx "seg0") seg tx)
        (c/fact! ctx form (c/value! ctx (str "comment" k)) cnode tx)
        (when-not (:capture-only? v) (let [rr! (:reresolve v)] (rr!)))
        (emit "insert-comment"
              (str "added " plc " comment on `" anchor-name "` in \"" scope "\" (comment" k "; 1 text seg minted)"))))))

;; ---------------------------------------------------------------------------
;; set-body — replace a def/defn's body with a freshly-minted body datum.
;; Handles BOTH shapes: a defn (`(defn f [params] :- R body…)`), where the body
;; follows the [param] vector, AND a plain value-def (`(def x :- T val)` /
;; `defonce`), where the body is the single value form that follows the NAME. The
;; two are symmetric under `ret?` (an optional `:- T` return/type annotation): the
;; only difference is the ANCHOR slot the body starts after — the param bracket
;; for a defn, the name for a value-def. (The old PARAM-FORMS gate rejected every
;; js/export-wrapped value-def with code 5, so "add a field to this map" was
;; unauthorable — the duel's F021–F024 failure.)
;; ---------------------------------------------------------------------------
(defn verb-set-body! [v :- Verb name :- String scope :- String datum :- Any] :- Any
  (let [ctx (:ctx v)
        view (:view v)
        tx (:tx v)
        warn (:warn v)
        reject (:reject v)
        ssrcs (:scope-srcs v)
        target-srcs (vec (ssrcs scope))]
    (when (not= 1 (count target-srcs))
      (warn (str "REJECTED — scope \"" scope "\" matches " (count target-srcs)
                 " source files; set-body needs exactly one (no facts mutated)."))
      (reject 3))
    (let [dbind (:def-binding v)
          ffv (:form-for-victim v)
          src (first target-srcs)
          B (dbind src name)
          form (when (some? B) (ffv src B))
          d (when (some? form) (rm/unwrap-def ctx view (nn form)))]
      (when (or (nil? form) (not (contains? rc/VALUE-DEFS (str (rr/head-sym ctx view d)))))
        (warn (str "REJECTED — `" name "` is not a def/defn with a body in \"" scope
                   "\" (set-body needs a value binding; no facts mutated)."))
        (reject 5))
      (let [fnf (:fn-facts v)
            mint (:mint v)
            kids (vec (fnf d))
            param? (contains? rc/PARAM-FORMS (str (rr/head-sym ctx view d)))
            ;; the body follows the [param] vector (defn) or the NAME (plain value-def).
            anchor-n (nn (if param?
                           (some (fn [e :- Any] :- Any
                                   (when (rb/brackets? ctx view (nn (enode e))) (ekey e)))
                                 kids)
                           (some (fn [e :- Any] :- Any
                                   (when (= name (rr/sym-val ctx view (rr/unwrap-meta ctx view (nn (enode e)))))
                                     (ekey e)))
                                 kids)))
            ret? (some (fn [e :- Any] :- Any
                         (when (and (= (ekey e) (+ anchor-n 1))
                                    (contains? rc/TYPE-COLON (str (rr/sym-val ctx view (nn (enode e))))))
                           true))
                       kids)
            body-start (+ anchor-n (if (some? ret?) 3 1))
            body-slots (vec (filter (fn [e :- Any] :- Bool (>= (nn (ekey e)) body-start)) kids))
            new-root (mint src datum)]
        (when (= 0 (count body-slots))
          (warn (str "REJECTED — `" name "` has no body fN edges to replace; no facts mutated."))
          (reject 5))
        (let [retire (:retire v)
              emit (:emit v)]
          (doseq [e :- Any body-slots] (retire (ecid e)))
          (c/fact! ctx (nn d) (c/value! ctx (str "f" body-start)) (nn new-root) tx)
          (when-not (:capture-only? v) (let [rr! (:reresolve v)] (rr!)))
          (emit "set-body"
                (str "replaced body of `" name "` in \"" scope "\" ("
                     (count body-slots) " body slot(s) superseded; new body minted as facts)")))))))
