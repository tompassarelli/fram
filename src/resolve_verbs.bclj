#lang beagle/clj

;; ============================================================================
;; resolve-verbs — THE AUTHORING VERBS: an edit is a FACT OPERATION.
;; ============================================================================
;; Stage M1 Cut H of the engine core port (north thread
;; 019f9f0e-de2a-7759-bb10-db8b14be6fad). These are the standalone authoring
;; verbs — rename / upsert-form / insert-form / insert-comment / set-body /
;; replace-in-body / delete / reorder — plus the graph-path dispatcher. Each one
;; checks its INVARIANTS first (collision, no-capture, no-orphaned-refs, shape,
;; anchor uniqueness) and, only if every one holds, mutates FACTS: mint the new
;; subtree, supersede the edges it replaces, never touch text. A rejected edit
;; mutates nothing.
;;
;; The verbs are STORE-AGNOSTIC by construction — they read the corpus tables and
;; write via fact!/value!/retire, so the SAME body runs on the text path (-main,
;; over resolve-edn! of emit-edn(text)) and on the graph path (run-verb-warm!,
;; over a LOG-booted warm store).
;;
;; STRUCTURAL ADAPTATIONS, all forced and all behavior-preserving:
;;
;;   1. STATE IS A PARAMETER (Cuts B–G's rule). resolve.clj's ^:dynamic vars
;;      cannot change namespace (coord_daemon.clj and tests/coord_*.clj `binding`
;;      them by qualified name), so the store, view, tx, the predicate value-ids,
;;      the corpus tables, the two reject arities and every resolve.clj-local
;;      helper the verbs call arrive HERE as one explicit `Verb` record that
;;      resolve.clj's `verb-env` builds from the dynamic state at call time.
;;
;;   2. THE HELPERS STAY BEHIND, AS CLOSURES. mint-datum! / retire-fact! /
;;      extract-file! / capture-refs / datum->canon / the disambiguation payload
;;      builder are resolve.clj's (they touch reader metadata, java.util.regex,
;;      clojure.edn and the projection writer — host surfaces this port does not
;;      move). They ride in the record as function VALUES, exactly as Cut G's
;;      xres/tres/ares did. What moved is the verb LOGIC: the invariant order,
;;      the reject codes + messages, the fact mutations and the emit reporting.
;;
;;   3. `binding [*out* *err*]` CANNOT MOVE (it rebinds a host dynamic var), so
;;      stderr reporting is one closure, `warn`, called once per LINE. The
;;      goldens compare bytes, so line order and spelling are preserved verbatim.
;;
;;   4. TWO REJECT ARITIES. Callers bind *reject!* with either arity — tests
;;      bind `(fn [code] …)`, the daemon `(fn [code & [detail]] …)` — so the
;;      record carries `reject` (1-arg) and `reject2` (2-arg, the structured
;;      disambiguation payload path) and each call site keeps its original arity.
;;
;; PER-DEF NOTES (the rationale that rode with the originals):
;;   verb-rename!      O(1) shadow-correct rename: the four invariants
;;                     (rename-doesn't-collide, beagle type-name shape,
;;                     no-capture, no-import-collision) then ONE fact per
;;                     definition name — references follow refers_to.
;;   verb-upsert-form! add OR replace a top-level def from an EDN datum. A
;;                     replace reuses the victim's CRDT path (new tie); an append
;;                     lands strictly after the last form.
;;   verb-insert-form! the CRDT MIDDLE-INSERT (#36): a path strictly between the
;;                     anchor and its next sibling — concurrent inserts after the
;;                     same anchor get distinct ties and BOTH land (commute).
;;   verb-insert-comment! author a standalone line comment (Turtle #6): a
;;                     kind="comment" node + one `text` seg + a commentN edge.
;;   verb-set-body!    replace a def/defn's body: supersede every body fN edge,
;;                     mint the new body, wire it at the first body slot. Handles
;;                     both the defn shape (body after the [param] vector) and
;;                     the value-def shape (body after the NAME).
;;   verb-replace-in-body! the SUB-DEF surgical edit — swap ONE interior form,
;;                     addressed structurally by an anchor datum, reusing the
;;                     matched edge's EXACT position literal (byte-stable; the
;;                     def is never re-minted, so siblings + comments survive).
;;   verb-delete!      remove a top-level def by superseding the wrapper's form
;;                     edge; fail-closed on any surviving reference (orphans).
;;   verb-reorder!     MOVE a def by re-spelling its wrapper order key — same
;;                     subtree, zero node churn, identity preserved.
;;   dispatch-verb!    run-verb-warm!'s op table (the portable half; the dynamic
;;                     `binding` scaffolding it runs inside stays in resolve.clj).
;;
;; Consumed by resolve.clj — the emitted out/resolve_verbs.clj must stay on the
;; classpath.
;; ============================================================================
(ns resolve-verbs
  (:require [clojure.string :as str]
    [fram.types :as t]
    [fram.store :as c]))

(define-mode strict)

;; The verb environment: the dynamic state of resolve.clj, handed over explicitly.
;; Everything typed `Any` here is a HOST CLOSURE (a resolve.clj function that reads
;; the dynamic state) or a corpus table keyed by src — the same `Any` boundary Cut
;; G's xres/tres/ares sit on. GAP: Beagle cannot name "a Clojure map whose keys are
;; arbitrary node ids" or a variadic host fn more precisely than Any.
(defrecord Verb [ctx :- (Atom t/Store)
                 view :- Any
                 tx :- Int
                 SUP :- Int
                 KIND :- Int
                 Vp :- Int
                 srcs :- (Vec String)
                 capture-only? :- Bool
                 emit-srcs :- (Vec String)
                 reject :- Any          ; (fn [code]) — the 1-arg reject every verb but replace-in-body uses
                 reject2 :- Any         ; (fn [code detail]) — structured disambiguation payload
                 warn :- Any            ; (fn [line]) — one println to *err*
                 emit :- Any            ; (fn [op detail]) — author-emit-scoped!
                 extract :- Any         ; (fn [src]) — extract-file! src (out-path src)
                 out-path :- Any        ; (fn [src]) -> the projected EDN path
                 def-binding :- Any     ; (fn [src nm]) -> value OR type binding node
                 typeframe :- Any       ; {src -> {type-name -> node}}
                 modframe :- Any        ; {src -> {name -> node}}
                 forms-of :- Any        ; (fn [src]) -> top-level forms
                 module-name :- Any     ; (fn [src]) -> the ns-form module name
                 parse-require :- Any   ; (fn [src]) -> {:refer .. :as .. :rename ..}
                 capture-refs :- Any])  ; (fn [node scope B new]) -> captured refs

;; ---------------------------------------------------------------------------
;; rename — every INVARIANT + fact mutation of the old `rename` case arm.
;; ---------------------------------------------------------------------------
;; the `^[A-Z]` shape test of the original, spelled without a regex literal
;; (`#"…"` cannot cross the graph-edit datum channel — resolve_read.bclj's rule):
;; ASCII A–Z is exactly the closed string range "A".."Z".
(defn- upper-first? [s :- String] :- Bool
  (and (> (count s) 0)
       (let [c (subs s 0 1)] (and (>= (compare c "A") 0) (<= (compare c "Z") 0)))))

(defn verb-rename! [v :- Verb old :- String new :- String target :- String] :- Any
  (let [ctx (:ctx v)
        tx (:tx v)
        srcs (:srcs v)
        warn (:warn v)
        reject (:reject v)
        dbind (:def-binding v)
        target-srcs (vec (filter (fn [s :- String] :- Bool (str/includes? s target)) srcs))
        edits (atom 0)]
    (doseq [src :- String target-srcs]
      (when (and (some? (dbind src old)) (some? (dbind src new)))
        (warn (str "REJECTED — `" new "` already names a binding in " src
                   " (rename-doesn't-collide; no facts mutated)."))
        (reject 3)))
    (doseq [src :- String target-srcs]
      (when (and (some? (get (get (:typeframe v) src) old)) (not (upper-first? new)))
        (warn (str "REJECTED — `" new "` is not a valid (Capitalized) type name "
                   "(beagle type-name shape; no facts mutated)."))
        (reject 3)))
    (doseq [src :- String target-srcs]
      (let [B (dbind src old)]
        (when (some? B)
          (let [crefs (:capture-refs v)
                fo (:forms-of v)
                caps (vec (mapcat (fn [s :- String] :- (Vec Any)
                                    (vec (mapcat (fn [f :- Any] :- (Vec Any)
                                                   (vec (crefs f (list (get (:modframe v) s)) B new)))
                                                 (vec (fo s)))))
                                  srcs))]
            (when (> (count caps) 0)
              (warn (str "REJECTED — renaming `" old "` -> `" new "` would be CAPTURED by a local `"
                         new "` in scope at " (count caps) " reference(s) (no-capture; no facts mutated)."))
              (reject 4))))))
    (let [mn (:module-name v)
          target-mods (set (vec (keep (fn [s :- String] :- Any (mn s)) target-srcs)))]
      (doseq [src :- String (vec (remove (fn [s :- String] :- Bool (some? (some (fn [t :- String] :- Any (when (= t s) t)) target-srcs))) srcs))]
        ;; GAP (beagle clj emitter): a keyword-access form applied DIRECTLY in call
        ;; position — `((:parse-require v) src)` — type-checks but crashes emit-clj
        ;; (symbol->string contract violation on the kw-access node). Every closure
        ;; field in this module is therefore let-bound before it is called.
        (let [preq (:parse-require v)
              pr (preq src)
              refer (get pr :refer)
              rename (get pr :rename)
              home (get refer old)]
          (when (and (some? home) (contains? target-mods home)
                     (or (some? (dbind src new)) (some? (get refer new)) (some? (get rename new))))
            (warn (str "REJECTED — renaming `" old "` -> `" new "` would DUPLICATE a binding in consumer "
                       src " (it already binds `" new "`; no-import-collision; no facts mutated)."))
            (reject 3)))))
    (doseq [src :- String target-srcs]
      (let [B (dbind src old)]
        (when (some? B)
          (let [oldc (first (vec (filter (fn [cid :- Int] :- Bool (= (:Vp v) (get (c/fact-of ctx cid) :p)))
                                         (c/by-l ctx B))))
                nc (c/fact! ctx B (:Vp v) (c/value! ctx new) tx)]
            (when (some? oldc) (c/fact! ctx nc (:SUP v) oldc tx))
            (swap! edits (fn [n :- Int] :- Int (+ n 1)))))))
    (when (= 0 @edits)
      (warn (str "REJECTED — no binding named `" old "` found in \"" target
                 "\" (nothing to rename; no facts mutated)."))
      (reject 5))
    ;; capture-only (daemon :edit-min): the name fact is mutated above; SKIP the
    ;; whole-corpus projection — the daemon commits the captured op + re-resolves scoped.
    (when-not (:capture-only? v)
      (let [ex (:extract v)
            op (:out-path v)]
        (doseq [src :- String (:emit-srcs v)] (ex src))
        (warn "================ Turtle #5 — O(1) shadow-correct rename ================")
        (warn (str "edit: rename def `" old "` -> `" new "` in \"" target "\""))
        (warn (str "FACTS EDITED: " @edits "  (just the definition's name; references follow refers_to)"))
        (doseq [src :- String (:emit-srcs v)] (warn (str "projected -> " (op src) "   <- " src)))))))
