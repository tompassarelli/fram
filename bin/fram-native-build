#!/usr/bin/env bash
set -euo pipefail
export LC_ALL=C
umask 022

die() {
  echo "fram-native-build: $*" >&2
  exit 2
}

usage() {
  cat <<'USAGE'
Usage:
  fram-native-build --host server [--adapter FILE] SOURCE.bgl...
  fram-native-build --host embed [--adapter FILE] SOURCE.bgl...
  fram-native-build --host world [--abi ID] [--entry NS/NAME]... SOURCE.bgl...
  fram-native-build --host world --regen-qbe-frontier [--entry NS/NAME]... SOURCE.bgl...

Prints the absolute immutable artifact directory on success.
Set FRAM_BEAGLE (or BEAGLE_HOME), FRAM_NATIVE_CACHE, FRAM_NATIVE_CC,
FRAM_NATIVE_STATIC=1 (server host: link -static), FRAM_NATIVE_AR, and
FRAM_QBE_FRONTIER_LEDGER as needed.

Native hosts default to native/server_generated.c beside this script. The
embed host emits include/fram.h, lib/libfram.a, and lib/libfram.so. The world
host stops at the sealed Native World and its C17 projection, emits no C host,
and is how a source slice narrower than the server ABI is taken through the
same release gate.

--abi names the Beagle ABI profile the world is sealed at (default lp64;
Beagle owns the registry and refuses an unknown id by name). It needs --host
world, because the C hosts link their projection with the native compiler. Each
profile gets its own Native World cache entry and its own QBE frontier scope.

RELEASE GATE
  REQUIRED (build fails)  complete C17 materialization, all seven obligation
                          projections PASS, no pending lowering work, and for
                          server/embed a clean C17 host link.
  RATCHETED (build fails) the QBE frontier: an unrecorded refusal fails, and a
                          recorded refusal that no longer reproduces fails
                          until its native/qbe-frontier.ledger line is deleted.
                          --regen-qbe-frontier rewrites this scope's line.
USAGE
}

host=""
adapter=""
sources=()
entries=()
regen_qbe_frontier=0
default_abi=lp64
abi="$default_abi"
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host)
      [[ $# -ge 2 && -z "$host" ]] || die "--host needs one host name"
      host="$2"
      shift 2
      ;;
    --abi)
      [[ $# -ge 2 ]] || die "--abi needs one profile id"
      abi="$2"
      shift 2
      ;;
    --adapter)
      [[ $# -ge 2 && -z "$adapter" ]] || die "--adapter needs one source path"
      adapter="$2"
      shift 2
      ;;
    --entry)
      [[ $# -ge 2 ]] || die "--entry needs one NS/NAME"
      entries+=("$2")
      shift 2
      ;;
    --regen-qbe-frontier)
      regen_qbe_frontier=1
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    --)
      shift
      sources+=("$@")
      break
      ;;
    -*) die "unknown option: $1" ;;
    *) sources+=("$1"); shift ;;
  esac
done
case "$host" in
  server|embed|world) ;;
  "") die "--host must be server, embed, or world" ;;
  *) die "unsupported host: $host" ;;
esac
[[ ${#sources[@]} -gt 0 ]] || die "provide the dependency-first source closure"
# Beagle owns the profile registry; the shape check is ours because the id
# enters both the cache manifest and the tab-separated frontier scope.
[[ "$abi" =~ ^[A-Za-z0-9_.-]+$ ]] || die "--abi takes a bare profile id: $abi"
[[ "$abi" == "$default_abi" || "$host" == "world" ]] ||
  die "--abi $abi needs --host world; the $host host links its C17 projection with the native compiler"
[[ ${#entries[@]} -eq 0 || "$host" == "world" ]] ||
  die "--entry overrides the server ABI entry set and needs --host world"
[[ "$regen_qbe_frontier" == 0 || "$host" == "world" ]] ||
  die "--regen-qbe-frontier needs --host world"

for command in awk cmp flock git grep mktemp realpath sed sha256sum; do
  command -v "$command" >/dev/null 2>&1 || die "required command is unavailable: $command"
done

home="${HOME:-}"
beagle_candidate="${FRAM_BEAGLE:-${BEAGLE_HOME:+$BEAGLE_HOME/bin/beagle}}"
beagle_candidate="${beagle_candidate:-${home:+$home/code/beagle/main/bin/beagle}}"
beagle="$(command -v "$beagle_candidate" 2>/dev/null || true)"
[[ -n "$beagle" && -x "$beagle" ]] || die "set FRAM_BEAGLE to an executable CLI"
beagle="$(realpath "$beagle")"

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
host_source=""
host_header=""
adapter_header=""
if [[ "$host" == "server" || "$host" == "embed" ]]; then
  if [[ "$host" == "server" ]]; then
    host_source="$repo/native/server_host.c"
    host_header="$repo/native/server_host.h"
  else
    host_source="$repo/native/fram_embed.c"
    host_header="$repo/native/fram.h"
    adapter_header="$repo/native/server_host.h"
  fi
  adapter="${adapter:-$repo/native/server_generated.c}"
  [[ -f "$host_source" ]] || die "$host host source is unavailable: $host_source"
  [[ -f "$host_header" ]] || die "$host host header is unavailable: $host_header"
  [[ -z "$adapter_header" || -f "$adapter_header" ]] ||
    die "embed adapter header is unavailable: $adapter_header"
  [[ -f "$adapter" ]] || die "server generated adapter is unavailable: $adapter"
  host_source="$(realpath "$host_source")"
  host_header="$(realpath "$host_header")"
  [[ -z "$adapter_header" ]] || adapter_header="$(realpath "$adapter_header")"
  adapter="$(realpath "$adapter")"
fi

cc_candidate="${FRAM_NATIVE_CC:-${CC:-cc}}"
cc="$(command -v "$cc_candidate" 2>/dev/null || true)"
[[ -n "$cc" && -x "$cc" ]] || die "C17 compiler is not executable: $cc_candidate"
cc="$(realpath "$cc")"
case "${FRAM_NATIVE_STATIC:-}" in
  "") link_mode=dynamic ;;
  1) link_mode=static ;;
  *) die "FRAM_NATIVE_STATIC must be 1 or unset" ;;
esac
# -static is server-host-only: embed emits -fPIC objects and a .so.
[[ "$link_mode" == dynamic || "$host" == server ]] ||
  die "FRAM_NATIVE_STATIC=1 needs --host server"
ar=""
if [[ "$host" == "embed" ]]; then
  ar_candidate="${FRAM_NATIVE_AR:-ar}"
  ar="$(command -v "$ar_candidate" 2>/dev/null || true)"
  [[ -n "$ar" && -x "$ar" ]] || die "archive tool is not executable: $ar_candidate"
  ar="$(realpath "$ar")"
fi

cache_root="${FRAM_NATIVE_CACHE:-${XDG_CACHE_HOME:-${home:+$home/.cache}}}"
[[ -n "$cache_root" ]] || die "set FRAM_NATIVE_CACHE, XDG_CACHE_HOME, or HOME"
[[ -n "${FRAM_NATIVE_CACHE:-}" ]] || cache_root="$cache_root/fram/native-build"
mkdir -p "$cache_root/.locks" "$cache_root/.tmp" \
  "$cache_root/.worlds/.locks" "$cache_root/.worlds/.tmp"
cache_root="$(cd "$cache_root" && pwd -P)"
world_cache="$cache_root/.worlds"

normalized_sources=()
for source in "${sources[@]}"; do
  [[ -f "$source" ]] || die "source file not found: $source"
  [[ "$source" == *.bgl ]] ||
    die "Native Core accepts canonical .bgl sources only: $source"
  first_line="$(sed -n '1p' "$source")"
  [[ "$first_line" =~ ^#lang[[:space:]]+beagle[[:space:]]*$ ]] ||
    die "$source must begin with bare #lang beagle"
  normalized_sources+=("$(realpath "$source")")
done

beagle_root="$(git -C "$(dirname "$beagle")" rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$beagle_root" ]]; then
  git -C "$beagle_root" diff --quiet --ignore-submodules -- ||
    die "Beagle has tracked changes: $beagle_root"
  git -C "$beagle_root" diff --cached --quiet --ignore-submodules -- ||
    die "Beagle has staged changes: $beagle_root"
  beagle_identity="git:$(git -C "$beagle_root" rev-parse 'HEAD^{commit}')"
else
  beagle_identity="file:$(sha256sum "$beagle" | sed 's/ .*//')"
fi
if [[ -x "$(dirname "$beagle")/beagle-build-core" ]]; then
  beagle_identity+=":build-core-$(sha256sum "$(dirname "$beagle")/beagle-build-core" | sed 's/ .*//')"
fi
cc_identity="$cc:$($cc --version 2>&1 | sed -n '1p')"
[[ -z "$ar" ]] || cc_identity+=":ar=$ar:$($ar --version 2>&1 | sed -n '1p')"
builder_identity="$(sha256sum "${BASH_SOURCE[0]}" | sed 's/ .*//')"

input_manifest=""
world_input_manifest=""
stage=""
world_stage=""
cleanup() {
  [[ -z "$stage" || ! -d "$stage" ]] || rm -rf "${stage:?}"
  [[ -z "$world_stage" || ! -d "$world_stage" ]] || rm -rf "${world_stage:?}"
  [[ -z "$input_manifest" || ! -f "$input_manifest" ]] || rm -f "${input_manifest:?}"
  [[ -z "$world_input_manifest" || ! -f "$world_input_manifest" ]] ||
    rm -f "${world_input_manifest:?}"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

native_server_entries=(
  fram.native-server/server-generated-abi
  fram.native-server/server-store-boot!
  fram.native-server/server-store-dispatch!
  fram.native-server/server-store-shutdown
  fram.native-server/server-codec-read-request!
  fram.native-server/server-codec-write-response!
  fram.native-server/server-codec-release-request
  fram.native-server/server-codec-release-response
)
# The QBE frontier ledger is keyed by the entry set, because that is what
# selects the Native World QBE judges; the default set gets a stable short name.
if [[ ${#entries[@]} -eq 0 ]]; then
  world_entries=("${native_server_entries[@]}")
  world_scope="fram-native-server"
else
  mapfile -t world_entries < <(printf '%s\n' "${entries[@]}" | LC_ALL=C sort -u)
  world_scope="$(IFS='+'; printf '%s' "${world_entries[*]}")"
fi
# QBE judges each ABI profile separately, so each gets its own scope; lp64 keeps
# the bare name so every recorded ledger line stays addressed as it was written.
[[ "$abi" == "$default_abi" ]] || world_scope+="@$abi"
[[ "$world_scope" != *[[:space:]]* ]] ||
  die "entry names must not contain whitespace: $world_scope"
native_server_entry_args=()
for native_server_entry in "${world_entries[@]}"; do
  native_server_entry_args+=(--entry "$native_server_entry")
done

qbe_ledger="${FRAM_QBE_FRONTIER_LEDGER:-$repo/native/qbe-frontier.ledger}"

write_world_input_manifest() {
  local destination="$1" index source
  {
    printf 'fram-native-world-input/v1\n%s\n%s\nconfiguration=profile=3\n' \
      "$builder_identity" "$beagle_identity"
    # Mirrors the ABI profile Beagle seals into the world configuration; without
    # it two profiles over one closure would collide on a single cache entry.
    printf 'abi=%s\n' "$abi"
    printf 'scope=%s\n' "$world_scope"
    for native_server_entry in "${world_entries[@]}"; do
      printf 'entry=%s\n' "$native_server_entry"
    done
    for index in "${!normalized_sources[@]}"; do
      source="${normalized_sources[$index]}"
      printf '%06d %q %s\n' "$index" "$source" "$(sha256sum "$source" | sed 's/ .*//')"
    done
  } >"$destination"
}

write_input_manifest() {
  local destination="$1"
  {
    printf 'fram-native-build-input/v1\n%s\nhost=%s\nworld=%s\nnative-world=%s\n%s\n' \
      "$builder_identity" "$host" "$world_closure_hash" \
      "$native_world_digest" "$cc_identity"
    printf 'link=%s\n' "$link_mode"
    printf 'host-source %q %s\n' "$host_source" \
      "$(sha256sum "$host_source" | sed 's/ .*//')"
    printf 'host-header %q %s\n' "$host_header" \
      "$(sha256sum "$host_header" | sed 's/ .*//')"
    if [[ -n "$adapter_header" ]]; then
      printf 'adapter-header %q %s\n' "$adapter_header" \
        "$(sha256sum "$adapter_header" | sed 's/ .*//')"
    fi
    printf 'adapter %q %s\n' "$adapter" \
      "$(sha256sum "$adapter" | sed 's/ .*//')"
  } >"$destination"
}

# The release requirement: C17 completeness plus all seven obligations, which
# carry the target-neutrality contract (valid-ssa, closed-layouts, legal-abi).
validate_native_report() {
  local report_path="$1" line
  local -a required_lines=(
    "stage source-seal ACCEPTED"
    "stage source-to-typed ACCEPTED"
    "stage typed-to-native COMPLETE"
    "native-lowering-result NativeLoweringCompleteV0"
    "result PASS"
    "obligation-projection PASS valid-ssa"
    "obligation-projection PASS exhaustive-matches"
    "obligation-projection PASS closed-layouts"
    "obligation-projection PASS checked-arithmetic"
    "obligation-projection PASS legal-abi"
    "obligation-projection PASS discharged-tokens"
    "obligation-projection PASS bounded-effects"
    "materialize-c17 OK module_0.h module_0.c"
  )
  [[ -f "$report_path" ]] || die "native build omitted $report_path"
  for line in "${required_lines[@]}"; do
    [[ "$(grep -Fxc -- "$line" "$report_path" || true)" == "1" ]] ||
      die "native report must contain exactly once: $line"
  done
  [[ "$(grep -c '^obligation-projection ' "$report_path" || true)" == "7" &&
     "$(grep -c '^obligation-projection PASS ' "$report_path" || true)" == "7" ]] ||
    die "native report must contain exactly seven passing obligations"
  ! grep -q '^pending ' "$report_path" ||
    die "native report contains pending lowering work"
}

# Keys must name the refused construct, never anything that churns per build.
classify_qbe_refusal() {
  local detail="$1"
  case "$detail" in
    "abi profile "*": qbe materializes lp64 only")
      detail="${detail#abi profile }"
      printf 'abi-profile\t%s\n' "${detail%%:*}" ;;
    "unsupported native value-semantics op: "*)
      printf 'unsupported-value-semantics\t%s\n' "${detail#unsupported native value-semantics op: }" ;;
    "QBE codec primitive is unsupported: "*)
      printf 'codec-primitive\t%s\n' "${detail#QBE codec primitive is unsupported: }" ;;
    "QBE Unicode text primitive is unsupported: "*)
      printf 'unicode-primitive\t%s\n' "${detail#QBE Unicode text primitive is unsupported: }" ;;
    "QBE checked integer division is unsupported: "*)
      printf 'checked-division\t%s\n' "${detail#QBE checked integer division is unsupported: }" ;;
    "QBE socket extern ABI is unsupported:"*) printf 'socket-extern\t-\n' ;;
    "QBE monotonic clock extern ABI is unsupported:"*) printf 'clock-extern\t-\n' ;;
    "QBE stdout extern ABI is unsupported:"*) printf 'stdout-extern\t-\n' ;;
    "QBE host extern ABI is unsupported:"*) printf 'host-extern\t-\n' ;;
    "QBE vector sort is unsupported:"*) printf 'vector-sort\t-\n' ;;
    "native world uses a shape outside the QBE materializer's slice")
      printf 'shape-outside-slice\t-\n' ;;
    "native world contains a Text or Keyword literal outside the QBE literal slice")
      printf 'literal-outside-slice\t-\n' ;;
    "native world is not sealed: validation obligations failed")
      printf 'world-not-sealed\t-\n' ;;
    "module index must be nonnegative") printf 'module-index\t-\n' ;;
    # Unrecognised refusals key on their own text so they fail the ratchet.
    *) printf 'unclassified\t%s\n' "$detail" ;;
  esac
}

write_qbe_frontier() {
  local report_path="$1" destination="$2"
  local -a qbe_lines=()
  local detail key class
  mapfile -t qbe_lines < <(grep '^materialize-qbe ' "$report_path" || true)
  [[ ${#qbe_lines[@]} -eq 1 ]] ||
    die "native report must carry exactly one materialize-qbe line (found ${#qbe_lines[@]}); QBE must always run and report"
  case "${qbe_lines[0]}" in
    "materialize-qbe OK module_0.ssa")
      printf 'qbe-frontier/v1\nscope\t%s\nstatus\tOK\n' "$world_scope" \
        >"$destination"
      ;;
    "materialize-qbe REFUSED "*)
      detail="${qbe_lines[0]#materialize-qbe REFUSED }"
      key="$(classify_qbe_refusal "$detail")"
      class="${key%%$'\t'*}"
      printf 'qbe-frontier/v1\nscope\t%s\nstatus\tREFUSED\nkey\t%s\ndetail\t%s\n' \
        "$world_scope" "$key" "$detail" >"$destination"
      [[ -n "$class" ]] || die "QBE refusal classified to an empty key"
      ;;
    *)
      die "unreadable materialize-qbe line: ${qbe_lines[0]}"
      ;;
  esac
}

# QBE stays visible in the host receipt; an invisible QBE is worse than a red one.
write_qbe_frontier_receipt() {
  local status key
  status="$(awk -F'\t' '$1 == "status" { print $2 }' "$stage/qbe-frontier.txt")"
  key="$(awk -F'\t' '$1 == "key" { print $2 "/" $3 }' "$stage/qbe-frontier.txt")"
  printf 'native-qbe-frontier %s scope=%s ledger=%s\n' \
    "$status" "$world_scope" "${key:-clean}"
}

# Two-sided and shrink-only: a new refusal fails, a stale one fails until deleted.
check_qbe_frontier() {
  local frontier_path="$1" status observed recorded
  local -a recorded_rows=()
  status="$(awk -F'\t' '$1 == "status" { print $2 }' "$frontier_path")"
  observed="$(awk -F'\t' '$1 == "key" { print $2 "\t" $3 }' "$frontier_path")"
  [[ -f "$qbe_ledger" ]] ||
    die "QBE frontier ledger is unavailable: $qbe_ledger"
  mapfile -t recorded_rows < <(
    awk -F'\t' -v scope="$world_scope" \
      '/^[^#]/ && NF >= 3 && $1 == scope { print $2 "\t" $3 }' "$qbe_ledger"
  )
  [[ ${#recorded_rows[@]} -le 1 ]] ||
    die "QBE frontier ledger records ${#recorded_rows[@]} refusals for scope $world_scope; QBE reports at most one per world"
  recorded="${recorded_rows[0]:-}"

  if [[ "$regen_qbe_frontier" == 1 ]]; then
    local regenerated
    regenerated="$(mktemp "$cache_root/.tmp/ledger.XXXXXX")"
    awk -F'\t' -v scope="$world_scope" \
      '/^#/ || NF < 3 || $1 != scope' "$qbe_ledger" >"$regenerated"
    [[ "$status" != "REFUSED" ]] ||
      printf '%s\t%s\n' "$world_scope" "$observed" >>"$regenerated"
    cat "$regenerated" >"$qbe_ledger"
    rm -f "${regenerated:?}"
    if [[ "$status" == "REFUSED" ]]; then
      echo "qbe frontier: recorded $world_scope -> $observed" >&2
    else
      echo "qbe frontier: cleared $world_scope (QBE materializes it)" >&2
    fi
    return 0
  fi

  if [[ "$status" == "OK" ]]; then
    [[ -z "$recorded" ]] || die "$(printf '%s\n%s\n%s' \
      "QBE frontier ledger is STALE for scope $world_scope: QBE now materializes it." \
      "  recorded: $recorded" \
      "  delete that line from $qbe_ledger (or rerun with --regen-qbe-frontier).")"
    return 0
  fi
  [[ -n "$recorded" ]] || die "$(printf '%s\n%s\n%s\n%s' \
    "QBE frontier GREW for scope $world_scope: an unrecorded QBE refusal." \
    "  observed: $observed" \
    "  QBE is the anti-C-capture check; a new refusal means this world left" \
    "  QBE's slice. Fix it, or record it in $qbe_ledger with a justification.")"
  [[ "$recorded" == "$observed" ]] || die "$(printf '%s\n%s\n%s' \
    "QBE frontier MOVED for scope $world_scope." \
    "  recorded: $recorded" \
    "  observed: $observed")"
}

write_server_symbols() {
  local report_path="$1" module_header="$2" destination="$3"
  local logical symbol suffix prototype prototype_regex return_type parameters
  local parameter parameter_regex source_index existing index
  local has_arena has_capability call_parameters call_arguments
  local -a report_rows=() prototypes=() raw_parameters=() source_types=()
  local -a symbols=() return_types=() arena_prefixes=() capability_prefixes=()
  local -A argument_types=()
  local -a logical_names=(
    server-generated-abi
    server-store-boot!
    server-store-dispatch!
    server-store-shutdown
    server-codec-read-request!
    server-codec-write-response!
    server-codec-release-request
    server-codec-release-response
  )
  local -a suffixes=(
    generated_abi
    store_boot
    store_dispatch
    store_shutdown
    codec_read_request
    codec_write_response
    codec_release_request
    codec_release_response
  )
  local -a macro_suffixes=(
    GENERATED_ABI
    STORE_BOOT
    STORE_DISPATCH
    STORE_SHUTDOWN
    CODEC_READ_REQUEST
    CODEC_WRITE_RESPONSE
    CODEC_RELEASE_REQUEST
    CODEC_RELEASE_RESPONSE
  )
  local -a source_arities=(0 3 3 1 1 1 1 1)

  [[ -f "$module_header" ]] || die "C17 materializer omitted module_0.h"
  for index in "${!logical_names[@]}"; do
    logical="${logical_names[$index]}"
    mapfile -t report_rows < <(
      awk -v name="$logical" '$1 == "lowered" && $3 == name { print $2 }' \
        "$report_path"
    )
    [[ ${#report_rows[@]} -eq 1 ]] ||
      die "native report must contain exactly one lowered row for $logical (found ${#report_rows[@]})"
    [[ "${report_rows[0]}" =~ ^fn_([0-9]+)$ ]] ||
      die "native report has an invalid function id for $logical: ${report_rows[0]}"
    symbol="native_m0_fn_${BASH_REMATCH[1]}"
    for existing in "${symbols[@]}"; do
      [[ "$existing" != "$symbol" ]] ||
        die "native report maps multiple server exports to $symbol"
    done
    symbols+=("$symbol")

    mapfile -t prototypes < <(
      grep -E "^[A-Za-z_][A-Za-z0-9_]* ${symbol}\\(.*\\);$" \
        "$module_header" || true
    )
    [[ ${#prototypes[@]} -eq 1 ]] ||
      die "module_0.h must contain exactly one prototype for $logical ($symbol)"
    prototype="${prototypes[0]}"
    prototype_regex="^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]+${symbol}\\((.*)\\);$"
    [[ "$prototype" =~ $prototype_regex ]] ||
      die "cannot parse generated prototype for $logical: $prototype"
    return_type="${BASH_REMATCH[1]}"
    parameters="${BASH_REMATCH[2]}"
    return_types+=("$return_type")

    raw_parameters=()
    if [[ "$parameters" == "void" ]]; then
      :
    elif [[ -n "$parameters" ]]; then
      IFS=',' read -r -a raw_parameters <<<"$parameters"
      for source_index in "${!raw_parameters[@]}"; do
        parameter="${raw_parameters[$source_index]}"
        parameter="$(sed -E \
          's/^[[:space:]]+//; s/[[:space:]]+$//; s/[[:space:]]+/ /g' \
          <<<"$parameter")"
        raw_parameters[source_index]="$parameter"
      done
    else
      die "generated prototype uses an unspecified parameter list for $logical"
    fi

    has_arena=0
    has_capability=0
    source_index=0
    if [[ ${#raw_parameters[@]} -gt "$source_index" &&
      "${raw_parameters[$source_index]}" == "native_arena *arena" ]]; then
      has_arena=1
      source_index=$((source_index + 1))
    fi
    if [[ ${#raw_parameters[@]} -gt "$source_index" &&
      "${raw_parameters[$source_index]}" == "const native_capability *capability" ]]; then
      has_capability=1
      source_index=$((source_index + 1))
    fi
    arena_prefixes+=("$has_arena")
    capability_prefixes+=("$has_capability")

    source_types=()
    parameter_regex='^([A-Za-z_][A-Za-z0-9_]*)[[:space:]]+native_v_([0-9]+)$'
    while [[ "$source_index" -lt ${#raw_parameters[@]} ]]; do
      parameter="${raw_parameters[$source_index]}"
      [[ "$parameter" =~ $parameter_regex ]] ||
        die "cannot parse source parameter in prototype for $logical: $parameter"
      [[ "${BASH_REMATCH[2]}" == "${#source_types[@]}" ]] ||
        die "generated source parameters are out of order for $logical"
      source_types+=("${BASH_REMATCH[1]}")
      source_index=$((source_index + 1))
    done
    [[ ${#source_types[@]} -eq "${source_arities[$index]}" ]] ||
      die "generated prototype for $logical has ${#source_types[@]} source arguments; expected ${source_arities[$index]}"
    for source_index in "${!source_types[@]}"; do
      argument_types["$index:$source_index"]="${source_types[$source_index]}"
    done
  done

  {
    printf '%s\n' \
      '#ifndef FRAM_SERVER_SYMBOLS_H' \
      '#define FRAM_SERVER_SYMBOLS_H' \
      '' \
      '#include "module_0.h"' \
      ''
    for index in "${!logical_names[@]}"; do
      suffix="${suffixes[$index]}"
      printf 'typedef %s fram_server_%s_return;\n' \
        "${return_types[$index]}" "$suffix"
      for ((source_index = 0; source_index < source_arities[index]; source_index += 1)); do
        printf 'typedef %s fram_server_%s_arg_%d;\n' \
          "${argument_types["$index:$source_index"]}" "$suffix" "$source_index"
      done
      printf '#define FRAM_SERVER_SYMBOL_%s %s\n' \
        "${macro_suffixes[$index]}" "${symbols[$index]}"

      call_parameters='arena, capability'
      call_arguments=''
      if [[ "${arena_prefixes[$index]}" == "1" ]]; then
        call_arguments='(arena)'
      fi
      if [[ "${capability_prefixes[$index]}" == "1" ]]; then
        [[ -z "$call_arguments" ]] || call_arguments+=', '
        call_arguments+='(capability)'
      fi
      for ((source_index = 0; source_index < source_arities[index]; source_index += 1)); do
        call_parameters+=", arg_$source_index"
        [[ -z "$call_arguments" ]] || call_arguments+=', '
        call_arguments+="(arg_$source_index)"
      done
      printf '#define FRAM_SERVER_CALL_%s(%s) FRAM_SERVER_SYMBOL_%s(%s)\n' \
        "${macro_suffixes[$index]}" "$call_parameters" \
        "${macro_suffixes[$index]}" "$call_arguments"
      printf '\n'
    done
    printf '%s\n' '#endif'
  } >"$destination"
}

world_input_manifest="$(mktemp "$world_cache/.tmp/input.XXXXXX")"
write_world_input_manifest "$world_input_manifest"
world_closure_hash="$(sha256sum "$world_input_manifest" | sed 's/ .*//')"
world_dir="$world_cache/$world_closure_hash"

exec {world_lock_fd}>"$world_cache/.locks/$world_closure_hash.lock"
flock "$world_lock_fd"
if [[ ! -e "$world_dir" ]]; then
  world_stage="$(mktemp -d "$world_cache/.tmp/$world_closure_hash.XXXXXX")"
  cp "$world_input_manifest" "$world_stage/input.manifest"
  combined_status=0
  "$beagle" build --materializer c17 --materializer qbe \
      --out "$world_stage" --abi "$abi" \
      "${native_server_entry_args[@]}" \
      -- \
      "${normalized_sources[@]}" \
      >"$world_stage/materialize.log" 2>&1 || combined_status=$?
  # beagle-build-core wipes managed artifacts up front and, on any materializer
  # failure, exits before copying the successful ones out (:118-133, :713-720).
  [[ -f "$world_stage/report.txt" ]] ||
    die "$(sed -n '1,240p' "$world_stage/materialize.log"; echo "Beagle Native World materialization produced no report")"
  cp "$world_stage/report.txt" "$world_stage/qbe-probe.report.txt"
  combined_world_digest=""
  [[ ! -f "$world_stage/module.native-world" ]] ||
    combined_world_digest="$(sha256sum "$world_stage/module.native-world" | sed 's/ .*//')"
  if [[ "$combined_status" -ne 0 ]]; then
    # Recover C17's output from the sibling refusal; any other failure is fatal.
    grep -Fxq 'materialize-c17 OK module_0.h module_0.c' \
      "$world_stage/qbe-probe.report.txt" &&
      grep -Fxq 'result FAIL materialization' \
        "$world_stage/qbe-probe.report.txt" &&
      grep -q '^materialize-qbe REFUSED ' "$world_stage/qbe-probe.report.txt" || {
        sed -n '1,240p' "$world_stage/materialize.log" >&2
        die "Beagle Native World materialization failed"
      }
    "$beagle" build --materializer c17 \
        --out "$world_stage" --abi "$abi" \
        "${native_server_entry_args[@]}" \
        -- \
        "${normalized_sources[@]}" \
        >"$world_stage/materialize.log" 2>&1 || {
      sed -n '1,240p' "$world_stage/materialize.log" >&2
      die "C17 recovery materialization failed after a QBE refusal"
    }
  fi
  write_qbe_frontier "$world_stage/qbe-probe.report.txt" \
    "$world_stage/qbe-frontier.txt"
  for artifact in source.facts module.native-world module.native-world.sha256 \
      module_0.h module_0.c native_shim.h native_shim.c \
      native_unicode15_data.h UNICODE-LICENSE.txt report.txt; do
    [[ -f "$world_stage/$artifact" ]] ||
      die "C17 materialization omitted $artifact"
  done
  validate_native_report "$world_stage/report.txt"
  [[ "$host" == "world" ]] ||
    { write_server_symbols "$world_stage/report.txt" "$world_stage/module_0.h" \
        "$world_stage/server_symbols.validate"
      rm -f "$world_stage/server_symbols.validate"; }
  native_world_digest="$(sha256sum "$world_stage/module.native-world" | sed 's/ .*//')"
  # The frontier receipt only attributes anything if QBE judged this world.
  [[ "$combined_world_digest" == "$native_world_digest" ]] ||
    die "QBE and C17 materialized different Native Worlds; the frontier receipt cannot be attributed"
  if [[ "$(awk -F'\t' '$1 == "status" { print $2 }' "$world_stage/qbe-frontier.txt")" == "OK" ]]; then
    [[ -f "$world_stage/module_0.ssa" ]] ||
      die "QBE reported OK but omitted module_0.ssa"
  else
    rm -f "$world_stage/module_0.ssa"
  fi
  check_qbe_frontier "$world_stage/qbe-frontier.txt"
  [[ "$(<"$world_stage/module.native-world.sha256")" == "$native_world_digest" ]] ||
    die "materializer Native World digest does not match its bytes"
  write_world_input_manifest "$world_stage/input.after"
  cmp -s "$world_input_manifest" "$world_stage/input.after" ||
    die "source/compiler/config closure changed during Native World build"
  rm -f "$world_stage/input.after"
  printf 'fram-native-world/v1 %s %s\n' \
    "$world_closure_hash" "$native_world_digest" >"$world_stage/READY"
  mv "$world_stage" "$world_dir"
  world_stage=""
fi

[[ -f "$world_dir/READY" && -f "$world_dir/input.manifest" &&
  -f "$world_dir/module.native-world" &&
  -f "$world_dir/module.native-world.sha256" ]] ||
  die "Native World cache entry is incomplete: $world_dir"
cmp -s "$world_input_manifest" "$world_dir/input.manifest" ||
  die "Native World cache identity does not match its input closure"
native_world_digest="$(sha256sum "$world_dir/module.native-world" | sed 's/ .*//')"
[[ "$(<"$world_dir/module.native-world.sha256")" == "$native_world_digest" &&
  "$(<"$world_dir/READY")" == \
    "fram-native-world/v1 $world_closure_hash $native_world_digest" ]] ||
  die "Native World cache entry failed its digest receipt: $world_dir"
validate_native_report "$world_dir/report.txt"
[[ -f "$world_dir/qbe-frontier.txt" && -f "$world_dir/qbe-probe.report.txt" ]] ||
  die "Native World cache entry omitted its QBE frontier receipt: $world_dir"
check_qbe_frontier "$world_dir/qbe-frontier.txt"
[[ "$regen_qbe_frontier" == 0 ]] || exit 0

if [[ "$host" == "world" ]]; then
  printf '%s\n' "$world_dir"
  exit 0
fi

input_manifest="$(mktemp "$cache_root/.tmp/input.XXXXXX")"
write_input_manifest "$input_manifest"
closure_hash="$(sha256sum "$input_manifest" | sed 's/ .*//')"
artifact_dir="$cache_root/$closure_hash"

exec {lock_fd}>"$cache_root/.locks/$closure_hash.lock"
flock "$lock_fd"
if [[ -e "$artifact_dir" ]]; then
  ready=""
  [[ ! -f "$artifact_dir/READY" ]] || ready="$(<"$artifact_dir/READY")"
  [[ "$ready" == "fram-native-build/v1 $closure_hash" &&
    -f "$artifact_dir/input.manifest" ]] ||
    die "cache entry exists but is not READY: $artifact_dir"
  cmp -s "$input_manifest" "$artifact_dir/input.manifest" ||
    die "cache entry identity does not match its input closure: $artifact_dir"
  if [[ "$host" == "embed" ]]; then
    [[ -f "$artifact_dir/include/fram.h" &&
      -f "$artifact_dir/lib/libfram.a" &&
      -f "$artifact_dir/lib/libfram.so" ]] ||
      die "embed cache entry omitted its public libraries: $artifact_dir"
  else
    [[ -x "$artifact_dir/bin/fram-server-native" ]] ||
      die "native cache entry omitted its executable: $artifact_dir"
  fi
  printf '%s\n' "$artifact_dir"
  exit 0
fi

stage="$(mktemp -d "$cache_root/.tmp/$closure_hash.XXXXXX")"
mkdir -p "$stage/bin" "$stage/include" "$stage/lib"
cp "$input_manifest" "$stage/input.manifest"
for artifact in source.facts module.native-world module.native-world.sha256 \
    module_0.h module_0.c native_shim.h native_shim.c \
    native_unicode15_data.h UNICODE-LICENSE.txt report.txt \
    qbe-frontier.txt qbe-probe.report.txt materialize.log; do
  [[ -f "$world_dir/$artifact" ]] ||
    die "Native World cache entry omitted $artifact"
  cp "$world_dir/$artifact" "$stage/$artifact"
done
[[ ! -f "$world_dir/module_0.ssa" ]] ||
  cp "$world_dir/module_0.ssa" "$stage/module_0.ssa"

report="$stage/report.txt"

[[ -f "$stage/native_shim.c" && -f "$stage/native_shim.h" ]] ||
  die "C17 materializer omitted the native shim"
write_server_symbols "$report" "$stage/module_0.h" \
  "$stage/server_symbols.h"
shopt -s nullglob
module_sources=("$stage"/module_*.c)
shopt -u nullglob
[[ ${#module_sources[@]} -gt 0 ]] || die "C17 materializer omitted module_*.c"
if [[ "$host" == "server" ]]; then
  link_flags=()
  [[ "$link_mode" != static ]] || link_flags+=(-static)
  if ! "$cc" -std=c17 -pedantic -Wall -Wextra -Werror -pthread \
      "${link_flags[@]}" \
      -I"$stage" -I"$(dirname "$host_header")" \
      "${module_sources[@]}" \
      "$stage/native_shim.c" \
      "$host_source" \
      "$adapter" \
      -o "$stage/bin/fram-server-native" \
      >"$stage/native-host.log" 2>&1; then
    sed -n '1,240p' "$stage/native-host.log" >&2
    die "server native host link failed"
  fi
  {
    printf 'native-host-c17 PASS compiler=%s output=%s\n' \
      "$cc" "$stage/bin/fram-server-native"
    printf 'native-host-abi PASS host=server exports=8\n'
    write_qbe_frontier_receipt
  } >"$stage/native-host.report.txt"
else
  mkdir -p "$stage/objects"
  embed_sources=("${module_sources[@]}" "$stage/native_shim.c" \
    "$adapter" "$host_source")
  embed_objects=()
  for index in "${!embed_sources[@]}"; do
    object="$stage/objects/$index.o"
    if ! "$cc" -std=c17 -pedantic -Wall -Wextra -Werror -pthread \
        -fPIC -fvisibility=hidden -DFRAM_BUILDING_SHARED \
        -I"$stage" -I"$repo/native" -c "${embed_sources[$index]}" \
        -o "$object" >>"$stage/native-host.log" 2>&1; then
      sed -n '1,240p' "$stage/native-host.log" >&2
      die "embed native object compilation failed"
    fi
    embed_objects+=("$object")
  done
  if ! "$ar" rcs "$stage/lib/libfram.a" "${embed_objects[@]}" \
      >>"$stage/native-host.log" 2>&1 ||
     ! "$cc" -shared -pthread "${embed_objects[@]}" \
      -o "$stage/lib/libfram.so" >>"$stage/native-host.log" 2>&1; then
    sed -n '1,240p' "$stage/native-host.log" >&2
    die "embed native library link failed"
  fi
  cp "$host_header" "$stage/include/fram.h"
  if command -v nm >/dev/null 2>&1; then
    nm -D --defined-only "$stage/lib/libfram.so" \
      | awk '{print $3}' | sed -n '/^fram_/p' | sort \
      >"$stage/embed.exports"
    printf '%s\n' fram_abi_version fram_buffer_release fram_close fram_open \
      fram_query fram_snapshot fram_transact | sort >"$stage/embed.expected"
    cmp -s "$stage/embed.expected" "$stage/embed.exports" ||
      die "embed shared library exports do not match the public ABI"
    rm -f "$stage/embed.expected"
  fi
  {
    printf 'native-host-c17 PASS compiler=%s output=%s\n' \
      "$cc" "$stage/lib/libfram.so"
    printf 'native-host-static PASS archiver=%s output=%s\n' \
      "$ar" "$stage/lib/libfram.a"
    printf 'native-host-abi PASS host=embed exports=7 version=1\n'
    write_qbe_frontier_receipt
  } >"$stage/native-host.report.txt"
fi
if [[ "$host" == "embed" ]]; then
  [[ -f "$stage/include/fram.h" && -f "$stage/lib/libfram.a" &&
    -f "$stage/lib/libfram.so" ]] || die "native embed libraries are missing"
else
  [[ -x "$stage/bin/fram-server-native" ]] || die "native executable is missing"
fi

world_after_manifest="$stage/world-input.after"
write_world_input_manifest "$world_after_manifest"
cmp -s "$world_input_manifest" "$world_after_manifest" ||
  die "source/compiler/config closure changed during host packaging"
rm -f "${world_after_manifest:?}"
after_manifest="$stage/input.after"
write_input_manifest "$after_manifest"
cmp -s "$input_manifest" "$after_manifest" ||
  die "host packaging closure changed during build"
rm -f "${after_manifest:?}"
printf 'fram-native-build/v1 %s\n' "$closure_hash" >"$stage/READY"
mv "$stage" "$artifact_dir"
stage=""
printf '%s\n' "$artifact_dir"
