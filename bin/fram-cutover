#!/usr/bin/env bb

;; Private-endpoint controller for fram-coordinator-cutover/v1.
;; The public selector owns HOLD/SWAP/RESUME. This command owns one daemon's
;; token-gated, log-fenced status/demotion/promotion turn and emits exactly one
;; EDN response on stdout for machine consumption.

(require '[clojure.edn :as edn]
         '[clojure.java.io :as io]
         '[clojure.string :as str])

(import '[java.net InetSocketAddress Socket]
        '[java.nio.charset StandardCharsets]
        '[java.nio.file CopyOption Files LinkOption OpenOption
          StandardCopyOption StandardOpenOption]
        '[java.nio.file.attribute PosixFilePermission])

(def protocol "fram-coordinator-cutover/v1")
(def usage
  (str
   "usage:\n"
   "  fram-cutover status  --port P --log PATH --token-file FILE\n"
   "  fram-cutover prepare --port P --log PATH --token-file FILE"
   " --cutover-id ID\n"
   "  fram-cutover demote --port P --log PATH --token-file FILE"
   " --cutover-id ID --expected-instance BOOT --marker-out FILE\n"
   "  fram-cutover promote --port P --log PATH --token-file FILE"
   " --cutover-id ID --marker-file FILE\n"
   "optional: --host HOST (default 127.0.0.1)"
   " --timeout-ms N (default 65000)\n"))

(defn exit! [code response]
  (println (pr-str response))
  (flush)
  (System/exit code))

(defn fail! [exit-code code message]
  (exit! exit-code
         {:error [(str message)]
          :code code
          :protocol protocol}))

(defn parse-options [args]
  (loop [remaining args
         parsed {}]
    (cond
      (empty? remaining) parsed
      (or (= 1 (count remaining))
          (not (str/starts-with? (first remaining) "--")))
      (fail! 2 :cutover-usage usage)
      :else
      (recur (nnext remaining)
             (assoc parsed
                    (keyword (subs (first remaining) 2))
                    (second remaining))))))

(defn required! [options key]
  (let [value (get options key)]
    (when (str/blank? (str value))
      (fail! 2 :cutover-usage
             (str "missing --" (name key) "\n" usage)))
    value))

(defn positive-int! [value label]
  (let [parsed (parse-long (str value))]
    (when-not (and parsed (pos? parsed) (<= parsed Integer/MAX_VALUE))
      (fail! 2 :cutover-usage
             (str label " must be a positive integer")))
    (int parsed)))

(defn canonical-path [path]
  (.getCanonicalPath (io/file path)))

(defn read-token! [path]
  (let [file (.toPath (io/file path))
        nofollow (into-array LinkOption
                             [LinkOption/NOFOLLOW_LINKS])]
    (when-not (Files/isRegularFile file nofollow)
      (fail! 2 :cutover-token-file-invalid
             "token file must be a regular non-symlink file"))
    (let [permissions (Files/getPosixFilePermissions file nofollow)
          forbidden (remove
                     #{PosixFilePermission/OWNER_READ
                       PosixFilePermission/OWNER_WRITE}
                     permissions)
          _ (when (seq forbidden)
              (fail! 2 :cutover-token-file-invalid
                     "token file permissions must be owner-only (0400 or 0600)"))
          token (str/trim (Files/readString file StandardCharsets/UTF_8))]
      (when (str/blank? token)
        (fail! 2 :cutover-token-file-invalid
               "token file must contain a nonblank token"))
      token)))

(defn read-marker! [path]
  (try
    (let [marker (edn/read-string
                  (Files/readString
                   (.toPath (io/file path))
                   StandardCharsets/UTF_8))]
      (when-not (map? marker)
        (fail! 2 :cutover-marker-file-invalid
               "marker file must contain one EDN map"))
      marker)
    (catch Throwable t
      (fail! 2 :cutover-marker-file-invalid
             (str "cannot read marker file: " (.getMessage t))))))

(def owner-read-write
  #{PosixFilePermission/OWNER_READ
    PosixFilePermission/OWNER_WRITE})

(defn write-marker-atomically! [path marker]
  (let [target (.toAbsolutePath (.normalize (.toPath (io/file path))))
        parent (or (.getParent target)
                   (.toPath (io/file ".")))
        tmp (Files/createTempFile parent ".fram-cutover-marker-" ".tmp"
                                  (make-array
                                   java.nio.file.attribute.FileAttribute
                                   0))]
    (try
      (Files/setPosixFilePermissions tmp owner-read-write)
      (with-open [channel
                  (java.nio.channels.FileChannel/open
                   tmp
                   (into-array
                    OpenOption
                    [StandardOpenOption/WRITE
                     StandardOpenOption/TRUNCATE_EXISTING]))]
        (let [bytes (.getBytes
                     (str (pr-str marker) "\n")
                     StandardCharsets/UTF_8)]
          (.write channel (java.nio.ByteBuffer/wrap bytes))
          (.force channel true)))
      (Files/move
       tmp target
       (into-array
        CopyOption
        [StandardCopyOption/ATOMIC_MOVE
         StandardCopyOption/REPLACE_EXISTING]))
      (Files/setPosixFilePermissions target owner-read-write)
      (finally
        (Files/deleteIfExists tmp)))))

(defn wire-request! [host port timeout-ms log inner]
  (with-open [socket (Socket.)]
    (.connect socket (InetSocketAddress. host port)
              (min timeout-ms 5000))
    (.setSoTimeout socket timeout-ms)
    (with-open [writer (io/writer (.getOutputStream socket))
                reader (java.io.PushbackReader.
                        (io/reader (.getInputStream socket)))]
      (.write writer
              (str
               (pr-str
                {:op :for-log
                 :expected-log (canonical-path log)
                 :request inner})
               "\n"))
      (.flush writer)
      (let [response (edn/read {:eof ::eof} reader)]
        (when (or (= ::eof response)
                  (not (map? response)))
          (throw
           (ex-info
            "coordinator returned no EDN response map"
            {:code :cutover-protocol-error})))
        response))))

(let [[command & raw-options] *command-line-args*
      options (parse-options raw-options)
      host (or (:host options) "127.0.0.1")
      port (positive-int! (required! options :port) "--port")
      timeout-ms (positive-int! (or (:timeout-ms options) "65000")
                                "--timeout-ms")
      log (required! options :log)
      token (read-token! (required! options :token-file))
      inner
      (case command
        "status"
        {:op :cutover-status
         :token token}

        "prepare"
        {:op :cutover-prepare
         :token token
         :cutover-id (required! options :cutover-id)}

        "demote"
        {:op :cutover-demote
         :token token
         :cutover-id (required! options :cutover-id)
         :expected-instance (required! options :expected-instance)}

        "promote"
        {:op :cutover-promote
         :token token
         :cutover-id (required! options :cutover-id)
         :marker (read-marker! (required! options :marker-file))}

        (fail! 2 :cutover-usage usage))]
  (try
    (let [response (wire-request! host port timeout-ms log inner)]
      (if (or (:reject response) (:error response))
        (exit! 3 response)
        (do
          (when (= command "demote")
            (let [marker (:marker response)]
              (when-not (map? marker)
                (fail! 4 :cutover-protocol-error
                       "successful demotion response has no marker map"))
              (write-marker-atomically!
               (required! options :marker-out)
               marker)))
          (exit! 0 response))))
    (catch Throwable t
      (fail! 4
             (or (:code (ex-data t)) :cutover-transport-error)
             (or (.getMessage t)
                 (.getSimpleName (class t)))))))
