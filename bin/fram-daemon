#!/usr/bin/env bash
# Fram coordinator daemon — the sole-writer multi-agent service. Production
# launches require a completed Beagle native artifact. The JVM remains available
# only through the explicitly selected oracle or checkout-development routes.
#   fram-daemon [serve] [port] [framlog] [space-id]   (mode defaults to serve)
#   FRAM_DAEMON_RUNTIME=native       production runtime (default)
#   FRAM_NATIVE_ARTIFACT_DIR=<path>  READY native-build artifact directory
#   FRAM_DAEMON_RUNTIME=graal        transitional self-contained coordinator
#   FRAM_GRAAL_ARTIFACT=<path>       absolute Graal coordinator executable
#   FRAM_DAEMON_RUNTIME=jvm-oracle   sealed Java/classpath differential oracle
#   FRAM_DAEMON_RUNTIME=jvm-dev      checkout-only Clojure development runtime
#   FRAM_BIND=0.0.0.0          bind all interfaces (default loopback)
#   FRAM_DAEMON_XMX=4g         JVM fallback max heap; empty disables the flag
#   FRAM_DAEMON_G1_REGION=32m  JVM fallback G1 region size; empty disables it
#   FRAM_DAEMON_LOG=<path>     request log file (default stderr)
#   FRAM_DAEMON_QUIET=1        log only slow requests
#   FRAM_SLOW_MS=1000          slow-request threshold, always logged
#   TLS termination belongs at the authenticated gateway until the sealed native
#   TLS listener is restored; these public data sockets are plaintext/private.
set -euo pipefail

HERE="$(cd "$(dirname "$0")/.." && pwd)"
# A numeric first arg keeps the convenient `fram-daemon [port] [log]` shape.
# Flat-log serving was removed; migration is a separate one-shot command.
mode=serve
case "${1:-}" in
  serve) shift ;;
  serve-flat)
    echo "fram-daemon: serve-flat was removed; migrate once with bin/fram-migrate-triple-log" >&2
    exit 2
    ;;
esac

if [[ -n "${2:-}" ]]; then
  log_path="$2"
elif [[ -n "${FRAM_LOG:-}" ]]; then
  log_path="$FRAM_LOG"
elif [[ "${FRAM_PACKAGED:-0}" == "1" ]]; then
  if [[ -n "${FRAM_STATE_DIR:-}" ]]; then
    state_dir="$FRAM_STATE_DIR"
  elif [[ -n "${XDG_STATE_HOME:-}" ]]; then
    state_dir="$XDG_STATE_HOME/fram"
  elif [[ -n "${HOME:-}" ]]; then
    state_dir="$HOME/.local/state/fram"
  else
    echo "fram-daemon: pass a log path, or set FRAM_LOG, FRAM_STATE_DIR, XDG_STATE_HOME, or HOME" >&2
    exit 2
  fi
  log_path="$state_dir/history.framlog"
else
  log_path="$HERE/history.framlog"
fi
space_id="${3:-${FRAM_SPACE_ID:-}}"
if [[ ! -e "$log_path" && -z "$space_id" ]]; then
  echo "fram-daemon: FRAM_SPACE_ID (or the fourth argument) is required to create a FRAMLOG" >&2
  exit 2
fi

runtime="${FRAM_DAEMON_RUNTIME:-native}"
case "$runtime" in
  native)
    artifact_dir="${FRAM_NATIVE_ARTIFACT_DIR:-}"
    if [[ -z "$artifact_dir" ]]; then
      echo "fram-daemon: FRAM_NATIVE_ARTIFACT_DIR is required for FRAM_DAEMON_RUNTIME=native" >&2
      exit 2
    fi
    case "$artifact_dir" in
      /*) ;;
      *)
        echo "fram-daemon: FRAM_NATIVE_ARTIFACT_DIR must be absolute: $artifact_dir" >&2
        exit 2
        ;;
    esac
    ready="$artifact_dir/READY"
    native_daemon="$artifact_dir/bin/fram-daemon-native"
    if [[ ! -r "$ready" ]]; then
      echo "fram-daemon: native artifact is not ready: missing $ready" >&2
      exit 2
    fi
    ready_line="$(<"$ready")"
    if [[ ! "$ready_line" =~ ^fram-native-build/v1\ [0-9a-f]{64}$ ]]; then
      echo "fram-daemon: native artifact READY marker is invalid: $ready" >&2
      exit 2
    fi
    if [[ ! -x "$native_daemon" ]]; then
      echo "fram-daemon: native artifact executable is unavailable: $native_daemon" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$log_path")"
    export FRAM_PORT="${1:-7977}"
    export FRAM_LOG="$log_path"
    if [[ -n "$space_id" ]]; then export FRAM_SPACE_ID="$space_id"; fi
    cd "$HERE"
    exec "$native_daemon"
    ;;
  graal)
    graal_artifact="${FRAM_GRAAL_ARTIFACT:-}"
    if [[ -z "$graal_artifact" ]]; then
      echo "fram-daemon: FRAM_GRAAL_ARTIFACT is required for FRAM_DAEMON_RUNTIME=graal" >&2
      exit 2
    fi
    case "$graal_artifact" in
      /*) ;;
      *)
        echo "fram-daemon: FRAM_GRAAL_ARTIFACT must be absolute: $graal_artifact" >&2
        exit 2
        ;;
    esac
    if [[ ! -x "$graal_artifact" ]]; then
      echo "fram-daemon: Graal coordinator executable is unavailable: $graal_artifact" >&2
      exit 2
    fi
    mkdir -p "$(dirname "$log_path")"
    graal_args=("$mode" "${1:-7977}" "$log_path")
    if [[ -n "$space_id" ]]; then graal_args+=("$space_id"); fi
    cd "$HERE"
    exec "$graal_artifact" "${graal_args[@]}"
    ;;
  jvm-oracle|jvm-dev) ;;
  *)
    echo "fram-daemon: unsupported FRAM_DAEMON_RUNTIME '$runtime'; expected native, graal, jvm-oracle, or jvm-dev" >&2
    exit 2
    ;;
esac

mkdir -p "$(dirname "$log_path")"
daemon_args=(coord_daemon.clj "$mode" "${1:-7977}" "$log_path")
if [[ -n "$space_id" ]]; then daemon_args+=("$space_id"); fi

# Heap and G1 region size are bound together: shrinking the heap also shrinks the
# ergonomic region, which LOWERS the humongous-allocation threshold.
heap_flags=()
xmx="${FRAM_DAEMON_XMX-4g}"
if [[ -n "$xmx" ]]; then heap_flags+=("-Xmx$xmx"); fi
g1_region="${FRAM_DAEMON_G1_REGION-32m}"
if [[ -n "$g1_region" ]]; then
  heap_flags+=(-XX:+UseG1GC "-XX:G1HeapRegionSize=$g1_region")
fi
# A capped heap must die loudly, not thrash: the supervisor restarts it and
# the dump names the culprit. FRAM_DAEMON_NO_OOM_EXIT=1 opts out.
if [[ -z "${FRAM_DAEMON_NO_OOM_EXIT:-}" && -n "$xmx" ]]; then
  oom_dump="${FRAM_DAEMON_LOG:+$FRAM_DAEMON_LOG.heap.hprof}"
  heap_flags+=(-XX:+ExitOnOutOfMemoryError -XX:+HeapDumpOnOutOfMemoryError
    "-XX:HeapDumpPath=${oom_dump:-/tmp/fram-daemon-oom.hprof}")
fi

if [[ "$runtime" == "jvm-oracle" ]]; then
  if [[ -z "${FRAM_JAVA:-}" || -z "${FRAM_DAEMON_CLASSPATH_FILE:-}" ]]; then
    echo "fram-daemon: FRAM_DAEMON_RUNTIME=jvm-oracle requires FRAM_JAVA and FRAM_DAEMON_CLASSPATH_FILE" >&2
    exit 2
  fi
  if [[ ! -x "$FRAM_JAVA" ]]; then
    echo "fram-daemon: FRAM_JAVA is not executable: $FRAM_JAVA" >&2
    exit 2
  fi
  if [[ ! -r "$FRAM_DAEMON_CLASSPATH_FILE" ]]; then
    echo "fram-daemon: classpath file is not readable: $FRAM_DAEMON_CLASSPATH_FILE" >&2
    exit 2
  fi
  daemon_classpath="$(<"$FRAM_DAEMON_CLASSPATH_FILE")"
  if [[ -z "$daemon_classpath" ]]; then
    echo "fram-daemon: packaged classpath is empty" >&2
    exit 2
  fi
  cd "$HERE"
  jvm_args=("${heap_flags[@]}")
  if [[ -n "${FRAM_LISTEN_FD:-}" ]]; then
    jvm_args+=(
      --add-exports=java.base/sun.nio.ch=ALL-UNNAMED
      --add-opens=java.base/sun.nio.ch=ALL-UNNAMED
    )
  fi
  exec "$FRAM_JAVA" "${jvm_args[@]}" -cp "$daemon_classpath" clojure.main \
    "${daemon_args[@]}"
fi

if [[ "${FRAM_PACKAGED:-0}" == "1" ]]; then
  echo "fram-daemon: FRAM_DAEMON_RUNTIME=jvm-dev is checkout-only" >&2
  exit 2
fi
if [[ -n "${FRAM_JAVA:-}" || -n "${FRAM_DAEMON_CLASSPATH_FILE:-}" ]]; then
  echo "fram-daemon: FRAM_DAEMON_RUNTIME=jvm-dev rejects packaged Java/classpath bindings" >&2
  exit 2
fi
if ! command -v clojure >/dev/null 2>&1; then
  echo "fram-daemon: FRAM_DAEMON_RUNTIME=jvm-dev requires clojure on PATH" >&2
  exit 2
fi
cd "$HERE"
clojure_jvm_args=()
for flag in "${heap_flags[@]}"; do clojure_jvm_args+=("-J$flag"); done
if [[ -n "${FRAM_LISTEN_FD:-}" ]]; then
  clojure_jvm_args+=(
    -J--add-exports=java.base/sun.nio.ch=ALL-UNNAMED
    -J--add-opens=java.base/sun.nio.ch=ALL-UNNAMED
  )
fi
exec clojure "${clojure_jvm_args[@]}" -M "${daemon_args[@]}"
