#!/usr/bin/env bash
set -euo pipefail

flags=()
while [[ "${1:-}" == "--deflate" || "${1:-}" == "--renumber" ]]; do
  flags+=("$1")
  shift
done

if [[ $# -ne 3 ]]; then
  echo "usage: fram-migrate-triple-log [--deflate] [--renumber] SOURCE SPACE_ID TARGET" >&2
  exit 2
fi

HERE="${BASH_SOURCE[0]%/*}/.."
cd "$HERE"
exec bb -cp "$HERE/out" "$HERE/server.clj" migrate-triple-log \
  "${flags[@]}" "$1" "$2" "$3"
