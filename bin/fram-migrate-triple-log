#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" == "--deflate" ]]; then
  deflate=true
  shift
else
  deflate=false
fi

if [[ $# -ne 3 ]]; then
  echo "usage: fram-migrate-triple-log [--deflate] SOURCE SPACE_ID TARGET" >&2
  exit 2
fi

HERE="${BASH_SOURCE[0]%/*}/.."
cd "$HERE"
if [[ "$deflate" == true ]]; then
  exec clojure -M "$HERE/server.clj" migrate-triple-log --deflate "$1" "$2" "$3"
fi
exec clojure -M "$HERE/server.clj" migrate-triple-log "$1" "$2" "$3"
