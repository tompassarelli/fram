{
  "name": "@tompassarelli/fram-cloudflare-do",
  "version": "0.1.0",
  "description": "Embed the Fram engine inside a Cloudflare Durable Object over the wasm-embed host seam",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/adapter.mjs"
    },
    "./seams": {
      "import": "./src/seams.mjs"
    }
  },
  "files": [
    "src/adapter.mjs",
    "src/seams.mjs",
    "scripts/build-wasm.sh",
    "scripts/check-seams.mjs",
    "wrangler.example.toml",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "bun": "1.3.13"
  },
  "scripts": {
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:seams": "bun scripts/check-seams.mjs",
    "pack:frames": "bun test/pack-frames.mjs",
    "test:bun": "bun test/run-node.mjs lib/libfram.wasm ../../tests/wasm_embed/frames",
    "test:workerd": "bun test/run-matrix.mjs test/out",
    "capacity": "bash capacity/run-gate.sh",
    "capacity:receipt": "bun test capacity/receipt.test.mjs"
  },
  "devDependencies": {
    "miniflare": "5.20260804.1-alpha",
    "wrangler": "4.121.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tompassarelli/fram.git",
    "directory": "clients/cloudflare-do"
  },
  "license": "MIT OR Apache-2.0"
}
