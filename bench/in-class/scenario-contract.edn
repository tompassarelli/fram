{:contract-version 1
 :corpus-size-unit :live-triples
 :default-corpus-sizes [3000 30000]
 :default-runs 2
 :workload
 {:warmup-writes 30
  :warmup-reads 10
  :measured-writes 1200
  :mixed-cycles 40
  :mixed-reads-per-cycle 3}
 :scenarios
 [{:id :boot-to-serving
   :measure :boot-to-serving-ms
   :definition "Open the durable corpus and reach the adapter-ready probe."}
  {:id :cold-start-query
   :measure :cold-start-query-ms
   :definition "First two-literal kind+title join after boot, before warmup."}
  {:id :sustained-write-under-read
   :measure :write-under-read-ops-s
   :definition "One sole writer commits distinct triples while concurrent readers repeat the same join."}
  {:id :mixed-read-write
   :measure :mixed-ops-s
   :definition "Fixed one-write/three-read cycles after warmup."}]
 :required-result-keys
 [:adapter :run :corpus-triples :boot-to-serving-ms
  :cold-start-query-ms :cold-query-rows :write-under-read-ops-s
  :concurrent-read-ops :mixed-ops-s :mixed-read-p50-ms :errors]
 :golden
 {:max-latency-regression-ratio 1.50
  :min-throughput-retention-ratio 0.67
  :metrics
  {:boot-to-serving-ms :lower-is-better
   :cold-start-query-ms :lower-is-better
   :write-under-read-ops-s :higher-is-better
   :mixed-ops-s :higher-is-better}}

 :index-architecture
 {:contract-version 1
  :corpus-size-unit :live-triples
  :default-corpus-sizes [3000 30000 300000]
  :rotation-corpus-size 350701
  :default-runs 2
  :engines ["store-id-hash" "mmap-rotations"]
  :required-result-keys
  [:receipt-kind :contract-version :scenario :decision-section :query-class
   :engine :run :corpus-triples :prepare-ms :query-ms :result-count
   :expected-count :errors :rss-before-kb :rss-retained-kb :heap-retained-bytes
   :storage-bytes :started-utc :revision :kernel :nproc :cpu-model
   :mem-total-kb :load-start :load-end :java-version :babashka-version]
  :scenarios []}}
